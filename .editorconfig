# Documents the formatting conventions this repo already follows (dotnet format defaults) —
# it intentionally does not introduce style changes. CI runs `dotnet format --verify-no-changes`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,razor}]
indent_size = 4

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
# Trailing double-space is meaningful markdown (hard line break)
trim_trailing_whitespace = false

[*.cs]
# Matches the codebase's established style; `dotnet format` enforces whitespace rules only,
# these naming/style entries document intent for IDEs.
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
