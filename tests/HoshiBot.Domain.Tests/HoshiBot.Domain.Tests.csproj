<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- NetCord is referenced here for exactly ONE test: BotPermissionTests, which asserts that
         Domain's BotPermission bits equal NetCord's. HoshiBot.Domain itself must stay NetCord-free
         (that's the whole reason BotPermission exists), so do not use NetCord types anywhere else
         in this project. -->
    <PackageReference Include="NetCord" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HoshiBot.Domain\HoshiBot.Domain.csproj" />
  </ItemGroup>

</Project>
