<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HoshiBot.Domain\HoshiBot.Domain.csproj" />
    <ProjectReference Include="..\HoshiBot.Data\HoshiBot.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.GenAI" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="NetCord" />
    <PackageReference Include="NetCord.Services" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="Quartz" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- OllamaSharp ships an optional source-generator (AOT JSON contexts, which we don't use)
         built against a newer Roslyn than the SDK; it's skipped with CS9057. The warning also
         propagates to any project referencing this one (see HoshiBot.Host). Harmless — silence it. -->
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

</Project>
