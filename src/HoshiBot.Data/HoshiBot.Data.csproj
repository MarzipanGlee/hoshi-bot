<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HoshiBot.Domain\HoshiBot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Large one-time seed snapshots: kept as embedded JSON, not C# array literals, so
         they cost a file read + deserialize at startup instead of Roslyn compile time on
         every build (StfcAllianceSeedData alone was ~10,000 lines of tuples). -->
    <EmbeddedResource Include="Seeding\StfcAllianceSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcPlayerSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcTerritoryOwnershipSeedData.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pins EF Core to 10.0.9 for this project and everything that references it. Npgsql
         10.0.2 only pulls EF Core 10.0.4 transitively, but Design (above, PrivateAssets=all)
         compiles this assembly against 10.0.9, so consumers must resolve 10.0.9 too or they
         hit CS1705 — the Sqlite package used to provide this pin incidentally. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
