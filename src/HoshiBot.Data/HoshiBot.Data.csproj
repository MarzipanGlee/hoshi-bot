<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HoshiBot.Domain\HoshiBot.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Large one-time seed snapshots: kept as embedded JSON, not C# array literals, so
         they cost a file read + deserialize at startup instead of Roslyn compile time on
         every build (StfcAllianceSeedData alone was ~10,000 lines of tuples). -->
    <EmbeddedResource Include="Seeding\StfcAllianceSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcPlayerSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcTerritoryOwnershipSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcServerSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcServerInviteSeedData.json" />
    <EmbeddedResource Include="Seeding\StfcServerStatusSeedData.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The explicit Relational reference pins EF Core for this project and all consumers —
         version rationale documented in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- IHttpClientFactory for the STFC import/sync services (StfcSystemSyncService etc.) -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
  </ItemGroup>

</Project>
