@implements IDisposable
@using Microsoft.AspNetCore.Authentication
@using Microsoft.EntityFrameworkCore
@inject CurrentGuildContext GuildContext
@inject DiscordUserGuildsService DiscordUserGuilds
@inject SupportModeContext SupportMode
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject GuildAllianceService AllianceService

<div class="guild-selector position-relative">
    <button type="button" class="guild-selector-toggle d-flex align-items-center gap-2 bg-white rounded-3" @onclick="ToggleOpen">
        @if (currentGuild is not null)
        {
            <GuildIcon GuildId="currentGuild.Id" IconHash="@currentGuild.IconHash" Name="@currentGuild.Name"
                       CssClass="guild-selector-icon rounded-circle object-fit-cover flex-shrink-0" Style="width:1.5rem;height:1.5rem;font-size:0.75rem;" />
            <span class="guild-selector-name text-truncate">@currentGuild.Name</span>
        }
        else
        {
            <span class="guild-selector-name guild-selector-placeholder text-truncate">@Msg.WebNav.SelectGuild(Lang)</span>
        }
        <span class="oi oi-chevron-bottom guild-selector-caret ms-auto flex-shrink-0" aria-hidden="true"></span>
    </button>

    @if (isOpen)
    {
        <div class="guild-selector-backdrop position-fixed top-0 start-0 end-0 bottom-0" @onclick="Close"></div>
        <div class="guild-selector-menu position-absolute start-0 overflow-y-auto bg-white rounded-3 shadow">
            @if (installedGuilds.Count == 0 && notInstalledGuilds.Count == 0)
            {
                <div class="guild-selector-empty">@Msg.WebNav.GuildsLoading(Lang)</div>
            }
            @foreach (var guild in installedGuilds)
            {
                <button type="button" class="guild-selector-item w-100 border-0 text-start text-decoration-none d-flex align-items-center @(guild.Id == GuildContext.GuildId ? "guild-selector-item-active fw-semibold" : "")"
                        @onclick="() => SelectAsync(guild.Id)">
                    <GuildIcon GuildId="guild.Id" IconHash="@guild.IconHash" Name="@guild.Name"
                               CssClass="guild-selector-icon rounded-circle object-fit-cover flex-shrink-0" Style="width:1.75rem;height:1.75rem;font-size:0.8rem;" />
                    <span class="text-truncate">@guild.Name</span>
                </button>
            }
            @if (notInstalledGuilds.Count > 0)
            {
                <div class="guild-selector-divider text-uppercase">@Msg.WebNav.BotNotAdded(Lang)</div>
                @foreach (var guild in notInstalledGuilds)
                {
                    <a class="guild-selector-item guild-selector-item-install w-100 border-0 text-start text-decoration-none d-flex align-items-center" href="invite?guildId=@guild.Id" target="_blank" rel="noopener">
                        <GuildIcon GuildId="guild.Id" IconHash="@guild.IconHash" Name="@guild.Name"
                                   CssClass="guild-selector-icon rounded-circle object-fit-cover flex-shrink-0" Style="width:1.75rem;height:1.75rem;font-size:0.8rem;" />
                        <span class="text-truncate">@guild.Name</span>
                        <span class="guild-selector-plus ms-auto flex-shrink-0 fw-bold" aria-hidden="true">+</span>
                    </a>
                }
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private List<UserManagedGuild> installedGuilds = [];
    private List<UserManagedGuild> notInstalledGuilds = [];
    private UserManagedGuild? currentGuild;
    private bool isOpen;

    protected override async Task OnInitializedAsync()
    {
        GuildContext.Changed += OnContextChanged;
        // Support mode is initialized in MainLayout.OnAfterRenderAsync (after this runs) and
        // fires Changed, so reload the list from the widened source once it flips on/off.
        SupportMode.Changed += OnSupportModeChanged;

        await LoadGuildsAsync();
    }

    private async Task LoadGuildsAsync()
    {
        // Support mode (global admins only): every guild the bot is in, regardless of the
        // user's own Discord membership/permissions. Otherwise, the user's own managed guilds.
        if (SupportMode.IsActive)
        {
            installedGuilds = await DiscordUserGuilds.GetAllBotGuildsAsync();
            notInstalledGuilds = [];
            UpdateCurrentGuild();
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var httpContext = HttpContextAccessor.HttpContext;
        var accessToken = httpContext is null ? null : await httpContext.GetTokenAsync("access_token");
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (accessToken is null || userIdClaim is null || !ulong.TryParse(userIdClaim, out var userId))
            return;

        var guilds = await DiscordUserGuilds.GetUserManagedGuildsAsync(accessToken, userId);
        installedGuilds = guilds.Where(g => g.BotInstalled).ToList();
        notInstalledGuilds = guilds.Where(g => !g.BotInstalled).ToList();
        UpdateCurrentGuild();
    }

    private void UpdateCurrentGuild() =>
        currentGuild = installedGuilds.FirstOrDefault(g => g.Id == GuildContext.GuildId);

    private void OnContextChanged() => InvokeAsync(() =>
    {
        UpdateCurrentGuild();
        StateHasChanged();
    });

    private void OnSupportModeChanged() => InvokeAsync(async () =>
    {
        await LoadGuildsAsync();
        StateHasChanged();
    });

    private void ToggleOpen() => isOpen = !isOpen;

    private void Close() => isOpen = false;

    private async Task SelectAsync(ulong guildId)
    {
        var previousGuildId = GuildContext.GuildId;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!await GuildContext.SetAsync(guildId, authState.User))
            return;

        isOpen = false;

        // Move the open page to the new guild too — switching used to refresh only the sidebar and
        // leave the page itself on the previous guild's data. Same idea as AllianceSelector's
        // /alliance/{id} rewrite, but a page can be inapplicable to the new guild (an audience it
        // doesn't serve, an alliance it doesn't have), so GuildScopedUrl decides where to land.
        if (previousGuildId is not { } oldGuildId || oldGuildId == guildId)
            return;

        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Split('#')[0];

        await using var db = await DbFactory.CreateDbContextAsync();
        var audiences = await db.GuildSettings
            .Where(s => s.GuildId == guildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();

        var target = GuildScopedUrl.Rewrite(path, oldGuildId, guildId, audiences, await AllianceService.GetPrimaryIdAsync(guildId));
        if (target is not null)
            Nav.NavigateTo(target);
    }

    public void Dispose()
    {
        GuildContext.Changed -= OnContextChanged;
        SupportMode.Changed -= OnSupportModeChanged;
    }
}
