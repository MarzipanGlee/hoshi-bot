@implements IDisposable
@inject CurrentGuildContext GuildContext
@inject CurrentAllianceContext AllianceContext
@inject NavigationManager Nav

@* Only shown when the guild has more than one linked alliance — a single-alliance guild has
   nothing to choose, so it auto-selects silently and this stays hidden. *@
@if (AllianceContext.Alliances.Count > 1)
{
    <div class="alliance-selector position-relative">
        <button type="button" class="alliance-selector-toggle d-flex align-items-center gap-2 bg-white rounded-3" @onclick="ToggleOpen">
            <AllianceEmblem Emblem="AllianceContext.Alliance?.StfcAlliance.Emblem" Size="20" />
            <span class="alliance-selector-tag text-truncate">@Label(AllianceContext.Alliance)</span>
            <span class="oi oi-chevron-bottom alliance-selector-caret ms-auto flex-shrink-0" aria-hidden="true"></span>
        </button>

        @if (isOpen)
        {
            <div class="alliance-selector-backdrop position-fixed top-0 start-0 end-0 bottom-0" @onclick="Close"></div>
            <div class="alliance-selector-menu position-absolute start-0 overflow-y-auto bg-white rounded-3 shadow">
                @foreach (var link in AllianceContext.Alliances)
                {
                    <button type="button" class="alliance-selector-item w-100 border-0 text-start text-decoration-none d-flex align-items-center gap-2 @(link.Id == AllianceContext.GuildAllianceId ? "alliance-selector-item-active fw-semibold" : "")"
                            @onclick="() => SelectAsync(link.Id)">
                        <AllianceEmblem Emblem="link.StfcAlliance.Emblem" Size="20" />
                        <span class="text-truncate">@Label(link)</span>
                    </button>
                }
            </div>
        }
    </div>
}

@code {
    private bool isOpen;

    protected override void OnInitialized()
    {
        GuildContext.Changed += OnChanged;
        AllianceContext.Changed += OnChanged;
    }

    private static string Label(GuildAlliance? link) =>
        link is null ? "—" : $"[{link.StfcAlliance.Tag}] {link.StfcAlliance.Name}";

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void ToggleOpen() => isOpen = !isOpen;

    private void Close() => isOpen = false;

    private async Task SelectAsync(int guildAllianceId)
    {
        await AllianceContext.SetAsync(guildAllianceId);
        isOpen = false;

        // If an alliance-scoped page (a feature editor, or the Alliance Settings/Command Bridge
        // pages) is open, move it to the new alliance so the page follows the selection. The
        // route carries the alliance id right after /alliance/ — replace just that id segment,
        // preserving any trailing path (e.g. /alliance/{id}/settings keeps "/settings").
        var path = new Uri(Nav.Uri).AbsolutePath;
        var marker = "/alliance/";
        var idx = path.IndexOf(marker, StringComparison.Ordinal);
        if (idx >= 0)
        {
            var after = path[(idx + marker.Length)..];
            var slashIdx = after.IndexOf('/');
            var suffix = slashIdx >= 0 ? after[slashIdx..] : "";
            var rewritten = path[..(idx + marker.Length)] + guildAllianceId + suffix;
            Nav.NavigateTo(rewritten);
        }
    }

    public void Dispose()
    {
        GuildContext.Changed -= OnChanged;
        AllianceContext.Changed -= OnChanged;
    }
}
