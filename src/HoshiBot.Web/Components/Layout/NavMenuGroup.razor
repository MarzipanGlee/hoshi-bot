<div class="nav-group">
    <input type="checkbox" id="@_checkboxId" class="nav-group-toggle-checkbox" checked="@(InitiallyExpanded || Active)" />
    <label for="@_checkboxId" class="nav-group-toggle rounded-1 d-flex align-items-center gap-2 w-100 fw-semibold text-uppercase @(Active ? "nav-group-toggle-active text-white" : "")">
        @if (IconContent is not null)
        {
            @IconContent
        }
        else
        {
            <span class="oi @Icon" aria-hidden="true"></span>
        }
        <span class="nav-group-label flex-grow-1 text-start">@Title</span>
        <span class="nav-group-chevron d-inline-block" aria-hidden="true">&#9656;</span>
    </label>
    <div class="nav-group-items">
        @ChildContent
    </div>
</div>

@code {
    // Most pages could render as static SSR -- a C# @onclick toggle here could silently do
    // nothing on those pages. A pure CSS checkbox/label pair (same technique the mobile
    // navbar-toggler already uses) needs no interactive circuit at all.
    private readonly string _checkboxId = $"nav-group-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Icon { get; set; } = string.Empty;

    /// <summary>Optional custom icon markup shown in place of the <see cref="Icon"/> glyph — used
    /// by the Alliance group to render the selected alliance's emblem image instead of a font icon.</summary>
    [Parameter]
    public RenderFragment? IconContent { get; set; }

    /// <summary>Whether the current route falls inside this group -- forces it open regardless of
    /// <see cref="InitiallyExpanded"/>, so navigating straight to a page never hides its own group.</summary>
    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public bool InitiallyExpanded { get; set; } = true;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
