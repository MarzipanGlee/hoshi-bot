@implements IDisposable
@inject NavigationManager NavigationManager
@inject CurrentGuildContext GuildContext
@inject GuildFeatureService FeatureService
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <img src="favicon.png" alt="" class="navbar-brand-icon" />
            Hoshi Bot
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item-top">
                    <NavLink class="nav-link" href="manage/guilds" Match="NavLinkMatch.All">Your Guilds</NavLink>
                </div>

                <NavMenuGroup Title="Alliance" Icon="oi-flag" Active="@(IsGroupActive(AllianceHrefs) || IsFeaturesGroupActive() || IsGuildScopedRouteActive("global-settings") || IsGuildScopedRouteActive("setup"))">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/dashboard">Dashboard</NavLink>
                    </div>
                    @if (GuildContext.GuildId is { } guildId)
                    {
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"manage/guilds/{guildId}/global-settings")">Settings</NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="@($"manage/guilds/{guildId}/setup")">Setup</NavLink>
                        </div>
                        @foreach (var audience in FeatureAudienceSections)
                        {
                            if (guildAudiences != GuildAudience.None && !guildAudiences.HasFlag(audience))
                                continue;

                            var features = FeatureCatalog.All
                                .Where(f => f.RelevantAudiences().HasFlag(audience) && enabledFeatures.Contains((f.Feature, audience)))
                                .ToList();
                            if (features.Count == 0)
                                continue;

                            <NavMenuGroup Title="@($"{AudienceDisplay.Labels(audience).First()} Features")" Icon="oi-puzzle-piece" Active="@features.Any(f => IsFeatureActive(f.Slug))">
                                @foreach (var feature in features)
                                {
                                    <div class="nav-item px-3">
                                        <NavLink class="nav-link" href="@FeatureHref(guildId, feature, audience)">
                                            @feature.Title
                                        </NavLink>
                                    </div>
                                }
                            </NavMenuGroup>
                        }
                    }
                </NavMenuGroup>

                <NavMenuGroup Title="STFC Catalog" Icon="oi-globe" Active="@IsGroupActive(CatalogHrefs)">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/regions">Regions</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/veil-groups">Veil Groups</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/servers">Servers</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/alliances">Alliances</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/alliance-diplomacy">Diplomacy</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/alliance-name-history">Alliance Name History</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/players">Players</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/player-name-history">Player Name History</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/systems">Systems</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/territories">Territories</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/server-status">Server Status</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/stfc/event-status">Event Status</NavLink>
                    </div>
                </NavMenuGroup>

                <NavMenuGroup Title="Administration" Icon="oi-shield" Active="@IsGroupActive(AdministrationHrefs)">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="manage/global-admins">Global Admins</NavLink>
                    </div>
                </NavMenuGroup>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly string[] AllianceHrefs = ["manage/dashboard"];
    private static readonly string[] CatalogHrefs =
        ["manage/stfc/regions", "manage/stfc/veil-groups", "manage/stfc/servers", "manage/stfc/alliances", "manage/stfc/alliance-diplomacy",
         "manage/stfc/alliance-name-history", "manage/stfc/players", "manage/stfc/player-name-history", "manage/stfc/systems",
         "manage/stfc/territories", "manage/stfc/server-status", "manage/stfc/event-status"];
    private static readonly string[] AdministrationHrefs = ["manage/global-admins"];
    private static readonly GuildAudience[] FeatureAudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private bool collapseNavMenu = true;
    private string? currentUrl;
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> enabledFeatures = [];
    private GuildAudience guildAudiences = GuildAudience.None;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        GuildContext.Changed += OnGuildContextChanged;
        await LoadEnabledFeaturesAsync();
    }

    private async Task LoadEnabledFeaturesAsync()
    {
        enabledFeatures = [];
        guildAudiences = GuildAudience.None;
        if (GuildContext.GuildId is not { } guildId)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        guildAudiences = await db.GuildSettings
            .Where(s => s.GuildId == guildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();

        foreach (var feature in FeatureCatalog.All)
        {
            var audiences = await FeatureService.GetEnabledAudiencesAsync(guildId, feature.Feature);
            foreach (var audience in audiences)
                enabledFeatures.Add((feature.Feature, audience));
        }
    }

    private void OnGuildContextChanged() => InvokeAsync(async () =>
    {
        await LoadEnabledFeaturesAsync();
        StateHasChanged();
    });

    // Also refreshes on every navigation (not just guild switches) — the most practical way
    // to pick up a feature toggled on/off from the Dashboard without a dedicated event bus
    // between the two components, since navigating away from the Dashboard after a toggle
    // is the common path.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _ = InvokeAsync(async () =>
        {
            await LoadEnabledFeaturesAsync();
            StateHasChanged();
        });
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool IsActive(string href) =>
        string.Equals(currentUrl, href, StringComparison.OrdinalIgnoreCase) ||
        (currentUrl?.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ?? false);

    private bool IsGroupActive(string[] hrefs) => Array.Exists(hrefs, IsActive);

    // Multi-audience features get a distinct href per audience so only the sidebar entry
    // matching the currently-open audience highlights as active — single-audience features
    // never had this problem (only one relevant audience, only one link) and keep their
    // existing 2-segment url unchanged.
    private static string FeatureHref(ulong guildId, IFeatureModule feature, GuildAudience audience) =>
        feature.HasMultipleAudiences()
            ? $"manage/guilds/{guildId}/features/{feature.Slug}/{AudienceDisplay.Slug(audience)}"
            : $"manage/guilds/{guildId}/features/{feature.Slug}";

    // Feature routes are guild-scoped (manage/guilds/{id}/features/{slug}) with a dynamic
    // id segment, so the static-hrefs-array approach IsGroupActive uses doesn't fit — a
    // plain substring check on the slug is enough (slugs are distinctive), consistent with
    // this codebase's low-ceremony style elsewhere.
    private bool IsFeatureActive(string slug) =>
        currentUrl?.Contains($"/features/{slug}", StringComparison.OrdinalIgnoreCase) ?? false;

    private bool IsFeaturesGroupActive() =>
        currentUrl?.Contains("/features/", StringComparison.OrdinalIgnoreCase) ?? false;

    // Settings/Setup routes are guild-scoped (manage/guilds/{id}/setup) with a dynamic id
    // segment, same reasoning as IsFeatureActive above — a substring check on the trailing
    // segment is enough.
    private bool IsGuildScopedRouteActive(string segment) =>
        currentUrl?.Contains($"/{segment}", StringComparison.OrdinalIgnoreCase) ?? false;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        GuildContext.Changed -= OnGuildContextChanged;
    }
}
