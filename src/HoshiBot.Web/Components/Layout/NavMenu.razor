@implements IDisposable
@inject NavigationManager NavigationManager
@inject CurrentGuildContext GuildContext
@inject CurrentAllianceContext AllianceContext
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="favicon.png" alt="" class="navbar-brand-icon rounded-circle object-fit-cover" />
            Hoshi Bot
        </a>
        <button title="Navigation menu" class="navbar-toggler bg-white bg-opacity-10" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item-top mt-3">
                    <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3 fw-semibold text-uppercase" href="manage" Match="NavLinkMatch.All">
                        <span class="oi oi-dashboard align-text-top" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                @if (GuildContext.GuildId is { } guildId)
                {
                    @* The guild's own admin pages + its guild-wide features — always shown. *@
                    <NavMenuGroup Title="Guild" Icon="@AudienceDisplay.Icon(GuildAudience.Guild)" Active="@IsGuildGroupActive(guildId)">
                        @foreach (var p in GuildAdminPages.All)
                        {
                            <div class="nav-item">
                                <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@GuildAdminPages.Href(guildId, p)" Match="@(p.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">@p.Label</NavLink>
                            </div>
                        }
                    </NavMenuGroup>

                    @* One group per linked alliance — a coalition guild has several. *@
                    @foreach (var link in AllianceContext.Alliances)
                    {
                        <NavMenuGroup Title="@AllianceGroupTitle(link)" Icon="oi-star" IconContent="@AllianceEmblemIcon(link)" Active="@IsAllianceGroupActive(link.Id)">
                            @foreach (var ap in AllianceAdminPages.All)
                            {
                                <div class="nav-item">
                                    <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@AllianceAdminPages.Href(guildId, link.Id, ap)" Match="@(ap.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">@ap.Label</NavLink>
                                </div>
                            }
                        </NavMenuGroup>
                    }

                    @foreach (var audience in NonAllianceAudienceSections)
                    {
                        // Only show an audience group the guild actually serves. If it serves none
                        // (Audiences == None), none of these show — the Guild group is always present
                        // as the baseline, so the nav is never empty.
                        if (!guildAudiences.HasFlag(audience))
                            continue;

                        <NavMenuGroup Title="@AudienceDisplay.Labels(audience).First()" Icon="@AudienceDisplay.Icon(audience)" Active="@IsAudienceFeaturesActive(audience)">
                            <div class="nav-item">
                                <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@AudienceFeaturesHref(guildId, audience)">Features</NavLink>
                            </div>
                        </NavMenuGroup>
                    }
                }

                @* Bot-wide admin sections (Bot settings, STFC Catalog, raw Database) are global-admin
                   only. The pages themselves already enforce the GlobalAdmin policy server-side; this
                   also hides the whole group from regular guild admins so it isn't just a dead link. *@
                <AuthorizeView Policy="GlobalAdmin" Context="adminAuth">
                    <Authorized>
                <NavMenuGroup Title="Bot" Icon="oi-shield" Active="@IsGroupActive(BotAdminPages.All, BotAdminPages.Href)">
                    @foreach (var p in BotAdminPages.All)
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@BotAdminPages.Href(p)">@p.Label</NavLink>
                        </div>
                    }
                </NavMenuGroup>

                <NavMenuGroup Title="STFC Catalog" Icon="oi-globe" Active="@IsGroupActive(StfcCatalogPages.All, StfcCatalogPages.Href)">
                    @foreach (var p in StfcCatalogPages.All)
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@StfcCatalogPages.Href(p)">@p.Label</NavLink>
                        </div>
                    }
                </NavMenuGroup>

                <NavMenuGroup Title="Database" Icon="oi-list-rich" Active="@IsGroupActive(DatabaseAdminPages.All, DatabaseAdminPages.Href)">
                    @foreach (var p in DatabaseAdminPages.All)
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@DatabaseAdminPages.Href(p)">@p.Label</NavLink>
                        </div>
                    }
                </NavMenuGroup>
                    </Authorized>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    // Guild is always shown (its own group) and Alliance gets one group per linked alliance;
    // these are the remaining guild-selectable audiences, each rendered as its own group when
    // the guild serves it.
    private static readonly GuildAudience[] NonAllianceAudienceSections =
        [GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private bool collapseNavMenu = true;
    private string? currentUrl;
    private GuildAudience guildAudiences = GuildAudience.None;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        GuildContext.Changed += OnContextChanged;
        AllianceContext.Changed += OnContextChanged;
        await LoadGuildAudiencesAsync();
    }

    // The nav no longer lists individual features (each audience group is a single "Features"
    // link now), so it only needs the guild's selected audiences to decide which guild-scoped
    // audience groups to show. Guild is always shown; Alliance groups come from AllianceContext.
    private async Task LoadGuildAudiencesAsync()
    {
        guildAudiences = GuildAudience.None;
        if (GuildContext.GuildId is not { } guildId)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        guildAudiences = await db.GuildSettings
            .Where(s => s.GuildId == guildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();
    }

    private void OnContextChanged() => InvokeAsync(async () =>
    {
        await LoadGuildAudiencesAsync();
        StateHasChanged();
    });

    // Also refreshes on every navigation (not just guild switches) — the most practical way
    // to pick up a feature toggled on/off from the Features page without a dedicated event
    // bus between the two components, since navigating away from Features after a toggle
    // is the common path.
    //
    // Also closes the mobile flyout here, deterministically, instead of the previous
    // "@onclick on the wrapping div" hack: that fired on ANY click bubbling up from inside
    // it (including a NavMenuGroup's checkbox/label toggle, which dispatches two click
    // events per interaction and so happened to cancel itself out) and just *toggled* the
    // collapsed flag — meaning a single nav-link click at desktop width (where the CSS
    // override hides the effect either way) silently flipped the flag with no visible
    // feedback, and that invisible drift only became apparent later after resizing down to
    // mobile, where the flag's actual value (now possibly "open") took effect for real.
    // Unconditionally setting it true on a genuine navigation is immune to that drift.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        collapseNavMenu = true;
        _ = InvokeAsync(async () =>
        {
            await LoadGuildAudiencesAsync();
            StateHasChanged();
        });
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool IsActive(string href) =>
        string.Equals(currentUrl, href, StringComparison.OrdinalIgnoreCase) ||
        (currentUrl?.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ?? false);

    // Active test for the global-admin groups — driven off the same registry the group's links
    // iterate, so an href never exists in two places.
    private bool IsGroupActive(IReadOnlyList<AdminPage> pages, Func<AdminPage, string> href) =>
        pages.Any(p => IsActive(href(p)));

    // The per-audience Features catalog page — the audience comes before "features" in the path
    // (Guild is the bare .../features; others are .../{slug}/features). Alliance pages are
    // per-alliance and come from AllianceAdminPages.Href instead.
    private string AudienceFeaturesHref(ulong guildId, GuildAudience audience) =>
        $"{AudienceDisplay.FeatureScopePrefix(guildId, audience, null)}/features";

    private string AllianceGroupTitle(GuildAlliance link) => $"Alliance — [{link.StfcAlliance.Tag}]";

    // This alliance's emblem, shown in place of the group's star glyph (AllianceEmblem falls
    // back to a star when it has no emblem yet).
    private RenderFragment AllianceEmblemIcon(GuildAlliance link) =>
        @<AllianceEmblem Emblem="link.StfcAlliance.Emblem" Size="18" />;

    // Highlights an alliance's group whenever the URL targets that specific alliance — any of its
    // pages share the .../alliance/{id}/ prefix (settings, command-bridge, features + editors).
    // Ids are distinctive, so a substring check suffices.
    private bool IsAllianceGroupActive(int allianceId) =>
        currentUrl?.Contains($"/alliance/{allianceId}", StringComparison.OrdinalIgnoreCase) ?? false;

    // The Guild group holds the guild's own admin pages plus its guild-wide (bare .../features)
    // features. Overview is matched exactly (its route is a prefix of every other guild page); the
    // rest are distinct paths that don't overlap the alliance/audience feature pages owned by the
    // other groups. Both the links above and this active test iterate the same GuildAdminPages list.
    private bool IsGuildGroupActive(ulong guildId) =>
        GuildAdminPages.All.Any(p => p.ExactMatch
            ? string.Equals(currentUrl, GuildAdminPages.Href(guildId, p), StringComparison.OrdinalIgnoreCase)
            : IsActive(GuildAdminPages.Href(guildId, p)));

    // Highlights a guild-scoped audience's group on its catalog page and its feature editors,
    // which share the audience's feature-path prefix: Guild = the bare .../features; every other
    // audience = .../{slug}/features.
    private bool IsAudienceFeaturesActive(GuildAudience audience)
    {
        if (GuildContext.GuildId is not { } guildId)
            return false;

        var basePath = audience == GuildAudience.Guild
            ? $"manage/guild/{guildId}/features"
            : $"manage/guild/{guildId}/{AudienceDisplay.Slug(audience)}/features";
        return IsActive(basePath);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        GuildContext.Changed -= OnContextChanged;
        AllianceContext.Changed -= OnContextChanged;
    }
}
