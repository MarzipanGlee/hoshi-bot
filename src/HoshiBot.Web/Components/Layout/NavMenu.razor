@implements IDisposable
@inject NavigationManager NavigationManager
@inject CurrentGuildContext GuildContext
@inject CurrentAllianceContext AllianceContext
@inject GuildFeatureService FeatureService
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="favicon.png" alt="" class="navbar-brand-icon rounded-circle object-fit-cover" />
            Hoshi Bot
        </a>
        <button title="Navigation menu" class="navbar-toggler bg-white bg-opacity-10" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item-top mt-3">
                    <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3 fw-semibold text-uppercase" href="manage" Match="NavLinkMatch.All">
                        <span class="oi oi-dashboard align-text-top" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>

                @if (GuildContext.GuildId is { } guildId)
                {
                    <div class="nav-item-top">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3" href="@($"manage/guilds/{guildId}")" Match="NavLinkMatch.All">
                            <span class="oi oi-flag align-text-top" aria-hidden="true"></span> Overview
                        </NavLink>
                    </div>
                    <div class="nav-item-top">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3" href="@($"manage/guilds/{guildId}/audience")">
                            <span class="oi oi-people align-text-top" aria-hidden="true"></span> Audience
                        </NavLink>
                    </div>
                    <div class="nav-item-top">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3" href="@($"manage/guilds/{guildId}/settings")">
                            <span class="oi oi-cog align-text-top" aria-hidden="true"></span> Settings
                        </NavLink>
                    </div>
                    <div class="nav-item-top">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center gap-2 px-3" href="@($"manage/guilds/{guildId}/setup-wizard")">
                            <span class="oi oi-wrench align-text-top" aria-hidden="true"></span> Setup Wizard
                        </NavLink>
                    </div>

                    @if (AllianceContext.Alliances.Count > 0)
                    {
                        var allianceFeatures = FeatureCatalog.All
                            .Where(f => f.RelevantAudiences().HasFlag(GuildAudience.Alliance) && enabledFeatures.Contains((f.Feature, GuildAudience.Alliance)))
                            .ToList();
                        <NavMenuGroup Title="@AllianceGroupTitle()" Icon="oi-star" Active="@IsAllianceGroupActive()">
                            <div class="nav-item px-3 ps-4">
                                <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@($"manage/guilds/{guildId}/features")" Match="NavLinkMatch.All">Features</NavLink>
                            </div>
                            @if (allianceFeatures.Count > 0)
                            {
                                <NavMenuGroup Title="Alliance Features" Icon="oi-puzzle-piece" Active="@allianceFeatures.Any(f => IsFeatureActive(f.Slug))">
                                    @foreach (var feature in allianceFeatures)
                                    {
                                        <div class="nav-item px-3 ps-4">
                                            <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@FeatureHref(guildId, feature, GuildAudience.Alliance)">@feature.Title</NavLink>
                                        </div>
                                    }
                                </NavMenuGroup>
                            }
                        </NavMenuGroup>
                    }

                    @foreach (var audience in NonAllianceAudienceSections)
                    {
                        if (guildAudiences != GuildAudience.None && !guildAudiences.HasFlag(audience))
                            continue;

                        var features = FeatureCatalog.All
                            .Where(f => f.RelevantAudiences().HasFlag(audience) && enabledFeatures.Contains((f.Feature, audience)))
                            .ToList();
                        if (features.Count == 0)
                            continue;

                        <NavMenuGroup Title="@($"{AudienceDisplay.Labels(audience).First()} Features")" Icon="oi-puzzle-piece" Active="@features.Any(f => IsFeatureActive(f.Slug))">
                            @foreach (var feature in features)
                            {
                                <div class="nav-item px-3 ps-4">
                                    <NavLink class="nav-link rounded-1 d-flex align-items-center" href="@FeatureHref(guildId, feature, audience)">
                                        @feature.Title
                                    </NavLink>
                                </div>
                            }
                        </NavMenuGroup>
                    }
                }

                <NavMenuGroup Title="Bot" Icon="oi-shield" Active="@IsGroupActive(BotHrefs)">
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/bot/global-admins">Global Admins</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/bot/trusted-users">Trusted Users</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/bot/stfc-news-settings">STFC News Settings</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/bot/incursions-schedule">Incursions Schedule</NavLink>
                    </div>
                </NavMenuGroup>

                <NavMenuGroup Title="STFC Catalog" Icon="oi-globe" Active="@IsGroupActive(CatalogHrefs)">
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/regions">Regions</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/veil-groups">Veil Groups</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/veil-group-invites">Veil Group Invites</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/servers">Servers</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/server-invites">Server Invites</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/alliances">Alliances</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/alliance-invites">Alliance Invites</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/alliance-name-history">Alliance Name History</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/alliance-diplomacy">Diplomacy</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/players">Players</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/player-name-history">Player Name History</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/systems">Systems</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/territories">Territories</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/territory-ownership">Territory Ownership</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/territory-neighbours">Territory Neighbours</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/server-status">Server Status</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/stfc/event-status">Event Status</NavLink>
                    </div>
                </NavMenuGroup>

                <NavMenuGroup Title="Database" Icon="oi-list-rich" Active="@IsGroupActive(DatabaseHrefs)">
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/client-releases">Client Releases</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/discord-guilds">Discord Guilds</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/discord-users">Discord Users</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/guild-members">Guild Members</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/user-players">User Players</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/pending-modal-inputs">Pending Modal Inputs</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/absences">Absences</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/thread-removal-requests">Thread Removal Requests</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/alerts">Alerts</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/alert-notifications">Alert Notifications</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/shield-reminders">Shield Reminders</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/shield-reminder-notifications">Shield Reminder Notifications</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/announcements">Announcements</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/announcement-read-receipts">Announcement Read Receipts</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/tickets">Tickets</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/roe-violation-reports">RoE Violation Reports</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/stfc-news-posts">STFC News Posts</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/stfc-news-post-guild-messages">STFC News Post Guild Messages</NavLink>
                    </div>
                    <div class="nav-item px-3 ps-4">
                        <NavLink class="nav-link rounded-1 d-flex align-items-center" href="manage/database/stfc-event-date-confirmations">STFC Event Date Confirmations</NavLink>
                    </div>
                </NavMenuGroup>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly string[] CatalogHrefs =
        ["manage/stfc/regions", "manage/stfc/veil-groups", "manage/stfc/servers", "manage/stfc/server-invites", "manage/stfc/veil-group-invites",
         "manage/stfc/alliances", "manage/stfc/alliance-invites", "manage/stfc/alliance-diplomacy",
         "manage/stfc/alliance-name-history", "manage/stfc/players", "manage/stfc/player-name-history", "manage/stfc/systems",
         "manage/stfc/territories", "manage/stfc/territory-ownership", "manage/stfc/territory-neighbours",
         "manage/stfc/server-status", "manage/stfc/event-status"];
    private static readonly string[] BotHrefs =
        ["manage/bot/global-admins", "manage/bot/trusted-users", "manage/bot/stfc-news-settings",
         "manage/bot/incursions-schedule"];
    private static readonly string[] DatabaseHrefs =
        ["manage/database/client-releases", "manage/database/discord-guilds", "manage/database/discord-users",
         "manage/database/guild-members", "manage/database/user-players", "manage/database/pending-modal-inputs",
         "manage/database/absences", "manage/database/thread-removal-requests", "manage/database/alerts",
         "manage/database/alert-notifications", "manage/database/shield-reminders", "manage/database/shield-reminder-notifications",
         "manage/database/announcements", "manage/database/announcement-read-receipts", "manage/database/tickets",
         "manage/database/roe-violation-reports", "manage/database/stfc-news-posts", "manage/database/stfc-news-post-guild-messages",
         "manage/database/stfc-event-date-confirmations"];
    // The Alliance audience gets its own dedicated group (scoped to the selected alliance);
    // these are the remaining audiences that still render as their own "… Features" groups.
    private static readonly GuildAudience[] NonAllianceAudienceSections =
        [GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private bool collapseNavMenu = true;
    private string? currentUrl;
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> enabledFeatures = [];
    private GuildAudience guildAudiences = GuildAudience.None;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        GuildContext.Changed += OnContextChanged;
        AllianceContext.Changed += OnContextChanged;
        await LoadEnabledFeaturesAsync();
    }

    private async Task LoadEnabledFeaturesAsync()
    {
        enabledFeatures = [];
        guildAudiences = GuildAudience.None;
        if (GuildContext.GuildId is not { } guildId)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        guildAudiences = await db.GuildSettings
            .Where(s => s.GuildId == guildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();

        // The Alliance audience is per-alliance: only surface it for the alliance selected in
        // the top bar. Every other audience is guild-scoped, so any enabled scope counts.
        var selectedAllianceId = AllianceContext.GuildAllianceId;
        foreach (var (feature, audience, allianceId) in await FeatureService.GetEnabledAsync(guildId))
        {
            if (audience == GuildAudience.Alliance)
            {
                if (allianceId == selectedAllianceId)
                    enabledFeatures.Add((feature, audience));
            }
            else
            {
                enabledFeatures.Add((feature, audience));
            }
        }
    }

    private void OnContextChanged() => InvokeAsync(async () =>
    {
        await LoadEnabledFeaturesAsync();
        StateHasChanged();
    });

    // Also refreshes on every navigation (not just guild switches) — the most practical way
    // to pick up a feature toggled on/off from the Features page without a dedicated event
    // bus between the two components, since navigating away from Features after a toggle
    // is the common path.
    //
    // Also closes the mobile flyout here, deterministically, instead of the previous
    // "@onclick on the wrapping div" hack: that fired on ANY click bubbling up from inside
    // it (including a NavMenuGroup's checkbox/label toggle, which dispatches two click
    // events per interaction and so happened to cancel itself out) and just *toggled* the
    // collapsed flag — meaning a single nav-link click at desktop width (where the CSS
    // override hides the effect either way) silently flipped the flag with no visible
    // feedback, and that invisible drift only became apparent later after resizing down to
    // mobile, where the flag's actual value (now possibly "open") took effect for real.
    // Unconditionally setting it true on a genuine navigation is immune to that drift.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        collapseNavMenu = true;
        _ = InvokeAsync(async () =>
        {
            await LoadEnabledFeaturesAsync();
            StateHasChanged();
        });
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private bool IsActive(string href) =>
        string.Equals(currentUrl, href, StringComparison.OrdinalIgnoreCase) ||
        (currentUrl?.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase) ?? false);

    private bool IsGroupActive(string[] hrefs) => Array.Exists(hrefs, IsActive);

    // Alliance-audience links carry the selected alliance id (/alliance/{id}); other audiences
    // get a distinct href per audience so only the matching sidebar entry highlights as active.
    private string FeatureHref(ulong guildId, IFeatureModule feature, GuildAudience audience) =>
        audience == GuildAudience.Alliance
            ? $"manage/guilds/{guildId}/features/{feature.Slug}/alliance/{AllianceContext.GuildAllianceId}"
            : $"manage/guilds/{guildId}/features/{feature.Slug}/{AudienceDisplay.Slug(audience)}";

    private string AllianceGroupTitle() =>
        AllianceContext.Alliance is { } link ? $"Alliance — [{link.StfcAlliance.Tag}]" : "Alliance";

    private bool IsAllianceGroupActive() =>
        (currentUrl?.Contains("/features/", StringComparison.OrdinalIgnoreCase) ?? false)
        && (currentUrl?.Contains("/alliance/", StringComparison.OrdinalIgnoreCase) ?? false)
        || (currentUrl?.EndsWith("/features", StringComparison.OrdinalIgnoreCase) ?? false);

    // Feature routes are guild-scoped (manage/guilds/{id}/features/{slug}) with a dynamic
    // id segment, so the static-hrefs-array approach IsGroupActive uses doesn't fit — a
    // plain substring check on the slug is enough (slugs are distinctive), consistent with
    // this codebase's low-ceremony style elsewhere.
    private bool IsFeatureActive(string slug) =>
        currentUrl?.Contains($"/features/{slug}", StringComparison.OrdinalIgnoreCase) ?? false;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        GuildContext.Changed -= OnContextChanged;
        AllianceContext.Changed -= OnContextChanged;
    }
}
