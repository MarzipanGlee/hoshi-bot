@inherits LayoutComponentBase
@inject CurrentGuildContext GuildContext
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Hoshi Bot Admin</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <PageBreadcrumb />
            <AuthorizeView>
                <Authorized>
                    <div class="topbar-actions">
                        <GuildSelector />
                        <span class="topbar-user" title="@context.User.Identity?.Name">
                            @{ var avatarUrl = GetAvatarUrl(context.User); }
                            @if (avatarUrl is not null)
                            {
                                <img src="@avatarUrl" alt="" class="topbar-avatar" />
                            }
                            else
                            {
                                <span class="oi oi-person topbar-avatar-fallback" aria-hidden="true"></span>
                            }
                            <span class="topbar-user-name">@context.User.Identity?.Name</span>
                        </span>
                        <form method="post" action="logout" data-enhance="false">
                            <button type="submit" class="btn btn-sm btn-outline-secondary topbar-logout-btn" aria-label="Log out">
                                <span class="oi oi-account-logout topbar-logout-icon" aria-hidden="true"></span>
                                <span class="topbar-logout-text">Log out</span>
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <BootstrapBlazorRoot>
                @Body
            </BootstrapBlazorRoot>
        </article>

        <SiteFooter ShowDisclaimer="false" />
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            await GuildContext.InitializeAsync(authState.User);
    }

    private static string? GetAvatarUrl(ClaimsPrincipal user)
    {
        var id = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var avatarHash = user.FindFirst("urn:discord:avatar:hash")?.Value;
        return id is not null && avatarHash is not null
            ? $"https://cdn.discordapp.com/avatars/{id}/{avatarHash}.png"
            : null;
    }
}
