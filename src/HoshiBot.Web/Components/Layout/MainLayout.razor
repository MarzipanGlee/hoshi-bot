@inherits LayoutComponentBase
@inject CurrentGuildContext GuildContext
@inject CurrentAllianceContext AllianceContext
@inject SupportModeContext SupportMode
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Hoshi Bot Admin</PageTitle>

<div class="page position-relative min-vh-100">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="flex-grow-1 d-flex flex-column">
        <div class="top-row px-4 d-flex flex-wrap align-items-center justify-content-between py-2">
            <PageBreadcrumb />
            <AuthorizeView>
                <Authorized>
                    <div class="topbar-actions d-flex align-items-center flex-shrink-0">
                        <SupportModeToggle />
                        <GuildSelector />
                        <AllianceSelector />
                        @* text-decoration-none only — Bootstrap's text-body is !important and would
                           beat .topbar-user's own grey; the scoped .topbar-user rule already outranks
                           the browser's default link colour on its own. *@
                        <a href="me" class="topbar-user d-flex align-items-center gap-2 text-nowrap text-decoration-none" title="My area">
                            @{ var avatarUrl = DiscordAvatar.UrlFor(context.User); }
                            @if (avatarUrl is not null)
                            {
                                <img src="@avatarUrl" alt="" class="topbar-avatar rounded-circle object-fit-cover" />
                            }
                            else
                            {
                                <span class="oi oi-person topbar-avatar-fallback align-items-center justify-content-center rounded-circle flex-shrink-0" aria-hidden="true"></span>
                            }
                            <span class="topbar-user-name">@context.User.Identity?.Name</span>
                        </a>
                        <form method="post" action="logout" data-enhance="false">
                            <button type="submit" class="btn btn-sm btn-outline-secondary topbar-logout-btn d-inline-flex align-items-center" aria-label="Log out">
                                <span class="oi oi-account-logout topbar-logout-icon" aria-hidden="true"></span>
                                <span class="topbar-logout-text">Log out</span>
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="px-4 py-4 flex-grow-1">
            <BootstrapBlazorRoot>
                @Body
            </BootstrapBlazorRoot>
        </article>

        <SiteFooter ShowDisclaimer="false" />
    </main>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // Support mode first: CurrentGuildContext.InitializeAsync validates the stored
            // guild through GuildAccessService, which must already know support mode is on for
            // a support-only guild to survive that check.
            if (ulong.TryParse(authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId))
                await SupportMode.InitializeAsync(userId);
            await GuildContext.InitializeAsync(authState.User);
            await AllianceContext.InitializeAsync();
        }
    }
}
