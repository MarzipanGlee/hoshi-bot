@implements IDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 flex-nowrap overflow-x-auto">
        @for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var isLast = i == items.Count - 1;
            @if (isLast || item.Href is null)
            {
                <li class="breadcrumb-item active flex-shrink-0 text-nowrap" aria-current="page">@item.Text</li>
            }
            else
            {
                <li class="breadcrumb-item flex-shrink-0 text-nowrap"><a href="@item.Href">@item.Text</a></li>
            }
        }
    </ol>
</nav>

@code {
    // Create/Edit/Delete only ever appear under the excluded Manage/Stfc operator area, so they
    // stay literal English by design (like the STFC Catalog / Bot crumbs below); the rest are
    // in-scope guild/alliance pages and localize per viewer.
    private static readonly Dictionary<string, Func<Language, string>> CrudLabels = new()
    {
        ["create"] = _ => "Create",
        ["edit"] = _ => "Edit",
        ["delete"] = _ => "Delete",
        ["settings"] = Msg.WebNav.Settings,
        ["setup-wizard"] = Msg.WebNav.SetupWizard,
        ["features"] = Msg.WebNav.Features,
        ["audience"] = Msg.WebNav.Audience,
        ["permission-check"] = Msg.WebNav.PermissionCheck,
    };

    [CascadingParameter] public Language Lang { get; set; }

    private List<(string Text, string? Href)> items = [];

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await BuildAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await BuildAsync();
        StateHasChanged();
    }

    private async Task BuildAsync()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<(string, string?)> { (Msg.WebNav.Home(Lang), "/") };

        if (segments.Length >= 1 && segments[0] == "manage")
        {
            result.Add((Msg.WebNav.Manage(Lang), "manage"));

            if (segments.Length >= 2 && segments[1] == "guild")
            {
                if (segments.Length >= 3 && ulong.TryParse(segments[2], out var guildId))
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var guildName = await db.DiscordGuilds
                        .Where(g => g.Id == guildId)
                        .Select(g => g.Name)
                        .FirstOrDefaultAsync() ?? segments[2];
                    result.Add((guildName, $"manage/guild/{guildId}"));

                    if (segments.Length >= 4)
                    {
                        if (segments[3] == "alliance" && segments.Length >= 5 && int.TryParse(segments[4], out var allianceId))
                        {
                            // Alliance crumb, e.g. "[EU164][LF] Lost Falcons" ({Region}{ServerId} +
                            // tag + name) — the same server-designation convention as StfcServer.DisplayName.
                            var a = await db.GuildAlliances
                                .Where(ga => ga.Id == allianceId)
                                .Select(ga => new { ga.StfcAlliance.Tag, ga.StfcAlliance.Name, ServerId = ga.StfcAlliance.Server.Id, Region = ga.StfcAlliance.Server.Region.Name })
                                .FirstOrDefaultAsync();
                            var allianceLabel = a is null ? segments[4] : $"[{a.Region}{a.ServerId}][{a.Tag}] {a.Name}";
                            result.Add((allianceLabel, $"manage/guild/{guildId}/alliance/{allianceId}"));

                            // The alliance's page (settings / command-bridge / features [+ feature slug]).
                            if (segments.Length >= 6)
                                AddAlliancePageCrumbs(Lang, result, segments, 5, $"manage/guild/{guildId}/alliance/{allianceId}");
                        }
                        else if (segments[3] == "features")
                        {
                            // Guild-wide features (the bare .../features path).
                            AddFeatureCrumbs(Lang, result, segments, 3, $"manage/guild/{guildId}/features");
                        }
                        else if (CrudLabels.TryGetValue(segments[3], out var pageLabel))
                        {
                            result.Add((pageLabel(Lang), null));
                        }
                        else if (AudienceDisplay.TryParseSlug(segments[3], out var aud) && segments.Length >= 5 && segments[4] == "features")
                        {
                            // Audience features (.../{slug}/features[/{featureSlug}]).
                            result.Add((AudienceDisplay.Labels(Lang, aud).FirstOrDefault() ?? segments[3], null));
                            AddFeatureCrumbs(Lang, result, segments, 4, $"manage/guild/{guildId}/{segments[3]}/features");
                        }
                    }
                }
            }
            else if (segments.Length >= 2
                && GlobalAdminAreas.All.FirstOrDefault(a => a.BasePath == $"manage/{segments[1]}") is { } area)
            {
                // The Bot / STFC Catalog / Database operator areas, all driven off the same registry
                // the sidebar and the dashboard cards use — the labels used to be retyped here, which
                // is how Database ended up with no crumbs at all and Bot with only one of its four
                // pages. They're out of localization scope, so the labels stay literal English (see
                // docs/localization-plan.md).
                var areaPage = segments.Length >= 3
                    ? area.Pages.FirstOrDefault(p => p.RouteSuffix == segments[2])
                    : null;
                var pageHref = areaPage is null ? null : area.Href(areaPage);

                // The area itself has no route, so its crumb links to the landing page — unless
                // that IS the page we're on, which would make it a link to itself.
                result.Add((area.Title, pageHref == area.LandingHref ? null : area.LandingHref));

                if (areaPage is not null)
                {
                    var crud = segments.Length >= 4 && CrudLabels.TryGetValue(segments[3], out var crudLabel)
                        ? crudLabel
                        : null;
                    result.Add((areaPage.Label(Lang), crud is null ? null : pageHref));

                    if (crud is not null)
                    {
                        result.Add((crud(Lang), null));
                    }
                }
            }
        }
        else if (segments.Length >= 1 && segments[0] == "me")
        {
            // The member self-service area. Page labels come from MePages, so a new /me page
            // is breadcrumbed automatically with no change here.
            var hasPage = segments.Length >= 2;
            result.Add((Msg.WebNav.MyArea(Lang), hasPage ? "me" : null));
            if (hasPage)
            {
                var mePage = MePages.All.FirstOrDefault(p => p.RouteSuffix == segments[1]);
                result.Add((mePage?.Label(Lang) ?? segments[1], null));
            }
        }

        items = result;
    }

    // Adds the "Features" crumb (+ the feature-title crumb when a feature slug follows, + an extra-page
    // crumb when the feature's own IFeatureModule.ExtraPages declares a matching one) given the index
    // of the "features" segment and the catalog backlink. The extra-page title is resolved from that
    // same declaration — so a feature's own auxiliary admin page (FeatureExtraPageHost.razor's route)
    // is correctly breadcrumbed automatically, with no changes needed here when a new one is added.
    private static void AddFeatureCrumbs(Language lang, List<(string, string?)> result, string[] segments, int featuresIndex, string catalogHref)
    {
        var hasSlug = segments.Length >= featuresIndex + 2;
        result.Add((Msg.WebNav.Features(lang), hasSlug ? catalogHref : null));
        if (!hasSlug)
            return;

        var featureSlug = segments[featuresIndex + 1];
        var feature = FeatureCatalog.FindBySlug(featureSlug);
        var hasExtraSlug = segments.Length >= featuresIndex + 3;
        result.Add((feature?.Title(lang) ?? featureSlug, hasExtraSlug ? $"{catalogHref}/{featureSlug}" : null));

        if (hasExtraSlug)
        {
            var extraSlug = segments[featuresIndex + 2];
            var extra = feature?.ExtraPages.FirstOrDefault(p => p.Slug == extraSlug);
            result.Add((extra?.Title(lang, feature!.Feature) ?? extraSlug, null));
        }
    }

    // Maps an alliance sub-page (segments[pageIndex]) to its crumb(s): settings / command-bridge
    // (a single label) or features (+ optional feature title).
    private static void AddAlliancePageCrumbs(Language lang, List<(string, string?)> result, string[] segments, int pageIndex, string allianceBase)
    {
        var page = segments[pageIndex];
        if (page == "features")
            AddFeatureCrumbs(lang, result, segments, pageIndex, $"{allianceBase}/features");
        else if (CrudLabels.TryGetValue(page, out var label))
            result.Add((label(lang), null));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
