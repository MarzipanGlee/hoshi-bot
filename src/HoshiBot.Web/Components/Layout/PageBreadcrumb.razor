@implements IDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 flex-nowrap overflow-x-auto">
        @for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var isLast = i == items.Count - 1;
            @if (isLast || item.Href is null)
            {
                <li class="breadcrumb-item active flex-shrink-0 text-nowrap" aria-current="page">@item.Text</li>
            }
            else
            {
                <li class="breadcrumb-item flex-shrink-0 text-nowrap"><a href="@item.Href">@item.Text</a></li>
            }
        }
    </ol>
</nav>

@code {
    private static readonly (string Segment, string Label)[] StfcCatalogSections =
    [
        ("regions", "Regions"),
        ("veil-groups", "Veil Groups"),
        ("servers", "Servers"),
        ("alliances", "Alliances"),
        ("alliance-diplomacy", "Diplomacy"),
        ("alliance-name-history", "Alliance Name History"),
        ("players", "Players"),
        ("player-name-history", "Player Name History"),
        ("systems", "Systems"),
        ("territories", "Territories"),
        ("server-status", "Server Status"),
        ("event-status", "Event Status"),
    ];

    private static readonly Dictionary<string, string> CrudLabels = new()
    {
        ["create"] = "Create",
        ["edit"] = "Edit",
        ["delete"] = "Delete",
        ["settings"] = "Settings",
        ["setup-wizard"] = "Setup Wizard",
        ["features"] = "Features",
        ["audience"] = "Audience",
        ["command-bridge"] = "Command Bridge",
        ["permission-check"] = "Permission Check",
    };

    private List<(string Text, string? Href)> items = [("Home", "/")];

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await BuildAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await BuildAsync();
        StateHasChanged();
    }

    private async Task BuildAsync()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<(string, string?)> { ("Home", "/") };

        if (segments.Length >= 1 && segments[0] == "manage")
        {
            result.Add(("Manage", "manage"));

            if (segments.Length >= 2 && segments[1] == "guild")
            {
                if (segments.Length >= 3 && ulong.TryParse(segments[2], out var guildId))
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var guildName = await db.DiscordGuilds
                        .Where(g => g.Id == guildId)
                        .Select(g => g.Name)
                        .FirstOrDefaultAsync() ?? segments[2];
                    result.Add((guildName, $"manage/guild/{guildId}"));

                    if (segments.Length >= 4)
                    {
                        if (segments[3] == "alliance" && segments.Length >= 5 && int.TryParse(segments[4], out var allianceId))
                        {
                            // Alliance crumb, e.g. "[EU164][LF] Lost Falcons" ({Region}{ServerId} +
                            // tag + name) — the same server-designation convention as StfcServer.DisplayName.
                            var a = await db.GuildAlliances
                                .Where(ga => ga.Id == allianceId)
                                .Select(ga => new { ga.StfcAlliance.Tag, ga.StfcAlliance.Name, ServerId = ga.StfcAlliance.Server.Id, Region = ga.StfcAlliance.Server.Region.Name })
                                .FirstOrDefaultAsync();
                            var allianceLabel = a is null ? segments[4] : $"[{a.Region}{a.ServerId}][{a.Tag}] {a.Name}";
                            result.Add((allianceLabel, $"manage/guild/{guildId}/alliance/{allianceId}/settings"));

                            // The alliance's page (settings / command-bridge / features [+ feature slug]).
                            if (segments.Length >= 6)
                                AddAlliancePageCrumbs(result, segments, 5, $"manage/guild/{guildId}/alliance/{allianceId}");
                        }
                        else if (segments[3] == "features")
                        {
                            // Guild-wide features (the bare .../features path).
                            AddFeatureCrumbs(result, segments, 3, $"manage/guild/{guildId}/features");
                        }
                        else if (CrudLabels.TryGetValue(segments[3], out var pageLabel))
                        {
                            result.Add((pageLabel, null));
                        }
                        else if (AudienceDisplay.TryParseSlug(segments[3], out var aud) && segments.Length >= 5 && segments[4] == "features")
                        {
                            // Audience features (.../{slug}/features[/{featureSlug}]).
                            result.Add((AudienceDisplay.Labels(aud).FirstOrDefault() ?? segments[3], null));
                            AddFeatureCrumbs(result, segments, 4, $"manage/guild/{guildId}/{segments[3]}/features");
                        }
                    }
                }
            }
            else if (segments.Length >= 2 && segments[1] == "stfc")
            {
                var catalogSection = segments.Length >= 3
                    ? Array.Find(StfcCatalogSections, s => s.Segment == segments[2])
                    : default;
                if (catalogSection != default)
                {
                    result.Add(("STFC Catalog", null));
                    result.Add((catalogSection.Label, $"manage/stfc/{catalogSection.Segment}"));

                    if (segments.Length >= 4 && CrudLabels.TryGetValue(segments[3], out var crudLabel))
                    {
                        result.Add((crudLabel, null));
                    }
                }
            }
            else if (segments.Length >= 2 && segments[1] == "bot")
            {
                result.Add(("Bot", null));

                if (segments.Length >= 3 && segments[2] == "global-admins")
                {
                    result.Add(("Global Admins", null));
                }
            }
        }

        items = result;
    }

    // Adds the "Features" crumb (+ the feature-title crumb when a feature slug follows) given the
    // index of the "features" segment and the catalog backlink.
    private static void AddFeatureCrumbs(List<(string, string?)> result, string[] segments, int featuresIndex, string catalogHref)
    {
        var hasSlug = segments.Length >= featuresIndex + 2;
        result.Add(("Features", hasSlug ? catalogHref : null));
        if (hasSlug)
        {
            var feature = FeatureCatalog.FindBySlug(segments[featuresIndex + 1]);
            result.Add((feature?.Title ?? segments[featuresIndex + 1], null));
        }
    }

    // Maps an alliance sub-page (segments[pageIndex]) to its crumb(s): settings / command-bridge
    // (a single label) or features (+ optional feature title).
    private static void AddAlliancePageCrumbs(List<(string, string?)> result, string[] segments, int pageIndex, string allianceBase)
    {
        var page = segments[pageIndex];
        if (page == "features")
            AddFeatureCrumbs(result, segments, pageIndex, $"{allianceBase}/features");
        else if (CrudLabels.TryGetValue(page, out var label))
            result.Add((label, null));
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
