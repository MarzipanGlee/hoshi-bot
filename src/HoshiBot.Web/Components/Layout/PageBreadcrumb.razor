@implements IDisposable
@inject NavigationManager NavigationManager
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        @for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var isLast = i == items.Count - 1;
            @if (isLast || item.Href is null)
            {
                <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
            }
            else
            {
                <li class="breadcrumb-item"><a href="@item.Href">@item.Text</a></li>
            }
        }
    </ol>
</nav>

@code {
    private static readonly (string Segment, string Label)[] StfcCatalogSections =
    [
        ("regions", "Regions"),
        ("veil-groups", "Veil Groups"),
        ("servers", "Servers"),
        ("alliances", "Alliances"),
        ("alliance-diplomacy", "Diplomacy"),
        ("alliance-name-history", "Alliance Name History"),
        ("players", "Players"),
        ("player-name-history", "Player Name History"),
        ("systems", "Systems"),
        ("territories", "Territories"),
        ("server-status", "Server Status"),
        ("event-status", "Event Status"),
    ];

    private static readonly Dictionary<string, string> CrudLabels = new()
    {
        ["create"] = "Create",
        ["edit"] = "Edit",
        ["delete"] = "Delete",
        ["settings"] = "Settings",
        ["setup-wizard"] = "Setup Wizard",
        ["features"] = "Features",
        ["scope"] = "Scope",
        ["permission-check"] = "Permission Check",
    };

    private List<(string Text, string? Href)> items = [("Home", "/")];

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await BuildAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await BuildAsync();
        StateHasChanged();
    }

    private async Task BuildAsync()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var result = new List<(string, string?)> { ("Home", "/") };

        if (segments.Length >= 1 && segments[0] == "manage")
        {
            result.Add(("Manage", "manage"));

            if (segments.Length >= 2 && segments[1] == "guilds")
            {
                if (segments.Length >= 3 && ulong.TryParse(segments[2], out var guildId))
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    var guildName = await db.DiscordGuilds
                        .Where(g => g.Id == guildId)
                        .Select(g => g.Name)
                        .FirstOrDefaultAsync() ?? segments[2];
                    result.Add((guildName, $"manage/guilds/{guildId}"));

                    if (segments.Length >= 4 && CrudLabels.TryGetValue(segments[3], out var pageLabel))
                    {
                        var isFeatures = segments[3] == "features";
                        var hasFeatureSlug = isFeatures && segments.Length >= 5;
                        result.Add((pageLabel, hasFeatureSlug ? $"manage/guilds/{guildId}/features" : null));

                        if (hasFeatureSlug)
                        {
                            var feature = FeatureCatalog.FindBySlug(segments[4]);
                            result.Add((feature?.Title ?? segments[4], null));
                        }
                    }
                }
            }
            else if (segments.Length >= 2 && segments[1] == "stfc")
            {
                var catalogSection = segments.Length >= 3
                    ? Array.Find(StfcCatalogSections, s => s.Segment == segments[2])
                    : default;
                if (catalogSection != default)
                {
                    result.Add(("STFC Catalog", null));
                    result.Add((catalogSection.Label, $"manage/stfc/{catalogSection.Segment}"));

                    if (segments.Length >= 4 && CrudLabels.TryGetValue(segments[3], out var crudLabel))
                    {
                        result.Add((crudLabel, null));
                    }
                }
            }
            else if (segments.Length >= 2 && segments[1] == "bot")
            {
                result.Add(("Bot", null));

                if (segments.Length >= 3 && segments[2] == "global-admins")
                {
                    result.Add(("Global Admins", null));
                }
            }
        }

        items = result;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
