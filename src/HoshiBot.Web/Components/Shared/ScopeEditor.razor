@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject GuildAllianceService AllianceService
@inject CurrentAllianceContext AllianceContext
@inject IJSRuntime JS

@if (Audience == GuildAudience.Alliance)
{
    <h2>@Msg.WebCommon.LinkedAlliances(Lang)</h2>
    <table class="table">
        <thead>
            <tr>
                <th>@Msg.WebCommon.Region(Lang)</th>
                <th>@Msg.WebCommon.Server(Lang)</th>
                <th>@Msg.WebGuild.TagHeader(Lang)</th>
                <th>@Msg.WebGuild.AllianceNameHeader(Lang)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var link in guildAlliances)
            {
                var info = allianceInfoById.GetValueOrDefault(link.StfcAllianceId);
                <tr>
                    <td>@info?.Region</td>
                    <td>@info?.Server</td>
                    <td>@info?.Tag</td>
                    <td>@info?.Name</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary me-1" href="manage/guild/@GuildId/alliance/@link.Id/settings">@Msg.WebNav.Settings(Lang)</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteGuildAlliance(link)">@Msg.WebCommon.Delete(Lang)</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-3">
        <div class="card-body d-flex gap-2 align-items-end flex-wrap">
            <RegionServerPicker @bind-RegionId="allianceRegionIdInput"
                                @bind-ServerId="allianceServerIdInput" @bind-ServerId:after="OnAllianceServerChangedAsync" />
            <div>
                <label class="form-label">@Msg.WebGuild.AllianceLabel(Lang)</label>
                <Select TValue="string" Items="allianceItems" @bind-Value="selectedAllianceIdInput"
                        ShowSearch="true" PlaceHolder="@Msg.WebGuild.SelectAlliancePlaceholder(Lang)" IsDisabled="@(allianceServerIdInput is null)" />
            </div>
            <div>
                <button class="btn btn-primary" @onclick="AddGuildAlliance">@Msg.WebCommon.Add(Lang)</button>
            </div>
        </div>
    </div>
    <p class="text-muted small mt-2 mb-0">
        @Msg.WebGuild.AllianceLinkHintLead(Lang) <strong>@Msg.WebNav.Settings(Lang)</strong> @Msg.WebGuild.AllianceLinkHintTail(Lang)
    </p>
}
else if (Audience == GuildAudience.Server)
{
    <h2>@Msg.WebCommon.LinkedServers(Lang)</h2>
    <table class="table">
        <thead><tr><th>@Msg.WebCommon.Server(Lang)</th><th></th></tr></thead>
        <tbody>
            @foreach (var link in guildServers)
            {
                <tr>
                    <td>@serverNamesById.GetValueOrDefault(link.StfcServerId)</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteGuildServer(link)">@Msg.WebCommon.Delete(Lang)</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-3">
        <div class="card-body d-flex gap-2 align-items-end flex-wrap">
            <RegionServerPicker @ref="serverPicker" ExcludedServerIds="LinkedServerIds"
                                @bind-RegionId="serverRegionIdInput" @bind-ServerId="selectedServerIdInput" />
            <div>
                <button class="btn btn-primary" @onclick="AddGuildServer">@Msg.WebCommon.Add(Lang)</button>
            </div>
        </div>
    </div>
}
else if (Audience == GuildAudience.VeilGroup)
{
    <h2>@Msg.WebCommon.LinkedVeilGroups(Lang)</h2>
    <table class="table">
        <thead><tr><th>@Msg.WebGuild.VeilGroupLabel(Lang)</th><th></th></tr></thead>
        <tbody>
            @foreach (var link in guildVeilGroups)
            {
                <tr>
                    <td>@veilGroupNamesById.GetValueOrDefault(link.StfcVeilGroupId)</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteGuildVeilGroup(link)">@Msg.WebCommon.Delete(Lang)</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card mt-3">
        <div class="card-body d-flex gap-2 align-items-end flex-wrap">
            <div>
                <label class="form-label">@Msg.WebCommon.Region(Lang)</label>
                <Select TValue="string" Items="regionItems" @bind-Value="veilGroupRegionIdInput" @bind-Value:after="OnVeilGroupRegionChangedAsync" PlaceHolder="@Msg.WebCommon.SelectRegionPlaceholder(Lang)" />
            </div>
            <div>
                <label class="form-label">@Msg.WebGuild.VeilGroupLabel(Lang)</label>
                <Select TValue="string" Items="veilGroupItems" @bind-Value="selectedVeilGroupIdInput" PlaceHolder="@Msg.WebGuild.SelectVeilGroupPlaceholder(Lang)" IsDisabled="@(veilGroupRegionIdInput is null)" />
            </div>
            <div>
                <button class="btn btn-primary" @onclick="AddGuildVeilGroup">@Msg.WebCommon.Add(Lang)</button>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }

    // Only the VeilGroup branch still renders its own region <Select> — the Alliance/Server
    // branches get theirs from RegionServerPicker, which loads regions itself.
    private List<SelectedItem> regionItems = [];

    private List<GuildAlliance> guildAlliances = [];
    private List<GuildServer> guildServers = [];
    private List<GuildVeilGroup> guildVeilGroups = [];
    private Dictionary<int, AllianceRow> allianceInfoById = [];
    private Dictionary<int, string> serverNamesById = [];
    private Dictionary<int, string> veilGroupNamesById = [];

    // One Linked Alliances table row's identifying columns.
    private record AllianceRow(string Region, string Server, string Tag, string Name);

    // Alliance branch
    private string? allianceRegionIdInput;
    private string? allianceServerIdInput;
    private string? selectedAllianceIdInput;
    private List<StfcAlliance> serverAlliances = [];
    private List<SelectedItem> allianceItems = [];

    // Server branch
    private string? serverRegionIdInput;
    private string? selectedServerIdInput;
    private RegionServerPicker? serverPicker;

    // Already-linked servers, kept out of the picker's dropdown — they'd otherwise throw on Add
    // (unique index on GuildId+StfcServerId). Primitive ids for the picker's EF query.
    private HashSet<int> LinkedServerIds => guildServers.Select(gs => gs.StfcServerId).ToHashSet();

    // VeilGroup branch
    private string? veilGroupRegionIdInput;
    private string? selectedVeilGroupIdInput;
    private List<SelectedItem> veilGroupItems = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (Audience == GuildAudience.VeilGroup)
        {
            var regions = await db.StfcRegions.OrderBy(r => r.Id).AsNoTracking().ToListAsync();
            regionItems = regions.Select(r => new SelectedItem(r.Id.ToString(), r.Name)).ToList();
        }

        switch (Audience)
        {
            case GuildAudience.Alliance:
                guildAlliances = await db.GuildAlliances.Where(ga => ga.GuildId == GuildId).AsNoTracking().ToListAsync();
                var linkedAllianceIdsForTable = guildAlliances.Select(ga => ga.StfcAllianceId).ToList();
                allianceInfoById = await db.StfcAlliances
                    .Where(a => linkedAllianceIdsForTable.Contains(a.Id))
                    .Select(a => new { a.Id, Region = a.Server.Region.Name, ServerId = a.Server.Id, ServerName = a.Server.Name, a.Tag, a.Name })
                    .ToDictionaryAsync(a => a.Id, a => new AllianceRow(a.Region, $"{a.ServerId} {a.ServerName}", a.Tag, a.Name));
                break;
            case GuildAudience.Server:
                guildServers = await db.GuildServers.Where(gs => gs.GuildId == GuildId).AsNoTracking().ToListAsync();
                serverNamesById = await db.StfcServers.Include(s => s.Region)
                    .Where(s => guildServers.Select(gs => gs.StfcServerId).Contains(s.Id))
                    .ToDictionaryAsync(s => s.Id, s => s.DisplayName);
                break;
            case GuildAudience.VeilGroup:
                guildVeilGroups = await db.GuildVeilGroups.Where(gv => gv.GuildId == GuildId).AsNoTracking().ToListAsync();
                veilGroupNamesById = await db.StfcVeilGroups
                    .Where(v => guildVeilGroups.Select(gv => gv.StfcVeilGroupId).Contains(v.Id))
                    .ToDictionaryAsync(v => v.Id, v => v.Name);
                break;
        }
    }

    private async Task OnAllianceServerChangedAsync()
    {
        selectedAllianceIdInput = null;

        if (!int.TryParse(allianceServerIdInput, out var serverId))
        {
            serverAlliances = [];
            allianceItems = [];
            return;
        }

        // Already-linked alliances would otherwise throw on Add (unique index on
        // GuildId+StfcAllianceId) — excluded here rather than letting that happen. Uses a
        // HashSet<int> rather than `guildAlliances.Any(...)` directly: EF Core can't translate
        // a lambda comparing against a local collection of entities (only primitive collections).
        var linkedAllianceIds = guildAlliances.Select(ga => ga.StfcAllianceId).ToHashSet();

        await using var db = await DbFactory.CreateDbContextAsync();
        serverAlliances = await db.StfcAlliances
            .Where(a => a.ServerId == serverId)
            .Where(a => !linkedAllianceIds.Contains(a.Id))
            .OrderBy(a => a.Tag)
            .AsNoTracking()
            .ToListAsync();
        allianceItems = serverAlliances.Select(a => new SelectedItem(a.Id.ToString(), $"{a.Tag} - {a.Name}")).ToList();
    }

    // Linking just creates the association — no Discord roles are created here. The alliance's
    // Member/Senior Staff/Notification roles (and channels) are set afterward on its own Settings
    // page or via the Setup Wizard, so those columns start null.
    private async Task AddGuildAlliance()
    {
        if (!int.TryParse(selectedAllianceIdInput, out var allianceId))
            return;

        var wasFirstLink = guildAlliances.Count == 0;
        var newAllianceLink = new GuildAlliance { GuildId = GuildId, StfcAllianceId = allianceId };

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildAlliances.Add(newAllianceLink);
            await db.SaveChangesAsync();
        }

        // Adopt any Alliance-audience settings seeded/migrated before this guild had a link
        // (see GuildAllianceService.AdoptOrphansAsync) onto the very first alliance linked.
        if (wasFirstLink)
            await AllianceService.AdoptOrphansAsync(GuildId, newAllianceLink.Id);

        selectedAllianceIdInput = null;
        await OnAllianceServerChangedAsync();
        await OnParametersSetAsync();
        await AllianceContext.ReloadAsync();
    }

    private async Task DeleteGuildAlliance(GuildAlliance link)
    {
        // Removing the link cascade-deletes this alliance's per-alliance feature toggles and
        // settings (see the FK), so confirm before destroying that configuration.
        if (!await JS.InvokeAsync<bool>("confirm", Msg.WebGuild.RemoveAllianceConfirm(Lang)))
            return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildAlliances.Remove(link);
            await db.SaveChangesAsync();
        }

        await OnParametersSetAsync();
        await AllianceContext.ReloadAsync();
    }

    private async Task AddGuildServer()
    {
        if (!int.TryParse(selectedServerIdInput, out var serverId))
            return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildServers.Add(new GuildServer { GuildId = GuildId, StfcServerId = serverId });
            await db.SaveChangesAsync();
        }

        selectedServerIdInput = null;
        if (serverPicker is not null)
            await serverPicker.ReloadServersAsync();
        await OnParametersSetAsync();
    }

    private async Task DeleteGuildServer(GuildServer link)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildServers.Remove(link);
            await db.SaveChangesAsync();
        }

        await OnParametersSetAsync();
    }

    private async Task OnVeilGroupRegionChangedAsync()
    {
        selectedVeilGroupIdInput = null;

        if (!int.TryParse(veilGroupRegionIdInput, out var regionId))
        {
            veilGroupItems = [];
            return;
        }

        // See OnAllianceServerChangedAsync's comment: EF Core can't translate a lambda
        // comparing against a local collection of entities, only primitive collections.
        var linkedVeilGroupIds = guildVeilGroups.Select(gv => gv.StfcVeilGroupId).ToHashSet();

        await using var db = await DbFactory.CreateDbContextAsync();
        var veilGroups = await db.StfcVeilGroups
            .Where(v => v.RegionId == regionId)
            .Where(v => !linkedVeilGroupIds.Contains(v.Id))
            .OrderBy(v => v.Name)
            .AsNoTracking()
            .ToListAsync();
        veilGroupItems = veilGroups.Select(v => new SelectedItem(v.Id.ToString(), v.Name)).ToList();
    }

    private async Task AddGuildVeilGroup()
    {
        if (!int.TryParse(selectedVeilGroupIdInput, out var veilGroupId))
            return;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildVeilGroups.Add(new GuildVeilGroup { GuildId = GuildId, StfcVeilGroupId = veilGroupId });
            await db.SaveChangesAsync();
        }

        selectedVeilGroupIdInput = null;
        await OnVeilGroupRegionChangedAsync();
        await OnParametersSetAsync();
    }

    private async Task DeleteGuildVeilGroup(GuildVeilGroup link)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.GuildVeilGroups.Remove(link);
            await db.SaveChangesAsync();
        }

        await OnParametersSetAsync();
    }
}
