@using HoshiBot.Web.Services
@using NetCord
@inject GuildFeatureChannelService FeatureChannelService
@inject DiscordGuildDataService DiscordData

@* A reusable list of post-to channels for one (feature, audience), backed by
   GuildFeatureChannel. The channel-only counterpart to AlertChannelListEditor — use this where
   the role to ping is decided elsewhere (e.g. ClientRelease's per-platform roles) rather than
   paired one-per-channel. *@
<SettingsCard Title="@Title">
    @if (!string.IsNullOrWhiteSpace(Usage))
    {
        <p class="form-text mb-0">@Usage</p>
    }
    <table class="table">
        <thead>
            <tr>
                <th>Channel</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var channelId in channelIds)
            {
                <tr>
                    <td>@ChannelName(channelId)</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => RemoveAsync(channelId)">Delete</button></td>
                </tr>
            }
        </tbody>
    </table>
    <EditForm Model="this" FormName="@($"add-feature-channel-{Feature}-{Audience}")" OnValidSubmit="AddAsync" class="d-flex flex-column gap-2">
        <select class="form-select" @bind="newChannelIdInput">
            <option value="">— select channel —</option>
            @if (AllowCategories)
            {
                <optgroup label="Ganze Kategorie">
                    @foreach (var category in CategoryOptions)
                    {
                        <option value="@category.Id">📁 @category.Name</option>
                    }
                </optgroup>
            }
            @foreach (var group in NormalChannelGroups)
            {
                @if (group.Category is not null)
                {
                    <optgroup label="@group.Category.Name">
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    </optgroup>
                }
                else
                {
                    @foreach (var channel in group.Channels)
                    {
                        <option value="@channel.Id">@ChannelLabel(channel)</option>
                    }
                }
            }
        </select>
        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>
</SettingsCard>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildFeature Feature { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }
    [Parameter] public string Title { get; set; } = "Channels";
    [Parameter] public string? Usage { get; set; }

    // When true, whole categories can also be added (stored by their category id). The consumer
    // is responsible for expanding a category id to its member channels at read time — see
    // AiChatService.ExpandKnowledgeChannelsAsync.
    [Parameter] public bool AllowCategories { get; set; }

    // When set, adding a channel first removes it from these sibling features (same guild/audience),
    // so the channel lives in exactly one of the mutually-exclusive buckets (e.g. the AI-chat
    // knowledge priority tiers). Null = plain add (today's behaviour).
    [Parameter] public IReadOnlyList<GuildFeature>? ExclusiveWith { get; set; }

    // Raised after any add/remove so a parent hosting several mutually-exclusive pickers can refresh
    // the siblings (via ReloadAsync) — a moved channel then disappears from the other lists.
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<ulong> channelIds = [];
    private List<IGuildChannel> channels = [];
    private string? newChannelIdInput;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        channelIds = await FeatureChannelService.GetChannelsAsync(GuildId, Feature, Audience);
        channels = await DiscordData.GetChannelsAsync(GuildId);
    }

    // Reload from storage and re-render — called by a parent to refresh sibling pickers after one of
    // them changed (see OnChanged / ExclusiveWith).
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task AddAsync()
    {
        if (!ulong.TryParse(newChannelIdInput, out var channelId))
            return;

        if (ExclusiveWith is { Count: > 0 })
            await FeatureChannelService.AddExclusiveAsync(GuildId, Feature, Audience, channelId, ExclusiveWith);
        else
            await FeatureChannelService.AddAsync(GuildId, Feature, Audience, channelId);
        newChannelIdInput = null;
        await LoadAsync();
        await NotifyChangedAsync();
    }

    private async Task RemoveAsync(ulong channelId)
    {
        await FeatureChannelService.RemoveAsync(GuildId, Feature, Audience, channelId);
        await LoadAsync();
        await NotifyChangedAsync();
    }

    private Task NotifyChangedAsync() => OnChanged.HasDelegate ? OnChanged.InvokeAsync() : Task.CompletedTask;

    // Every consumer posts via a plain SendMessageAsync (never a private thread), so Normal is
    // always right here — same reasoning as AlertChannelListEditor.
    private List<CategoryGuildChannel> CategoryOptions =>
        channels.OfType<CategoryGuildChannel>().OrderBy(c => c.Name).ToList();

    private List<ChannelGroup> NormalChannelGroups =>
        DiscordGuildDataService.GroupChannelsForDisplay(channels
                .Where(c => c is CategoryGuildChannel || DiscordGuildDataService.IsAllowedChannel(c, ChannelKind.Normal))
                .ToList())
            .Where(g => g.Channels.Count > 0)
            .ToList();

    private string ChannelName(ulong id) =>
        channels.FirstOrDefault(c => c.Id == id) is { } channel ? ChannelLabel(channel) : $"⚠ Unbekannt ({id})";

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        CategoryGuildChannel => $"📁 {channel.Name} (ganze Kategorie)",
        VoiceGuildChannel or StageGuildChannel => $"🔊 {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"📋 {channel.Name}",
        _ => $"# {channel.Name}",
    };
}
