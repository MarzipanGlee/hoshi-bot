@using HoshiBot.Domain.Attribution

@* Small "Powered by {source}" credit for admin surfaces backed by third-party data. Pass the domain
   entity type(s) the page/feature shows or depends on; the source(s) follow from PoweredByRegistry
   (distinct, so a mix like Territory Capture's territory.lol + stfc.pro renders both). *@
@if (sources.Count > 0)
{
    <div class="alert alert-info powered-by" role="alert">
        <span class="oi oi-external-link me-1" aria-hidden="true"></span>
        @* The span is what keeps the space before the first source: Razor drops the whitespace
           between an expression and the code block that follows, so "Powered by" ran straight
           into "territory.lol". Trailing space in the catalog string would be too easy to lose. *@
        <span class="me-1">@Msg.WebCommon.PoweredBy(Lang)</span>
        @for (var i = 0; i < sources.Count; i++)
        {
            <a class="alert-link" href="@sources[i].Url" target="_blank" rel="noopener">@sources[i].Name</a>@((MarkupString)Separator(i))
        }
    </div>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public Type[] For { get; set; } = [];

    private IReadOnlyList<PoweredBySource> sources = [];

    protected override void OnParametersSet() => sources = PoweredByRegistry.For(For);

    // "A", "A and B", "A, B and C".
    private string Separator(int i) =>
        i == sources.Count - 1 ? "" : i == sources.Count - 2 ? Msg.WebCommon.ListAnd(Lang) : ", ";
}
