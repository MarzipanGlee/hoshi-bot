@* The public site's top bar — shared by LandingLayout and MeLayout, which differ only in
   what sits below it (and in whether the footer carries the disclaimer). *@
<header class="landing-nav d-flex align-items-center sticky-top">
    <div class="landing-nav-inner d-flex align-items-center justify-content-between mx-auto px-4">
        <a class="landing-brand d-flex align-items-center text-white text-decoration-none fw-semibold" href="/">
            <img src="favicon.png" alt="" class="landing-brand-icon rounded-circle object-fit-cover" />
            Hoshi Bot
        </a>
        <div class="landing-nav-actions d-flex align-items-center gap-2">
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-light btn-sm" href="me">@Msg.WebNav.MyArea(Lang)</a>
                    <a class="btn btn-outline-light btn-sm" href="manage">@Msg.WebNav.Manage(Lang)</a>
                    <form method="post" action="logout" data-enhance="false" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm">@Msg.WebNav.LogOut(Lang)</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="btn btn-outline-light btn-sm" href="login">@Msg.WebNav.LogIn(Lang)</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    [CascadingParameter] public Language Lang { get; set; }
}
