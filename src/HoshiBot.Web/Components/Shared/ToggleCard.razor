<div class="card h-100 border-start border-4 @BorderClass">
    <div class="card-header">
        <span class="oi @Icon" style="font-size:0.85rem;color:#5a5a63;margin-right:0.35rem;" aria-hidden="true"></span>
        <strong>@Title</strong>
    </div>
    <div class="card-body">
        <p class="mb-0" style="color:#5a5a63;font-size:0.9rem;">@Description</p>
    </div>
    <div class="card-footer d-flex align-items-center justify-content-between">
        <div class="form-switch mb-0">
            <input class="form-check-input" type="checkbox" role="switch" checked="@Enabled"
                   @onchange="e => EnabledChanged.InvokeAsync((bool)e.Value!)" />
        </div>
        @FooterEnd
    </div>
</div>

@code {
    // A toggleable catalog entry: icon+title header, description body, an Enabled switch plus
    // one caller-specific footer action — the shape shared by the Features catalog and the
    // Audience page's cards. Renders as a direct grid item (no separate column wrapper), same
    // as SettingsCard — wrap one or more ToggleCards in a `<div class="card-grid">`.
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter] public string BorderClass { get; set; } = "";
    [Parameter] public bool Enabled { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> EnabledChanged { get; set; }

    // Features always renders a real navigation link here; Audience conditionally renders a
    // button that fires a callback instead — different enough per caller that this stays a
    // slot the caller fills, rather than the component owning "Configure" itself.
    [Parameter] public RenderFragment? FooterEnd { get; set; }
}
