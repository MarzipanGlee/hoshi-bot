@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

<h2>Channels</h2>
<div class="card-grid mt-1">
    <ChannelPicker CardTitle="Log" Usage="General bot activity log." @bind-Value="logChannelIdInput" @bind-Value:after="SaveLogChannelAsync" Channels="channels" />
    <ChannelPicker CardTitle="Admin" Usage="Where the bot reports permission/configuration problems it hits." @bind-Value="adminChannelIdInput" @bind-Value:after="SaveAdminChannelAsync" Channels="channels" />
    <ChannelPicker CardTitle="User Log" Usage="User-facing activity log, separate from the admin-facing one." @bind-Value="userLogChannelIdInput" @bind-Value:after="SaveUserLogChannelAsync" Channels="channels" />
</div>

<h2>Roles</h2>
@if (createError is not null)
{
    <p class="text-danger">@createError</p>
}
<div class="card-grid mt-1">
    <RolePicker CardTitle="Crews" CreateRoleName="Crews" @bind-Value="crewsRoleIdInput" @bind-Value:after="SaveCrewsRoleAsync" Roles="roles" />
    <RolePicker CardTitle="Beta Tester" CreateRoleName="Beta Tester" @bind-Value="betaTesterRoleIdInput" @bind-Value:after="SaveBetaTesterRoleAsync" Roles="roles" />
    <RolePicker CardTitle="Hoshi Tester" CreateRoleName="Hoshi Tester" @bind-Value="hoshiTesterRoleIdInput" @bind-Value:after="SaveHoshiTesterRoleAsync" Roles="roles" />
</div>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    private GuildSettings settings = new();
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? createError;

    private string? logChannelIdInput;
    private string? adminChannelIdInput;
    private string? userLogChannelIdInput;
    private string? crewsRoleIdInput;
    private string? betaTesterRoleIdInput;
    private string? hoshiTesterRoleIdInput;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        settings = await db.GuildSettings.AsNoTracking().FirstOrDefaultAsync(s => s.GuildId == GuildId)
            ?? new GuildSettings { GuildId = GuildId };

        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);

        logChannelIdInput = settings.LogChannelId?.ToString();
        adminChannelIdInput = settings.AdminChannelId?.ToString();
        userLogChannelIdInput = settings.UserLogChannelId?.ToString();
        crewsRoleIdInput = settings.CrewsRoleId?.ToString();
        betaTesterRoleIdInput = settings.BetaTesterRoleId?.ToString();
        hoshiTesterRoleIdInput = settings.HoshiTesterRoleId?.ToString();
    }

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;

    private async Task SaveAsync(Action<GuildSettings> apply)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == GuildId);
        if (existing is null)
        {
            existing = new GuildSettings { GuildId = GuildId };
            db.GuildSettings.Add(existing);
        }

        apply(existing);
        await db.SaveChangesAsync();
    }

    private Task SaveLogChannelAsync() => SaveAsync(s => s.LogChannelId = ParseId(logChannelIdInput));
    private Task SaveAdminChannelAsync() => SaveAsync(s => s.AdminChannelId = ParseId(adminChannelIdInput));
    private Task SaveUserLogChannelAsync() => SaveAsync(s => s.UserLogChannelId = ParseId(userLogChannelIdInput));

    // A blank selection creates a new role instead of just saving null — named after the
    // setting so it's clear at a glance what it's for.
    private async Task SaveRoleAsync(Action<GuildSettings, ulong?> setter, string? currentInput, Action<string?> setInput, string defaultName)
    {
        createError = null;
        try
        {
            var roleId = await DiscordData.EnsureRoleAsync(GuildId, currentInput, defaultName);
            setInput(roleId?.ToString());
            roles = await DiscordData.GetRolesAsync(GuildId);
            await SaveAsync(s => setter(s, roleId));
        }
        catch (RestException)
        {
            createError = "Could not create a role on Discord — does the bot have Manage Roles permission in this server?";
            if (currentInput == RolePicker.CreateSentinel)
                setInput(null);
        }
    }

    private Task SaveCrewsRoleAsync() => SaveRoleAsync((s, id) => s.CrewsRoleId = id, crewsRoleIdInput, v => crewsRoleIdInput = v, "Crews");
    private Task SaveBetaTesterRoleAsync() => SaveRoleAsync((s, id) => s.BetaTesterRoleId = id, betaTesterRoleIdInput, v => betaTesterRoleIdInput = v, "Beta Tester");
    private Task SaveHoshiTesterRoleAsync() => SaveRoleAsync((s, id) => s.HoshiTesterRoleId = id, hoshiTesterRoleIdInput, v => hoshiTesterRoleIdInput = v, "Hoshi Tester");
}
