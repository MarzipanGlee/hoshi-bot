@* The "this guild has no alliance linked yet" hint shown by the alliance-scoped pages
   (Alliance Overview/Settings, the alliance Features catalog + a single feature editor) when the
   guild has no linked alliance. Extracted so the sentence isn't copy-pasted across those four
   pages. The page keeps its own <h1>; this is just the lead paragraph. *@
<p class="text-muted">
    @Msg.WebCommon.NoAllianceLead(Lang)
    <a href="manage/guild/@GuildId/audience">@Msg.WebCommon.NoAllianceLinkText(Lang)</a> @Msg.WebCommon.NoAllianceTail(Lang)
</p>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public string GuildId { get; set; } = "";
}
