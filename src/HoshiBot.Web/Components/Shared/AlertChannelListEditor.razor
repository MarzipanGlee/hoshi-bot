@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

@* One card, unwrapped: the caller owns the grid, so this can sit in a row next to the feature's
   own cards instead of forcing a row of its own. *@
<SettingsCard Title="@Msg.WebCommon.AlertChannels(Lang)">
    <p class="form-text mb-0">
        @Msg.WebCommon.AlertChannelsUsage(Lang)
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>@Msg.WebCommon.Channel(Lang)</th>
                @if (PerChannelRole)
                {
                    <th>@Msg.WebCommon.Role(Lang)</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alertChannel in alertChannels)
            {
                <tr>
                    <td>@ChannelName(alertChannel.ChannelId)</td>
                    @if (PerChannelRole)
                    {
                        <td>@RoleName(alertChannel.RoleId)</td>
                    }
                    <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteAlertChannelAsync(alertChannel)">@Msg.WebCommon.Delete(Lang)</button></td>
                </tr>
            }
        </tbody>
    </table>
    <EditForm Model="this" FormName="@($"add-alert-channel-{Kind}")" OnValidSubmit="AddAlertChannelAsync" class="d-flex flex-column gap-2">
        <select class="form-select" @bind="newChannelIdInput">
            <option value="">@Msg.WebCommon.SelectChannelOption(Lang)</option>
            @foreach (var group in NormalChannelGroups)
            {
                @if (group.Category is not null)
                {
                    <optgroup label="@group.Category.Name">
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    </optgroup>
                }
                else
                {
                    @foreach (var channel in group.Channels)
                    {
                        <option value="@channel.Id">@ChannelLabel(channel)</option>
                    }
                }
            }
        </select>
        @if (PerChannelRole)
        {
            <select class="form-select" @bind="newRoleIdInput">
                <option value="">@Msg.WebCommon.SelectRoleOption(Lang)</option>
                @foreach (var role in roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        }
        <button type="submit" class="btn btn-primary">@Msg.WebCommon.Add(Lang)</button>
</EditForm>
</SettingsCard>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildAlertChannelKind Kind { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }

    [Parameter] public int? GuildAllianceId { get; set; }

    // Whether each row picks its own role. False for Raid/Shield, which ping the alliance's one
    // alert role — the role members opt into, so a per-channel choice could only ever disagree with
    // it. True for ServerStatus/InfiniteIncursions/AllianceTournament, where different channels
    // genuinely serve different audiences and roles.
    [Parameter] public bool PerChannelRole { get; set; } = true;

    private List<GuildAlertChannel> alertChannels = [];
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? newChannelIdInput;
    private string? newRoleIdInput;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Alliance-tagged rows are filtered by alliance too, so a coalition guild's five raid
        // configurations stop showing each other's channels.
        alertChannels = await db.GuildAlertChannels
            .Where(c => c.GuildId == GuildId && c.Kind == Kind && c.Audience == Audience
                && (GuildAllianceId == null || c.GuildAllianceId == GuildAllianceId))
            .AsNoTracking()
            .ToListAsync();

        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
    }

    private async Task AddAlertChannelAsync()
    {
        if (!ulong.TryParse(newChannelIdInput, out var channelId))
            return;

        ulong? roleId = null;
        if (PerChannelRole)
        {
            if (!ulong.TryParse(newRoleIdInput, out var picked))
                return;
            roleId = picked;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAlertChannels.Add(new GuildAlertChannel
        {
            GuildId = GuildId,
            Kind = Kind,
            ChannelId = channelId,
            RoleId = roleId,
            Audience = Audience,
            GuildAllianceId = GuildAllianceId,
        });
        await db.SaveChangesAsync();

        newChannelIdInput = null;
        newRoleIdInput = null;
        await LoadAsync();
    }

    private async Task DeleteAlertChannelAsync(GuildAlertChannel alertChannel)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAlertChannels.Remove(alertChannel);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    // All 4 GuildAlertChannelKind values deliver via a plain SendMessageAsync (see
    // NotificationDispatcher) — never a private thread — so Normal is always right here,
    // unlike ChannelPicker's per-setting Kind parameter.
    private List<ChannelGroup> NormalChannelGroups =>
        DiscordGuildDataService.GroupChannelsForDisplay(channels
                .Where(c => c is CategoryGuildChannel || DiscordGuildDataService.IsAllowedChannel(c, ChannelKind.Normal))
                .ToList())
            .Where(g => g.Channels.Count > 0)
            .ToList();

    private string ChannelName(ulong id) =>
        channels.FirstOrDefault(c => c.Id == id) is { } channel ? ChannelLabel(channel) : Msg.WebCommon.Unknown(Lang, id);

    private string RoleName(ulong? id) =>
        id is not { } roleId ? "—"
            : roles.FirstOrDefault(r => r.Id == roleId)?.Name ?? Msg.WebCommon.Unknown(Lang, roleId);

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        VoiceGuildChannel or StageGuildChannel => $"{Icons.VoiceChannel} {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"{Icons.ForumChannel} {channel.Name}",
        _ => $"# {channel.Name}",
    };
}
