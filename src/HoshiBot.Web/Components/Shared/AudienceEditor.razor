@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<div class="card-grid">
    @foreach (var audience in AudienceCards)
    {
        var enabled = audiences.HasFlag(audience);
        <ToggleCard Icon="@AudienceDisplay.Icon(audience)" Title="@AudienceDisplay.Labels(Lang, audience).First()"
                    Description="@AudienceDisplay.Description(Lang, audience)"
                    BorderClass="@(enabled ? "border-success" : "border-danger")" Enabled="@enabled"
                    EnabledChanged="e => ToggleAsync(audience, e)">
            <FooterEnd>
                @if (ShowConfigureButton && enabled)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@ConfigureHref(audience)">@Msg.WebGuild.Configure(Lang)</a>
                }
            </FooterEnd>
        </ToggleCard>
    }
</div>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private static readonly GuildAudience[] AudienceCards =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    // Fires after every toggle saves — lets an embedding page (the Setup Wizard) react
    // immediately, e.g. recomputing which later steps are relevant.
    [Parameter] public EventCallback<GuildAudience> AudienceChanged { get; set; }

    // Off in the Setup Wizard: it walks the user through the same configuration inline as its own
    // later step, so sending them away mid-flow would break it.
    [Parameter] public bool ShowConfigureButton { get; set; } = true;

    private GuildAudience audiences;

    // Each audience's own page, the way a feature card links to its editor. Alliance is the odd one
    // out: {slug}/settings is the per-audience settings page for everyone else, but for Alliance
    // that route is already the per-ALLIANCE settings page, so its guild-level linking lives at
    // /alliances instead.
    private string ConfigureHref(GuildAudience audience) => audience == GuildAudience.Alliance
        ? $"manage/guild/{GuildId}/alliances"
        : $"{AudienceDisplay.FeatureScopePrefix(GuildId, audience, null)}/settings";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GuildSettings.AsNoTracking().FirstOrDefaultAsync(s => s.GuildId == GuildId);
        audiences = settings?.Audiences ?? GuildAudience.None;
    }

    private async Task ToggleAsync(GuildAudience flag, bool enabled)
    {
        audiences = enabled ? audiences | flag : audiences & ~flag;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == GuildId);
        if (existing is null)
        {
            existing = new GuildSettings { GuildId = GuildId };
            db.GuildSettings.Add(existing);
        }

        existing.Audiences = audiences;
        await db.SaveChangesAsync();

        await AudienceChanged.InvokeAsync(audiences);
    }
}
