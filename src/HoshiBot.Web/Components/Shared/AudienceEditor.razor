@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<div class="row g-3">
    @foreach (var audience in AudienceCards)
    {
        var enabled = audiences.HasFlag(audience);
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 border-start border-4 @(enabled ? "border-success" : "border-danger")">
                <div class="card-body d-flex flex-column">
                    <h4 class="fs-6 fw-semibold mb-2">
                        <span class="oi @AudienceDisplay.Icon(audience)" style="font-size:0.85rem;color:#5a5a63;margin-right:0.35rem;" aria-hidden="true"></span>
                        @AudienceDisplay.Labels(audience).First()
                    </h4>
                    <p class="flex-grow-1" style="color:#5a5a63;font-size:0.9rem;">@AudienceDisplay.Description(audience)</p>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" checked="@enabled"
                                   @onchange="e => ToggleAsync(audience, (bool)e.Value!)" />
                        </div>
                        @if (ShowConfigureButton && enabled && audience != GuildAudience.Community)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnConfigure.InvokeAsync(audience)">Configure</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Community has no corresponding GuildXxx link entity/ScopeEditor branch — no Configure
    // button for it regardless of ShowConfigureButton.
    private static readonly GuildAudience[] AudienceCards =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    // Fires after every toggle saves — lets an embedding page (the Setup Wizard) react
    // immediately, e.g. recomputing which later steps are relevant.
    [Parameter] public EventCallback<GuildAudience> AudienceChanged { get; set; }

    // The Setup Wizard doesn't show the Scope accordion until its own later step, so a
    // Configure button here would have nothing to jump to — the Audience page (which shows
    // the accordion directly below this editor) is the only place it makes sense.
    [Parameter] public bool ShowConfigureButton { get; set; } = true;

    // Only meaningful when ShowConfigureButton is true — lets the embedding page expand
    // (and scroll to) the matching ScopeAccordion section.
    [Parameter] public EventCallback<GuildAudience> OnConfigure { get; set; }

    private GuildAudience audiences;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GuildSettings.AsNoTracking().FirstOrDefaultAsync(s => s.GuildId == GuildId);
        audiences = settings?.Audiences ?? GuildAudience.None;
    }

    private async Task ToggleAsync(GuildAudience flag, bool enabled)
    {
        audiences = enabled ? audiences | flag : audiences & ~flag;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == GuildId);
        if (existing is null)
        {
            existing = new GuildSettings { GuildId = GuildId };
            db.GuildSettings.Add(existing);
        }

        existing.Audiences = audiences;
        await db.SaveChangesAsync();

        await AudienceChanged.InvokeAsync(audiences);
    }
}
