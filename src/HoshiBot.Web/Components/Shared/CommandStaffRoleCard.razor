@using NetCord
@inject CommandStaffRoles CommandStaffRoles
@inject DiscordGuildDataService DiscordData

@* The scope's Command Staff role, shown by every feature that reads it (RoE "report on behalf of an
   own player", raid-alert termination, announcement attribution, STFC News confirmer count).

   Read-only, and per scope. It was one guild-wide value editable from these four feature pages and
   owned by none of them — so a coalition guild gave every alliance the same leadership, and the only
   way to set it was from inside a feature that merely read it. *@
<OwnedElsewhereCard Title="@Msg.WebCommon.CommandStaffRole(Lang)"
                    Label="@Msg.WebCommon.CommandStaffRoleUsage(Lang)" Lang="Lang"
                    Value="@display"
                    Hint="@(IsAlliance ? Msg.WebCommon.OwnedByAllianceSettings(Lang) : Msg.WebCommon.OwnedByAudienceSettings(Lang))"
                    LinkText="@(IsAlliance ? Msg.WebCommon.OpenAllianceSettings(Lang) : Msg.WebCommon.OpenAudienceSettings(Lang))"
                    LinkHref="@OwnerHref" />

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }
    [Parameter] public int? GuildAllianceId { get; set; }

    private string? display;

    private bool IsAlliance => Audience == GuildAudience.Alliance && GuildAllianceId is not null;

    private string OwnerHref => IsAlliance
        ? $"manage/guild/{GuildId}/alliance/{GuildAllianceId}/settings"
        : $"manage/guild/{GuildId}/{AudienceDisplay.Slug(Audience)}/settings";

    protected override async Task OnParametersSetAsync()
    {
        if (await CommandStaffRoles.ForScopeAsync(GuildId, Audience, GuildAllianceId) is not { } roleId)
        {
            display = null;
            return;
        }

        var roles = await DiscordData.GetRolesAsync(GuildId);
        display = roles.FirstOrDefault(r => r.Id == roleId) is { } role ? $"@{role.Name}" : null;
    }
}
