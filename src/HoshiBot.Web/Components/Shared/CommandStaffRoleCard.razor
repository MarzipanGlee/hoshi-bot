@using NetCord
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

@* The guild-wide Command Staff role, shown by every feature that reads it (RoE "report on behalf of
   an own player", raid-alert termination, announcement attribution, STFC News confirmer count).

   Read-only: it is ONE value on GuildSettings, and editing it from four feature pages made a shared
   setting look like four that mysteriously moved together. Changed on the guild settings page. *@
<OwnedElsewhereCard Title="@Msg.WebCommon.CommandStaffRole(Lang)"
                    Label="@Msg.WebCommon.CommandStaffRoleUsage(Lang)" Lang="Lang"
                    Value="@display"
                    Hint="@Msg.WebCommon.OwnedByGuildSettings(Lang)"
                    LinkText="@Msg.WebCommon.OpenGuildSettings(Lang)"
                    LinkHref="@($"manage/guild/{GuildId}/settings")" />

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    private string? display;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GuildSettings.AsNoTracking().FirstOrDefaultAsync(s => s.GuildId == GuildId);
        if (settings?.CommandStaffRoleId is not { } roleId)
            return;

        var roles = await DiscordData.GetRolesAsync(GuildId);
        display = roles.FirstOrDefault(r => r.Id == roleId) is { } role ? $"@{role.Name}" : null;
    }
}
