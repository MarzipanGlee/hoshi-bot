@* The shared loading placeholder. Defaults to the dominant shape (<p><em>Loading...</em></p> — the
   Stfc/**/Edit pages and DeleteConfirmation); Em/Text only exist so the other converted sites keep
   the exact rendering they already had, not to invite new variants. *@
@if (Em)
{
    <p><em>@ResolvedText</em></p>
}
else
{
    <p>@ResolvedText</p>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    // Null = the catalog's localized "Loading..." — callers only pass Text for a bespoke wording
    // (which they localize themselves).
    [Parameter] public string? Text { get; set; }

    [Parameter] public bool Em { get; set; } = true;

    private string ResolvedText => Text ?? Msg.WebCommon.Loading(Lang);
}
