@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest

@if (CardTitle is not null)
{
    <SettingsCard Title="@CardTitle">
        @Body
    </SettingsCard>
}
else
{
    @Body
}

@code {
    [Parameter] public string Label { get; set; } = "";

    // When set, the picker renders itself inside a SettingsCard with this as the card title (the card
    // header is the label, so the inline label is hidden). Collapses the single-picker-per-card idiom
    // `<SettingsCard Title="X"><ChannelPicker Label="X" ShowLabel="false" …/></SettingsCard>` to
    // `<ChannelPicker CardTitle="X" …/>`.
    [Parameter] public string? CardTitle { get; set; }

    // Off when a caller renders its own header for Label instead (e.g. a card header).
    [Parameter] public bool ShowLabel { get; set; } = true;

    // Rendered as a small explanatory line under the picker — this is where "good
    // description per setting, usage must be explained" actually lands.
    [Parameter] public string? Usage { get; set; }

    [Parameter] public string PlaceholderText { get; set; } = "— none —";

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<IGuildChannel> Channels { get; set; } = [];

    // Most settings just need "something SendMessageAsync can target" (Normal); RoE Violations/
    // Tickets create a private thread under the channel instead, which narrows this to plain
    // text channels only (TextOnly) — see DiscordGuildDataService.IsAllowedChannel.
    [Parameter] public ChannelKind Kind { get; set; } = ChannelKind.Normal;

    // When set, adds a "— create "{name}" —" action option (value = CreateSentinel). The caller's
    // save handler detects the sentinel and creates the channel/category of the right type via
    // DiscordGuildDataService.EnsureChannelAsync — mirrors RolePicker.CreateRoleName.
    [Parameter] public string? CreateChannelName { get; set; }

    // Category picker mode: the Channels passed are categories, and each is rendered as a flat,
    // selectable option (not an <optgroup> header). Used by the Default Channel Category setting.
    [Parameter] public bool CategorySelect { get; set; }

    public const string CreateSentinel = "__create_channel__";

    private bool ChannelWithCreateNameExists =>
        CreateChannelName is not null && Channels.Any(c => string.Equals(c.Name, CreateChannelName, StringComparison.OrdinalIgnoreCase));

    private bool IsUnknown =>
        !string.IsNullOrEmpty(Value) && ulong.TryParse(Value, out var id) && !Channels.Any(c => c.Id == id);

    // Categories stay so a category with no matching children just disappears (no empty
    // <optgroup>) rather than needing separate filtering logic before grouping.
    private List<ChannelGroup> FilteredGroups =>
        DiscordGuildDataService.GroupChannelsForDisplay(Channels
                .Where(c => c is CategoryGuildChannel || DiscordGuildDataService.IsAllowedChannel(c, Kind))
                .ToList())
            .Where(g => g.Channels.Count > 0)
            .ToList();

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        VoiceGuildChannel or StageGuildChannel => $"🔊 {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"📋 {channel.Name}",
        _ => $"# {channel.Name}",
    };

    private RenderFragment Body => @<div class="mb-2">
        @if (ShowLabel && CardTitle is null)
        {
            <label>@Label</label>
        }
        <select class="form-select" value="@Value" @onchange="OnChangeAsync">
            <option value="">@PlaceholderText</option>
            @* Create action — a distinct sentinel value (not the blank option, which stays a valid
               "none"/"server root" choice), hidden once a channel/category by this exact name exists. *@
            @if (CreateChannelName is not null && !ChannelWithCreateNameExists)
            {
                <option value="@CreateSentinel">— create "@CreateChannelName" —</option>
            }
            @if (IsUnknown)
            {
                <option value="@Value" selected>⚠ Unbekannt (@Value)</option>
            }
            @if (CategorySelect)
            {
                @* Categories are the selectable options themselves here (not <optgroup> headers). *@
                @foreach (var category in Channels.OfType<CategoryGuildChannel>())
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
            else
            {
                @foreach (var group in FilteredGroups)
                {
                    @if (group.Category is not null)
                    {
                        <optgroup label="@group.Category.Name">
                            @foreach (var channel in group.Channels)
                            {
                                <option value="@channel.Id">@ChannelLabel(channel)</option>
                            }
                        </optgroup>
                    }
                    else
                    {
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    }
                }
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(Usage))
        {
            <div class="form-text">@Usage</div>
        }
    </div>;
}
