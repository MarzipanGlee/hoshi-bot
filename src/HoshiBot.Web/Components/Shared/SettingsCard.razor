@if (Href is not null)
{
    <a class="card h-100 text-decoration-none text-body @Class" href="@Href">
        @Header
        @Body
        @FooterSection
    </a>
}
else
{
    <div class="card h-100 @Class">
        @Header
        @Body
        @FooterSection
    </div>
}

@code {
    // Groups one logical section of a feature editor's settings (e.g. "Zone Slot Roles") in
    // its own grid card — every feature editor uses this instead of its own bespoke wrapper, so
    // the Features pages read consistently regardless of how many settings a given feature has.
    // Callers must wrap one or more SettingsCards in a `<div class="card-grid">` — this renders
    // as a direct grid item, no separate column wrapper needed the way Bootstrap's row/col grid
    // required (CSS Grid sizes/positions items itself).
    [Parameter] public string? Title { get; set; }

    // Extra CSS class(es) on the card's root grid item — e.g. "card-span-full" to make one card
    // span the whole card-grid width (for a wide table that the default 350px track squeezes).
    [Parameter] public string? Class { get; set; }

    // Alternative to Title for headers that need more than plain text (an icon image, a
    // secondary range-label span, etc.) — RankRoles/OpsLevelRoles use this.
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    // When set, the whole card becomes a link instead of a static container — used by plain
    // shortcut cards (Dashboard/Guild overview) with no switch/footer of their own, just
    // navigate somewhere on click.
    [Parameter] public string? Href { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Optional status/action line pinned to the bottom in a card-footer — the shortcut cards
    // (Dashboard/Guild/Alliance overview) put their subtitle here so they read like GuildCard/
    // AllianceCard (header on top, status footer below), instead of stacking everything in the body.
    [Parameter] public RenderFragment? Footer { get; set; }

    private RenderFragment? Header => HeaderContent is null && string.IsNullOrEmpty(Title)
        ? null
        : @<div class="card-header">
              @if (HeaderContent is not null)
              {
                  @HeaderContent
              }
              else
              {
                  <strong>@Title</strong>
              }
          </div>;

    // The body only renders when there's ChildContent — a shortcut card that only has a header +
    // footer shouldn't emit an empty card-body between them.
    private RenderFragment? Body => ChildContent is null
        ? null
        : @<div class="card-body d-flex flex-column gap-3">@ChildContent</div>;

    private RenderFragment? FooterSection => Footer is null
        ? null
        : @<div class="card-footer">@Footer</div>;
}
