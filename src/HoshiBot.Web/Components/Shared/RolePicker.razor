@using NetCord

@if (CardTitle is not null)
{
    <SettingsCard Title="@CardTitle">
        @Body
    </SettingsCard>
}
else
{
    @Body
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter] public string Label { get; set; } = "";

    // When set, the picker renders itself inside a SettingsCard with this as the card title (the card
    // header is the label, so the inline label is hidden). Collapses the single-picker-per-card idiom
    // `<SettingsCard Title="X"><RolePicker Label="X" ShowLabel="false" …/></SettingsCard>` to
    // `<RolePicker CardTitle="X" …/>`.
    [Parameter] public string? CardTitle { get; set; }

    // Off when a caller renders its own header for Label/IconSrc instead (e.g. a card header).
    [Parameter] public bool ShowLabel { get; set; } = true;

    // Rendered inline after the label text — used by rank-role pickers to pair each rank
    // with its own icon, right next to the title it belongs to (not floating separately).
    [Parameter] public string? IconSrc { get; set; }

    // Rendered as a small explanatory line under the picker — this is where "good
    // description per setting, usage must be explained" actually lands.
    [Parameter] public string? Usage { get; set; }

    // Null = the catalog's localized "— none —" — callers only pass this for a bespoke wording.
    [Parameter] public string? PlaceholderText { get; set; }

    // When set, the blank option means "create a new role named this" (an action) rather than
    // "no role assigned" (a valid end state) — so it gets its own sentinel value, separate from
    // the genuinely-blank "— choose a role —" placeholder shown until a real choice is made.
    // Without this split, a picker that starts blank already has "create" pre-selected (same
    // value=""), so <select>'s change event — which only fires on an actual value change —
    // never fires on that first click, and no role ever gets created. The create option is
    // hidden entirely once a role by this exact name already exists, since picking it then
    // would just make a same-named duplicate instead of reusing the one already there.
    [Parameter] public string? CreateRoleName { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<Role> Roles { get; set; } = [];

    public const string CreateSentinel = "__create__";

    private bool RoleWithCreateNameExists => Roles.Any(r => r.Name == CreateRoleName);

    private bool IsUnknown =>
        !string.IsNullOrEmpty(Value) && ulong.TryParse(Value, out var id) && !Roles.Any(r => r.Id == id);

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        await ValueChanged.InvokeAsync(Value);
    }

    private RenderFragment Body => @<div class="mb-2">
        @if (ShowLabel && CardTitle is null)
        {
            <label>
                @Label
                @if (IconSrc is not null)
                {
                    <img src="@IconSrc" alt="" class="role-picker-icon" />
                }
            </label>
        }
        <select class="form-select" value="@Value" @onchange="OnChangeAsync">
            @if (CreateRoleName is not null)
            {
                <option value="">@Msg.WebCommon.ChooseRoleOption(Lang)</option>
                @if (!RoleWithCreateNameExists)
                {
                    <option value="@CreateSentinel">@Msg.WebCommon.CreateRoleOption(Lang, CreateRoleName)</option>
                }
            }
            else
            {
                <option value="">@(PlaceholderText ?? Msg.WebCommon.NoneOption(Lang))</option>
            }
            @if (IsUnknown)
            {
                <option value="@Value" selected>@Msg.WebCommon.Unknown(Lang, Value)</option>
            }
            @foreach (var role in Roles)
            {
                <option value="@role.Id">@role.Name</option>
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(Usage))
        {
            <div class="form-text">@Usage</div>
        }
    </div>;
}
