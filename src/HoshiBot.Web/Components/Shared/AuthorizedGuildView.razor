@* Wraps a guild-admin page's body, showing the "Checking access…" placeholder until the
   resource-scoped auth check completes. Replaces the per-page
   `@if (!Authorized) { <p>Checking access...</p> } else { … }` guard — GuildAdminPageBase is a
   pure-C# base with no markup, so each page hand-rolled the guard; this is the one shared home. *@
@if (Authorized)
{
    @ChildContent
}
else
{
    <p>@Msg.WebCommon.CheckingAccess(Lang)</p>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter] public bool Authorized { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
