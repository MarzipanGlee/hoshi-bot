@page "/Error"
@using System.Diagnostics

<PageTitle>@Msg.WebCommon.ErrorPageTitle(Lang)</PageTitle>

<h1 class="text-danger">@Msg.WebCommon.ErrorHeading(Lang)</h1>
<h2 class="text-danger">@Msg.WebCommon.ErrorMessage(Lang)</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Msg.WebCommon.ErrorRequestId(Lang)</strong> <code>@RequestId</code>
    </p>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
