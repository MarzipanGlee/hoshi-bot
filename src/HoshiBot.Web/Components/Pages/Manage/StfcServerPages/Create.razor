@page "/manage/stfc-servers/create"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Server</PageTitle>

<h1>Create Server</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Server" OnValidSubmit="AddServer" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="number" class="form-label">Server Number (ID):</label>
                <InputNumber id="number" @bind-Value="Server.Id" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Server.Id" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="Server.Name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Server.Name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="region" class="form-label">Region:</label>
                <InputSelect id="region" @bind-Value="Server.RegionId" class="form-control">
                    <option value="0">Select region...</option>
                    @foreach (var region in regions)
                    {
                        <option value="@region.Id">@region.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Server.RegionId" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="veilGroup" class="form-label">Veil Group:</label>
                <InputSelect id="veilGroup" @bind-Value="Server.VeilGroupId" class="form-control">
                    <option value="">No veil group (new/unclassified)</option>
                    @foreach (var veilGroup in veilGroups)
                    {
                        <option value="@veilGroup.Id">@veilGroup.Name</option>
                    }
                </InputSelect>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc-servers">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private StfcServer Server { get; set; } = default!;

    private List<StfcRegion> regions = [];
    private List<StfcVeilGroup> veilGroups = [];

    protected override async Task OnInitializedAsync()
    {
        Server ??= new() { Name = "" };
        using var context = DbFactory.CreateDbContext();
        regions = await context.StfcRegions.AsNoTracking().ToListAsync();
        veilGroups = await context.StfcVeilGroups.AsNoTracking().ToListAsync();
    }

    private async Task AddServer()
    {
        if (Server.RegionId == 0)
            return;

        using var context = DbFactory.CreateDbContext();
        context.StfcServers.Add(Server);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc-servers");
    }
}
