@page "/manage/stfc/servers/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Server</PageTitle>

<h1>Delete Server</h1>

<p>Are you sure you want to delete this?</p>
<div>
    @if (server is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Number</dt>
            <dd class="col-sm-10">@server.Id</dd>
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@server.Name</dd>
            <dt class="col-sm-2">Region</dt>
            <dd class="col-sm-10">@server.Region.Name</dd>
            <dt class="col-sm-2">Veil Group</dt>
            <dd class="col-sm-10">@(server.VeilGroup?.Name ?? "Unassigned")</dd>
        </dl>
        <EditForm method="post" Model="server" OnValidSubmit="DeleteServer" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/manage/stfc/servers">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private StfcServer? server;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        server = await context.StfcServers
            .Include(s => s.Region)
            .Include(s => s.VeilGroup)
            .FirstOrDefaultAsync(s => s.Id == Id);

        if (server is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteServer()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcServers.Remove(server!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/servers");
    }
}
