@page "/manage/stfc/alliance-diplomacy/edit"
@inherits EntityEditPageBase<StfcAllianceDiplomacy, int>

<PageTitle>Edit Alliance Diplomacy</PageTitle>

<h1>Edit Alliance Diplomacy</h1>
<hr />
@if (Entity is null)
{
    <LoadingPlaceholder />
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="source" Label="Source Alliance:" Required>
                    <InputSelect id="source" @bind-Value="Entity.SourceAllianceId" class="form-control">
                        @foreach (var alliance in alliances)
                        {
                            <option value="@alliance.Id">@alliance.Tag</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.SourceAllianceId" class="text-danger" />
                </FormField>
                <FormField For="target" Label="Target Alliance:" Required>
                    <InputSelect id="target" @bind-Value="Entity.TargetAllianceId" class="form-control">
                        @foreach (var alliance in alliances)
                        {
                            <option value="@alliance.Id">@alliance.Tag</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.TargetAllianceId" class="text-danger" />
                </FormField>
                <FormField For="status" Label="Status:" Required>
                    <InputSelect id="status" @bind-Value="Entity.Status" class="form-control">
                        @foreach (var status in Enum.GetValues<DiplomacyStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.Status" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/alliance-diplomacy">Back to List</a>
</div>

@code {
    private List<StfcAlliance> alliances = [];

    protected override string ListHref => "/manage/stfc/alliance-diplomacy";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        alliances = await context.StfcAlliances.AsNoTracking().ToListAsync();
        await base.OnInitializedAsync();
    }

    protected override Task<StfcAllianceDiplomacy?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiplomacies.FirstOrDefaultAsync(d => d.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiplomacies.AnyAsync(d => d.Id == id);
}
