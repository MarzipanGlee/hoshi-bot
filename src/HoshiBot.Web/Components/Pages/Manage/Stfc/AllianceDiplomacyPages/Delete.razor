@page "/manage/stfc/alliance-diplomacy/delete"
@inherits EntityDeletePageBase<StfcAllianceDiplomacy, int>

<DeleteConfirmation EntityName="Alliance Diplomacy" BackHref="/manage/stfc/alliance-diplomacy" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Source</dt>
    <dd class="col-sm-10">@Entity!.SourceAlliance.Tag</dd>
    <dt class="col-sm-2">Target</dt>
    <dd class="col-sm-10">@Entity!.TargetAlliance.Tag</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Entity!.Status</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/alliance-diplomacy";

    protected override Task<StfcAllianceDiplomacy?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiplomacies
            .Include(d => d.SourceAlliance)
            .Include(d => d.TargetAlliance)
            .FirstOrDefaultAsync(d => d.Id == id);
}
