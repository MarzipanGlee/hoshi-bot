@page "/manage/stfc/alliance-diplomacy/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<DeleteConfirmation EntityName="Alliance Diplomacy" BackHref="/manage/stfc/alliance-diplomacy" Loaded="diplomacy is not null" OnConfirm="DeleteDiplomacy">
    <dt class="col-sm-2">Source</dt>
    <dd class="col-sm-10">@diplomacy!.SourceAlliance.Tag</dd>
    <dt class="col-sm-2">Target</dt>
    <dd class="col-sm-10">@diplomacy!.TargetAlliance.Tag</dd>
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@diplomacy!.Status</dd>
</DeleteConfirmation>

@code {
    private StfcAllianceDiplomacy? diplomacy;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        diplomacy = await context.StfcAllianceDiplomacies
            .Include(d => d.SourceAlliance)
            .Include(d => d.TargetAlliance)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (diplomacy is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteDiplomacy()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcAllianceDiplomacies.Remove(diplomacy!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/alliance-diplomacy");
    }
}
