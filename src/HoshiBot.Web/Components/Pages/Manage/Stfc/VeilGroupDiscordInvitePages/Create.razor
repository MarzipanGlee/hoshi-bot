@page "/manage/stfc/veil-group-invites/create"
@inherits EntityCreatePageBase<StfcVeilGroupDiscordInvite>

<PageTitle>Create Veil Group Discord Invite</PageTitle>

<h1>Create Veil Group Discord Invite</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddInvite" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="veilGroup" Label="Veil Group:" Required>
                <InputSelect id="veilGroup" @bind-Value="Entity.VeilGroupId" class="form-control">
                    <option value="0">Select veil group...</option>
                    @foreach (var veilGroup in veilGroups)
                    {
                        <option value="@veilGroup.Id">@veilGroup.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.VeilGroupId" class="text-danger" />
            </FormField>
            <FormField For="url" Label="Invite URL:" Required>
                <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Url" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/veil-group-invites">Back to List</a>
</div>

@code {
    private List<StfcVeilGroup> veilGroups = [];

    protected override string ListHref => "/manage/stfc/veil-group-invites";

    protected override StfcVeilGroupDiscordInvite CreateNew() => new() { Url = "" };

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        veilGroups = await context.StfcVeilGroups.AsNoTracking().OrderBy(v => v.Name).ToListAsync();
    }

    private async Task AddInvite()
    {
        if (Entity.VeilGroupId == 0)
            return;

        await AddAsync();
    }
}
