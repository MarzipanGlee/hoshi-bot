@page "/manage/stfc/veil-group-invites/edit"
@inherits EntityEditPageBase<StfcVeilGroupDiscordInvite, int>

<PageTitle>Edit Veil Group Discord Invite</PageTitle>

<h1>Edit Veil Group Discord Invite</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="veilGroup" Label="Veil Group:" Required>
                    <InputSelect id="veilGroup" @bind-Value="Entity.VeilGroupId" class="form-control">
                        @foreach (var veilGroup in veilGroups)
                        {
                            <option value="@veilGroup.Id">@veilGroup.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.VeilGroupId" class="text-danger" />
                </FormField>
                <FormField For="url" Label="Invite URL:" Required>
                    <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Url" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/veil-group-invites">Back to List</a>
</div>

@code {
    private List<StfcVeilGroup> veilGroups = [];

    protected override string ListHref => "/manage/stfc/veil-group-invites";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        veilGroups = await context.StfcVeilGroups.AsNoTracking().OrderBy(v => v.Name).ToListAsync();
        await base.OnInitializedAsync();
    }

    protected override Task<StfcVeilGroupDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroupDiscordInvites.FirstOrDefaultAsync(i => i.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroupDiscordInvites.AnyAsync(i => i.Id == id);
}
