@page "/manage/stfc/veil-group-invites/delete"
@inherits EntityDeletePageBase<StfcVeilGroupDiscordInvite, int>

<DeleteConfirmation EntityName="Veil Group Discord Invite" BackHref="/manage/stfc/veil-group-invites" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Veil Group</dt>
    <dd class="col-sm-10">@Entity!.VeilGroup.Name</dd>
    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@Entity!.Url</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/veil-group-invites";

    protected override Task<StfcVeilGroupDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroupDiscordInvites
            .Include(i => i.VeilGroup)
            .FirstOrDefaultAsync(i => i.Id == id);
}
