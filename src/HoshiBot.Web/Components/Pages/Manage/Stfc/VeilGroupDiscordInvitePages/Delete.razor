@page "/manage/stfc/veil-group-invites/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<DeleteConfirmation EntityName="Veil Group Discord Invite" BackHref="/manage/stfc/veil-group-invites" Loaded="invite is not null" OnConfirm="DeleteInvite">
    <dt class="col-sm-2">Veil Group</dt>
    <dd class="col-sm-10">@invite!.VeilGroup.Name</dd>
    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@invite!.Url</dd>
</DeleteConfirmation>

@code {
    private StfcVeilGroupDiscordInvite? invite;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invite = await context.StfcVeilGroupDiscordInvites
            .Include(i => i.VeilGroup)
            .FirstOrDefaultAsync(i => i.Id == Id);

        if (invite is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteInvite()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcVeilGroupDiscordInvites.Remove(invite!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/veil-group-invites");
    }
}
