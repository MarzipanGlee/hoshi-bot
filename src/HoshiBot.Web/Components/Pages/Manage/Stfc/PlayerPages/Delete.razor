@page "/manage/stfc/players/delete"
@inherits EntityDeletePageBase<StfcPlayer, int>

<DeleteConfirmation EntityName="Player" BackHref="/manage/stfc/players" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
    <dt class="col-sm-2">Server</dt>
    <dd class="col-sm-10">@Entity!.Server.DisplayName</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/players";

    protected override Task<StfcPlayer?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcPlayers.Include(p => p.Server).ThenInclude(s => s.Region).FirstOrDefaultAsync(p => p.Id == id);
}
