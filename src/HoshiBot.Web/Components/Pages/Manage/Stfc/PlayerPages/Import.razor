@page "/manage/stfc/players/import"
@using System.IO.Compression
@using System.Text.Json
@using HoshiBot.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject StfcPlayerImportService ImportService

<PageTitle>Import Players</PageTitle>

<h1>Import Players</h1>
<p>Upload one or more player-data files for a single server — either the paginated per-page exports from an external stats site (<code>{"count":…,"players":[{"data":{…}}]}</code>, gzipped or plain) or a single merged flat array of player records (<code>[{…},…]</code>, e.g. <code>data/players.json</code> from <code>tools/HoshiBot.StfcSeedSync</code>). Existing players are matched by their external ID and updated in place; new ones are added.</p>

<div class="d-flex gap-2 align-items-end flex-wrap mb-3">
    <RegionServerPicker @bind-RegionId="regionIdInput" @bind-ServerId="serverIdInput" />
</div>

<ImportForm TResult="StfcPlayerImportResult" Accept=".json,.gz" IsMultiple="true"
            Disabled="@(serverIdInput is null)" Import="ImportAsync">
    <ResultTemplate Context="r">
        <p class="mt-3">
            Added @r.Added, updated @r.Updated (@r.Renamed renamed). Skipped @r.Mismatched
            (wrong server), @r.InvalidRank (invalid rank), @r.MissingName (missing name).
        </p>
    </ResultTemplate>
</ImportForm>

@code {
    private string? regionIdInput;
    private string? serverIdInput;

    private async Task<StfcPlayerImportResult> ImportAsync(IReadOnlyCollection<UploadFile> files)
    {
        // Unreachable via the UI — the upload stays disabled until a server is picked.
        if (!int.TryParse(serverIdInput, out var serverId))
            throw new InvalidOperationException("Pick a server first.");

        var entries = new List<StfcPlayerImportEntry>();
        foreach (var file in files)
        {
            if (file.File is null)
                continue;

            entries.AddRange(await ParseFileAsync(file.File));
        }

        return await ImportService.ImportAsync(serverId, entries);
    }

    // Real feed files (e.g. data/players_164*) have no file extension and no declared
    // content-type — sniffing the gzip magic number is the only reliable signal. The JSON
    // itself comes in two shapes: the feed's own paginated {"count":…,"players":[{"data":{…}}]}
    // wrapper, or a flat array of player records (e.g. data/players.json, merged from those
    // pages by tools/HoshiBot.StfcSeedSync) — sniffed by the first non-whitespace token.
    private static async Task<List<StfcPlayerImportEntry>> ParseFileAsync(IBrowserFile file)
    {
        await using var raw = file.OpenReadStream(maxAllowedSize: 20_000_000);
        var buffered = new MemoryStream();
        await raw.CopyToAsync(buffered);
        buffered.Position = 0;

        var isGzip = buffered.Length >= 2 && buffered.ReadByte() == 0x1F && buffered.ReadByte() == 0x8B;
        buffered.Position = 0;

        await using Stream jsonStream = isGzip ? new GZipStream(buffered, CompressionMode.Decompress) : buffered;
        using var doc = await JsonDocument.ParseAsync(jsonStream);

        var records = doc.RootElement.ValueKind == JsonValueKind.Array
            ? doc.RootElement.EnumerateArray()
            : doc.RootElement.GetProperty("players").EnumerateArray().Select(p => p.GetProperty("data"));

        return records.Select(ToEntry).ToList();
    }

    // "owner" is the player's in-game display name — "name" on the same record is the
    // alliance's name (parallel to "tag"), not the player's; using "name" here was a
    // real bug that silently stored every imported player's alliance name as their own.
    private static StfcPlayerImportEntry ToEntry(JsonElement p) => new(
        p.GetProperty("playerid").GetInt64(),
        p.TryGetProperty("owner", out var owner) ? owner.GetString() : null,
        p.TryGetProperty("tag", out var tag) && tag.ValueKind == JsonValueKind.String ? tag.GetString() : null,
        p.GetProperty("server").GetInt32(),
        p.GetProperty("rankid").GetInt32(),
        p.GetProperty("level").GetInt32());
}
