@page "/manage/stfc/players"
@inherits DbContextPageBase

<PageTitle>Players</PageTitle>

<h1>Players</h1>
<p>One-time seed snapshot, not a live sync by default — see StfcPlayerSeedData. Use <a href="manage/stfc/players/import">Import</a> to bring in a fresh roster (incl. rank/Ops level) for a server.</p>

<QuickGrid Class="table" Items="Context.StfcPlayers.Include(p => p.Server).ThenInclude(s => s.Region).Include(p => p.Alliance).OrderBy(p => p.ServerId).ThenBy(p => p.Name)" Pagination="pagination">
    <PropertyColumn Property="player => player.Name" Sortable="true" />
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real ServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcPlayer>.ByAscending(p => p.ServerId))" Context="player">
        @player.Server.DisplayName
    </TemplateColumn>
    <TemplateColumn Title="Alliance" Context="player">
        @(player.Alliance?.Tag ?? "—")
    </TemplateColumn>
    <TemplateColumn Title="Rank" Sortable="true" SortBy="@(GridSort<StfcPlayer>.ByAscending(p => p.Rank))" Context="player">
        @(player.Rank?.ToString() ?? "—")
    </TemplateColumn>
    <TemplateColumn Title="Ops Level" Sortable="true" SortBy="@(GridSort<StfcPlayer>.ByAscending(p => p.OpsLevel))" Context="player">
        @(player.OpsLevel is { } level ? $"{level} ({StfcOpsGroupExtensions.FromLevel(level)?.ToString() ?? "—"})" : "—")
    </TemplateColumn>

    <TemplateColumn Context="player">
        <a href="@($"manage/stfc/players/edit?id={player.Id}")">Edit</a> |
        <a href="@($"manage/stfc/players/delete?id={player.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
