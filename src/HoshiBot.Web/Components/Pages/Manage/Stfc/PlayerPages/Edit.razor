@page "/manage/stfc/players/edit"
@inherits EntityEditPageBase<StfcPlayer, int>

<PageTitle>Edit Player</PageTitle>

<h1>Edit Player</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <input type="hidden" name="Entity.ServerId" value="@Entity.ServerId" />
                <input type="hidden" name="Entity.ExternalId" value="@Entity.ExternalId" />
                <div class="mb-3">
                    <label class="form-label">External ID:</label>
                    <p class="form-control-plaintext">@Entity.ExternalId</p>
                </div>
                <div class="mb-3">
                    <label class="form-label">Server:</label>
                    <p class="form-control-plaintext">@serverName</p>
                </div>
                <FormField For="name" Label="Name:" Required>
                    <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Name" class="text-danger" />
                </FormField>
                <FormField For="alliance" Label="Alliance:">
                    <InputSelect id="alliance" @bind-Value="Entity.AllianceId" class="form-control">
                        <option value="">Unaffiliated</option>
                        @foreach (var alliance in alliances)
                        {
                            <option value="@alliance.Id">@alliance.Tag - @alliance.Name</option>
                        }
                    </InputSelect>
                </FormField>
                <FormField For="rank" Label="Rank:">
                    <InputSelect id="rank" @bind-Value="Entity.Rank" class="form-control">
                        <option value="">— none —</option>
                        @foreach (var rank in Enum.GetValues<StfcPlayerRank>())
                        {
                            <option value="@rank">@rank</option>
                        }
                    </InputSelect>
                </FormField>
                <FormField For="opsLevel" Label="Ops Level:">
                    <InputNumber id="opsLevel" @bind-Value="Entity.OpsLevel" class="form-control" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/players">Back to List</a>
</div>

@code {
    private string? serverName;
    private List<StfcAlliance> alliances = [];

    protected override string ListHref => "/manage/stfc/players";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (Entity is null)
            return;

        using var context = DbFactory.CreateDbContext();
        serverName = await context.StfcServers
            .Include(s => s.Region)
            .Where(s => s.Id == Entity.ServerId)
            .Select(s => s.DisplayName)
            .FirstOrDefaultAsync();

        alliances = await context.StfcAlliances
            .Where(a => a.ServerId == Entity.ServerId)
            .OrderBy(a => a.Tag)
            .AsNoTracking()
            .ToListAsync();
    }

    protected override Task<StfcPlayer?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcPlayers.FirstOrDefaultAsync(p => p.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcPlayers.AnyAsync(p => p.Id == id);
}
