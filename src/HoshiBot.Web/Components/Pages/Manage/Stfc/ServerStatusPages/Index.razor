@page "/manage/stfc/server-status"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>Server Status</PageTitle>

<h1>Server Status</h1>
<p>
    One-time seed snapshot, not a live sync (see StfcServerStatusSeedData) — read-only here.
    Status/Maintenance is what was last observed; Notified* is what ServerStatusNotifyJob last announced to Discord.
</p>

<QuickGrid Class="table" Items="context.StfcServerStatuses.Include(s => s.StfcServer).ThenInclude(s => s.Region).OrderBy(s => s.StfcServerId)" Pagination="pagination">
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real StfcServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcServerStatus>.ByAscending(s => s.StfcServerId))" Context="status">
        @status.StfcServer.DisplayName
    </TemplateColumn>
    <PropertyColumn Property="status => status.Status" Sortable="true" />
    <PropertyColumn Property="status => status.Maintenance" Sortable="true" />
    @* Not sortable — UpdatedAt is a DateTimeOffset, which SQLite's EF provider can't
       translate in ORDER BY. *@
    <PropertyColumn Property="status => status.UpdatedAt" />
    <PropertyColumn Property="status => status.NotifiedStatus" Title="Notified Status" Sortable="true" />
    <PropertyColumn Property="status => status.NotifiedMaintenance" Title="Notified Maintenance" Sortable="true" />
</QuickGrid>

<Paginator State="pagination" />

@code {
    private HoshiBotDbContext context = default!;
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
