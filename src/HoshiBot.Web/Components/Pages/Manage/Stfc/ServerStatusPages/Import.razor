@page "/manage/stfc/server-status/import"
@using System.Text.Json
@using HoshiBot.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject StfcServerStatusImportService ImportService

<PageTitle>Import Server Status</PageTitle>

<h1>Import Server Status</h1>
<p>
    Upload a fresh server-status snapshot (e.g. <code>data/server-status.json</code>). Existing
    rows have their observed Status/Maintenance updated — the Notified* columns are left alone
    so <code>ServerStatusNotifyJob</code> can detect and announce the change. A server seen for
    the first time gets Notified* set equal to the observed values, so it doesn't trigger a false
    "just changed" announcement.
</p>

<ImportForm TResult="StfcServerStatusImportResult" Import="ImportAsync">
    <ResultTemplate Context="r">
        <p class="mt-3">
            Added @r.Added, updated @r.Updated. Skipped @r.UnknownServer (unknown server).
        </p>
    </ResultTemplate>
</ImportForm>

@code {
    private async Task<StfcServerStatusImportResult> ImportAsync(IReadOnlyCollection<UploadFile> files)
    {
        var file = files.FirstOrDefault()?.File
            ?? throw new InvalidOperationException("No file was uploaded.");
        var entries = await ParseFileAsync(file);
        return await ImportService.ImportAsync(entries);
    }

    private static async Task<List<StfcServerStatusImportEntry>> ParseFileAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
        using var doc = await JsonDocument.ParseAsync(stream);

        return doc.RootElement.EnumerateArray()
            .Select(e => new StfcServerStatusImportEntry(
                e.GetProperty("id").GetInt32(),
                e.GetProperty("status").GetInt32(),
                e.GetProperty("maintenance").GetString() ?? "0"))
            .ToList();
    }
}
