@page "/manage/stfc/servers/edit"
@inherits EntityEditPageBase<StfcServer, int>

<PageTitle>Edit Server</PageTitle>

<h1>Edit Server</h1>
<hr />
@if (Entity is null)
{
    <LoadingPlaceholder />
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <div class="mb-3">
                    <label class="form-label">Server Number (ID):</label>
                    <p class="form-control-plaintext">@Entity.Id</p>
                </div>
                <FormField For="name" Label="Name:" Required>
                    <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Name" class="text-danger" />
                </FormField>
                <FormField For="region" Label="Region:" Required>
                    <InputSelect id="region" @bind-Value="Entity.RegionId" class="form-control">
                        @foreach (var region in regions)
                        {
                            <option value="@region.Id">@region.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.RegionId" class="text-danger" />
                </FormField>
                <FormField For="veilGroup" Label="Veil Group:">
                    <InputSelect id="veilGroup" @bind-Value="Entity.VeilGroupId" class="form-control">
                        <option value="">No veil group (new/unclassified)</option>
                        @foreach (var veilGroup in veilGroups)
                        {
                            <option value="@veilGroup.Id">@veilGroup.Name</option>
                        }
                    </InputSelect>
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>

    <h2>Discord Invites</h2>
    <table class="table">
        <thead><tr><th>Url</th><th></th></tr></thead>
        <tbody>
            @foreach (var invite in invites)
            {
                <tr>
                    <td>@invite.Url</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => RemoveInviteAsync(invite)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <EditForm Model="this" FormName="add-invite" OnValidSubmit="AddInviteAsync">
        <input type="text" class="form-control d-inline-block w-auto" @bind="newInviteUrl" placeholder="https://discord.gg/..." />
        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>
}

<div>
    <a href="/manage/stfc/servers">Back to List</a>
</div>

@code {
    private List<StfcRegion> regions = [];
    private List<StfcVeilGroup> veilGroups = [];
    private List<StfcServerDiscordInvite> invites = [];
    private string? newInviteUrl;

    protected override string ListHref => "/manage/stfc/servers";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        regions = await context.StfcRegions.AsNoTracking().ToListAsync();
        veilGroups = await context.StfcVeilGroups.AsNoTracking().ToListAsync();
        await base.OnInitializedAsync();

        if (Entity is null)
            return;

        await LoadInvitesAsync();
    }

    protected override Task<StfcServer?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcServers.FirstOrDefaultAsync(s => s.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcServers.AnyAsync(s => s.Id == id);

    private async Task LoadInvitesAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invites = await context.StfcServerDiscordInvites.Where(i => i.ServerId == Id).AsNoTracking().ToListAsync();
    }

    private async Task AddInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(newInviteUrl))
            return;

        using var context = DbFactory.CreateDbContext();
        context.StfcServerDiscordInvites.Add(new StfcServerDiscordInvite { ServerId = Id, Url = newInviteUrl });
        await context.SaveChangesAsync();

        newInviteUrl = null;
        await LoadInvitesAsync();
    }

    private async Task RemoveInviteAsync(StfcServerDiscordInvite invite)
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcServerDiscordInvites.Remove(invite);
        await context.SaveChangesAsync();
        await LoadInvitesAsync();
    }
}
