@page "/manage/stfc/servers"
@inherits DbContextPageBase

<PageTitle>Servers</PageTitle>

<h1>Servers</h1>

<p>
    <a href="manage/stfc/servers/create">Create New</a> |
    <a href="manage/stfc/servers/import">Import</a>
</p>

<QuickGrid Class="table" Items="Context.StfcServers.Include(s => s.Region).Include(s => s.VeilGroup).OrderBy(s => s.Id)" Pagination="pagination">
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real Id column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcServer>.ByAscending(s => s.Id))" Context="server">
        @server.DisplayName
    </TemplateColumn>
    <TemplateColumn Title="Veil Group" Context="server">
        @(server.VeilGroup?.Name ?? "Unassigned")
    </TemplateColumn>

    <TemplateColumn Context="server">
        <a href="@($"manage/stfc/servers/edit?id={server.Id}")">Edit</a> |
        <a href="@($"manage/stfc/servers/delete?id={server.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

<PoweredBy For="@(new[] { typeof(StfcServer) })" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
