@page "/manage/stfc/servers/delete"
@inherits EntityDeletePageBase<StfcServer, int>

<DeleteConfirmation EntityName="Server" BackHref="/manage/stfc/servers" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Number</dt>
    <dd class="col-sm-10">@Entity!.Id</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
    <dt class="col-sm-2">Region</dt>
    <dd class="col-sm-10">@Entity!.Region.Name</dd>
    <dt class="col-sm-2">Veil Group</dt>
    <dd class="col-sm-10">@(Entity!.VeilGroup?.Name ?? "Unassigned")</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/servers";

    protected override Task<StfcServer?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcServers
            .Include(s => s.Region)
            .Include(s => s.VeilGroup)
            .FirstOrDefaultAsync(s => s.Id == id);
}
