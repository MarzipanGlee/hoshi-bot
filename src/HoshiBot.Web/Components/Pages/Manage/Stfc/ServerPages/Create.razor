@page "/manage/stfc/servers/create"
@inherits EntityCreatePageBase<StfcServer>

<PageTitle>Create Server</PageTitle>

<h1>Create Server</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddServer" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="number" Label="Server Number (ID):" Required>
                <InputNumber id="number" @bind-Value="Entity.Id" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Id" class="text-danger" />
            </FormField>
            <FormField For="name" Label="Name:" Required>
                <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Name" class="text-danger" />
            </FormField>
            <FormField For="region" Label="Region:" Required>
                <InputSelect id="region" @bind-Value="Entity.RegionId" class="form-control">
                    <option value="0">Select region...</option>
                    @foreach (var region in regions)
                    {
                        <option value="@region.Id">@region.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.RegionId" class="text-danger" />
            </FormField>
            <FormField For="veilGroup" Label="Veil Group:">
                <InputSelect id="veilGroup" @bind-Value="Entity.VeilGroupId" class="form-control">
                    <option value="">No veil group (new/unclassified)</option>
                    @foreach (var veilGroup in veilGroups)
                    {
                        <option value="@veilGroup.Id">@veilGroup.Name</option>
                    }
                </InputSelect>
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/servers">Back to List</a>
</div>

@code {
    private List<StfcRegion> regions = [];
    private List<StfcVeilGroup> veilGroups = [];

    protected override string ListHref => "/manage/stfc/servers";

    protected override StfcServer CreateNew() => new() { Name = "" };

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        regions = await context.StfcRegions.AsNoTracking().ToListAsync();
        veilGroups = await context.StfcVeilGroups.AsNoTracking().ToListAsync();
    }

    private async Task AddServer()
    {
        if (Entity.RegionId == 0)
            return;

        await AddAsync();
    }
}
