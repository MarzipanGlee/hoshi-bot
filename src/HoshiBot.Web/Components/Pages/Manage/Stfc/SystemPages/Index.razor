@page "/manage/stfc/systems"
@inherits DbContextPageBase

<PageTitle>Systems</PageTitle>

<h1>Systems</h1>
<p>Synced daily from stfc.space by StfcSystemSyncService — read-only here, no manual edits (they'd just get overwritten on the next sync).</p>

<QuickGrid Class="table" Items="Context.StfcSystems.OrderBy(s => s.Number)" Pagination="pagination">
    <PropertyColumn Property="system => system.Number" Sortable="true" />
    <PropertyColumn Property="system => system.Name" Sortable="true" />
    <PropertyColumn Title="Station Housing" Property="system => system.HasStationHousing" Sortable="true" />
</QuickGrid>

<Paginator State="pagination" />

<PoweredBy For="@(new[] { typeof(StfcSystem) })" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
