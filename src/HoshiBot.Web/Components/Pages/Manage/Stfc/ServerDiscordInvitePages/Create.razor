@page "/manage/stfc/server-invites/create"
@inherits EntityCreatePageBase<StfcServerDiscordInvite>

<PageTitle>Create Server Discord Invite</PageTitle>

<h1>Create Server Discord Invite</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddInvite" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="server" Label="Server:" Required>
                <InputSelect id="server" @bind-Value="Entity.ServerId" class="form-control">
                    <option value="0">Select server...</option>
                    @foreach (var server in servers)
                    {
                        <option value="@server.Id">@server.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.ServerId" class="text-danger" />
            </FormField>
            <FormField For="url" Label="Invite URL:" Required>
                <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Url" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/server-invites">Back to List</a>
</div>

@code {
    private List<StfcServer> servers = [];

    protected override string ListHref => "/manage/stfc/server-invites";

    protected override StfcServerDiscordInvite CreateNew() => new() { Url = "" };

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servers = await context.StfcServers.Include(s => s.Region).AsNoTracking().OrderBy(s => s.Name).ToListAsync();
    }

    private async Task AddInvite()
    {
        if (Entity.ServerId == 0)
            return;

        await AddAsync();
    }
}
