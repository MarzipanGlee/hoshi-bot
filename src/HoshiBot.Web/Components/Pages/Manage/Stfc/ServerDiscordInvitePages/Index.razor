@page "/manage/stfc/server-invites"
@inherits DbContextPageBase

<PageTitle>Server Discord Invites</PageTitle>

<h1>Server Discord Invites</h1>

<p>
    <a href="manage/stfc/server-invites/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Context.StfcServerDiscordInvites.Include(i => i.Server).Include(i => i.Server.Region).OrderBy(i => i.Server.Name)">
    <PropertyColumn Property="invite => invite.Server.DisplayName" Title="Server" Sortable="true" />
    <PropertyColumn Property="invite => invite.Url" Sortable="true" />

    <TemplateColumn Context="invite">
        <a href="@($"manage/stfc/server-invites/edit?id={invite.Id}")">Edit</a> |
        <a href="@($"manage/stfc/server-invites/delete?id={invite.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>
