@page "/manage/stfc/server-invites/edit"
@inherits EntityEditPageBase<StfcServerDiscordInvite, int>

<PageTitle>Edit Server Discord Invite</PageTitle>

<h1>Edit Server Discord Invite</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="server" Label="Server:" Required>
                    <InputSelect id="server" @bind-Value="Entity.ServerId" class="form-control">
                        @foreach (var server in servers)
                        {
                            <option value="@server.Id">@server.DisplayName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.ServerId" class="text-danger" />
                </FormField>
                <FormField For="url" Label="Invite URL:" Required>
                    <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Url" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/server-invites">Back to List</a>
</div>

@code {
    private List<StfcServer> servers = [];

    protected override string ListHref => "/manage/stfc/server-invites";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servers = await context.StfcServers.Include(s => s.Region).AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        await base.OnInitializedAsync();
    }

    protected override Task<StfcServerDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcServerDiscordInvites.FirstOrDefaultAsync(i => i.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcServerDiscordInvites.AnyAsync(i => i.Id == id);
}
