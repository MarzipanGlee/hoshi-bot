@page "/manage/stfc/server-invites/edit"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Server Discord Invite</PageTitle>

<h1>Edit Server Discord Invite</h1>
<hr />
@if (Invite is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Invite" OnValidSubmit="UpdateInvite" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Invite.Id" value="@Invite.Id" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="server" class="form-label">Server:</label>
                    <InputSelect id="server" @bind-Value="Invite.ServerId" class="form-control">
                        @foreach (var server in servers)
                        {
                            <option value="@server.Id">@server.DisplayName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Invite.ServerId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="url" class="form-label">Invite URL:</label>
                    <InputText id="url" @bind-Value="Invite.Url" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Invite.Url" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/server-invites">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private StfcServerDiscordInvite? Invite { get; set; }

    private List<StfcServer> servers = [];

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servers = await context.StfcServers.Include(s => s.Region).AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        Invite ??= await context.StfcServerDiscordInvites.FirstOrDefaultAsync(i => i.Id == Id);

        if (Invite is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateInvite()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Invite!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!await InviteExistsAsync(Invite!.Id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/manage/stfc/server-invites");
    }

    private async Task<bool> InviteExistsAsync(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return await context.StfcServerDiscordInvites.AnyAsync(i => i.Id == id);
    }
}
