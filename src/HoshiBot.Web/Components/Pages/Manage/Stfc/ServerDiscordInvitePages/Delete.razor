@page "/manage/stfc/server-invites/delete"
@inherits EntityDeletePageBase<StfcServerDiscordInvite, int>

<DeleteConfirmation EntityName="Server Discord Invite" BackHref="/manage/stfc/server-invites" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Server</dt>
    <dd class="col-sm-10">@Entity!.Server.DisplayName</dd>
    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@Entity!.Url</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/server-invites";

    protected override Task<StfcServerDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcServerDiscordInvites
            .Include(i => i.Server)
            .Include(i => i.Server.Region)
            .FirstOrDefaultAsync(i => i.Id == id);
}
