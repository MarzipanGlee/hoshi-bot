@page "/manage/stfc/server-invites/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<DeleteConfirmation EntityName="Server Discord Invite" BackHref="/manage/stfc/server-invites" Loaded="invite is not null" OnConfirm="DeleteInvite">
    <dt class="col-sm-2">Server</dt>
    <dd class="col-sm-10">@invite!.Server.DisplayName</dd>
    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@invite!.Url</dd>
</DeleteConfirmation>

@code {
    private StfcServerDiscordInvite? invite;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invite = await context.StfcServerDiscordInvites
            .Include(i => i.Server)
            .Include(i => i.Server.Region)
            .FirstOrDefaultAsync(i => i.Id == Id);

        if (invite is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteInvite()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcServerDiscordInvites.Remove(invite!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/server-invites");
    }
}
