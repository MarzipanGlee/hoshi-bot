@page "/manage/stfc/event-status"
@inherits DbContextPageBase

<PageTitle>Event Status</PageTitle>

<h1>Event Status</h1>
<p>
    One-time seed snapshot, not a live sync (see StfcEventStatusSeedData) — read-only here.
    Only "incursions" is currently acted on by InfiniteIncursionsNotifyJob; NotifiedEventStart is what it last announced.
</p>

<QuickGrid Class="table" Items="Context.StfcEventStatuses.OrderBy(e => e.EventGroup)">
    <PropertyColumn Property="status => status.EventGroup" Sortable="true" />
    <PropertyColumn Property="status => status.EventStart" Sortable="true" />
    <PropertyColumn Property="status => status.EventEnd" Sortable="true" />
    <PropertyColumn Property="status => status.Active" Sortable="true" />
    <PropertyColumn Property="status => status.UpdatedAt" Sortable="true" />
    <PropertyColumn Property="status => status.NotifiedEventStart" Title="Notified Event Start" Sortable="true" />
</QuickGrid>

<PoweredBy For="@(new[] { typeof(StfcEventStatus) })" />
