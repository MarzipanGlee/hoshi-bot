@page "/manage/stfc/alliance-name-history"
@inherits DbContextPageBase

<PageTitle>Alliance Name History</PageTitle>

<h1>Alliance Name History</h1>
<p>Read-only audit trail — one row per (Tag, Name) an alliance has been observed under. Most recent first.</p>

@* Ordered by Id, not ObservedAt — append-only, so Id already reflects insertion order. *@
<QuickGrid Class="table" Items="Context.StfcAllianceNameHistories.Include(h => h.StfcAlliance).ThenInclude(a => a.Server).ThenInclude(s => s.Region).OrderByDescending(h => h.Id)" Pagination="pagination">
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real ServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcAllianceNameHistory>.ByAscending(h => h.StfcAlliance.ServerId))" Context="h">
        @h.StfcAlliance.Server.DisplayName
    </TemplateColumn>
    <PropertyColumn Property="h => h.Tag" Sortable="true" />
    <PropertyColumn Property="h => h.Name" Sortable="true" />
    <PropertyColumn Property="h => h.ObservedAt" Sortable="true" />
    <TemplateColumn Title="Current Alliance" Context="h">
        <a href="@($"manage/stfc/alliances/edit?id={h.StfcAllianceId}")">@h.StfcAlliance.Tag - @h.StfcAlliance.Name</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

<PoweredBy For="@(new[] { typeof(StfcAllianceNameHistory) })" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
