@page "/manage/stfc/territory-neighbours/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<DeleteConfirmation EntityName="Territory Neighbour" BackHref="/manage/stfc/territory-neighbours" Loaded="neighbour is not null" OnConfirm="DeleteNeighbour">
    <dt class="col-sm-2">Territory</dt>
    <dd class="col-sm-10">@neighbour!.Territory.Name</dd>
    <dt class="col-sm-2">Neighbour</dt>
    <dd class="col-sm-10">@neighbour!.NeighbourTerritory.Name</dd>
</DeleteConfirmation>

@code {
    private StfcTerritoryNeighbour? neighbour;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        neighbour = await context.StfcTerritoryNeighbours
            .Include(n => n.Territory)
            .Include(n => n.NeighbourTerritory)
            .FirstOrDefaultAsync(n => n.Id == Id);

        if (neighbour is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteNeighbour()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcTerritoryNeighbours.Remove(neighbour!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/territory-neighbours");
    }
}
