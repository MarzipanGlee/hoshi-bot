@page "/manage/stfc/territory-neighbours/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Territory Neighbour</PageTitle>

<h1>Delete Territory Neighbour</h1>

<p>Are you sure you want to delete this?</p>
<div>
    @if (neighbour is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Territory</dt>
            <dd class="col-sm-10">@neighbour.Territory.Name</dd>
            <dt class="col-sm-2">Neighbour</dt>
            <dd class="col-sm-10">@neighbour.NeighbourTerritory.Name</dd>
        </dl>
        <EditForm method="post" Model="neighbour" OnValidSubmit="DeleteNeighbour" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/manage/stfc/territory-neighbours">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private StfcTerritoryNeighbour? neighbour;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        neighbour = await context.StfcTerritoryNeighbours
            .Include(n => n.Territory)
            .Include(n => n.NeighbourTerritory)
            .FirstOrDefaultAsync(n => n.Id == Id);

        if (neighbour is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteNeighbour()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcTerritoryNeighbours.Remove(neighbour!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/territory-neighbours");
    }
}
