@page "/manage/stfc/territory-neighbours/delete"
@inherits EntityDeletePageBase<StfcTerritoryNeighbour, int>

<DeleteConfirmation EntityName="Territory Neighbour" BackHref="/manage/stfc/territory-neighbours" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Territory</dt>
    <dd class="col-sm-10">@Entity!.Territory.Name</dd>
    <dt class="col-sm-2">Neighbour</dt>
    <dd class="col-sm-10">@Entity!.NeighbourTerritory.Name</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/territory-neighbours";

    protected override Task<StfcTerritoryNeighbour?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcTerritoryNeighbours
            .Include(n => n.Territory)
            .Include(n => n.NeighbourTerritory)
            .FirstOrDefaultAsync(n => n.Id == id);
}
