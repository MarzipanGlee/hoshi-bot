@page "/manage/stfc/territory-neighbours/edit"
@inherits EntityEditPageBase<StfcTerritoryNeighbour, int>

<PageTitle>Edit Territory Neighbour</PageTitle>

<h1>Edit Territory Neighbour</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="territory" Label="Territory:" Required>
                    <InputSelect id="territory" @bind-Value="Entity.TerritoryId" class="form-control">
                        @foreach (var territory in territories)
                        {
                            <option value="@territory.Id">@territory.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.TerritoryId" class="text-danger" />
                </FormField>
                <FormField For="neighbourTerritory" Label="Neighbour Territory:" Required>
                    <InputSelect id="neighbourTerritory" @bind-Value="Entity.NeighbourTerritoryId" class="form-control">
                        @foreach (var territory in territories)
                        {
                            <option value="@territory.Id">@territory.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.NeighbourTerritoryId" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/territory-neighbours">Back to List</a>
</div>

@code {
    private List<StfcTerritory> territories = [];

    protected override string ListHref => "/manage/stfc/territory-neighbours";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        territories = await context.StfcTerritories.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        await base.OnInitializedAsync();
    }

    protected override Task<StfcTerritoryNeighbour?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcTerritoryNeighbours.FirstOrDefaultAsync(n => n.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcTerritoryNeighbours.AnyAsync(n => n.Id == id);
}
