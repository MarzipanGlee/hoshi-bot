@page "/manage/stfc/territory-neighbours/create"
@inherits EntityCreatePageBase<StfcTerritoryNeighbour>

<PageTitle>Create Territory Neighbour</PageTitle>

<h1>Create Territory Neighbour</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddNeighbour" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="territory" Label="Territory:" Required>
                <InputSelect id="territory" @bind-Value="Entity.TerritoryId" class="form-control">
                    <option value="0">Select territory...</option>
                    @foreach (var territory in territories)
                    {
                        <option value="@territory.Id">@territory.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.TerritoryId" class="text-danger" />
            </FormField>
            <FormField For="neighbourTerritory" Label="Neighbour Territory:" Required>
                <InputSelect id="neighbourTerritory" @bind-Value="Entity.NeighbourTerritoryId" class="form-control">
                    <option value="0">Select territory...</option>
                    @foreach (var territory in territories)
                    {
                        <option value="@territory.Id">@territory.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.NeighbourTerritoryId" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/territory-neighbours">Back to List</a>
</div>

@code {
    private List<StfcTerritory> territories = [];

    protected override string ListHref => "/manage/stfc/territory-neighbours";

    protected override StfcTerritoryNeighbour CreateNew() => new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        territories = await context.StfcTerritories.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
    }

    private async Task AddNeighbour()
    {
        if (Entity.TerritoryId == 0 || Entity.NeighbourTerritoryId == 0)
            return;

        await AddAsync();
    }
}
