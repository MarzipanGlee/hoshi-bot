@page "/manage/stfc/territories/delete"
@inherits EntityDeletePageBase<StfcTerritory, int>

<DeleteConfirmation EntityName="Territory" BackHref="/manage/stfc/territories" Loaded="Entity is not null" OnConfirm="DeleteAsync"
                    Warning="Linked systems, neighbour links, and ownership rows are removed too.">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
    <dt class="col-sm-2">Tier</dt>
    <dd class="col-sm-10">@Entity!.Tier</dd>
    <dt class="col-sm-2">Weekday</dt>
    <dd class="col-sm-10">@(Entity!.Weekday?.ToString() ?? "Unknown")</dd>
    <dt class="col-sm-2">Capture Time (UTC)</dt>
    <dd class="col-sm-10">@(Entity!.CaptureTimeUtc?.ToString("HH:mm") ?? "Unknown")</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/territories";

    protected override Task<StfcTerritory?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcTerritories.FirstOrDefaultAsync(t => t.Id == id);
}
