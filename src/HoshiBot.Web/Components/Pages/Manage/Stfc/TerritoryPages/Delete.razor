@page "/manage/stfc/territories/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<DeleteConfirmation EntityName="Territory" BackHref="/manage/stfc/territories" Loaded="territory is not null" OnConfirm="DeleteTerritory"
                    Warning="Linked systems, neighbour links, and ownership rows are removed too.">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@territory!.Name</dd>
    <dt class="col-sm-2">Tier</dt>
    <dd class="col-sm-10">@territory!.Tier</dd>
    <dt class="col-sm-2">Weekday</dt>
    <dd class="col-sm-10">@(territory!.Weekday?.ToString() ?? "Unknown")</dd>
    <dt class="col-sm-2">Capture Time (UTC)</dt>
    <dd class="col-sm-10">@(territory!.CaptureTimeUtc?.ToString("HH:mm") ?? "Unknown")</dd>
</DeleteConfirmation>

@code {
    private StfcTerritory? territory;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        territory = await context.StfcTerritories.FirstOrDefaultAsync(t => t.Id == Id);

        if (territory is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteTerritory()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcTerritories.Remove(territory!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/territories");
    }
}
