@page "/manage/stfc/territories"
@inherits DbContextPageBase

<PageTitle>Territories</PageTitle>

<h1>Territories</h1>

<p>
    <a href="manage/stfc/territories/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Context.StfcTerritories.OrderBy(t => t.Name)">
    <PropertyColumn Property="territory => territory.Id" Sortable="true" />
    <PropertyColumn Property="territory => territory.Name" Sortable="true" />
    <PropertyColumn Property="territory => territory.Tier" Sortable="true" />
    <TemplateColumn Title="Weekday" Context="territory">
        @(territory.Weekday?.ToString() ?? "Unknown")
    </TemplateColumn>
    <TemplateColumn Title="Capture Time (UTC)" Context="territory">
        @(territory.CaptureTimeUtc?.ToString("HH:mm") ?? "Unknown")
    </TemplateColumn>

    <TemplateColumn Context="territory">
        <a href="@($"manage/stfc/territories/edit?id={territory.Id}")">Edit</a> |
        <a href="@($"manage/stfc/territories/delete?id={territory.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<PoweredBy For="@(new[] { typeof(StfcTerritory) })" />
