@page "/manage/stfc/regions/create"
@inherits EntityCreatePageBase<StfcRegion>

<PageTitle>Create Region</PageTitle>

<h1>Create Region</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddAsync" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="id" Label="Id (matches Scopely's region numbering):" Required>
                <InputNumber id="id" @bind-Value="Entity.Id" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Id" class="text-danger" />
            </FormField>
            <FormField For="name" Label="Name:" Required>
                <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Name" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/regions">Back to List</a>
</div>

@code {
    protected override string ListHref => "/manage/stfc/regions";

    protected override StfcRegion CreateNew() => new() { Name = "" };
}
