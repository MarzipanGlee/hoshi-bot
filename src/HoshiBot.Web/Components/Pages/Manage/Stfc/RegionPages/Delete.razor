@page "/manage/stfc/regions/delete"
@inherits EntityDeletePageBase<StfcRegion, int>

<DeleteConfirmation EntityName="Region" BackHref="/manage/stfc/regions" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/regions";

    protected override Task<StfcRegion?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcRegions.FirstOrDefaultAsync(r => r.Id == id);
}
