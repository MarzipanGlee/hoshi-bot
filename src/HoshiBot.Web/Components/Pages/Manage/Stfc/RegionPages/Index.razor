@page "/manage/stfc/regions"
@inherits DbContextPageBase

<PageTitle>Regions</PageTitle>

<h1>Regions</h1>

<p>
    <a href="manage/stfc/regions/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Context.StfcRegions.OrderBy(r => r.Name)">
    <PropertyColumn Property="region => region.Id" Sortable="true" />
    <PropertyColumn Property="region => region.Name" Sortable="true" />

    <TemplateColumn Context="region">
        <a href="@($"manage/stfc/regions/edit?id={region.Id}")">Edit</a> |
        <a href="@($"manage/stfc/regions/delete?id={region.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>
