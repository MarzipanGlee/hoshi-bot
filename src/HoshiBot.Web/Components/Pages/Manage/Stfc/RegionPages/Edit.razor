@page "/manage/stfc/regions/edit"
@inherits EntityEditPageBase<StfcRegion, int>

<PageTitle>Edit Region</PageTitle>

<h1>Edit Region</h1>
<hr />
@if (Entity is null)
{
    <LoadingPlaceholder />
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="name" Label="Name:" Required>
                    <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Name" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/regions">Back to List</a>
</div>

@code {
    protected override string ListHref => "/manage/stfc/regions";

    protected override Task<StfcRegion?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcRegions.FirstOrDefaultAsync(r => r.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcRegions.AnyAsync(r => r.Id == id);
}
