@page "/manage/stfc/alliance-invites/delete"
@inherits EntityDeletePageBase<StfcAllianceDiscordInvite, int>

<DeleteConfirmation EntityName="Alliance Discord Invite" BackHref="/manage/stfc/alliance-invites" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Alliance</dt>
    <dd class="col-sm-10">@Entity!.Alliance.Tag (@Entity!.Alliance.Server.DisplayName)</dd>
    <dt class="col-sm-2">Url</dt>
    <dd class="col-sm-10">@Entity!.Url</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/alliance-invites";

    protected override Task<StfcAllianceDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiscordInvites
            .Include(i => i.Alliance)
            .Include(i => i.Alliance.Server)
            .Include(i => i.Alliance.Server.Region)
            .FirstOrDefaultAsync(i => i.Id == id);
}
