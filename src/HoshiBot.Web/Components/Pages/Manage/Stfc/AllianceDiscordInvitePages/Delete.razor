@page "/manage/stfc/alliance-invites/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Alliance Discord Invite</PageTitle>

<h1>Delete Alliance Discord Invite</h1>

<p>Are you sure you want to delete this?</p>
<div>
    @if (invite is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Alliance</dt>
            <dd class="col-sm-10">@invite.Alliance.Tag (@invite.Alliance.Server.DisplayName)</dd>
            <dt class="col-sm-2">Url</dt>
            <dd class="col-sm-10">@invite.Url</dd>
        </dl>
        <EditForm method="post" Model="invite" OnValidSubmit="DeleteInvite" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/manage/stfc/alliance-invites">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private StfcAllianceDiscordInvite? invite;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invite = await context.StfcAllianceDiscordInvites
            .Include(i => i.Alliance)
            .Include(i => i.Alliance.Server)
            .Include(i => i.Alliance.Server.Region)
            .FirstOrDefaultAsync(i => i.Id == Id);

        if (invite is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteInvite()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcAllianceDiscordInvites.Remove(invite!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/alliance-invites");
    }
}
