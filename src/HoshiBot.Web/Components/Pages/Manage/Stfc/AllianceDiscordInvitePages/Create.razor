@page "/manage/stfc/alliance-invites/create"
@inherits EntityCreatePageBase<StfcAllianceDiscordInvite>

<PageTitle>Create Alliance Discord Invite</PageTitle>

<h1>Create Alliance Discord Invite</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddInvite" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="alliance" Label="Alliance:" Required>
                <InputSelect id="alliance" @bind-Value="Entity.AllianceId" class="form-control">
                    <option value="0">Select alliance...</option>
                    @foreach (var alliance in alliances)
                    {
                        <option value="@alliance.Id">@alliance.Tag (@alliance.Server.DisplayName)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.AllianceId" class="text-danger" />
            </FormField>
            <FormField For="url" Label="Invite URL:" Required>
                <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Url" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/alliance-invites">Back to List</a>
</div>

@code {
    private List<StfcAlliance> alliances = [];

    protected override string ListHref => "/manage/stfc/alliance-invites";

    protected override StfcAllianceDiscordInvite CreateNew() => new() { Url = "" };

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        alliances = await context.StfcAlliances.Include(a => a.Server).ThenInclude(s => s.Region).AsNoTracking().OrderBy(a => a.Tag).ToListAsync();
    }

    private async Task AddInvite()
    {
        if (Entity.AllianceId == 0)
            return;

        await AddAsync();
    }
}
