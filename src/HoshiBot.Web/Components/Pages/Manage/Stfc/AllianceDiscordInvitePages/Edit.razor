@page "/manage/stfc/alliance-invites/edit"
@inherits EntityEditPageBase<StfcAllianceDiscordInvite, int>

<PageTitle>Edit Alliance Discord Invite</PageTitle>

<h1>Edit Alliance Discord Invite</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="alliance" Label="Alliance:" Required>
                    <InputSelect id="alliance" @bind-Value="Entity.AllianceId" class="form-control">
                        @foreach (var alliance in alliances)
                        {
                            <option value="@alliance.Id">@alliance.Tag (@alliance.Server.DisplayName)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.AllianceId" class="text-danger" />
                </FormField>
                <FormField For="url" Label="Invite URL:" Required>
                    <InputText id="url" @bind-Value="Entity.Url" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Url" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/manage/stfc/alliance-invites">Back to List</a>
</div>

@code {
    private List<StfcAlliance> alliances = [];

    protected override string ListHref => "/manage/stfc/alliance-invites";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        alliances = await context.StfcAlliances.Include(a => a.Server).ThenInclude(s => s.Region).AsNoTracking().OrderBy(a => a.Tag).ToListAsync();
        await base.OnInitializedAsync();
    }

    protected override Task<StfcAllianceDiscordInvite?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiscordInvites.FirstOrDefaultAsync(i => i.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcAllianceDiscordInvites.AnyAsync(i => i.Id == id);
}
