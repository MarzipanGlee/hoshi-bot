@page "/manage/stfc/alliance-invites"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>Alliance Discord Invites</PageTitle>

<h1>Alliance Discord Invites</h1>

<p>
    <a href="manage/stfc/alliance-invites/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.StfcAllianceDiscordInvites.Include(i => i.Alliance).Include(i => i.Alliance.Server).Include(i => i.Alliance.Server.Region).OrderBy(i => i.Alliance.Tag)">
    <PropertyColumn Property="invite => invite.Alliance.Tag" Title="Alliance" Sortable="true" />
    <PropertyColumn Property="invite => invite.Alliance.Server.DisplayName" Title="Server" Sortable="true" />
    <PropertyColumn Property="invite => invite.Url" Sortable="true" />

    <TemplateColumn Context="invite">
        <a href="@($"manage/stfc/alliance-invites/edit?id={invite.Id}")">Edit</a> |
        <a href="@($"manage/stfc/alliance-invites/delete?id={invite.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private HoshiBotDbContext context = default!;

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
