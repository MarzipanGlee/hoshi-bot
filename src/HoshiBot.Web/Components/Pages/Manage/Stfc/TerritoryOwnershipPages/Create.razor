@page "/manage/stfc/territory-ownership/create"
@inherits EntityCreatePageBase<StfcTerritoryOwnership>

<PageTitle>Create Territory Ownership</PageTitle>

<h1>Create Territory Ownership</h1>
<p>Setting ownership for a territory/server pair that already has a row updates it instead of creating a duplicate.</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddOwnership" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="territory" Label="Territory:" Required>
                <InputSelect id="territory" @bind-Value="Entity.TerritoryId" class="form-control">
                    <option value="0">Select territory...</option>
                    @foreach (var territory in territories)
                    {
                        <option value="@territory.Id">@territory.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.TerritoryId" class="text-danger" />
            </FormField>
            <FormField For="server" Label="Server:" Required>
                <InputSelect id="server" @bind-Value="Entity.ServerId" class="form-control">
                    <option value="0">Select server...</option>
                    @foreach (var server in servers)
                    {
                        <option value="@server.Id">@server.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.ServerId" class="text-danger" />
            </FormField>
            <FormField For="alliance" Label="Alliance:" Required>
                <InputSelect id="alliance" @bind-Value="Entity.AllianceId" class="form-control">
                    <option value="0">Select alliance...</option>
                    @foreach (var alliance in alliances)
                    {
                        <option value="@alliance.Id">@alliance.Tag (@alliance.Server.DisplayName)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.AllianceId" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/territory-ownership">Back to List</a>
</div>

@code {
    private List<StfcTerritory> territories = [];
    private List<StfcServer> servers = [];
    private List<StfcAlliance> alliances = [];

    protected override string ListHref => "/manage/stfc/territory-ownership";

    protected override StfcTerritoryOwnership CreateNew() => new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        territories = await context.StfcTerritories.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        servers = await context.StfcServers.Include(s => s.Region).AsNoTracking().OrderBy(s => s.Name).ToListAsync();
        alliances = await context.StfcAlliances.Include(a => a.Server).ThenInclude(s => s.Region).AsNoTracking().OrderBy(a => a.Tag).ToListAsync();
    }

    private async Task AddOwnership()
    {
        if (Entity.TerritoryId == 0 || Entity.ServerId == 0 || Entity.AllianceId == 0)
            return;

        using var context = DbFactory.CreateDbContext();

        // (TerritoryId, ServerId) uniqueness is enforced in application code, not a DB
        // constraint (see the entity's comment) — replicate that here rather than let a
        // second row for the same pair silently coexist.
        var existing = await context.StfcTerritoryOwnerships
            .FirstOrDefaultAsync(o => o.TerritoryId == Entity.TerritoryId && o.ServerId == Entity.ServerId);

        if (existing is null)
        {
            context.StfcTerritoryOwnerships.Add(Entity);
        }
        else
        {
            existing.AllianceId = Entity.AllianceId;
        }

        await context.SaveChangesAsync();
        NavigationManager.NavigateTo(ListHref);
    }
}
