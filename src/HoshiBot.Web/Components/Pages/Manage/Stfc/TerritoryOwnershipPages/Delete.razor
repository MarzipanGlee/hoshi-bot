@page "/manage/stfc/territory-ownership/delete"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Territory Ownership</PageTitle>

<h1>Delete Territory Ownership</h1>

<p>Are you sure you want to delete this?</p>
<div>
    @if (ownership is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">Territory</dt>
            <dd class="col-sm-10">@ownership.Territory.Name</dd>
            <dt class="col-sm-2">Server</dt>
            <dd class="col-sm-10">@ownership.Server.DisplayName</dd>
            <dt class="col-sm-2">Alliance</dt>
            <dd class="col-sm-10">@ownership.Alliance.Tag</dd>
        </dl>
        <EditForm method="post" Model="ownership" OnValidSubmit="DeleteOwnership" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger">Delete</button> |
            <a href="/manage/stfc/territory-ownership">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private StfcTerritoryOwnership? ownership;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        ownership = await context.StfcTerritoryOwnerships
            .Include(o => o.Territory)
            .Include(o => o.Server)
            .Include(o => o.Server.Region)
            .Include(o => o.Alliance)
            .FirstOrDefaultAsync(o => o.Id == Id);

        if (ownership is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteOwnership()
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcTerritoryOwnerships.Remove(ownership!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/territory-ownership");
    }
}
