@page "/manage/stfc/territory-ownership/delete"
@inherits EntityDeletePageBase<StfcTerritoryOwnership, int>

<DeleteConfirmation EntityName="Territory Ownership" BackHref="/manage/stfc/territory-ownership" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Territory</dt>
    <dd class="col-sm-10">@Entity!.Territory.Name</dd>
    <dt class="col-sm-2">Server</dt>
    <dd class="col-sm-10">@Entity!.Server.DisplayName</dd>
    <dt class="col-sm-2">Alliance</dt>
    <dd class="col-sm-10">@Entity!.Alliance.Tag</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/territory-ownership";

    protected override Task<StfcTerritoryOwnership?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcTerritoryOwnerships
            .Include(o => o.Territory)
            .Include(o => o.Server)
            .Include(o => o.Server.Region)
            .Include(o => o.Alliance)
            .FirstOrDefaultAsync(o => o.Id == id);
}
