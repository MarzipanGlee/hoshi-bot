@page "/manage/stfc/territory-ownership/import"
@using System.Text.Json
@using HoshiBot.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject StfcTerritoryOwnershipImportService ImportService

<PageTitle>Import Territory Ownership</PageTitle>

<h1>Import Territory Ownership</h1>
<p>
    Upload a fresh ownership snapshot from stfc.pro's <code>stfc_territories</code> feed (e.g.
    <code>data/territory-owners.json</code>). A territory with a null Tag is now unowned and any
    existing ownership row for it is removed; a Tag that can't be resolved to a known alliance on
    that server is left untouched rather than guessed at.
</p>

<ImportForm TResult="StfcTerritoryOwnershipImportResult" Import="ImportAsync">
    <ResultTemplate Context="r">
        <p class="mt-3">
            Added @r.Added, updated @r.Updated, removed @r.Removed (now unowned).
            Skipped @r.UnknownTerritory (unknown territory), @r.UnresolvedTag (unresolved alliance tag).
        </p>
    </ResultTemplate>
</ImportForm>

@code {
    private async Task<StfcTerritoryOwnershipImportResult> ImportAsync(IReadOnlyCollection<UploadFile> files)
    {
        var file = files.FirstOrDefault()?.File
            ?? throw new InvalidOperationException("No file was uploaded.");
        var entries = await ParseFileAsync(file);
        return await ImportService.ImportAsync(entries);
    }

    private static async Task<List<StfcTerritoryOwnershipImportEntry>> ParseFileAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: 5_000_000);
        using var doc = await JsonDocument.ParseAsync(stream);

        return doc.RootElement.EnumerateArray()
            .Select(e => new StfcTerritoryOwnershipImportEntry(
                e.GetProperty("server").GetInt32(),
                e.GetProperty("territory").GetInt32(),
                e.TryGetProperty("tag", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null))
            .ToList();
    }
}
