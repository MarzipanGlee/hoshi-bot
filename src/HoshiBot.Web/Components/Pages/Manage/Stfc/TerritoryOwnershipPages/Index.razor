@page "/manage/stfc/territory-ownership"
@inherits DbContextPageBase

<PageTitle>Territory Ownership</PageTitle>

<h1>Territory Ownership</h1>

<p>
    <a href="manage/stfc/territory-ownership/create">Create New</a> |
    <a href="manage/stfc/territory-ownership/import">Import</a>
</p>

<QuickGrid Class="table" Items="Context.StfcTerritoryOwnerships.Include(o => o.Territory).Include(o => o.Server).Include(o => o.Server.Region).Include(o => o.Alliance).OrderBy(o => o.Territory.Name).ThenBy(o => o.Server.Name)" Pagination="pagination">
    <PropertyColumn Property="ownership => ownership.Territory.Name" Title="Territory" Sortable="true" />
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real ServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcTerritoryOwnership>.ByAscending(o => o.ServerId))" Context="ownership">
        @ownership.Server.DisplayName
    </TemplateColumn>
    <PropertyColumn Property="ownership => ownership.Alliance.Tag" Title="Alliance" Sortable="true" />

    <TemplateColumn Context="ownership">
        <a href="@($"manage/stfc/territory-ownership/edit?id={ownership.Id}")">Edit</a> |
        <a href="@($"manage/stfc/territory-ownership/delete?id={ownership.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

<PoweredBy For="@(new[] { typeof(StfcTerritoryOwnership) })" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
