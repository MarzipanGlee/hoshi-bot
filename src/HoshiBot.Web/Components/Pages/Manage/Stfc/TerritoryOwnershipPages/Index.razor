@page "/manage/stfc/territory-ownership"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>Territory Ownership</PageTitle>

<h1>Territory Ownership</h1>

<p>
    <a href="manage/stfc/territory-ownership/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.StfcTerritoryOwnerships.Include(o => o.Territory).Include(o => o.Server).Include(o => o.Server.Region).Include(o => o.Alliance).OrderBy(o => o.Territory.Name).ThenBy(o => o.Server.Name)">
    <PropertyColumn Property="ownership => ownership.Territory.Name" Title="Territory" Sortable="true" />
    <PropertyColumn Property="ownership => ownership.Server.DisplayName" Title="Server" Sortable="true" />
    <PropertyColumn Property="ownership => ownership.Alliance.Tag" Title="Alliance" Sortable="true" />
    <PropertyColumn Property="ownership => ownership.LastCapturedAt" Title="Last Captured" Sortable="true" />

    <TemplateColumn Context="ownership">
        <a href="@($"manage/stfc/territory-ownership/edit?id={ownership.Id}")">Edit</a> |
        <a href="@($"manage/stfc/territory-ownership/delete?id={ownership.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private HoshiBotDbContext context = default!;

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
