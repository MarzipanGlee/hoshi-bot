@page "/manage/stfc/veil-groups/delete"
@inherits EntityDeletePageBase<StfcVeilGroup, int>

<DeleteConfirmation EntityName="Veil Group" BackHref="/manage/stfc/veil-groups" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
    <dt class="col-sm-2">Region</dt>
    <dd class="col-sm-10">@Entity!.Region.Name</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/veil-groups";

    protected override Task<StfcVeilGroup?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroups.Include(v => v.Region).FirstOrDefaultAsync(v => v.Id == id);
}
