@page "/manage/stfc/veil-groups"
@inherits DbContextPageBase

<PageTitle>Veil Groups</PageTitle>

<h1>Veil Groups</h1>

<p>
    <a href="manage/stfc/veil-groups/create">Create New</a>
</p>

<QuickGrid Class="table" Items="Context.StfcVeilGroups.Include(v => v.Region).OrderBy(v => v.Name)">
    <PropertyColumn Property="veilGroup => veilGroup.Id" Sortable="true" />
    <PropertyColumn Property="veilGroup => veilGroup.Name" Sortable="true" />
    <PropertyColumn Property="veilGroup => veilGroup.Region.Name" Title="Region" Sortable="true" />

    <TemplateColumn Context="veilGroup">
        <a href="@($"manage/stfc/veil-groups/edit?id={veilGroup.Id}")">Edit</a> |
        <a href="@($"manage/stfc/veil-groups/delete?id={veilGroup.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<PoweredBy For="@(new[] { typeof(StfcVeilGroup) })" />
