@page "/manage/stfc/veil-groups/create"
@inherits EntityCreatePageBase<StfcVeilGroup>

<PageTitle>Create Veil Group</PageTitle>

<h1>Create Veil Group</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Entity" OnValidSubmit="AddVeilGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="id" Label="Id (matches Scopely's veil-group numbering):" Required>
                <InputNumber id="id" @bind-Value="Entity.Id" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Id" class="text-danger" />
            </FormField>
            <FormField For="name" Label="Name:" Required>
                <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Entity.Name" class="text-danger" />
            </FormField>
            <FormField For="region" Label="Region:" Required>
                <InputSelect id="region" @bind-Value="Entity.RegionId" class="form-control">
                    <option value="0">Select region...</option>
                    @foreach (var region in regions)
                    {
                        <option value="@region.Id">@region.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Entity.RegionId" class="text-danger" />
            </FormField>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/veil-groups">Back to List</a>
</div>

@code {
    private List<StfcRegion> regions = [];

    protected override string ListHref => "/manage/stfc/veil-groups";

    protected override StfcVeilGroup CreateNew() => new() { Name = "" };

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        regions = await context.StfcRegions.AsNoTracking().ToListAsync();
    }

    private async Task AddVeilGroup()
    {
        if (Entity.RegionId == 0)
            return;

        await AddAsync();
    }
}
