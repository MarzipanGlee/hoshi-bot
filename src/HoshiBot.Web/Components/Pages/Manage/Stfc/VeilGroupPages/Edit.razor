@page "/manage/stfc/veil-groups/edit"
@inherits EntityEditPageBase<StfcVeilGroup, int>

<PageTitle>Edit Veil Group</PageTitle>

<h1>Edit Veil Group</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="name" Label="Name:" Required>
                    <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Name" class="text-danger" />
                </FormField>
                <FormField For="region" Label="Region:" Required>
                    <InputSelect id="region" @bind-Value="Entity.RegionId" class="form-control">
                        @foreach (var region in regions)
                        {
                            <option value="@region.Id">@region.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.RegionId" class="text-danger" />
                </FormField>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>

    <h2>Discord Invites</h2>
    <table class="table">
        <thead><tr><th>Url</th><th></th></tr></thead>
        <tbody>
            @foreach (var invite in invites)
            {
                <tr>
                    <td>@invite.Url</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => RemoveInviteAsync(invite)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <EditForm Model="this" FormName="add-invite" OnValidSubmit="AddInviteAsync">
        <input type="text" class="form-control d-inline-block w-auto" @bind="newInviteUrl" placeholder="https://discord.gg/..." />
        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>
}

<div>
    <a href="/manage/stfc/veil-groups">Back to List</a>
</div>

@code {
    private List<StfcRegion> regions = [];
    private List<StfcVeilGroupDiscordInvite> invites = [];
    private string? newInviteUrl;

    protected override string ListHref => "/manage/stfc/veil-groups";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        regions = await context.StfcRegions.AsNoTracking().ToListAsync();
        await base.OnInitializedAsync();

        if (Entity is null)
            return;

        await LoadInvitesAsync();
    }

    protected override Task<StfcVeilGroup?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroups.FirstOrDefaultAsync(v => v.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcVeilGroups.AnyAsync(v => v.Id == id);

    private async Task LoadInvitesAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invites = await context.StfcVeilGroupDiscordInvites.Where(i => i.VeilGroupId == Id).AsNoTracking().ToListAsync();
    }

    private async Task AddInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(newInviteUrl))
            return;

        using var context = DbFactory.CreateDbContext();
        context.StfcVeilGroupDiscordInvites.Add(new StfcVeilGroupDiscordInvite { VeilGroupId = Id, Url = newInviteUrl });
        await context.SaveChangesAsync();

        newInviteUrl = null;
        await LoadInvitesAsync();
    }

    private async Task RemoveInviteAsync(StfcVeilGroupDiscordInvite invite)
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcVeilGroupDiscordInvites.Remove(invite);
        await context.SaveChangesAsync();
        await LoadInvitesAsync();
    }
}
