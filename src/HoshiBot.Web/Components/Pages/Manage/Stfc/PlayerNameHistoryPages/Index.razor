@page "/manage/stfc/player-name-history"
@inherits DbContextPageBase

<PageTitle>Player Name History</PageTitle>

<h1>Player Name History</h1>
<p>Read-only audit trail — one row per name a player has been observed under. Most recent first.</p>

@* Ordered by Id, not ObservedAt — append-only, so Id already reflects insertion order. *@
<QuickGrid Class="table" Items="Context.StfcPlayerNameHistories.Include(h => h.StfcPlayer).ThenInclude(p => p.Server).ThenInclude(s => s.Region).OrderByDescending(h => h.Id)" Pagination="pagination">
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real ServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcPlayerNameHistory>.ByAscending(h => h.StfcPlayer.ServerId))" Context="h">
        @h.StfcPlayer.Server.DisplayName
    </TemplateColumn>
    <PropertyColumn Property="h => h.Name" Sortable="true" />
    <PropertyColumn Property="h => h.ObservedAt" Sortable="true" />
    <TemplateColumn Title="Current Player" Context="h">
        <a href="@($"manage/stfc/players/edit?id={h.StfcPlayerId}")">@h.StfcPlayer.Name</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

<PoweredBy For="@(new[] { typeof(StfcPlayerNameHistory) })" />

@code {
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };
}
