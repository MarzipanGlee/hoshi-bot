@page "/manage/stfc/alliances"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>Alliances</PageTitle>

<h1>Alliances</h1>

<p>
    <a href="manage/stfc/alliances/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.StfcAlliances.Include(a => a.Server).ThenInclude(s => s.Region).OrderBy(a => a.Server.Id).ThenBy(a => a.Tag)" Pagination="pagination">
    <PropertyColumn Property="alliance => alliance.Tag" Sortable="true" />
    <PropertyColumn Property="alliance => alliance.Name" Sortable="true" />
    @* DisplayName is a computed property — PropertyColumn can't take an explicit SortBy
       (that's TemplateColumn-only), so this sorts by the real ServerId column instead. *@
    <TemplateColumn Title="Server" Sortable="true" SortBy="@(GridSort<StfcAlliance>.ByAscending(a => a.ServerId))" Context="alliance">
        @alliance.Server.DisplayName
    </TemplateColumn>

    <TemplateColumn Context="alliance">
        <a href="@($"manage/stfc/alliances/edit?id={alliance.Id}")">Edit</a> |
        <a href="@($"manage/stfc/alliances/delete?id={alliance.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

@code {
    private HoshiBotDbContext context = default!;
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
