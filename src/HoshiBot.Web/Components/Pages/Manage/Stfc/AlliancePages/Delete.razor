@page "/manage/stfc/alliances/delete"
@inherits EntityDeletePageBase<StfcAlliance, int>

<DeleteConfirmation EntityName="Alliance" BackHref="/manage/stfc/alliances" Loaded="Entity is not null" OnConfirm="DeleteAsync">
    <dt class="col-sm-2">Tag</dt>
    <dd class="col-sm-10">@Entity!.Tag</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Entity!.Name</dd>
    <dt class="col-sm-2">Server</dt>
    <dd class="col-sm-10">@Entity!.Server.DisplayName</dd>
</DeleteConfirmation>

@code {
    protected override string ListHref => "/manage/stfc/alliances";

    protected override Task<StfcAlliance?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAlliances.Include(a => a.Server).ThenInclude(s => s.Region).FirstOrDefaultAsync(a => a.Id == id);
}
