@page "/manage/stfc/alliances/create"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Alliance</PageTitle>

<h1>Create Alliance</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Alliance" OnValidSubmit="AddAlliance" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <FormField For="tag" Label="Tag:" Required>
                <InputText id="tag" @bind-Value="Alliance.Tag" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Alliance.Tag" class="text-danger" />
            </FormField>
            <FormField For="name" Label="Name:" Required>
                <InputText id="name" @bind-Value="Alliance.Name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Alliance.Name" class="text-danger" />
            </FormField>
            <FormField For="server" Label="Server:" Required>
                <InputSelect id="server" @bind-Value="Alliance.ServerId" class="form-control">
                    <option value="0">Select server...</option>
                    @foreach (var server in servers)
                    {
                        <option value="@server.Id">@server.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Alliance.ServerId" class="text-danger" />
            </FormField>
            <div class="mb-3">
                <label class="form-label">Emblem:</label>
                <InputRadioGroup @bind-Value="Alliance.Emblem">
                    <div class="emblem-picker">
                        <label class="emblem-tile emblem-tile-none">
                            <InputRadio Value="@((int?)null)" class="d-none" />
                            None
                        </label>
                        @for (var i = 0; i <= MaxEmblem; i++)
                        {
                            var idx = i;
                            <label class="emblem-tile" title="Emblem @idx">
                                <InputRadio Value="@((int?)idx)" class="d-none" />
                                <AllianceEmblem Emblem="idx" Size="44" />
                            </label>
                        }
                    </div>
                </InputRadioGroup>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/manage/stfc/alliances">Back to List</a>
</div>

@code {
    // Highest emblem index bundled in wwwroot/images/emblems (emblem_000..emblem_026).
    private const int MaxEmblem = 26;

    [SupplyParameterFromForm]
    private StfcAlliance Alliance { get; set; } = default!;

    private List<StfcServer> servers = [];

    protected override async Task OnInitializedAsync()
    {
        Alliance ??= new() { Tag = "", Name = "" };
        using var context = DbFactory.CreateDbContext();
        servers = await context.StfcServers.Include(s => s.Region).OrderBy(s => s.Region.Name).ThenBy(s => s.Id).AsNoTracking().ToListAsync();
    }

    private async Task AddAlliance()
    {
        if (Alliance.ServerId == 0)
            return;

        using var context = DbFactory.CreateDbContext();
        context.StfcAlliances.Add(Alliance);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/manage/stfc/alliances");
    }
}
