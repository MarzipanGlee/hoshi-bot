@page "/manage/stfc/alliances/edit"
@inherits EntityEditPageBase<StfcAlliance, int>

<PageTitle>Edit Alliance</PageTitle>

<h1>Edit Alliance</h1>
<hr />
@if (Entity is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Entity" OnValidSubmit="SaveAsync" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Entity.Id" value="@Entity.Id" />
                <FormField For="tag" Label="Tag:" Required>
                    <InputText id="tag" @bind-Value="Entity.Tag" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Tag" class="text-danger" />
                </FormField>
                <FormField For="name" Label="Name:" Required>
                    <InputText id="name" @bind-Value="Entity.Name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Entity.Name" class="text-danger" />
                </FormField>
                <FormField For="server" Label="Server:" Required>
                    <InputSelect id="server" @bind-Value="Entity.ServerId" class="form-control">
                        @foreach (var server in servers)
                        {
                            <option value="@server.Id">@server.DisplayName</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Entity.ServerId" class="text-danger" />
                </FormField>
                <div class="mb-3">
                    <label class="form-label">Emblem:</label>
                    <InputRadioGroup @bind-Value="Entity.Emblem">
                        <div class="emblem-picker">
                            <label class="emblem-tile emblem-tile-none">
                                <InputRadio Value="@((int?)null)" class="d-none" />
                                None
                            </label>
                            @for (var i = 0; i <= MaxEmblem; i++)
                            {
                                var idx = i;
                                <label class="emblem-tile" title="Emblem @idx">
                                    <InputRadio Value="@((int?)idx)" class="d-none" />
                                    <AllianceEmblem Emblem="idx" Size="44" />
                                </label>
                            }
                        </div>
                    </InputRadioGroup>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>

    <h2>Discord Invites</h2>
    <table class="table">
        <thead><tr><th>Url</th><th></th></tr></thead>
        <tbody>
            @foreach (var invite in invites)
            {
                <tr>
                    <td>@invite.Url</td>
                    <td><button class="btn btn-sm btn-danger" @onclick="() => RemoveInviteAsync(invite)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <EditForm Model="this" FormName="add-invite" OnValidSubmit="AddInviteAsync">
        <input type="text" class="form-control d-inline-block w-auto" @bind="newInviteUrl" placeholder="https://discord.gg/..." />
        <button type="submit" class="btn btn-primary">Add</button>
    </EditForm>
}

<div>
    <a href="/manage/stfc/alliances">Back to List</a>
</div>

@code {
    // Highest emblem index bundled in wwwroot/images/emblems (emblem_000..emblem_026).
    private const int MaxEmblem = 26;

    private List<StfcServer> servers = [];
    private List<StfcAllianceDiscordInvite> invites = [];
    private string? newInviteUrl;

    protected override string ListHref => "/manage/stfc/alliances";

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        servers = await context.StfcServers.Include(s => s.Region).OrderBy(s => s.Region.Name).ThenBy(s => s.Id).AsNoTracking().ToListAsync();
        await base.OnInitializedAsync();

        if (Entity is null)
            return;

        await LoadInvitesAsync();
    }

    protected override Task<StfcAlliance?> LoadAsync(HoshiBotDbContext context, int id)
        => context.StfcAlliances.FirstOrDefaultAsync(a => a.Id == id);

    protected override Task<bool> ExistsAsync(HoshiBotDbContext context, int id)
        => context.StfcAlliances.AnyAsync(a => a.Id == id);

    private async Task LoadInvitesAsync()
    {
        using var context = DbFactory.CreateDbContext();
        invites = await context.StfcAllianceDiscordInvites.Where(i => i.AllianceId == Id).AsNoTracking().ToListAsync();
    }

    private async Task AddInviteAsync()
    {
        if (string.IsNullOrWhiteSpace(newInviteUrl))
            return;

        using var context = DbFactory.CreateDbContext();
        context.StfcAllianceDiscordInvites.Add(new StfcAllianceDiscordInvite { AllianceId = Id, Url = newInviteUrl });
        await context.SaveChangesAsync();

        newInviteUrl = null;
        await LoadInvitesAsync();
    }

    private async Task RemoveInviteAsync(StfcAllianceDiscordInvite invite)
    {
        using var context = DbFactory.CreateDbContext();
        context.StfcAllianceDiscordInvites.Remove(invite);
        await context.SaveChangesAsync();
        await LoadInvitesAsync();
    }
}
