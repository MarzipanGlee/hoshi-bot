@page "/manage"
@using Microsoft.AspNetCore.Authentication
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject GuildAccessService GuildAccessService
@inject DiscordUserGuildsService DiscordUserGuilds
@inject IHttpContextAccessor HttpContextAccessor
@inject CurrentGuildContext GuildContext
@inject SupportModeContext SupportMode
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Msg.WebNav.Dashboard(Lang)</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>@Msg.WebGuild.Welcome(Lang, context.User.Identity?.Name)</h1>

        @if (needsSetupGuilds.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>@Msg.WebGuild.NeedsSetup(Lang, needsSetupGuilds.Count)</strong>
                @string.Join(", ", needsSetupGuilds.Select(g => g.Name))
            </div>
        }

        <h2>@Msg.WebGuild.YourGuilds(Lang)</h2>

        @if (guilds is null)
        {
            <LoadingPlaceholder Em="false" />
        }
        else if (guilds.Count == 0)
        {
            <p>@Msg.WebGuild.NoGuilds(Lang)</p>
        }
        else
        {
            <div class="card-grid mt-1">
                @foreach (var guild in guilds)
                {
                    <GuildCard @key="guild.Id" Guild="guild"
                               Audience="audiencesByGuildId.GetValueOrDefault(guild.Id)"
                               SetupComplete="setupCompleteGuildIds.Contains(guild.Id)"
                               OnOpen="() => OpenAsync(guild)" />
                }
            </div>
        }

        @if (SupportMode.IsActive && foreignGuilds.Count > 0)
        {
            <h2>@Msg.WebGuild.ForeignServers(Lang) <span class="badge bg-info text-dark align-middle">@Msg.WebGuild.SupportBadge(Lang)</span></h2>
            <p class="text-muted mb-1">@Msg.WebGuild.ForeignServersLead(Lang)</p>
            <div class="card-grid mt-1">
                @foreach (var guild in foreignGuilds)
                {
                    <GuildCard @key="guild.Id" Guild="guild"
                               Audience="audiencesByGuildId.GetValueOrDefault(guild.Id)"
                               SetupComplete="setupCompleteGuildIds.Contains(guild.Id)"
                               OnOpen="() => OpenAsync(guild)" />
                }
            </div>
        }

        @* Global-admin-only shortcuts (STFC Catalog + Bot settings). Both pages enforce the
           GlobalAdmin policy server-side; gate the whole card grid so non-admins don't see the
           shortcuts either — matching the nav, which hides the same sections. *@
        @if (isGlobalAdmin)
        {
            <div class="card-grid mt-4">
                <NavCard Href="manage/stfc/regions" Icon="oi-globe" Title="STFC Catalog"
                         Subtitle="Regions, servers, alliances, and territories" />
                <NavCard Href="manage/bot/global-admins" Icon="oi-shield" Title="Bot"
                         Subtitle="Manage global admin access" />
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <p><a href="login?returnUrl=%2Fmanage">@Msg.WebGuild.LogInWithDiscord(Lang)</a> @Msg.WebGuild.LogInTail(Lang)</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private List<UserManagedGuild>? guilds;
    private List<UserManagedGuild> foreignGuilds = [];
    private Dictionary<ulong, GuildAudience> audiencesByGuildId = [];
    private HashSet<ulong> setupCompleteGuildIds = [];
    private List<DiscordGuild> needsSetupGuilds = [];
    private bool isGlobalAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var globalAdminResult = await AuthorizationService.AuthorizeAsync(user, null, new GlobalAdminRequirement());
        isGlobalAdmin = globalAdminResult.Succeeded;

        // Seed support mode before loading data (GetAccessibleGuildsAsync + the foreign row
        // depend on it) — this page can run before MainLayout initializes it on a fresh load.
        if (ulong.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var userId))
            await SupportMode.InitializeAsync(userId);

        // Reload the guild lists live when the top-row switch is toggled while on this page.
        SupportMode.Changed += OnSupportModeChanged;

        await LoadDataAsync(user);
    }

    private async Task LoadDataAsync(System.Security.Claims.ClaimsPrincipal user)
    {
        var accessibleGuilds = await GuildAccessService.GetAccessibleGuildsAsync(user);

        await using var db = await DbFactory.CreateDbContextAsync();
        var setupCompleteIds = (await db.GuildSettings
            .Where(s => s.SetupCompletedAt != null)
            .Select(s => s.GuildId)
            .ToListAsync())
            .ToHashSet();
        needsSetupGuilds = accessibleGuilds.Where(g => !setupCompleteIds.Contains(g.Id)).ToList();

        var httpContext = HttpContextAccessor.HttpContext;
        var accessToken = httpContext is null ? null : await httpContext.GetTokenAsync("access_token");
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        ulong.TryParse(userIdClaim, out var userId);

        guilds = accessToken is null || userId == 0
            ? []
            : await DiscordUserGuilds.GetUserManagedGuildsAsync(accessToken, userId);

        audiencesByGuildId = await db.GuildSettings.AsNoTracking().ToDictionaryAsync(s => s.GuildId, s => s.Audiences);
        setupCompleteGuildIds = setupCompleteIds;

        // Support mode: every guild the bot is in that isn't already in "Your Guilds" — a
        // global admin's operator view of foreign servers they aren't personally a member of.
        if (SupportMode.IsActive)
        {
            var ownIds = guilds.Select(g => g.Id).ToHashSet();
            var allBotGuilds = await DiscordUserGuilds.GetAllBotGuildsAsync();
            foreignGuilds = allBotGuilds.Where(g => !ownIds.Contains(g.Id)).ToList();
        }
        else
        {
            foreignGuilds = [];
        }
    }

    private void OnSupportModeChanged() => InvokeAsync(async () =>
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await LoadDataAsync(authState.User);
        StateHasChanged();
    });

    public void Dispose() => SupportMode.Changed -= OnSupportModeChanged;

    private async Task OpenAsync(UserManagedGuild guild)
    {
        if (!guild.BotInstalled)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await GuildContext.SetAsync(guild.Id, authState.User);
        Nav.NavigateTo($"manage/guild/{guild.Id}");
    }
}
