@page "/manage"
@using Microsoft.AspNetCore.Authentication
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject GuildAccessService GuildAccessService
@inject DiscordUserGuildsService DiscordUserGuilds
@inject IHttpContextAccessor HttpContextAccessor
@inject CurrentGuildContext GuildContext
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Welcome, @context.User.Identity?.Name</h1>

        @if (needsSetupGuilds.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>@needsSetupGuilds.Count guild@(needsSetupGuilds.Count == 1 ? "" : "s")</strong> still
                need@(needsSetupGuilds.Count == 1 ? "s" : "") setup:
                @string.Join(", ", needsSetupGuilds.Select(g => g.Name))
            </div>
        }

        <h2>Your Guilds</h2>

        @if (guilds is null)
        {
            <p>Loading...</p>
        }
        else if (guilds.Count == 0)
        {
            <p>No guilds found where you're the owner or have the Manage Server permission.</p>
        }
        else
        {
            <div class="row g-3 mt-1">
                @foreach (var guild in guilds)
                {
                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 @(guild.BotInstalled ? "" : "opacity-75")"
                             style="@(guild.BotInstalled ? "cursor:pointer;" : "")"
                             @onclick="() => OpenAsync(guild)">
                            <div class="card-header d-flex align-items-center gap-3">
                                <GuildIcon GuildId="guild.Id" IconHash="@guild.IconHash" Name="@guild.Name"
                                           CssClass="rounded-circle object-fit-cover flex-shrink-0" Style="width:3rem;height:3rem;font-size:1.25rem;" />
                                <div>
                                    <h2 class="fs-6 fw-semibold mb-1">@guild.Name</h2>
                                    @if (audiencesByGuildId.TryGetValue(guild.Id, out var audience) && audience != GuildAudience.None)
                                    {
                                        @foreach (var label in AudienceDisplay.Labels(audience))
                                        {
                                            <span class="badge bg-secondary me-1">@label</span>
                                        }
                                    }
                                    @if (guild.BotInstalled && !setupCompleteGuildIds.Contains(guild.Id))
                                    {
                                        <span class="badge bg-warning text-dark">needs setup</span>
                                    }
                                </div>
                            </div>

                            <div class="card-footer">
                                @if (!guild.BotInstalled)
                                {
                                    <a class="btn btn-outline-primary btn-sm" href="invite?guildId=@guild.Id" target="_blank" rel="noopener" @onclick:stopPropagation="true">+ Install bot</a>
                                }
                                else
                                {
                                    <div class="d-flex gap-2">
                                        <a class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" href="manage/guilds/@guild.Id/features" @onclick:stopPropagation="true">Features</a>
                                        <a class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" href="manage/guilds/@guild.Id/settings" @onclick:stopPropagation="true">Settings</a>
                                        <a class="btn btn-outline-secondary btn-sm d-flex align-items-center justify-content-center" href="manage/guilds/@guild.Id/setup-wizard" @onclick:stopPropagation="true">Setup Wizard</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="row g-3 mt-4">
            <div class="col-sm-6 col-lg-3">
                <a class="card h-100 text-decoration-none text-body" href="manage/stfc/regions">
                    <div class="card-body">
                        <span class="oi oi-globe fs-4" style="color:rgb(5,39,103);" aria-hidden="true"></span>
                        <h2 class="fs-6 fw-semibold mt-2 mb-1">STFC Catalog</h2>
                        <p class="mb-0" style="color:#5a5a63;">Regions, servers, alliances, and territories</p>
                    </div>
                </a>
            </div>
            @if (isGlobalAdmin)
            {
                <div class="col-sm-6 col-lg-3">
                    <a class="card h-100 text-decoration-none text-body" href="manage/bot/global-admins">
                        <div class="card-body">
                            <span class="oi oi-shield fs-4" style="color:rgb(5,39,103);" aria-hidden="true"></span>
                            <h2 class="fs-6 fw-semibold mt-2 mb-1">Bot</h2>
                            <p class="mb-0" style="color:#5a5a63;">Manage global admin access</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p><a href="login?returnUrl=%2Fmanage">Log in with Discord</a> to see your dashboard.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<UserManagedGuild>? guilds;
    private Dictionary<ulong, GuildAudience> audiencesByGuildId = [];
    private HashSet<ulong> setupCompleteGuildIds = [];
    private List<DiscordGuild> needsSetupGuilds = [];
    private bool isGlobalAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var globalAdminResult = await AuthorizationService.AuthorizeAsync(user, null, new GlobalAdminRequirement());
        isGlobalAdmin = globalAdminResult.Succeeded;

        var accessibleGuilds = await GuildAccessService.GetAccessibleGuildsAsync(user);

        await using var db = await DbFactory.CreateDbContextAsync();
        var setupCompleteIds = (await db.GuildSettings
            .Where(s => s.SetupCompletedAt != null)
            .Select(s => s.GuildId)
            .ToListAsync())
            .ToHashSet();
        needsSetupGuilds = accessibleGuilds.Where(g => !setupCompleteIds.Contains(g.Id)).ToList();

        var httpContext = HttpContextAccessor.HttpContext;
        var accessToken = httpContext is null ? null : await httpContext.GetTokenAsync("access_token");
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (accessToken is null || userIdClaim is null || !ulong.TryParse(userIdClaim, out var userId))
        {
            guilds = [];
            return;
        }

        guilds = await DiscordUserGuilds.GetUserManagedGuildsAsync(accessToken, userId);

        audiencesByGuildId = await db.GuildSettings.AsNoTracking().ToDictionaryAsync(s => s.GuildId, s => s.Audiences);
        setupCompleteGuildIds = setupCompleteIds;
    }

    private async Task OpenAsync(UserManagedGuild guild)
    {
        if (!guild.BotInstalled)
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        await GuildContext.SetAsync(guild.Id, authState.User);
        Nav.NavigateTo($"manage/guilds/{guild.Id}");
    }
}
