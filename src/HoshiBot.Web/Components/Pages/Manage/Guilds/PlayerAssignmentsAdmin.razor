@page "/manage/guilds/{GuildId}/player-assignments"
@using HoshiBot.Data
@using HoshiBot.Web.Services
@inherits GuildAdminPageBase
@inject DiscordGuildDataService DiscordData
@inject PlayerLinkService PlayerLink

<PageTitle>Player Assignments</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else if (loading)
{
    <p>Lade Mitglieder…</p>
}
else
{
    <h1>Spielerzuordnung</h1>
    <p class="text-muted">
        Ordne jedes Mitglied seinem/seinen In-Game-Spieler(n) zu. Die Zuordnung gilt <strong>global für die
        Person</strong> — sie wirkt in jedem Server, den sie mit Hoshi teilt, und steuert die automatische
        Rollenvergabe (Rang, Ops-Level, Nickname). Ein Spieler kann mehreren Discord-Konten zugeordnet sein
        (z. B. Zweitaccounts).
    </p>

    <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
        <div style="max-width:22rem;flex:1 1 16rem">
            <label class="form-label small mb-1">Mitglied suchen</label>
            <input class="form-control form-control-sm" placeholder="Name…" value="@memberFilter"
                   @oninput="e => memberFilter = e.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="onlyUnlinked"
                   checked="@onlyUnlinked" @onchange="e => onlyUnlinked = (bool)e.Value!" />
            <label class="form-check-label" for="onlyUnlinked">Nur ohne Zuordnung</label>
        </div>
        <span class="text-muted small">@FilteredMembers.Count / @members.Count Mitglieder</span>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th style="min-width:12rem">Mitglied (Nickname)</th>
                    <th>Zugeordnete Spieler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in FilteredMembers)
                {
                    <tr>
                        <td>@m.Name</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @foreach (var link in m.Links)
                                {
                                    <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                                        @if (link.IsMain)
                                        {
                                            <span title="Hauptspieler">★</span>
                                        }
                                        <span>@PlayerLabel(link.Name, link.ServerName, link.AllianceTag)</span>
                                        @if (!link.IsMain)
                                        {
                                            <button type="button" class="btn btn-sm btn-link p-0 text-white text-decoration-none"
                                                    title="Als Hauptspieler setzen" @onclick="() => SetMainAsync(m.Id, link.PlayerId)">☆</button>
                                        }
                                        <button type="button" class="btn btn-sm btn-link p-0 text-white text-decoration-none"
                                                title="Entfernen" @onclick="() => UnlinkAsync(m.Id, link.PlayerId)">✕</button>
                                    </span>
                                }
                                @if (addingForUserId == m.Id)
                                {
                                    <div class="d-inline-flex flex-column" style="min-width:18rem">
                                        <input class="form-control form-control-sm" placeholder="Spieler suchen…" value="@searchTerm"
                                               @oninput="OnSearchInputAsync" autofocus />
                                        @if (searchResults.Count > 0)
                                        {
                                            <div class="list-group mt-1" style="max-height:14rem;overflow-y:auto">
                                                @foreach (var r in searchResults)
                                                {
                                                    <button type="button" class="list-group-item list-group-item-action py-1"
                                                            @onclick="() => AssignAsync(m.Id, r.Id)">
                                                        @PlayerLabel(r.Name, r.ServerName, r.AllianceTag)
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartAdding(m.Id)">
                                        + Spieler
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool loading = true;
    private List<MemberRow> members = [];
    private string memberFilter = "";
    private bool onlyUnlinked;

    private ulong? addingForUserId;
    private string searchTerm = "";
    private List<PlayerSearchResult> searchResults = [];

    private List<MemberRow> FilteredMembers => members
        .Where(m => !onlyUnlinked || m.Links.Count == 0)
        .Where(m => memberFilter.Length == 0 || m.Name.Contains(memberFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnAuthorizedParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var names = await DiscordData.GetMemberDisplayNamesAsync(ParsedGuildId);
        var links = await PlayerLink.GetLinksForUsersAsync(names.Keys);
        members = names
            .Select(kv => new MemberRow(kv.Key, string.IsNullOrWhiteSpace(kv.Value) ? kv.Key.ToString() : kv.Value,
                links.GetValueOrDefault(kv.Key) ?? []))
            .OrderBy(m => m.Name)
            .ToList();
        loading = false;
    }

    // Refresh one member's links after a change, without re-fetching the whole Discord member list.
    private async Task RefreshLinksAsync(ulong userId)
    {
        var links = await PlayerLink.GetLinksForUsersAsync([userId]);
        var idx = members.FindIndex(m => m.Id == userId);
        if (idx >= 0)
            members[idx] = members[idx] with { Links = links.GetValueOrDefault(userId) ?? [] };
    }

    private void StartAdding(ulong userId)
    {
        addingForUserId = userId;
        searchTerm = "";
        searchResults = [];
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchResults = searchTerm.Trim().Length < 2 ? [] : await PlayerLink.SearchPlayersAsync(searchTerm);
    }

    private async Task AssignAsync(ulong userId, int playerId)
    {
        await PlayerLink.LinkAsync(userId, playerId);
        await PlayerLink.MarkUserResolvedAsync(userId);
        addingForUserId = null;
        searchTerm = "";
        searchResults = [];
        await RefreshLinksAsync(userId);
    }

    private async Task SetMainAsync(ulong userId, int playerId)
    {
        await PlayerLink.SetMainAsync(userId, playerId);
        await RefreshLinksAsync(userId);
    }

    private async Task UnlinkAsync(ulong userId, int playerId)
    {
        await PlayerLink.UnlinkAsync(userId, playerId);
        await RefreshLinksAsync(userId);
    }

    private static string PlayerLabel(string name, string server, string? tag) =>
        tag is { Length: > 0 } ? $"{name} ({server}, [{tag}])" : $"{name} ({server})";

    private record MemberRow(ulong Id, string Name, List<MemberPlayerLink> Links);
}
