@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

<div class="row g-3 mt-1">
    <SettingsCard Title="Alert Channels">
        <p class="form-text mb-0">
            Each channel+role pair below gets a copy of every alert for this feature — add one per
            channel you want notified (e.g. one for officers, one for the general server).
        </p>
        <table class="table">
            <thead>
                <tr>
                    <th>Channel</th>
                    <th>Role</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alertChannel in alertChannels)
                {
                    <tr>
                        <td>@ChannelName(alertChannel.ChannelId)</td>
                        <td>@RoleName(alertChannel.RoleId)</td>
                        <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteAlertChannelAsync(alertChannel)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <EditForm Model="this" FormName="@($"add-alert-channel-{Kind}")" OnValidSubmit="AddAlertChannelAsync">
            <select class="form-select d-inline-block w-auto" @bind="newChannelIdInput">
                <option value="">— select channel —</option>
                @foreach (var channel in channels)
                {
                    <option value="@channel.Id">@ChannelLabel(channel)</option>
                }
            </select>
            <select class="form-select d-inline-block w-auto" @bind="newRoleIdInput">
                <option value="">— select role —</option>
                @foreach (var role in roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Add</button>
        </EditForm>
    </SettingsCard>
</div>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildAlertChannelKind Kind { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }

    private List<GuildAlertChannel> alertChannels = [];
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? newChannelIdInput;
    private string? newRoleIdInput;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        alertChannels = await db.GuildAlertChannels
            .Where(c => c.GuildId == GuildId && c.Kind == Kind && c.Audience == Audience)
            .AsNoTracking()
            .ToListAsync();

        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
    }

    private async Task AddAlertChannelAsync()
    {
        if (!ulong.TryParse(newChannelIdInput, out var channelId) || !ulong.TryParse(newRoleIdInput, out var roleId))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAlertChannels.Add(new GuildAlertChannel
        {
            GuildId = GuildId,
            Kind = Kind,
            ChannelId = channelId,
            RoleId = roleId,
            Audience = Audience,
        });
        await db.SaveChangesAsync();

        newChannelIdInput = null;
        newRoleIdInput = null;
        await LoadAsync();
    }

    private async Task DeleteAlertChannelAsync(GuildAlertChannel alertChannel)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAlertChannels.Remove(alertChannel);
        await db.SaveChangesAsync();
        await LoadAsync();
    }

    private string ChannelName(ulong id) =>
        channels.FirstOrDefault(c => c.Id == id) is { } channel ? ChannelLabel(channel) : $"⚠ Unbekannt ({id})";

    private string RoleName(ulong id) =>
        roles.FirstOrDefault(r => r.Id == id)?.Name ?? $"⚠ Unbekannt ({id})";

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        VoiceGuildChannel or StageGuildChannel => $"🔊 {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"📋 {channel.Name}",
        _ => $"# {channel.Name}",
    };
}
