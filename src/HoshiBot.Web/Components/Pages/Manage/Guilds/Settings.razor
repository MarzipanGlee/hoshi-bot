@page "/manage/guilds/{GuildId}/settings"
@inject NavigationManager Nav

@code {
    // Settings.razor was replaced by GlobalSettings.razor (non-feature-specific fields)
    // plus one page per feature (Features/FeatureSettings.razor, linked from the
    // Dashboard) — this stub just keeps old bookmarks/links from 404ing.
    [Parameter] public string GuildId { get; set; } = "";

    protected override void OnInitialized() => Nav.NavigateTo($"manage/guilds/{GuildId}/global-settings", forceLoad: false);
}
