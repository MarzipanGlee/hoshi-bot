@page "/manage/guilds/{GuildId}/settings"
@inherits GuildAdminPageBase

<PageTitle>Settings</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else
{
    <h1>Settings</h1>
    <p>Settings not tied to one feature — per-feature channels/roles live on that feature's own page (see Features).</p>

    <SettingsEditor GuildId="ParsedGuildId" />
}
