@page "/manage/guilds/{GuildId}"
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject GuildFeatureService FeatureService

<PageTitle>@(guildName ?? "Guild")</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else
{
    <h1>@guildName</h1>

    <div class="row g-3">
        <div class="col-sm-6 col-lg-4">
            <a class="card h-100 text-decoration-none text-body" href="manage/guilds/@GuildId/features">
                <div class="card-body">
                    <span class="oi oi-puzzle-piece fs-4" style="color:rgb(5,39,103);" aria-hidden="true"></span>
                    <h2 class="fs-5 fw-semibold mt-2 mb-1">Features</h2>
                    <p class="mb-0" style="color:#5a5a63;">@enabledCount/@totalCount enabled</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a class="card h-100 text-decoration-none text-body" href="manage/guilds/@GuildId/settings">
                <div class="card-body">
                    <span class="oi oi-cog fs-4" style="color:rgb(5,39,103);" aria-hidden="true"></span>
                    <h2 class="fs-5 fw-semibold mt-2 mb-1">Settings</h2>
                    <p class="mb-0" style="color:#5a5a63;">@audienceSummary</p>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-4">
            <a class="card h-100 text-decoration-none text-body" href="manage/guilds/@GuildId/setup-wizard">
                <div class="card-body">
                    <span class="oi oi-list-rich fs-4" style="color:rgb(5,39,103);" aria-hidden="true"></span>
                    <h2 class="fs-5 fw-semibold mt-2 mb-1">Setup Wizard</h2>
                    <p class="mb-0" style="color:#5a5a63;">@(setupComplete ? "Setup complete" : "Needs setup")</p>
                </div>
            </a>
        </div>
    </div>
}

@code {
    private static readonly GuildAudience[] AudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private string? guildName;
    private string audienceSummary = "Not configured yet";
    private bool setupComplete;
    private int enabledCount;
    private int totalCount;

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        guildName = await db.DiscordGuilds
            .Where(g => g.Id == ParsedGuildId)
            .Select(g => g.Name)
            .FirstOrDefaultAsync();

        var settings = await db.GuildSettings.Where(s => s.GuildId == ParsedGuildId).FirstOrDefaultAsync();
        var guildAudiences = settings?.Audiences ?? GuildAudience.None;
        setupComplete = settings?.SetupCompletedAt is not null;
        audienceSummary = guildAudiences == GuildAudience.None
            ? "Not configured yet"
            : string.Join(", ", AudienceDisplay.Labels(guildAudiences));

        var enabledFeatures = new HashSet<(GuildFeature Feature, GuildAudience Audience)>();
        foreach (var feature in FeatureCatalog.All)
        {
            var audiences = await FeatureService.GetEnabledAudiencesAsync(ParsedGuildId, feature.Feature);
            foreach (var audience in audiences)
                enabledFeatures.Add((feature.Feature, audience));
        }

        enabledCount = 0;
        totalCount = 0;
        foreach (var audience in AudienceSections)
        {
            if (guildAudiences != GuildAudience.None && !guildAudiences.HasFlag(audience))
                continue;

            foreach (var feature in FeatureCatalog.All)
            {
                if (!feature.RelevantAudiences().HasFlag(audience))
                    continue;

                totalCount++;
                if (enabledFeatures.Contains((feature.Feature, audience)))
                    enabledCount++;
            }
        }
    }
}
