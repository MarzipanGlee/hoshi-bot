@page "/manage/guilds"
@inject HoshiBotDbContext Db
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Your Guilds</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Your Guilds</h1>
        @if (accessibleGuilds is null)
        {
            <p>Loading...</p>
        }
        else if (accessibleGuilds.Count == 0)
        {
            <p>You don't have admin access to any guild Hoshi Bot manages.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Guild</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guild in accessibleGuilds)
                    {
                        <tr>
                            <td>@guild.Name</td>
                            <td>
                                @if (!setupCompleteGuildIds.Contains(guild.Id))
                                {
                                    <span class="badge bg-warning text-dark">needs setup</span>
                                }
                            </td>
                            <td>
                                <a href="manage/guilds/@guild.Id/setup">Setup Wizard</a> |
                                <a href="manage/guilds/@guild.Id/scope">Scope</a> |
                                <a href="manage/guilds/@guild.Id/settings">Settings</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </Authorized>
    <NotAuthorized>
        <p><a href="login?returnUrl=%2Fmanage%2Fguilds">Log in with Discord</a> to manage your guilds.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<DiscordGuild>? accessibleGuilds;
    private HashSet<ulong> setupCompleteGuildIds = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var allGuilds = await Db.DiscordGuilds.AsNoTracking().ToListAsync();
        var accessible = new List<DiscordGuild>();
        foreach (var guild in allGuilds)
        {
            var result = await AuthorizationService.AuthorizeAsync(user, guild.Id, new GuildAdminRequirement());
            if (result.Succeeded)
                accessible.Add(guild);
        }

        accessibleGuilds = accessible;
        setupCompleteGuildIds = (await Db.GuildSettings
            .Where(s => s.SetupCompletedAt != null)
            .Select(s => s.GuildId)
            .ToListAsync())
            .ToHashSet();
    }
}
