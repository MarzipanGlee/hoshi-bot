@page "/manage/guilds/{GuildId}/scope"
@inherits GuildAdminPageBase

<PageTitle>Guild Scope</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else
{
    <h1>Scope Settings</h1>
    <p>Which shared alliances, servers, and veil groups this guild tracks. A guild can link any combination — none linked at all means a "global" guild.</p>

    <ScopeEditor GuildId="ParsedGuildId" />
}
