@page "/manage/guilds/{GuildId}/features"
@implements IDisposable
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject GuildFeatureService FeatureService
@inject GuildFeatureSettingsService SettingsService
@inject CurrentAllianceContext AllianceContext
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedLocalStorage Storage

<PageTitle>Features</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else
{
    <div class="d-flex align-items-center justify-content-between mt-3">
        <h1>Features</h1>
        <div class="form-switch">
            <input class="form-check-input" type="checkbox" id="hideInactive" role="switch"
                   checked="@hideInactive" @onchange="ToggleHideInactiveAsync" />
            <label class="form-check-label" for="hideInactive">Hide inactive features</label>
        </div>
    </div>

    @foreach (var audience in AudienceSections)
    {
        if (guildAudiences != GuildAudience.None && !guildAudiences.HasFlag(audience))
            continue;

        // The Alliance section shows the currently-selected alliance (top-bar AllianceSelector).
        // With no alliance linked there's nothing to scope to, so skip it (Audience page links one).
        if (audience == GuildAudience.Alliance && SelectedAllianceId is null)
            continue;

        var features = FeatureCatalog.All.Where(f => f.RelevantAudiences().HasFlag(audience)).ToList();
        if (hideInactive)
            features = features.Where(f => enabledFeatures.Contains((f.Feature, audience))).ToList();

        if (features.Count == 0)
            continue;

        <h3 class="fs-6 fw-semibold text-uppercase mt-4" style="color:#5a5a63;letter-spacing:0.03em;margin-bottom:0.75rem;">@SectionHeader(audience)</h3>
        <div class="card-grid">
            @foreach (var feature in features)
            {
                var enabled = enabledFeatures.Contains((feature.Feature, audience));
                var configured = enabled && configuredFeatures.Contains((feature.Feature, audience));
                var borderClass = !enabled ? "border-danger"
                    : configured ? "border-success"
                    : "border-warning";
                <ToggleCard Icon="@feature.Icon" Title="@feature.Title" Description="@feature.Description"
                            BorderClass="@borderClass" Enabled="@enabled"
                            EnabledChanged="e => ToggleFeatureAsync(feature.Feature, audience, e)">
                    <FooterEnd>
                        <a class="btn btn-sm btn-outline-secondary" href="@FeatureHref(feature, audience)">Configure</a>
                    </FooterEnd>
                </ToggleCard>
            }
        </div>
    }
}

@code {
    private static readonly GuildAudience[] AudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private const string HideInactiveStorageKey = "hoshibot.hideInactiveFeatures";

    private GuildAudience guildAudiences = GuildAudience.None;
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> enabledFeatures = [];
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> configuredFeatures = [];
    private bool hideInactive;

    // The Alliance section reflects the alliance chosen in the top-bar AllianceSelector; other
    // audiences are guild-scoped (null).
    private int? SelectedAllianceId => AllianceContext.GuildAllianceId;
    private int? Scope(GuildAudience audience) => audience == GuildAudience.Alliance ? SelectedAllianceId : null;

    private string SectionHeader(GuildAudience audience) =>
        audience == GuildAudience.Alliance && AllianceContext.Alliance is { } link
            ? $"Alliance — [{link.StfcAlliance.Tag}]"
            : AudienceDisplay.Labels(audience).First();

    private string FeatureHref(IFeatureModule feature, GuildAudience audience) =>
        audience == GuildAudience.Alliance
            ? $"manage/guilds/{GuildId}/features/{feature.Slug}/alliance/{SelectedAllianceId}"
            : $"manage/guilds/{GuildId}/features/{feature.Slug}/{AudienceDisplay.Slug(audience)}";

    protected override void OnInitialized() => AllianceContext.Changed += OnAllianceChanged;

    private void OnAllianceChanged() => InvokeAsync(async () =>
    {
        await LoadFeaturesAsync();
        StateHasChanged();
    });

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        var storedHideInactive = await Storage.GetAsync<bool>(HideInactiveStorageKey);
        if (storedHideInactive.Success)
            hideInactive = storedHideInactive.Value;

        await using var db = await DbFactory.CreateDbContextAsync();
        guildAudiences = await db.GuildSettings
            .Where(s => s.GuildId == ParsedGuildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();

        await LoadFeaturesAsync();
    }

    // Builds the enabled/configured sets for the current selected alliance. Re-run on alliance
    // switch so the Alliance section reflects the chosen alliance specifically (not "any alliance").
    private async Task LoadFeaturesAsync()
    {
        var enabledScopes = await FeatureService.GetEnabledAsync(ParsedGuildId);
        var context = new FeatureModuleContext(FeatureService, SettingsService, DbFactory);
        enabledFeatures = [];
        configuredFeatures = [];
        foreach (var feature in FeatureCatalog.All)
        {
            foreach (var audience in GuildFeatureAudiences.EnumerateFlags(feature.RelevantAudiences()))
            {
                if (audience == GuildAudience.Alliance && SelectedAllianceId is null)
                    continue;

                var scope = Scope(audience);
                if (!enabledScopes.Contains((feature.Feature, audience, scope)))
                    continue;

                enabledFeatures.Add((feature.Feature, audience));
                if (await feature.IsConfiguredAsync(ParsedGuildId, audience, scope, context))
                    configuredFeatures.Add((feature.Feature, audience));
            }
        }
    }

    private async Task ToggleFeatureAsync(GuildFeature feature, GuildAudience audience, bool enabled)
    {
        await FeatureService.SetEnabledAsync(ParsedGuildId, feature, audience, Scope(audience), enabled);
        if (enabled)
        {
            enabledFeatures.Add((feature, audience));

            var module = FeatureCatalog.All.First(f => f.Feature == feature);
            var context = new FeatureModuleContext(FeatureService, SettingsService, DbFactory);
            if (await module.IsConfiguredAsync(ParsedGuildId, audience, Scope(audience), context))
                configuredFeatures.Add((feature, audience));
        }
        else
        {
            enabledFeatures.Remove((feature, audience));
        }
    }

    public void Dispose() => AllianceContext.Changed -= OnAllianceChanged;

    private async Task ToggleHideInactiveAsync(ChangeEventArgs e)
    {
        hideInactive = (bool)e.Value!;
        await Storage.SetAsync(HideInactiveStorageKey, hideInactive);
    }
}
