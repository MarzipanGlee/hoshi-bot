@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@inject GuildFeatureSettingsService SettingsService
@inject DiscordGuildDataService DiscordData

<p class="form-text">
    The bot listens to every message in the <strong>listen channels</strong> and answers with Google
    Gemini <strong>or</strong> a local Ollama model when it has a genuinely helpful reply (staying
    silent otherwise). It always answers when addressed by its nickname or @@mention. Answers are
    grounded in the recent conversation plus the configured <strong>knowledge channels</strong>.
    Gemini requires this guild's own API key; Ollama runs on the shared local server (no key).
</p>

<div class="form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch" checked="@Enabled"
           @onchange="e => ToggleEnabledAsync((bool)e.Value!)" />
    <label class="form-check-label">Enabled</label>
</div>

<div class="card-grid mt-1">
    <SettingsCard Title="KI-Anbieter">
        <label for="aiChatProvider" class="form-label">
            Welches Sprachmodell diese Gilde nutzt. <strong>Gemini</strong> (Google-Cloud, eigener
            API-Schlüssel nötig) oder <strong>Ollama</strong> (lokales Modell auf dem gemeinsamen
            Server, kein Schlüssel nötig).
        </label>
        <select id="aiChatProvider" class="form-select" @bind="providerInput" @bind:after="SaveProviderAsync">
            <option value="gemini">Google Gemini</option>
            <option value="ollama">Ollama (lokal)</option>
        </select>
    </SettingsCard>

    @if (providerInput != "ollama")
    {
        <SettingsCard Title="Gemini API Key">
            <label class="form-label">
                Dieser Gilde eigener Google-Gemini-API-Schlüssel. Wird für alle KI-Antworten verwendet und
                im Klartext gespeichert.
            </label>
            @if (hasKey)
            {
                <p class="form-text mb-1 text-success">Ein Schlüssel ist gespeichert. Neuen Wert eingeben, um ihn zu ersetzen.</p>
            }
            <div class="d-flex gap-2">
                <input type="password" class="form-control" autocomplete="off"
                       placeholder="@(hasKey ? "•••••••• (gespeichert)" : "API-Schlüssel eingeben")"
                       @bind="apiKeyInput" @bind:after="SaveApiKeyAsync" />
                @if (hasKey)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="ClearApiKeyAsync">Löschen</button>
                }
            </div>
        </SettingsCard>
    }

    <MultiChannelPicker GuildId="GuildId" Feature="GuildFeature.AiChat" Audience="ResolvedAudience"
        Title="Zuhör-Kanäle" Usage="Kanäle, in denen der Bot mitliest und antwortet." />

    <MultiChannelPicker GuildId="GuildId" Feature="GuildFeature.AiChatKnowledge" Audience="ResolvedAudience"
        AllowCategories="true"
        Title="Wissensquellen-Kanäle" Usage="Kanäle (oder ganze Kategorien), deren aktuelle Nachrichten der Bot als Wissensbasis für Antworten heranzieht." />

    <SettingsCard Title="System-Prompt (optional)">
        <label for="aiChatSystemPrompt" class="form-label">
            Zusätzliche Persönlichkeits-/Verhaltensanweisung, die dem Standard-Prompt vorangestellt wird.
        </label>
        <textarea id="aiChatSystemPrompt" class="form-control flex-grow-1" rows="4"
                  @bind="systemPromptInput" @bind:after="SaveSystemPromptAsync"></textarea>
    </SettingsCard>

    <SettingsCard Title="Modell (optional)">
        @if (providerInput == "ollama")
        {
            <label for="aiChatModel" class="form-label">
                Ollama-Modell. Leer lassen für das Standardmodell des Servers.
            </label>
            <input id="aiChatModel" class="form-control" placeholder="Standardmodell des Servers"
                   @bind="modelInput" @bind:after="SaveModelAsync" />
        }
        else
        {
            <label for="aiChatModel" class="form-label">
                Gemini-Modell. Leer lassen für den Standard (@AiChatSettingKeys.DefaultModel).
            </label>
            <input id="aiChatModel" class="form-control" placeholder="@AiChatSettingKeys.DefaultModel"
                   @bind="modelInput" @bind:after="SaveModelAsync" />
        }
    </SettingsCard>

    <SettingsCard Title="Suchsprache">
        <label for="aiChatSearchLanguage" class="form-label">
            Sprache für die Volltextsuche in den Wissensquellen (bestimmt die Wortstamm-Erkennung).
            Vorbelegt aus der Server-Sprache.
        </label>
        <select id="aiChatSearchLanguage" class="form-select" @bind="searchLanguageInput" @bind:after="SaveSearchLanguageAsync">
            @foreach (var lang in FtsLanguage.SupportedConfigs)
            {
                <option value="@lang">@lang</option>
            }
        </select>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AiChat;

    private bool hasKey;
    private string? apiKeyInput;
    private string providerInput = "gemini";
    private string? systemPromptInput;
    private string? modelInput;
    private string? searchLanguageInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        // The stored API key is never echoed back into the field — we only track whether one
        // exists and let the admin overwrite it.
        hasKey = !string.IsNullOrWhiteSpace(await GetText(AiChatSettingKeys.ApiKey));
        // Unset/unknown provider means Gemini (matches AiChatService's default).
        var storedProvider = await GetText(AiChatSettingKeys.Provider);
        providerInput = string.Equals(storedProvider, "ollama", StringComparison.OrdinalIgnoreCase) ? "ollama" : "gemini";
        systemPromptInput = await GetText(AiChatSettingKeys.SystemPrompt);
        modelInput = await GetText(AiChatSettingKeys.Model);

        // Show the effective search language: the stored choice, or the default derived from the
        // guild's Discord locale when unset (matches what the bot resolves at query time).
        var storedLanguage = await GetText(AiChatSettingKeys.SearchLanguage);
        searchLanguageInput = !string.IsNullOrWhiteSpace(storedLanguage)
            ? FtsLanguage.Normalize(storedLanguage)
            : FtsLanguage.FromDiscordLocale(await DiscordData.GetPreferredLocaleAsync(GuildId));
    }

    // The API key, system prompt, and model are guild-wide (one Gemini account per guild), so
    // they're stored at the None/null scope and shown identically on every audience tab — only the
    // channel lists below are per-audience. Mirrors ClientRelease's guild-wide platform roles.
    private Task<string?> GetText(string key) =>
        SettingsService.GetTextAsync(GuildId, Feature, GuildAudience.None, null, key);

    private Task SetText(string key, string? value) =>
        SettingsService.SetTextAsync(GuildId, Feature, GuildAudience.None, null, key, value);

    private async Task SaveApiKeyAsync()
    {
        // Blank submit leaves the existing key untouched (use "Löschen" to remove it).
        if (string.IsNullOrWhiteSpace(apiKeyInput))
            return;

        await SetText(AiChatSettingKeys.ApiKey, apiKeyInput.Trim());
        apiKeyInput = null;
        hasKey = true;
    }

    private async Task ClearApiKeyAsync()
    {
        await SetText(AiChatSettingKeys.ApiKey, null);
        apiKeyInput = null;
        hasKey = false;
    }

    private Task SaveProviderAsync() => SetText(AiChatSettingKeys.Provider, providerInput);

    private Task SaveSystemPromptAsync() => SetText(AiChatSettingKeys.SystemPrompt, systemPromptInput);

    private Task SaveModelAsync() => SetText(AiChatSettingKeys.Model, modelInput);

    private Task SaveSearchLanguageAsync() => SetText(AiChatSettingKeys.SearchLanguage, searchLanguageInput);
}
