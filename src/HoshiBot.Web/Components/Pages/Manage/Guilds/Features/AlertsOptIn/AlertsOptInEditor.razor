@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<div class="form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch" checked="@Enabled"
           @onchange="e => ToggleEnabledAsync((bool)e.Value!)" />
    <label class="form-check-label">Enabled</label>
</div>

@if (createRoleError is not null)
{
    <p class="text-danger">@createRoleError</p>
}

<div class="row g-3 mt-1">
    <SettingsCard Title="Alerts">
        <RolePicker Label="Alerts" ShowLabel="false" Usage="Role members opt into via the hub's 'manage alerts' button, to receive raid/shield pings." CreateRoleName="Alerts"
            @bind-Value="roleIdInput" @bind-Value:after="SaveRoleAsync" Roles="roles" />
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AlertsOptIn;

    private GuildAudience audience;
    private List<Role> roles = [];
    private string? roleIdInput;
    private string? createRoleError;

    protected override async Task OnSettingsLoadedAsync()
    {
        audience = GuildFeatureAudiences.SingleAudience(Feature);
        roles = await DiscordData.GetRolesAsync(GuildId);
        roleIdInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, audience, AlertsOptInSettingKeys.Role))?.ToString();
    }

    private async Task SaveRoleAsync()
    {
        createRoleError = null;
        try
        {
            var roleId = await DiscordData.EnsureRoleAsync(GuildId, roleIdInput, "Alerts");
            roleIdInput = roleId?.ToString();
            roles = await DiscordData.GetRolesAsync(GuildId);
            await SettingsService.SetSnowflakeAsync(GuildId, Feature, audience, AlertsOptInSettingKeys.Role, roleId);
        }
        catch (RestException)
        {
            createRoleError = "Could not create a role on Discord — does the bot have Manage Roles permission in this server?";
            if (roleIdInput == RolePicker.CreateSentinel)
                roleIdInput = null;
        }
    }
}
