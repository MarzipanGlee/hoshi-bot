@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService
@inject GuildFeatureService FeatureService

@foreach (var audience in GuildFeatureAudiences.EnumerateFlags(RelevantAudiences))
{
    var state = blocks[audience];
    <h3 class="mt-4">@AudienceDisplay.Labels(audience).First()</h3>
    <div class="form-check form-switch mb-3">
        <input type="checkbox" class="form-check-input" role="switch" checked="@state.Enabled"
               @onchange="e => ToggleAsync(audience, (bool)e.Value!)" />
        <label class="form-check-label">Enabled</label>
    </div>

    <ChannelPicker Label="Announcements" Usage="Where published announcements are posted."
        @bind-Value="state.ChannelInput" @bind-Value:after="() => SaveChannelAsync(audience)" Channels="channels" />

    <ChannelPicker Label="Announcements Reminders" Usage="A second channel that gets reminder pings for unread announcements."
        @bind-Value="state.RemindersChannelInput" @bind-Value:after="() => SaveRemindersChannelAsync(audience)" Channels="channels" />

    <ChannelPicker Label="Announcements Draft" Usage="Where staff post announcement drafts (plain message, attachments allowed) before publishing them."
        @bind-Value="state.DraftChannelInput" @bind-Value:after="() => SaveDraftChannelAsync(audience)" Channels="channels" />
}

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    private static readonly GuildAudience RelevantAudiences = GuildFeatureAudiences.RelevantAudiences(GuildFeature.Announcements);

    private sealed class AudienceBlock
    {
        public bool Enabled { get; set; }
        public string? ChannelInput { get; set; }
        public string? RemindersChannelInput { get; set; }
        public string? DraftChannelInput { get; set; }
    }

    private List<IGuildChannel> channels = [];
    private readonly Dictionary<GuildAudience, AudienceBlock> blocks = [];

    protected override async Task OnInitializedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        foreach (var audience in GuildFeatureAudiences.EnumerateFlags(RelevantAudiences))
        {
            blocks[audience] = new AudienceBlock
            {
                Enabled = await FeatureService.IsEnabledAsync(GuildId, GuildFeature.Announcements, audience),
                ChannelInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.Channel))?.ToString(),
                RemindersChannelInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.RemindersChannel))?.ToString(),
                DraftChannelInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.DraftChannel))?.ToString(),
            };
        }
    }

    private async Task ToggleAsync(GuildAudience audience, bool enabled)
    {
        await FeatureService.SetEnabledAsync(GuildId, GuildFeature.Announcements, audience, enabled);
        blocks[audience].Enabled = enabled;
    }

    private Task SaveChannelAsync(GuildAudience audience) =>
        SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.Channel, ParseId(blocks[audience].ChannelInput));

    private Task SaveRemindersChannelAsync(GuildAudience audience) =>
        SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.RemindersChannel, ParseId(blocks[audience].RemindersChannelInput));

    private Task SaveDraftChannelAsync(GuildAudience audience) =>
        SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.Announcements, audience, AnnouncementsSettingKeys.DraftChannel, ParseId(blocks[audience].DraftChannelInput));

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;
}
