@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<div class="form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch" checked="@Enabled"
           @onchange="e => ToggleEnabledAsync((bool)e.Value!)" />
    <label class="form-check-label">Enabled</label>
</div>

<div class="card-grid mt-1">
    <SettingsCard Title="Absences Report">
        <ChannelPicker Label="Absences Report" ShowLabel="false" Usage="Where the public, kept-updated absence report is posted. Each entry respects the member's chosen privacy setting."
            @bind-Value="reportChannelIdInput" @bind-Value:after="SaveReportChannelAsync" Channels="channels" />
    </SettingsCard>

    <SettingsCard Title="Absences Report (Staff)">
        <ChannelPicker Label="Absences Report (Staff)" ShowLabel="false" Usage="A staff-only copy of the report that always shows every absence in full, ignoring members' privacy settings."
            @bind-Value="staffChannelIdInput" @bind-Value:after="SaveStaffChannelAsync" Channels="channels" />
    </SettingsCard>

    <SettingsCard Title="Notification Role">
        <RolePicker Label="Notification Role" ShowLabel="false"
            Usage="The role members opt into to be pinged for alliance activity (the Territory Capture weekly digest and Elevated announcements). Kept absence-clean automatically: a member with an active absence that suppresses notifications is removed from it until the absence ends. Also editable on the Territory Capture page — it's the same setting."
            @bind-Value="notificationRoleInput" @bind-Value:after="SaveNotificationRoleAsync" Roles="roles" />
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.Absences;

    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? reportChannelIdInput;
    private string? staffChannelIdInput;
    private string? notificationRoleInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        reportChannelIdInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.ReportChannel))?.ToString();
        staffChannelIdInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.ReportStaffChannel))?.ToString();
        notificationRoleInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.NotificationRole))?.ToString();
    }

    private Task SaveReportChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.ReportChannel, ParseId(reportChannelIdInput));

    private Task SaveStaffChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.ReportStaffChannel, ParseId(staffChannelIdInput));

    private Task SaveNotificationRoleAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AbsencesSettingKeys.NotificationRole, ParseId(notificationRoleInput));
}
