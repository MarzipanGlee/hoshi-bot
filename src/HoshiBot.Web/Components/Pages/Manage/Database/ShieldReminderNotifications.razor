@page "/manage/database/shield-reminder-notifications"
@inherits DbContextPageBase

<PageTitle>Shield Reminder Notifications</PageTitle>

<h1>Shield Reminder Notifications</h1>
<p>Read-only — one row per channel/DM a shield reminder was sent to. For debugging.</p>

<QuickGrid Class="table" Items="Context.ShieldReminderNotifications.OrderByDescending(n => n.Id)">
    <PropertyColumn Property="notification => notification.Id" Sortable="true" />
    <PropertyColumn Property="notification => notification.ShieldReminderId" Sortable="true" />
    <PropertyColumn Property="notification => notification.Kind" Sortable="true" />
    <PropertyColumn Property="notification => notification.ChannelId" Sortable="true" />
    <PropertyColumn Property="notification => notification.MessageId" Sortable="true" />
    <PropertyColumn Property="notification => notification.SentAt" Sortable="true" />
</QuickGrid>
