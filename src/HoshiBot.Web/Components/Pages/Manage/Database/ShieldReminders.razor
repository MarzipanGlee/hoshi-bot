@page "/manage/database/shield-reminders"
@inherits DbContextPageBase

<PageTitle>Shield Reminders</PageTitle>

<h1>Shield Reminders</h1>
<p>Read-only — a member's self-set shield-expiration countdown. For debugging.</p>

<QuickGrid Class="table" Items="Context.ShieldReminders.Include(r => r.StfcSystem).OrderByDescending(r => r.Id)">
    <PropertyColumn Property="reminder => reminder.Id" Sortable="true" />
    <PropertyColumn Property="reminder => reminder.GuildId" Sortable="true" />
    <PropertyColumn Property="reminder => reminder.DiscordUserId" Sortable="true" />
    <PropertyColumn Property="reminder => reminder.ShieldExpiration" Sortable="true" />
    <PropertyColumn Property="reminder => reminder.StfcSystem == null ? null : reminder.StfcSystem.Name" Title="System" Sortable="true" />
    <PropertyColumn Property="reminder => reminder.Disabled" Sortable="true" />
</QuickGrid>
