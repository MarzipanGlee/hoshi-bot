@page "/manage/database/alert-notifications"
@inherits DbContextPageBase

<PageTitle>Alert Notifications</PageTitle>

<h1>Alert Notifications</h1>
<p>Read-only — one row per channel/DM an alert was fanned out to. For debugging.</p>

<QuickGrid Class="table" Items="Context.AlertNotifications.OrderByDescending(n => n.Id)">
    <PropertyColumn Property="notification => notification.Id" Sortable="true" />
    <PropertyColumn Property="notification => notification.AlertId" Sortable="true" />
    <PropertyColumn Property="notification => notification.Kind" Sortable="true" />
    <PropertyColumn Property="notification => notification.ChannelId" Sortable="true" />
    <PropertyColumn Property="notification => notification.MessageId" Sortable="true" />
    <PropertyColumn Property="notification => notification.SentAt" Sortable="true" />
</QuickGrid>
