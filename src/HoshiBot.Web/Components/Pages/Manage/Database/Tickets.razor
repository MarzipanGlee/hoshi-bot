@page "/manage/database/tickets"
@inherits DbContextPageBase

<PageTitle>Tickets</PageTitle>

<h1>Tickets</h1>
<p>Read-only — a support thread under the guild's Tickets channel. For debugging.</p>

<QuickGrid Class="table" Items="Context.Tickets.OrderByDescending(t => t.Id)">
    <PropertyColumn Property="ticket => ticket.Id" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.GuildId" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.ThreadId" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.Subject" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.OpenedByDiscordUserId" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.Audience" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.Status" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.CreatedAt" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.ClosedAt" Sortable="true" />
    <PropertyColumn Property="ticket => ticket.ClosedByDiscordUserId" Sortable="true" />
</QuickGrid>
