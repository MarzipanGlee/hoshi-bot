@page "/manage/database/discord-guilds"
@inherits DbContextPageBase

<PageTitle>Discord Guilds</PageTitle>

<h1>Discord Guilds</h1>
<p>Read-only — synced from Discord, not admin-editable here. For debugging.</p>

<QuickGrid Class="table" Items="Context.DiscordGuilds.OrderBy(g => g.Name)">
    <PropertyColumn Property="guild => guild.Id" Sortable="true" />
    <PropertyColumn Property="guild => guild.Name" Sortable="true" />
    <PropertyColumn Property="guild => guild.Locale" Sortable="true" />
</QuickGrid>
