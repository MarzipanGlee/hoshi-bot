@page "/manage/database/absences"
@inherits DbContextPageBase

<PageTitle>Absences</PageTitle>

<h1>Absences</h1>
<p>Read-only — managed entirely via Discord buttons/modals. For debugging.</p>

<QuickGrid Class="table" Items="Context.Absences.OrderByDescending(a => a.Id)">
    <PropertyColumn Property="absence => absence.Id" Sortable="true" />
    <PropertyColumn Property="absence => absence.GuildId" Sortable="true" />
    <PropertyColumn Property="absence => absence.DiscordUserId" Sortable="true" />
    <PropertyColumn Property="absence => absence.StartsAt" Sortable="true" />
    <PropertyColumn Property="absence => absence.EndsAt" Sortable="true" />
    <PropertyColumn Property="absence => absence.Reason" Sortable="true" />
    <PropertyColumn Property="absence => absence.SuppressNotifications" Sortable="true" />
    <PropertyColumn Property="absence => absence.Visibility" Sortable="true" />
    <PropertyColumn Property="absence => absence.Status" Sortable="true" />
    <PropertyColumn Property="absence => absence.CreatedByDiscordUserId" Sortable="true" />
    <PropertyColumn Property="absence => absence.CreatedAt" Sortable="true" />
    <PropertyColumn Property="absence => absence.EditsAbsenceId" Sortable="true" />
</QuickGrid>
