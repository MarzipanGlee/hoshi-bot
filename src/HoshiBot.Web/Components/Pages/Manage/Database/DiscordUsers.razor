@page "/manage/database/discord-users"
@inherits DbContextPageBase

<PageTitle>Discord Users</PageTitle>

<h1>Discord Users</h1>
<p>Read-only — synced from Discord, not admin-editable here. For debugging.</p>

<QuickGrid Class="table" Items="Context.DiscordUsers">
    <PropertyColumn Property="user => user.DiscordUserId" Sortable="true" />
    <PropertyColumn Property="user => user.PlayerLinks.Count" Title="Linked Players" Sortable="true" />
    <PropertyColumn Property="user => user.GuildMemberships.Count" Title="Guild Memberships" Sortable="true" />
</QuickGrid>
