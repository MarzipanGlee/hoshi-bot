@page "/manage/database/discord-users"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>Discord Users</PageTitle>

<h1>Discord Users</h1>
<p>Read-only — synced from Discord, not admin-editable here. For debugging.</p>

@* DiscordUserId is a ulong (Discord snowflake) — SQLite's EF Core provider can't
   translate it in ORDER BY, so this is left unordered and DiscordUserId non-sortable. *@
<QuickGrid Class="table" Items="context.DiscordUsers">
    <PropertyColumn Property="user => user.DiscordUserId" />
    <PropertyColumn Property="user => user.PlayerLinks.Count" Title="Linked Players" />
    <PropertyColumn Property="user => user.GuildMemberships.Count" Title="Guild Memberships" />
</QuickGrid>

@code {
    private HoshiBotDbContext context = default!;

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
