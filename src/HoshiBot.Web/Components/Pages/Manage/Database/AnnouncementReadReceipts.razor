@page "/manage/database/announcement-read-receipts"
@inherits DbContextPageBase

<PageTitle>Announcement Read Receipts</PageTitle>

<h1>Announcement Read Receipts</h1>
<p>Read-only — one row per member who clicked "read confirm" on an announcement. For debugging.</p>

<QuickGrid Class="table" Items="Context.AnnouncementReadReceipts.OrderByDescending(r => r.Id)">
    <PropertyColumn Property="receipt => receipt.Id" Sortable="true" />
    <PropertyColumn Property="receipt => receipt.AnnouncementId" Sortable="true" />
    <PropertyColumn Property="receipt => receipt.GuildId" Sortable="true" />
    <PropertyColumn Property="receipt => receipt.DiscordUserId" Sortable="true" />
    <PropertyColumn Property="receipt => receipt.ReadAt" Sortable="true" />
</QuickGrid>
