@page "/manage/database/stfc-event-date-confirmations"
@inherits DbContextPageBase

<PageTitle>STFC Event Date Confirmations</PageTitle>

<h1>STFC Event Date Confirmations</h1>
<p>Read-only — one row per Discord user who confirmed a news post's submitted date. For debugging.</p>

<QuickGrid Class="table" Items="Context.StfcEventDateConfirmations.OrderByDescending(c => c.Id)">
    <PropertyColumn Property="confirmation => confirmation.Id" Sortable="true" />
    <PropertyColumn Property="confirmation => confirmation.StfcNewsPostId" Sortable="true" />
    <PropertyColumn Property="confirmation => confirmation.DiscordUserId" Sortable="true" />
    <PropertyColumn Property="confirmation => confirmation.ConfirmedAt" Sortable="true" />
</QuickGrid>
