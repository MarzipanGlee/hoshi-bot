@page "/manage/database/stfc-news-post-guild-messages"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>STFC News Post Guild Messages</PageTitle>

<h1>STFC News Post Guild Messages</h1>
<p>Read-only — one row per guild pinged for a news post, so its copy of the message can be edited in place. For debugging.</p>

@* GuildId is a ulong (Discord snowflake) — SQLite's EF Core provider can't translate it
   in ORDER BY, so it's left non-sortable here. *@
<QuickGrid Class="table" Items="context.StfcNewsPostGuildMessages.OrderByDescending(m => m.Id)">
    <PropertyColumn Property="message => message.Id" Sortable="true" />
    <PropertyColumn Property="message => message.StfcNewsPostId" Sortable="true" />
    <PropertyColumn Property="message => message.GuildId" />
    <PropertyColumn Property="message => message.ChannelId" />
    <PropertyColumn Property="message => message.MessageId" />
    <PropertyColumn Property="message => message.EligibleMemberCount" Sortable="true" />
</QuickGrid>

@code {
    private HoshiBotDbContext context = default!;

    protected override void OnInitialized() => context = DbFactory.CreateDbContext();

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
