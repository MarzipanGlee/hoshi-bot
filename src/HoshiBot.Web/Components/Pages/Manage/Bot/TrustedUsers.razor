@page "/manage/bot/trusted-users"

<PageTitle>Trusted Users</PageTitle>

<h1>Trusted Users</h1>
<p>
    Discord users whose confirmation of an STFC News event date is trusted enough to
    resolve it immediately, without waiting for the usual confirmation quorum.
</p>

<SnowflakeAllowListEditor TItem="TrustedUser" FormName="add-trusted-user"
    Items="@(db => db.TrustedUsers)" Id="@(u => u.DiscordUserId)" Create="CreateUser"
    ExtraColumnHeader="Display Name" OnAdded="() => newDisplayNameInput = null">
    <ExtraColumn>@context.DisplayName</ExtraColumn>
    <ExtraInputs>
        <input type="text" class="form-control d-inline-block w-auto" @bind="newDisplayNameInput" placeholder="Display name (optional)" />
    </ExtraInputs>
</SnowflakeAllowListEditor>

@code {
    private string? newDisplayNameInput;

    private TrustedUser CreateUser(ulong discordUserId) => new()
    {
        DiscordUserId = discordUserId,
        DisplayName = string.IsNullOrWhiteSpace(newDisplayNameInput) ? null : newDisplayNameInput,
        AddedAt = DateTimeOffset.UtcNow,
    };
}
