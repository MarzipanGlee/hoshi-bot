@page "/manage/bot/incursions-schedule"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Infinite Incursions Schedule</PageTitle>

@if (authorized is null)
{
    <p>Checking access...</p>
}
else if (authorized == false)
{
    <p>You do not have admin access to this page.</p>
}
else
{
    <h1>Infinite Incursions Schedule</h1>
    <p>
        Infinite Incursions has 3 distinct regional start times. An admin only ever submits
        one shared event date — these preserved daily times (and the event's duration) are
        combined with that date to produce each region's actual start/end.
    </p>

    <EditForm Model="this" FormName="incursions-schedule" OnValidSubmit="SaveAsync">
        <table class="table" style="max-width: 500px;">
            <thead><tr><th>Region</th><th>Default start time (UTC)</th></tr></thead>
            <tbody>
                @foreach (var row in regionRows)
                {
                    <tr>
                        <td>@row.RegionName</td>
                        <td><input type="time" class="form-control" @bind="row.StartTime" /></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mb-3" style="max-width: 200px;">
            <label class="form-label">Event duration (hours)</label>
            <input type="number" class="form-control" min="1" max="72" @bind="durationHours" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        @if (saved)
        {
            <span class="text-success ms-2">Saved.</span>
        }
    </EditForm>
}

@code {
    private bool? authorized;
    private List<RegionRow> regionRows = [];
    private int durationHours = 12;
    private bool saved;

    private class RegionRow
    {
        public int RegionId { get; set; }
        public required string RegionName { get; set; }
        public TimeOnly StartTime { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var result = await AuthorizationService.AuthorizeAsync(authState.User, null, new GlobalAdminRequirement());
        authorized = result.Succeeded;

        if (authorized == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var defaults = await db.IncursionsRegionDefaults.AsNoTracking().Include(d => d.Region).ToListAsync();
        regionRows = defaults
            .OrderBy(d => d.Region.Name)
            .Select(d => new RegionRow
            {
                RegionId = d.RegionId,
                RegionName = d.Region.Name,
                StartTime = d.DefaultStartTimeUtc,
            })
            .ToList();

        var settings = await db.StfcNewsSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
        if (settings is not null)
            durationHours = settings.IncursionsEventDurationHours;
    }

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Load the existing rows once (tracked) instead of a FirstOrDefaultAsync per region.
        var existingByRegion = await db.IncursionsRegionDefaults.ToDictionaryAsync(d => d.RegionId);
        foreach (var row in regionRows)
        {
            if (existingByRegion.TryGetValue(row.RegionId, out var existing))
                existing.DefaultStartTimeUtc = row.StartTime;
            else
                db.IncursionsRegionDefaults.Add(new IncursionsRegionDefault { RegionId = row.RegionId, DefaultStartTimeUtc = row.StartTime });
        }

        var settings = await db.StfcNewsSettings.FirstOrDefaultAsync(s => s.Id == 1);
        if (settings is null)
        {
            settings = new() { Id = 1 };
            db.StfcNewsSettings.Add(settings);
        }
        settings.IncursionsEventDurationHours = durationHours;

        await db.SaveChangesAsync();
        saved = true;
    }
}
