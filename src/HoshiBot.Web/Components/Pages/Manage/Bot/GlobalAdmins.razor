@page "/manage/bot/global-admins"

<PageTitle>Global Admins</PageTitle>

<h1>Global Admins</h1>
<p>Discord users with bot-wide access to the STFC catalog.</p>

<SnowflakeAllowListEditor TItem="GlobalAdmin" FormName="add-global-admin"
    Items="@(db => db.GlobalAdmins)" Id="@(a => a.DiscordUserId)"
    Create="@(id => new GlobalAdmin { DiscordUserId = id })" />
