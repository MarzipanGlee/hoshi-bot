@page "/manage/bot/stfc-news-settings"
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>STFC News Settings</PageTitle>

@if (authorized is null)
{
    <p>Checking access...</p>
}
else if (authorized == false)
{
    <p>You do not have admin access to this page.</p>
}
else
{
    <h1>STFC News Settings</h1>
    <p>
        Controls the crowd-sourced quorum required before an admin-submitted event date
        (Alliance Tournament / Infinite Incursions) is trusted and acted on automatically.
    </p>

    <EditForm Model="this" FormName="stfc-news-settings" OnValidSubmit="SaveAsync">
        <div class="mb-3">
            <label class="form-label">Required confirmation percentage</label>
            <div class="input-group" style="max-width: 200px;">
                <input type="number" class="form-control" min="1" max="100" @bind="requiredConfirmationPercentage" />
                <span class="input-group-text">%</span>
            </div>
            <div class="form-text">
                Percentage of eligible confirmers (across every guild pinged for a post)
                required before a submitted date auto-resolves.
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        @if (saved)
        {
            <span class="text-success ms-2">Saved.</span>
        }
    </EditForm>
}

@code {
    private bool? authorized;
    private int requiredConfirmationPercentage = 20;
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var result = await AuthorizationService.AuthorizeAsync(authState.User, null, new GlobalAdminRequirement());
        authorized = result.Succeeded;

        if (authorized == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.StfcNewsSettings.AsNoTracking().FirstOrDefaultAsync(s => s.Id == 1);
        if (settings is not null)
            requiredConfirmationPercentage = settings.RequiredConfirmationPercentage;
    }

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.StfcNewsSettings.FirstOrDefaultAsync(s => s.Id == 1);
        if (settings is null)
        {
            settings = new() { Id = 1 };
            db.StfcNewsSettings.Add(settings);
        }

        settings.RequiredConfirmationPercentage = requiredConfirmationPercentage;
        await db.SaveChangesAsync();

        saved = true;
    }
}
