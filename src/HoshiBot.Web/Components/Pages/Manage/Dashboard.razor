@page "/manage/dashboard"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using HoshiBot.Web.Components.Pages.Manage.Guilds.Features
@implements IDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider
@inject GuildAccessService GuildAccessService
@inject GuildFeatureService FeatureService
@inject GuildFeatureSettingsService SettingsService
@inject CurrentGuildContext GuildContext
@inject ProtectedLocalStorage Storage

<PageTitle>Dashboard</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Welcome, @context.User.Identity?.Name</h1>

        @if (needsSetupGuilds.Count > 0)
        {
            <div class="alert alert-warning">
                <strong>@needsSetupGuilds.Count guild@(needsSetupGuilds.Count == 1 ? "" : "s")</strong> still
                need@(needsSetupGuilds.Count == 1 ? "s" : "") setup:
                @string.Join(", ", needsSetupGuilds.Select(g => g.Name))
            </div>
        }

        @if (GuildContext.Guild is null)
        {
            <div class="alert alert-info">
                Select a guild from the picker at the top, or from <a href="manage/guilds">Your Guilds</a>,
                to enable and configure its features.
            </div>
        }

        <div class="feature-section-header">
            <div class="feature-section-title-group">
                <h2>@(GuildContext.Guild?.Name ?? "Features")</h2>
                @if (GuildContext.GuildId is { } headerGuildId)
                {
                    <a class="btn btn-outline-secondary btn-sm" href="manage/guilds/@headerGuildId/global-settings">Global Settings</a>
                    <a class="btn btn-outline-secondary btn-sm" href="manage/guilds/@headerGuildId/setup">Setup Wizard</a>
                }
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="hideInactive" role="switch"
                       checked="@hideInactive" disabled="@(GuildContext.Guild is null)" @onchange="ToggleHideInactiveAsync" />
                <label class="form-check-label" for="hideInactive">Hide inactive features</label>
            </div>
        </div>

        @foreach (var audience in AudienceSections)
        {
            var features = FeatureCatalog.All.Where(f => f.RelevantAudiences().HasFlag(audience)).ToList();
            if (hideInactive && GuildContext.Guild is not null)
                features = features.Where(f => enabledFeatures.Contains((f.Feature, audience))).ToList();

            if (features.Count == 0)
                continue;

            <h3 class="feature-section-title">@AudienceDisplay.Labels(audience).First()</h3>
            <div class="feature-grid">
                @foreach (var feature in features)
                {
                    var enabled = GuildContext.Guild is not null && enabledFeatures.Contains((feature.Feature, audience));
                    var configured = enabled && configuredFeatures.Contains((feature.Feature, audience));
                    var cardClass = GuildContext.Guild is null ? "feature-card-unselected"
                        : !enabled ? "feature-card-disabled"
                        : configured ? "feature-card-enabled"
                        : "feature-card-needs-config";
                    <div class="feature-card @cardClass">
                        <h4><span class="oi @feature.Icon" aria-hidden="true"></span> @feature.Title</h4>
                        <p>@feature.Description</p>
                        <div class="feature-card-footer">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" checked="@enabled"
                                       disabled="@(GuildContext.Guild is null)"
                                       @onchange="e => ToggleFeatureAsync(feature.Feature, audience, (bool)e.Value!)" />
                            </div>
                            @if (GuildContext.GuildId is { } guildId)
                            {
                                <a class="btn btn-sm btn-outline-secondary" href="manage/guilds/@guildId/features/@feature.Slug">Configure</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled>Configure</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="dashboard-grid dashboard-grid-secondary">
            <a class="dashboard-card" href="manage/guilds">
                <span class="oi oi-list-rich" aria-hidden="true"></span>
                <h2>Your Guilds</h2>
                <p>@(accessibleGuilds?.Count.ToString() ?? "...") guild@((accessibleGuilds?.Count ?? 0) == 1 ? "" : "s") you administer</p>
            </a>
            <a class="dashboard-card" href="manage/stfc/regions">
                <span class="oi oi-globe" aria-hidden="true"></span>
                <h2>STFC Catalog</h2>
                <p>Regions, servers, alliances, and territories</p>
            </a>
            @if (isGlobalAdmin)
            {
                <a class="dashboard-card" href="manage/global-admins">
                    <span class="oi oi-shield" aria-hidden="true"></span>
                    <h2>Administration</h2>
                    <p>Manage global admin access</p>
                </a>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <p><a href="login?returnUrl=%2Fmanage%2Fdashboard">Log in with Discord</a> to see your dashboard.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly GuildAudience[] AudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    private const string HideInactiveStorageKey = "hoshibot.hideInactiveFeatures";

    private List<DiscordGuild>? accessibleGuilds;
    private List<DiscordGuild> needsSetupGuilds = [];
    private bool isGlobalAdmin;
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> enabledFeatures = [];
    private HashSet<(GuildFeature Feature, GuildAudience Audience)> configuredFeatures = [];
    private bool hideInactive;

    protected override async Task OnInitializedAsync()
    {
        GuildContext.Changed += OnGuildChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var globalAdminResult = await AuthorizationService.AuthorizeAsync(user, null, new GlobalAdminRequirement());
        isGlobalAdmin = globalAdminResult.Succeeded;

        accessibleGuilds = await GuildAccessService.GetAccessibleGuildsAsync(user);

        await using var db = await DbFactory.CreateDbContextAsync();
        var setupCompleteGuildIds = (await db.GuildSettings
            .Where(s => s.SetupCompletedAt != null)
            .Select(s => s.GuildId)
            .ToListAsync())
            .ToHashSet();
        needsSetupGuilds = accessibleGuilds.Where(g => !setupCompleteGuildIds.Contains(g.Id)).ToList();

        var storedHideInactive = await Storage.GetAsync<bool>(HideInactiveStorageKey);
        if (storedHideInactive.Success)
            hideInactive = storedHideInactive.Value;

        await LoadFeatureStateAsync();
    }

    private async Task LoadFeatureStateAsync()
    {
        enabledFeatures = [];
        configuredFeatures = [];
        if (GuildContext.GuildId is not { } guildId)
            return;

        var context = new FeatureModuleContext(FeatureService, SettingsService, DbFactory);

        foreach (var feature in FeatureCatalog.All)
        {
            var audiences = await FeatureService.GetEnabledAudiencesAsync(guildId, feature.Feature);
            foreach (var audience in audiences)
            {
                enabledFeatures.Add((feature.Feature, audience));
                if (await feature.IsConfiguredAsync(guildId, audience, context))
                    configuredFeatures.Add((feature.Feature, audience));
            }
        }
    }

    private void OnGuildChanged() => InvokeAsync(async () =>
    {
        await LoadFeatureStateAsync();
        StateHasChanged();
    });

    private async Task ToggleFeatureAsync(GuildFeature feature, GuildAudience audience, bool enabled)
    {
        if (GuildContext.GuildId is not { } guildId)
            return;

        await FeatureService.SetEnabledAsync(guildId, feature, audience, enabled);
        if (enabled)
        {
            enabledFeatures.Add((feature, audience));

            var module = FeatureCatalog.All.First(f => f.Feature == feature);
            var context = new FeatureModuleContext(FeatureService, SettingsService, DbFactory);
            if (await module.IsConfiguredAsync(guildId, audience, context))
                configuredFeatures.Add((feature, audience));
        }
        else
        {
            enabledFeatures.Remove((feature, audience));
        }
    }

    private async Task ToggleHideInactiveAsync(ChangeEventArgs e)
    {
        hideInactive = (bool)e.Value!;
        await Storage.SetAsync(HideInactiveStorageKey, hideInactive);
    }

    public void Dispose() => GuildContext.Changed -= OnGuildChanged;
}
