@page "/manage/stfc/server-status"
@implements IAsyncDisposable
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Server Status</PageTitle>

@if (authorized is null)
{
    <p>Checking access...</p>
}
else if (authorized == false)
{
    <p>You do not have admin access to the STFC catalog.</p>
}
else
{
    <h1>Server Status</h1>
    <p>
        One-time seed snapshot, not a live sync (see StfcServerStatusSeedData) — read-only here.
        Status/Maintenance is what was last observed; Notified* is what ServerStatusNotifyJob last announced to Discord.
    </p>

    <QuickGrid Class="table" Items="context.StfcServerStatuses.Include(s => s.StfcServer).ThenInclude(s => s.Region).OrderBy(s => s.StfcServerId)" Pagination="pagination">
        <PropertyColumn Property="status => status.StfcServer.DisplayName" Title="Server" />
        <PropertyColumn Property="status => status.Status" />
        <PropertyColumn Property="status => status.Maintenance" />
        <PropertyColumn Property="status => status.UpdatedAt" />
        <PropertyColumn Property="status => status.NotifiedStatus" Title="Notified Status" />
        <PropertyColumn Property="status => status.NotifiedMaintenance" Title="Notified Maintenance" />
    </QuickGrid>

    <Paginator State="pagination" />
}

@code {
    private bool? authorized;
    private HoshiBotDbContext context = default!;
    private readonly PaginationState pagination = new() { ItemsPerPage = 50 };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var result = await AuthorizationService.AuthorizeAsync(authState.User, null, new GlobalAdminRequirement());
        authorized = result.Succeeded;

        if (authorized == true)
            context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync()
    {
        if (context is not null)
            await context.DisposeAsync();
    }
}
