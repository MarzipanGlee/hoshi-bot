@* The "Audit" section of the Permission Check page: runs the expectation audit and lists each
   expectation's live-vs-expected diff with its per-row Fix button.
   Explicit @namespace: a folder-derived namespace ending in "PermissionCheck" would collide
   with the PermissionCheck page class itself. *@
@namespace HoshiBot.Web.Components.Pages.Manage.Guild

<h2>@Msg.WebAudit.AuditTitle(Lang)</h2>
<button class="btn btn-primary" disabled="@Auditing" @onclick="OnRunAudit">@(Auditing ? Msg.WebAudit.CheckingEllipsis(Lang) : Msg.WebAudit.RunAudit(Lang))</button>

@if (Results is not null)
{
    <table class="table mt-3">
        <thead><tr><th>@Msg.WebCommon.Channel(Lang)</th><th>@Msg.WebCommon.Role(Lang)</th><th>@Msg.WebAudit.StatusColumn(Lang)</th><th>@Msg.WebAudit.DetailsColumn(Lang)</th><th></th></tr></thead>
        <tbody>
            @foreach (var result in Results)
            {
                <tr class="@(result.IsMatch ? "table-success" : "table-danger")">
                    <td>@Context.ChannelName(Lang, result.Expectation.ChannelId)</td>
                    <td>@Context.RoleName(Lang, result.Expectation.RoleId)</td>
                    <td>@(result.IsMatch ? Msg.WebAudit.OkStatus(Lang) : Msg.WebAudit.MismatchStatus(Lang))</td>
                    <td>
                        @if (!result.IsMatch)
                        {
                            @if (result.MissingAllow.Count > 0)
                            {
                                <div>@Msg.WebAudit.MissingAllowLabel(Lang) @string.Join(", ", result.MissingAllow.Select(p => PermissionAuditService.PermLabel(Lang, p)))</div>
                            }
                            @if (result.ExtraAllow.Count > 0)
                            {
                                <div>@Msg.WebAudit.UnexpectedAllowLabel(Lang) @string.Join(", ", result.ExtraAllow.Select(p => PermissionAuditService.PermLabel(Lang, p)))</div>
                            }
                            @if (result.MissingDeny.Count > 0)
                            {
                                <div>@Msg.WebAudit.MissingDenyLabel(Lang) @string.Join(", ", result.MissingDeny.Select(p => PermissionAuditService.PermLabel(Lang, p)))</div>
                            }
                            @if (result.ExtraDeny.Count > 0)
                            {
                                <div>@Msg.WebAudit.UnexpectedDenyLabel(Lang) @string.Join(", ", result.ExtraDeny.Select(p => PermissionAuditService.PermLabel(Lang, p)))</div>
                            }
                        }
                    </td>
                    <td>
                        @if (!result.IsMatch)
                        {
                            @if (result.CanFix)
                            {
                                <button class="btn btn-sm btn-warning" @onclick="() => OnFix.InvokeAsync(result)">@Msg.WebAudit.FixButton(Lang)</button>
                            }
                            else
                            {
                                <span class="text-danger">@Icons.Text.Warning @result.BlockReason</span>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired]
    public PermissionAuditContext Context { get; set; } = PermissionAuditContext.Empty;

    [Parameter]
    public List<PermissionAuditResult>? Results { get; set; }

    [Parameter]
    public bool Auditing { get; set; }

    [Parameter]
    public EventCallback OnRunAudit { get; set; }

    [Parameter]
    public EventCallback<PermissionAuditResult> OnFix { get; set; }
}
