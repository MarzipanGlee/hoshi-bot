@* The "Bot Posting Access" section of the Permission Check page: every configured post-to
   channel with the bot's live access state, plus the per-row category/channel fix buttons.
   Explicit @namespace: a folder-derived namespace ending in "PermissionCheck" would collide
   with the PermissionCheck page class itself. *@
@namespace HoshiBot.Web.Components.Pages.Manage.Guild
@using NetCord

<h2>@Msg.WebAudit.BotPostingAccessTitle(Lang)</h2>
<p>
    @Msg.WebAudit.BotPostingAccessIntro(Lang)
</p>
<button class="btn btn-primary" disabled="@Checking" @onclick="OnReCheck">@(Checking ? Msg.WebAudit.CheckingEllipsis(Lang) : Msg.WebAudit.ReCheck(Lang))</button>

@if (Results is not null)
{
    @if (Results.Count == 0)
    {
        <p class="text-muted mt-3">@Msg.WebAudit.NoPostToChannelsConfigured(Lang)</p>
    }
    else
    {
        @if (Results.Any(r => !r.CanView))
        {
            <div class="alert alert-info mt-3">
                <strong>@Msg.WebAudit.CantFixCalloutTitle(Lang)</strong>
                <p class="mb-2 mt-1">
                    @((MarkupString)Msg.WebAudit.CantFixCalloutIntro(Lang))
                </p>
                <ol class="mb-2">
                    <li>@((MarkupString)Msg.WebAudit.CantFixStep1(Lang))</li>
                    <li>@((MarkupString)Msg.WebAudit.CantFixStep2(Lang))</li>
                    <li>@((MarkupString)Msg.WebAudit.CantFixStep3(Lang))</li>
                    <li>@((MarkupString)Msg.WebAudit.CantFixStep4(Lang))</li>
                </ol>
                <p class="mb-0">
                    @((MarkupString)Msg.WebAudit.CantFixCalloutOutro(Lang))
                </p>
            </div>
        }

        <table class="table mt-3">
            <thead><tr><th>@Msg.WebCommon.Channel(Lang)</th><th>@Msg.WebAudit.UsedByColumn(Lang)</th><th>@Msg.WebAudit.StatusColumn(Lang)</th><th></th></tr></thead>
            <tbody>
                @foreach (var result in Results)
                {
                    <tr class="@(result.HasAccess ? "table-success" : "table-danger")">
                        <td>@Context.ChannelName(Lang, result.ChannelId)</td>
                        <td>@result.Sources</td>
                        <td>
                            @if (result.HasAccess)
                            {
                                <span>@Msg.WebAudit.OkStatus(Lang)</span>
                            }
                            else
                            {
                                <div>@Msg.WebAudit.MissingAccessStatus(Lang)</div>
                                <div class="small text-nowrap">@Msg.WebAudit.ChannelStatusLine(Lang, PermissionAuditService.PermsSummary(Lang, result.Required, result.ChannelEffective))</div>
                                @if (result.Category is { } cat)
                                {
                                    <div class="small text-nowrap">@Msg.WebAudit.CategoryStatusLine(Lang, PermissionAuditService.PermsSummary(Lang, result.Required, cat.Effective))</div>
                                }
                            }
                        </td>
                        <td>
                            @* A fix button is only shown for a level the bot can actually see: Discord
                               returns Missing Access on any edit to a channel/category it can't view, so a
                               button there would always fail. When it can see neither, the only route is a
                               manual grant in Discord (the callout above). *@
                            @if (!result.HasAccess)
                            {
                                @if (result.CanFix && (result.CanFixChannel || result.CanFixCategory))
                                {
                                    <div class="d-flex flex-wrap gap-2">
                                        @if (result.ParentCategoryId is { } categoryId && result.CanFixCategory)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => OnFix.InvokeAsync((result, categoryId, true))">@Msg.WebAudit.FixOnCategoryButton(Lang, Context.CategoryName(Lang, categoryId))</button>
                                        }
                                        @if (result.CanFixChannel)
                                        {
                                            <button class="btn btn-sm @(result.CanFixCategory ? "btn-outline-dark" : "btn-primary")" @onclick="() => OnFix.InvokeAsync((result, result.ChannelId, false))">@Msg.WebAudit.FixOnChannelButton(Lang)</button>
                                        }
                                    </div>
                                }
                                else if (result.CanFix)
                                {
                                    <div class="small text-danger mt-1">
                                        @Msg.WebAudit.CantFixAutomaticallyNote(Lang)
                                    </div>
                                }
                                else
                                {
                                    <span class="text-danger">⚠ @result.BlockReason</span>
                                }
                            }
                            @if (FixStatus.TryGetValue(result.ChannelId, out var status))
                            {
                                <div class="small mt-1">@status</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired]
    public PermissionAuditContext Context { get; set; } = PermissionAuditContext.Empty;

    [Parameter]
    public List<BotAccessResult>? Results { get; set; }

    [Parameter]
    public bool Checking { get; set; }

    // Per-channel outcome line from the last Fix, keyed by the configured channel id — owned
    // by the page (it survives re-checks after a fix), only rendered here.
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<ulong, string> FixStatus { get; set; } = new Dictionary<ulong, string>();

    [Parameter]
    public EventCallback OnReCheck { get; set; }

    [Parameter]
    public EventCallback<(BotAccessResult Result, ulong TargetId, bool ViaCategory)> OnFix { get; set; }
}
