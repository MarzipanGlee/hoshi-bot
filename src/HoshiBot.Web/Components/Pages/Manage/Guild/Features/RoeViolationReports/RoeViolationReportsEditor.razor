@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createError is not null)
{
    <p class="text-danger">@createError.Value.Text(Lang)</p>
}

<div class="card-grid mt-1">
    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, RoeViolationReportsSettingKeys.Channel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, RoeViolationReportsSettingKeys.Channel)" Kind="ChannelKind.Forum"
            CreateChannelName="roe-verstösse" @bind-Value="channelIdInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />

    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, DiplomacySettingKeys.DiplomatRole)" Usage="@Msg.WebEditor.Usage(Lang, Feature, DiplomacySettingKeys.DiplomatRole)" CreateRoleName="Diplomat"
            @bind-Value="diplomatRoleIdInput" @bind-Value:after="SaveDiplomatRoleAsync" Roles="roles" />

    <CommandStaffRoleCard GuildId="GuildId" />
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.RoeViolationReports;

    // The diplomat role is the Diplomacy feature's per-alliance DiplomatRole (both features are
    // Alliance-scoped) — RoE reuses that same role rather than defining its own, so it's read/
    // written under GuildFeature.Diplomacy here while everything else stays under RoE's own key.
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? channelIdInput;
    private string? diplomatRoleIdInput;
    private DiscordCreateErrorKind? createError;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        channelIdInput = (await GetSnowflakeAsync(RoeViolationReportsSettingKeys.Channel))?.ToString();
        diplomatRoleIdInput = (await GetSnowflakeAsync(GuildFeature.Diplomacy, DiplomacySettingKeys.DiplomatRole))?.ToString();
    }

    private async Task SaveChannelAsync()
    {
        createError = null;
        (var channelId, channelIdInput, createError) = await DiscordData.EnsureChannelOrErrorAsync(GuildId, channelIdInput, "roe-verstösse", ChannelType.ForumGuildChannel);
        if (createError is not null)
            return;

        channels = await DiscordData.GetChannelsAsync(GuildId);
        await SetSnowflakeAsync(RoeViolationReportsSettingKeys.Channel, channelId);
    }

    private async Task SaveDiplomatRoleAsync()
    {
        createError = null;
        (var roleId, diplomatRoleIdInput, createError) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, diplomatRoleIdInput, "Diplomat");
        if (createError is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(GuildFeature.Diplomacy, DiplomacySettingKeys.DiplomatRole, roleId);
    }
}
