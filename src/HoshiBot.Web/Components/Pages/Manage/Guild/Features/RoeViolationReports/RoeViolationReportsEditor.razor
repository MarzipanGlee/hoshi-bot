@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createError is not null)
{
    <p class="text-danger">@createError</p>
}

<div class="card-grid mt-1">
    <SettingsCard Title="RoE Violations">
        <ChannelPicker Label="RoE Violations" ShowLabel="false" Usage="Where /report-roe-violation reports are posted — must be a Forum channel." Kind="ChannelKind.Forum"
            CreateChannelName="roe-verstösse" @bind-Value="channelIdInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />
    </SettingsCard>

    <SettingsCard Title="Diplomat">
        <RolePicker Label="Diplomat" ShowLabel="false" Usage="Per-alliance role pinged in the report thread once the reporter marks a case ready. This is the same Diplomat role as the Diplomacy feature." CreateRoleName="Diplomat"
            @bind-Value="diplomatRoleIdInput" @bind-Value:after="SaveDiplomatRoleAsync" Roles="roles" />
    </SettingsCard>

    <CommandStaffRoleCard GuildId="GuildId" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.RoeViolationReports;

    // The diplomat role is the Diplomacy feature's per-alliance DiplomatRole (both features are
    // Alliance-scoped) — RoE reuses that same role rather than defining its own, so it's read/
    // written under GuildFeature.Diplomacy here while everything else stays under RoE's own key.
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? channelIdInput;
    private string? diplomatRoleIdInput;
    private string? createError;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        channelIdInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, RoeViolationReportsSettingKeys.Channel))?.ToString();
        diplomatRoleIdInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.Diplomacy, ResolvedAudience, GuildAllianceId, DiplomacySettingKeys.DiplomatRole))?.ToString();
    }

    private async Task SaveChannelAsync()
    {
        createError = null;
        try
        {
            var channelId = await DiscordData.EnsureChannelAsync(GuildId, channelIdInput, "roe-verstösse", ChannelType.ForumGuildChannel);
            channelIdInput = channelId?.ToString();
            channels = await DiscordData.GetChannelsAsync(GuildId);
            await SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, RoeViolationReportsSettingKeys.Channel, channelId);
        }
        catch (RestException)
        {
            createError = "Could not create a channel on Discord — does the bot have Manage Channels permission in this server?";
            if (channelIdInput == ChannelPicker.CreateSentinel)
                channelIdInput = null;
        }
    }

    private async Task SaveDiplomatRoleAsync()
    {
        createError = null;
        try
        {
            var roleId = await DiscordData.EnsureRoleAsync(GuildId, diplomatRoleIdInput, "Diplomat");
            diplomatRoleIdInput = roleId?.ToString();
            roles = await DiscordData.GetRolesAsync(GuildId);
            await SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.Diplomacy, ResolvedAudience, GuildAllianceId, DiplomacySettingKeys.DiplomatRole, roleId);
        }
        catch (RestException)
        {
            createError = "Could not create a role on Discord — does the bot have Manage Roles permission in this server?";
            if (diplomatRoleIdInput == RolePicker.CreateSentinel)
                diplomatRoleIdInput = null;
        }
    }
}
