@inherits FeatureEditorBase
@using System.Globalization
@using HoshiBot.Domain
@using HoshiBot.Web.Components.Pages.Manage.Guild
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@* Where the alerts go, then who they reach: the channels first, then the three role cards this
   feature reads but does not own. *@
<div class="card-grid mt-1">
    <AlertChannelListEditor GuildId="GuildId" Kind="GuildAlertChannelKind.Raid" Audience="ResolvedAudience"
                            GuildAllianceId="GuildAllianceId" PerChannelRole="false" />

    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, RaidAlertsSettingKeys.ReportChannel)"
            Usage="@Msg.WebEditor.Usage(Lang, Feature, RaidAlertsSettingKeys.ReportChannel)"
            @bind-Value="channelIdInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, RaidAlertsSettingKeys.ReportTime)">
        <p class="form-text mb-2">@Msg.WebEditor.Usage(Lang, Feature, RaidAlertsSettingKeys.ReportTime)</p>
        @* A plain hour list rather than a time input: the setting has whole-hour resolution, and a
           time picker invites minutes it would only round away. *@
        <select class="form-select" id="raidReportHour" value="@reportHour" @onchange="OnReportHourChangedAsync">
            @for (var hour = 0; hour < 24; hour++)
            {
                <option value="@hour">@hour</option>
            }
        </select>
    </SettingsCard>
</div>

<div class="card-grid mt-1">
    <AlertRoleCard GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId" />
    <NotificationRoleCard GuildId="GuildId" GuildAllianceId="GuildAllianceId" />
    <OptInPointerCard GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId" />
    <SeniorStaffRoleCard GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId" />
</div>

<PoweredBy For="@(new[] { typeof(StfcSystem) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.RaidAlerts;

    private List<IGuildChannel> channels = [];
    private string? channelIdInput;
    private int reportHour;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        channelIdInput = (await GetSnowflakeAsync(RaidAlertsSettingKeys.ReportChannel))?.ToString();
        reportHour = ParseHour(await GetTextAsync(RaidAlertsSettingKeys.ReportTime));
    }

    private Task SaveChannelAsync() =>
        SetSnowflakeAsync(RaidAlertsSettingKeys.ReportChannel, ParseId(channelIdInput));

    // Stored as "HH:mm" like the capture digest's own fire times, so both read the same way in the
    // settings table and the service parses one format. The dropdown just picks the hour.
    //
    // An awaited handler rather than @bind with a saving setter: a property setter cannot await, so
    // the write would be fire-and-forget and a failed save would pass silently.
    private async Task OnReportHourChangedAsync(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, out var hour) || hour is < 0 or > 23)
            return;

        reportHour = hour;
        await SetTextAsync(RaidAlertsSettingKeys.ReportTime,
            new TimeOnly(hour, 0).ToString("HH:mm", CultureInfo.InvariantCulture));
    }

    private static int ParseHour(string? raw) =>
        TimeOnly.TryParseExact(raw, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? parsed.Hour
            : TimeOnly.ParseExact(RaidReportScheduler.DefaultLocalTime, "HH:mm", CultureInfo.InvariantCulture).Hour;
}
