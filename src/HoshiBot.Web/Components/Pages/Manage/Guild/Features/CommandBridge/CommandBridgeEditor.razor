@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createError is not null)
{
    <p class="text-danger">@createError.Value.Text(Lang)</p>
}

<p class="text-muted">
    @((MarkupString)Msg.WebCommandBridge.Intro(Lang))
</p>

<div class="card-grid mt-1">
    @foreach (var bridge in bridges)
    {
        <SettingsCard Title="@Heading(bridge)">
            <p class="text-muted small mb-0">@Subtitle(bridge)</p>

            <ChannelPicker Label="@Msg.WebCommon.Channel(Lang)" ShowLabel="false"
                           Usage="@Msg.WebCommandBridge.ChannelUsage(Lang)"
                           CreateChannelName="@ChannelName(bridge)"
                           Value="@channelInputs[bridge]"
                           ValueChanged="v => OnChannelChangedAsync(bridge, v)"
                           Channels="channels" />

            <div>
                <button class="btn btn-primary btn-sm" @onclick="() => PublishAsync(bridge)"
                        disabled="@(!Enabled || ParseId(channelInputs[bridge]) is null || IsBusy(bridge))">
                    @Msg.WebCommandBridge.Publish(Lang)
                </button>
                @if (statuses.TryGetValue(bridge, out var status))
                {
                    <span class="ms-2 @(status.Done ? "text-success" : "text-muted")">@status.Text</span>
                }
            </div>

            <div>
                <h3 class="h6 mb-1">@Msg.WebCommandBridge.ButtonsHeading(Lang)</h3>
                @{
                    var items = OverviewFor(bridge);
                }
                @if (items.Count == 0)
                {
                    <p class="text-muted mb-0">@Msg.WebCommandBridge.NoButtons(Lang)</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var item in items.Where(i => i.Shown))
                        {
                            <li>@Icons.Ok @Link(item)</li>
                        }
                        @foreach (var item in items.Where(i => !i.Shown))
                        {
                            <li class="text-muted">@Icons.Blocked @Link(item) <span class="small">@Msg.WebCommandBridge.Hidden(Lang)</span></li>
                        }
                    </ul>
                }
            </div>
        </SettingsCard>
    }
</div>

@code {
    // The catalog's button labels render in the viewer's request language (the layout-cascaded
    // Lang, inherited from FeatureEditorBase) — unlike the bot's hub rendering, which follows
    // the guild-side language resolution.
    protected override GuildFeature Feature => GuildFeature.CommandBridge;

    private record OverviewItem(string Label, bool Shown, string? Slug);

    private static readonly CommandBridgeKind[] bridges =
    [
        CommandBridgeKind.User,
        CommandBridgeKind.Staff,
        CommandBridgeKind.Friends,
    ];

    private string Heading(CommandBridgeKind bridge) => bridge switch
    {
        CommandBridgeKind.Staff => Msg.WebCommandBridge.StaffBridgeHeading(Lang),
        CommandBridgeKind.Friends => Msg.WebCommandBridge.FriendsBridgeHeading(Lang),
        _ => Msg.WebCommandBridge.UserBridgeHeading(Lang),
    };

    private string Subtitle(CommandBridgeKind bridge) => bridge switch
    {
        CommandBridgeKind.Staff => Msg.WebCommandBridge.StaffBridgeSubtitle(Lang),
        CommandBridgeKind.Friends => Msg.WebCommandBridge.FriendsBridgeSubtitle(Lang),
        _ => Msg.WebCommandBridge.UserBridgeSubtitle(Lang),
    };

    private record PublishStatus(string Text, bool Done);

    private List<IGuildChannel> channels = [];
    private DiscordCreateErrorKind? createError;
    // Pre-seeded with all three bridge keys so the markup's channelInputs[bridge.Kind] lookup
    // never throws on the base class's first (pre-OnSettingsLoadedAsync) render — unlike the old
    // page, this editor has no "still loading" guard around the cards.
    private readonly Dictionary<CommandBridgeKind, string?> channelInputs = new()
    {
        [CommandBridgeKind.User] = null,
        [CommandBridgeKind.Staff] = null,
        [CommandBridgeKind.Friends] = null,
    };
    private readonly Dictionary<CommandBridgeKind, PublishStatus> statuses = new();

    // Which features are enabled for THIS alliance's hub — a feature counts if it's enabled for
    // this alliance (Alliance audience) or for any of its non-alliance (guild-scoped) audiences.
    private HashSet<GuildFeature> enabledForHub = [];

    private bool IsBusy(CommandBridgeKind bridge) => statuses.TryGetValue(bridge, out var s) && !s.Done;

    protected override async Task OnSettingsLoadedAsync()
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var alliance = await db.GuildAlliances.AsNoTracking()
                .FirstOrDefaultAsync(a => a.Id == GuildAllianceId && a.GuildId == GuildId);
            channelInputs[CommandBridgeKind.User] = alliance?.CommandBridgeChannelId?.ToString();
            channelInputs[CommandBridgeKind.Staff] = alliance?.StaffCommandBridgeChannelId?.ToString();
            channelInputs[CommandBridgeKind.Friends] = alliance?.FriendsCommandBridgeChannelId?.ToString();
        }

        channels = await DiscordData.GetChannelsAsync(GuildId);

        var enabled = await FeatureService.GetEnabledAsync(GuildId);
        enabledForHub = enabled
            .Where(e => (e.Audience == GuildAudience.Alliance && e.GuildAllianceId == GuildAllianceId) || e.Audience != GuildAudience.Alliance)
            .Select(e => e.Feature)
            .ToHashSet();
    }

    // The names the three bridges already carry in practice, so "create" produces what an admin
    // would have made by hand. Not tag-prefixed like the ROLES are: a channel lives inside the
    // alliance's own category, which supplies the scoping a role name has to carry itself.
    // In the alliance's language — see FeatureEditorBase.ScopeLanguage. A bridge is a channel every
    // member of that alliance reads, so it is named the way they read.
    private string ChannelName(CommandBridgeKind bridge) => bridge switch
    {
        CommandBridgeKind.Staff => Msg.ChannelName.CommandBridgeStaff(ScopeLanguage),
        CommandBridgeKind.Friends => Msg.ChannelName.CommandBridgeFriends(ScopeLanguage),
        _ => Msg.ChannelName.CommandBridge(ScopeLanguage),
    };

    private async Task OnChannelChangedAsync(CommandBridgeKind bridge, string? value)
    {
        channelInputs[bridge] = value;

        if (GuildAllianceId is not { } allianceId)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var alliance = await db.GuildAlliances.FirstOrDefaultAsync(a => a.Id == allianceId && a.GuildId == GuildId);
        if (alliance is null)
            return;

        // Through EnsureChannelOrError, not ParseId: the picker's "create it" option posts a
        // sentinel rather than an id. Created under the alliance's default category so a new bridge
        // lands with its siblings instead of at the root of the server.
        createError = null;
        (var id, channelInputs[bridge], createError) = await DiscordData.EnsureChannelOrErrorAsync(
            GuildId, value, ChannelName(bridge), ChannelType.TextGuildChannel, alliance.DefaultChannelCategoryId);
        if (createError is not null)
            return;

        channels = await DiscordData.GetChannelsAsync(GuildId);

        switch (bridge)
        {
            case CommandBridgeKind.Staff: alliance.StaffCommandBridgeChannelId = id; break;
            case CommandBridgeKind.Friends: alliance.FriendsCommandBridgeChannelId = id; break;
            default: alliance.CommandBridgeChannelId = id; break;
        }

        await db.SaveChangesAsync();
    }

    // Enqueue a republish request for the bot to pick up (Web can't post to Discord itself —
    // it doesn't reference HoshiBot.Discord). CommandBridgeRepublishJob drains the queue: it
    // DELETES the row once the hub is posted, so a vanished row means done. A row that is still
    // there but carries LastError means the bot tried and Discord refused — surface that instead
    // of polling out, which is what used to happen (the job retried forever and the button just
    // spun).
    private async Task PublishAsync(CommandBridgeKind bridge)
    {
        if (GuildAllianceId is not { } allianceId)
            return;

        int requestId;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var request = new CommandBridgeRepublishRequest
            {
                GuildId = GuildId,
                GuildAllianceId = allianceId,
                Bridge = bridge,
                RequestedAt = DateTimeOffset.UtcNow,
            };
            db.CommandBridgeRepublishRequests.Add(request);
            await db.SaveChangesAsync();
            requestId = request.Id;
        }

        statuses[bridge] = new PublishStatus(Msg.WebCommandBridge.StatusQueued(Lang), false);
        StateHasChanged();

        // Poll until the bot drains the request (up to ~40s; the job runs every 15s).
        for (var attempt = 0; attempt < 20; attempt++)
        {
            await Task.Delay(TimeSpan.FromSeconds(2));

            string? lastError;
            bool stillPending;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                var row = await db.CommandBridgeRepublishRequests
                    .Where(r => r.Id == requestId)
                    .Select(r => new { r.LastError })
                    .FirstOrDefaultAsync();
                stillPending = row is not null;
                lastError = row?.LastError;
            }

            if (!stillPending)
            {
                statuses[bridge] = new PublishStatus(Msg.WebCommandBridge.StatusPosted(Lang), true);
                return;
            }

            if (lastError is { Length: > 0 })
            {
                statuses[bridge] = new PublishStatus(Msg.WebCommandBridge.StatusFailed(Lang, lastError), true);
                return;
            }
        }

        statuses[bridge] = new PublishStatus(Msg.WebCommandBridge.StatusStillQueued(Lang), true);
    }

    private List<OverviewItem> OverviewFor(CommandBridgeKind bridge)
    {
        var items = new List<OverviewItem>();
        foreach (var entry in CommandBridgeCatalog.ForBridge(bridge))
        {
            var label = MessageCatalog.Format(Lang, entry.LabelKey);
            if (entry.Kind == CommandBridgeButtonKind.ContactStaff)
            {
                // Mirrors the hub's rule approximately: shown when Tickets OR AnonymousMessaging
                // is enabled for this alliance (the hub also requires a configured channel; the
                // exact per-audience check lives in the bot).
                var shown = enabledForHub.Contains(GuildFeature.Tickets)
                    || enabledForHub.Contains(GuildFeature.AnonymousMessaging);
                items.Add(new OverviewItem(label, shown, SlugFor(GuildFeature.Tickets)));
                continue;
            }

            if (entry.Feature is { } feature)
                items.Add(new OverviewItem(label, enabledForHub.Contains(feature), SlugFor(feature)));
            else
                // Not gated by a single GuildFeature — always shown, and no feature page to link to.
                items.Add(new OverviewItem(label, true, null));
        }

        return items;
    }

    private static string? SlugFor(GuildFeature feature) =>
        FeatureCatalog.All.FirstOrDefault(m => m.Feature == feature)?.Slug;

    private RenderFragment Link(OverviewItem item) => builder =>
    {
        if (item.Slug is null)
        {
            builder.AddContent(0, item.Label);
        }
        else
        {
            builder.OpenElement(1, "a");
            builder.AddAttribute(2, "href", $"manage/guild/{GuildId}/alliance/{GuildAllianceId}/features/{item.Slug}");
            builder.AddContent(3, item.Label);
            builder.CloseElement();
        }
    };
}
