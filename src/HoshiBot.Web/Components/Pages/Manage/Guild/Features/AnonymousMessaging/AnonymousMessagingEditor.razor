@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService
@inject GuildFeatureService FeatureService

<FeatureEnableSwitch Enabled="enabled" OnToggle="ToggleAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="Anonymous Messages">
        <ChannelPicker Label="Anonymous Messages" ShowLabel="false" Usage="Where anonymous messages submitted via the hub button are posted."
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />
    </SettingsCard>
</div>

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }
    [Parameter] public int? GuildAllianceId { get; set; }

    private List<IGuildChannel> channels = [];
    private bool enabled;
    private string? channelInput;

    protected override async Task OnInitializedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        enabled = await FeatureService.IsEnabledAsync(GuildId, GuildFeature.AnonymousMessaging, Audience, GuildAllianceId);
        channelInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.AnonymousMessaging, Audience, GuildAllianceId, AnonymousMessagingSettingKeys.Channel))?.ToString();
    }

    private async Task ToggleAsync(bool value)
    {
        await FeatureService.SetEnabledAsync(GuildId, GuildFeature.AnonymousMessaging, Audience, GuildAllianceId, value);
        enabled = value;
    }

    private Task SaveChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.AnonymousMessaging, Audience, GuildAllianceId, AnonymousMessagingSettingKeys.Channel, ParseId(channelInput));

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;
}
