@using HoshiBot.Web.Services
@using NetCord
@inherits FeatureEditorBase
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="Anonymous Messages">
        <ChannelPicker Label="Anonymous Messages" ShowLabel="false" Usage="Where anonymous messages submitted via the hub button are posted."
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AnonymousMessaging;

    private List<IGuildChannel> channels = [];
    private string? channelInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        channelInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnonymousMessagingSettingKeys.Channel))?.ToString();
    }

    private Task SaveChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnonymousMessagingSettingKeys.Channel, ParseId(channelInput));
}
