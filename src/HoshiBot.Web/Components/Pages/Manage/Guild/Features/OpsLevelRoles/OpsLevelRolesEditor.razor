@inherits FeatureEditorBase

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<RoleTierEditor GuildId="GuildId" Feature="Feature" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId" Tiers="Tiers">
    <HeaderTemplate Context="tier">
        <strong>@tier.DefaultName</strong>
        <span class="text-secondary ms-1">(@tier.Note)</span>
    </HeaderTemplate>
</RoleTierEditor>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.OpsLevelRoles;

    private static readonly IReadOnlyList<RoleTierSpec> Tiers =
    [
        new("G1", OpsLevelRolesSettingKeys.G1Role, "1-9"),
        new("G2", OpsLevelRolesSettingKeys.G2Role, "10-19"),
        new("G3", OpsLevelRolesSettingKeys.G3Role, "20-39"),
        new("G4", OpsLevelRolesSettingKeys.G4Role, "40-50"),
        new("G5", OpsLevelRolesSettingKeys.G5Role, "51-60"),
        new("G6", OpsLevelRolesSettingKeys.G6Role, "61-70"),
        new("G7", OpsLevelRolesSettingKeys.G7Role, "71-80"),
    ];
}
