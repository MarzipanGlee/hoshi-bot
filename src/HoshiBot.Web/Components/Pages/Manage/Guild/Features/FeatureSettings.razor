@page "/manage/guild/{GuildId}/features/{FeatureSlug}"
@page "/manage/guild/{GuildId}/{AudienceSlug}/features/{FeatureSlug}"
@page "/manage/guild/{GuildId}/alliance/{GuildAllianceIdRaw:int}/features/{FeatureSlug}"
@inherits GuildAdminPageBase
@inject GuildAllianceService AllianceService
@inject CurrentAllianceContext AllianceContext
@inject GuildFeatureService FeatureService
@inject GuildFeatureSettingsService SettingsService
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>@(descriptor?.Title ?? "Feature Settings")</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else if (descriptor is null)
{
    <p>Unknown feature "@FeatureSlug".</p>
}
else if (needsAllianceLink)
{
    <h1>@descriptor.Title</h1>
    <p class="text-muted">
        This is an alliance feature, but this guild has no alliance linked yet. Link one on the
        <a href="manage/guild/@GuildId/audience">Audience</a> page first, then come back to configure it.
    </p>
}
else if (editorParameters is null)
{
    <p>Redirecting...</p>
}
else
{
    <h1>@descriptor.Title</h1>
    <p>@descriptor.Description</p>

    @if (dependencies.Count > 0)
    {
        <div class="alert @(dependencies.All(d => d.Satisfied) ? "alert-secondary" : "alert-warning")">
            <div class="fw-semibold mb-2">
                <span class="oi oi-link-intact" aria-hidden="true"></span>
                @(dependencies.All(d => d.Satisfied) ? "Requires other features" : "Needs other features to work")
            </div>
            <ul class="mb-0 ps-3">
                @foreach (var dep in dependencies)
                {
                    <li>
                        <a href="@DependencyHref(dep.Module)">@dep.Module.Title</a>
                        @if (dep.Satisfied)
                        {
                            <span class="badge bg-success ms-1">enabled</span>
                        }
                        else if (dep.Enabled)
                        {
                            <span class="badge bg-warning text-dark ms-1">not configured</span>
                        }
                        else
                        {
                            <span class="badge bg-danger ms-1">not enabled</span>
                        }
                        @if (dep.Note is { Length: > 0 })
                        {
                            <span class="text-muted"> — @dep.Note</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <DynamicComponent Type="descriptor.EditorComponentType" Parameters="editorParameters" @key="editorKey" />
}

@code {
    [Parameter] public string FeatureSlug { get; set; } = "";
    [Parameter] public string? AudienceSlug { get; set; }
    [Parameter] public int? GuildAllianceIdRaw { get; set; }

    private IFeatureModule? descriptor;
    private IDictionary<string, object>? editorParameters;
    private bool needsAllianceLink;
    private string editorKey = "";

    // The audience/alliance the editor is rendering for — kept so the dependency block can build
    // correct Configure links for each dependency relative to this feature's context.
    private GuildAudience resolvedAudience;
    private int? resolvedAllianceId;
    private IReadOnlyList<FeatureDependencyState> dependencies = [];

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        editorParameters = null;
        needsAllianceLink = false;
        dependencies = [];

        descriptor = FeatureCatalog.FindBySlug(FeatureSlug);
        if (descriptor is null)
        {
            Nav.NotFound();
            return;
        }

        GuildAudience effectiveAudience;
        if (descriptor.HasMultipleAudiences())
        {
            var relevant = descriptor.RelevantAudiences();
            // Alliance can also arrive as the /alliance/{id}/features/{slug} route, where
            // AudienceSlug is null but GuildAllianceIdRaw is set — treat that as the Alliance audience.
            var slugParsed = AudienceDisplay.TryParseSlug(AudienceSlug, out var parsed);
            if (GuildAllianceIdRaw is not null && relevant.HasFlag(GuildAudience.Alliance))
            {
                parsed = GuildAudience.Alliance;
                slugParsed = true;
            }

            if (!slugParsed || !relevant.HasFlag(parsed))
            {
                var first = GuildFeatureAudiences.EnumerateFlags(relevant).First();
                Nav.NavigateTo(CanonicalUrl(first, await DefaultAllianceIdAsync(first)), replace: true);
                return;
            }

            effectiveAudience = parsed;
        }
        else
        {
            effectiveAudience = GuildFeatureAudiences.SingleAudience(descriptor.Feature);
        }

        int? guildAllianceId = null;
        if (effectiveAudience == GuildAudience.Alliance)
        {
            // Resolve the target alliance: an explicit (validated) route id wins, else the
            // top-bar selection, else the guild's primary link.
            guildAllianceId = await ResolveAllianceIdAsync(GuildAllianceIdRaw);
            if (guildAllianceId is null)
            {
                needsAllianceLink = true;
                return;
            }

            // Canonicalize the URL so it's deep-linkable and the AllianceSelector's rewrite works:
            // /alliance/{id}/features/{slug} (for single- and multi-audience alliance features).
            if (GuildAllianceIdRaw != guildAllianceId)
            {
                Nav.NavigateTo(CanonicalUrl(GuildAudience.Alliance, guildAllianceId), replace: true);
                return;
            }
        }

        // Always pass the resolved audience: multi-audience editors need it to know which
        // audience they're on, and single-audience editors that declare a non-nullable
        // [EditorRequired] Audience (OpsLevelRoles/RankRoles) need it too. For editors built on
        // FeatureEditorBase (nullable Audience) this equals what ResolvedAudience would compute.
        editorParameters = new Dictionary<string, object>
        {
            ["GuildId"] = ParsedGuildId,
            ["Audience"] = effectiveAudience,
        };
        editorParameters["GuildAllianceId"] = guildAllianceId!;

        editorKey = $"{effectiveAudience}:{guildAllianceId}";

        resolvedAudience = effectiveAudience;
        resolvedAllianceId = guildAllianceId;
        var depContext = new FeatureModuleContext(FeatureService, SettingsService, DbFactory);
        dependencies = await descriptor.GetDependencyStatesAsync(ParsedGuildId, effectiveAudience, guildAllianceId, depContext);
    }

    // Configure link for a dependency, relative to this feature's context: the same audience/
    // alliance when the dependency is offered there, else the dependency's own first audience.
    private string DependencyHref(IFeatureModule dep)
    {
        var relevant = dep.RelevantAudiences();
        GuildAudience audience;
        int? allianceId = null;
        if (relevant.HasFlag(resolvedAudience))
        {
            audience = resolvedAudience;
            allianceId = resolvedAllianceId;
        }
        else
        {
            audience = GuildFeatureAudiences.EnumerateFlags(relevant).First();
        }

        return $"{AudienceDisplay.FeatureScopePrefix(ParsedGuildId, audience, allianceId)}/features/{dep.Slug}";
    }

    // Route id if it's a real link of this guild; else the selected alliance; else the primary.
    private async Task<int?> ResolveAllianceIdAsync(int? routeId)
    {
        if (routeId is { } id && await AllianceService.FindByIdAsync(ParsedGuildId, id) is not null)
            return id;
        if (AllianceContext.GuildAllianceId is { } selected && await AllianceService.FindByIdAsync(ParsedGuildId, selected) is not null)
            return selected;
        return await AllianceService.GetPrimaryIdAsync(ParsedGuildId);
    }

    private async Task<int?> DefaultAllianceIdAsync(GuildAudience audience) =>
        audience == GuildAudience.Alliance ? await ResolveAllianceIdAsync(null) : null;

    private string CanonicalUrl(GuildAudience audience, int? guildAllianceId) =>
        $"{AudienceDisplay.FeatureScopePrefix(ParsedGuildId, audience, guildAllianceId)}/features/{FeatureSlug}";
}
