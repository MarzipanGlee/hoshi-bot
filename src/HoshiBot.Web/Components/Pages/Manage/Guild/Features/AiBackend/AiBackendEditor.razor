@inherits FeatureEditorBase
@using HoshiBot.Web.Services

<p class="form-text">@Msg.WebAiBackend.Intro(Lang)</p>

<AiHealthBanner GuildId="GuildId" />

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.Provider)">
        <label for="aiProvider" class="form-label">
            @((MarkupString)Msg.WebEditor.Label(Lang, Feature, AiBackendSettingKeys.Provider))
        </label>
        <select id="aiProvider" class="form-select" @bind="providerInput" @bind:after="SaveProviderAsync">
            <option value="gemini">@Msg.WebAiBackend.ProviderOptionGemini(Lang)</option>
            <option value="ollama">@Msg.WebAiBackend.ProviderOptionOllama(Lang)</option>
        </select>
    </SettingsCard>

    @if (providerInput != "ollama")
    {
        <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.ApiKey)">
            <label class="form-label">
                @Msg.WebEditor.Label(Lang, Feature, AiBackendSettingKeys.ApiKey)
            </label>
            @if (hasKey)
            {
                <p class="form-text mb-1 text-success">@Msg.WebAiBackend.KeySaved(Lang)</p>
            }
            <div class="d-flex gap-2">
                <input type="password" class="form-control" autocomplete="off"
                       placeholder="@(hasKey ? Msg.WebAiBackend.KeySavedPlaceholder(Lang) : Msg.WebAiBackend.EnterKeyPlaceholder(Lang))"
                       @bind="apiKeyInput" @bind:after="SaveApiKeyAsync" />
                @if (hasKey)
                {
                    <button type="button" class="btn btn-sm btn-danger" @onclick="ClearApiKeyAsync">@Msg.WebCommon.Delete(Lang)</button>
                }
            </div>
        </SettingsCard>
    }

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.Model)">
        @if (providerInput == "ollama")
        {
            <label for="aiModel" class="form-label">
                @Msg.WebAiBackend.ModelLabelOllama(Lang)
            </label>
            <input id="aiModel" class="form-control" placeholder="@Msg.WebAiBackend.ServerDefaultModelPlaceholder(Lang)"
                   @bind="modelInput" @bind:after="SaveModelAsync" />
        }
        else
        {
            <label for="aiModel" class="form-label">
                @Msg.WebAiBackend.ModelLabelGemini(Lang, AiBackendSettingKeys.DefaultModel)
            </label>
            <input id="aiModel" class="form-control" placeholder="@AiBackendSettingKeys.DefaultModel"
                   @bind="modelInput" @bind:after="SaveModelAsync" />
        }
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.EmbeddingProvider)">
        <label for="aiEmbeddingProvider" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, AiBackendSettingKeys.EmbeddingProvider)
        </label>
        <select id="aiEmbeddingProvider" class="form-select"
                @bind="embeddingProviderInput" @bind:after="SaveEmbeddingProviderAsync">
            <option value="ollama">@Msg.WebAiBackend.EmbeddingOptionOllama(Lang)</option>
            <option value="gemini-embedding-001">@Msg.WebAiBackend.EmbeddingOptionGemini1(Lang)</option>
            <option value="gemini-embedding-2">@Msg.WebAiBackend.EmbeddingOptionGemini2(Lang)</option>
        </select>
        <div class="form-text">
            @((MarkupString)Msg.WebEditor.Usage(Lang, Feature, AiBackendSettingKeys.EmbeddingProvider))
        </div>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.GateModel)">
        <label for="aiGateModel" class="form-label">
            @((MarkupString)Msg.WebEditor.Label(Lang, Feature, AiBackendSettingKeys.GateModel))
        </label>
        @if (providerInput == "ollama")
        {
            <input id="aiGateModel" class="form-control" placeholder="@Msg.WebAiBackend.ServerDefaultPlaceholder(Lang)"
                   @bind="gateModelInput" @bind:after="SaveGateModelAsync" />
            <div class="form-text">
                @((MarkupString)Msg.WebAiBackend.GateUsageOllama(Lang))
            </div>
        }
        else
        {
            <input id="aiGateModel" class="form-control" placeholder="@Msg.WebAiBackend.DefaultModelPlaceholder(Lang, AiBackendSettingKeys.DefaultGateModel)"
                   @bind="gateModelInput" @bind:after="SaveGateModelAsync" />
            <div class="form-text">@((MarkupString)Msg.WebAiBackend.GateUsageGemini(Lang, AiBackendSettingKeys.DefaultGateModel))</div>
        }
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiBackendSettingKeys.RouterModel)">
        <label for="aiRouterModel" class="form-label">
            @((MarkupString)Msg.WebEditor.Label(Lang, Feature, AiBackendSettingKeys.RouterModel))
            @if (providerInput != "ollama")
            {
                <span>
                    @((MarkupString)Msg.WebAiBackend.RouterTip(Lang, AiBackendSettingKeys.DefaultGateModel))
                </span>
            }
        </label>
        <input id="aiRouterModel" class="form-control"
               placeholder="@(providerInput == "ollama" ? Msg.WebAiBackend.RouterOffOllamaPlaceholder(Lang) : Msg.WebAiBackend.RouterOffGeminiPlaceholder(Lang, AiBackendSettingKeys.DefaultGateModel))"
               @bind="routerModelInput" @bind:after="SaveRouterModelAsync" />
        <div class="form-text">@((MarkupString)Msg.WebEditor.Usage(Lang, Feature, AiBackendSettingKeys.RouterModel))</div>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AiBackend;

    private bool hasKey;
    private string? apiKeyInput;
    private string providerInput = "gemini";
    private string? modelInput;
    private string embeddingProviderInput = "ollama";
    private string? gateModelInput;
    private string? routerModelInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        // The stored API key is never echoed back into the field — we only track whether one exists.
        hasKey = !string.IsNullOrWhiteSpace(await GetTextAsync(AiBackendSettingKeys.ApiKey));
        // Unset/unknown provider means Gemini (matches AiChatService's default).
        var storedProvider = await GetTextAsync(AiBackendSettingKeys.Provider);
        providerInput = string.Equals(storedProvider, "ollama", StringComparison.OrdinalIgnoreCase) ? "ollama" : "gemini";
        modelInput = await GetTextAsync(AiBackendSettingKeys.Model);
        var storedEmbeddingProvider = await GetTextAsync(AiBackendSettingKeys.EmbeddingProvider);
        embeddingProviderInput = storedEmbeddingProvider is "gemini-embedding-001" or "gemini-embedding-2"
            ? storedEmbeddingProvider
            : "ollama";
        gateModelInput = await GetTextAsync(AiBackendSettingKeys.GateModel);
        routerModelInput = await GetTextAsync(AiBackendSettingKeys.RouterModel);
    }

    private async Task SaveApiKeyAsync()
    {
        // Blank submit leaves the existing key untouched (use Delete to remove it).
        if (string.IsNullOrWhiteSpace(apiKeyInput))
            return;

        // Encrypted at rest — write via the secret path, not the plain SetTextAsync helper.
        await SetSecretAsync(AiBackendSettingKeys.ApiKey, apiKeyInput.Trim());
        apiKeyInput = null;
        hasKey = true;
    }

    private async Task ClearApiKeyAsync()
    {
        await SetTextAsync(AiBackendSettingKeys.ApiKey, null);
        apiKeyInput = null;
        hasKey = false;
    }

    private Task SaveProviderAsync() => SetTextAsync(AiBackendSettingKeys.Provider, providerInput);

    private Task SaveModelAsync() => SetTextAsync(AiBackendSettingKeys.Model, modelInput);

    private Task SaveEmbeddingProviderAsync() => SetTextAsync(AiBackendSettingKeys.EmbeddingProvider, embeddingProviderInput);

    private Task SaveGateModelAsync() => SetTextAsync(AiBackendSettingKeys.GateModel, gateModelInput);

    private Task SaveRouterModelAsync() => SetTextAsync(AiBackendSettingKeys.RouterModel, routerModelInput);
}
