@using HoshiBot.Web.Services
@using NetCord
@inherits FeatureEditorBase
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <ChannelPicker CardTitle="Tickets" Usage="Parent channel every ticket thread gets created under. Staff visibility comes from this channel's own Discord permissions (Manage Threads), not from anything the bot manages." Kind="ChannelKind.TextOnly"
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.Tickets;

    private List<IGuildChannel> channels = [];
    private string? channelInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        channelInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, TicketsSettingKeys.Channel))?.ToString();
    }

    private Task SaveChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, TicketsSettingKeys.Channel, ParseId(channelInput));
}
