@using HoshiBot.Data
@using HoshiBot.Web.Services
@inherits GuildAdminPageBase
@inject DiscordGuildDataService DiscordData
@inject PlayerLinkService PlayerLink

<PageTitle>@Msg.WebFeature.ExtraTitle(Lang, GuildFeature.PlayerLink, "assignments")</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <p>@Msg.WebPlayerAssignmentsAdmin.Loading(Lang)</p>
    }
    else
    {
        <h1>@Msg.WebPlayerAssignmentsAdmin.Heading(Lang)</h1>
        <p class="text-muted">
            @((MarkupString)Msg.WebPlayerAssignmentsAdmin.Intro(Lang))
        </p>

        <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
            <div style="max-width:22rem;flex:1 1 16rem">
                <label class="form-label small mb-1">@Msg.WebPlayerAssignmentsAdmin.SearchMemberLabel(Lang)</label>
                <input class="form-control form-control-sm" placeholder="@Msg.WebPlayerAssignmentsAdmin.SearchPlaceholder(Lang)" value="@memberFilter"
                       @oninput="e => memberFilter = e.Value?.ToString() ?? string.Empty" />
            </div>
            @* nowrap: this switch is a flex item in the toolbar row above, so it gets squeezed and
               its label breaks mid-phrase ("Nur nicht" / "zugeordnete"). Unlike the switches inside
               settings cards, whose long usage text is meant to wrap, this one is a short caption
               that should stay on one line and let the row wrap around it instead. *@
            <div class="form-switch text-nowrap">
                <input class="form-check-input" type="checkbox" role="switch" id="onlyUnlinked"
                       checked="@onlyUnlinked" @onchange="e => onlyUnlinked = (bool)e.Value!" />
                <label class="form-check-label" for="onlyUnlinked">@Msg.WebPlayerAssignmentsAdmin.OnlyUnassigned(Lang)</label>
            </div>
            <span class="text-muted small">@Msg.WebPlayerAssignmentsAdmin.MembersCount(Lang, FilteredMembers.Count, members.Count)</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="min-width:12rem">@Msg.WebPlayerAssignmentsAdmin.ColMember(Lang)</th>
                        <th>@Msg.WebPlayerAssignmentsAdmin.ColAssignedPlayers(Lang)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in FilteredMembers)
                    {
                        <tr>
                            <td>@m.Name</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    @foreach (var link in m.Links)
                                    {
                                        <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                                            @if (link.IsGuildPrimary)
                                            {
                                                <span title="@Msg.WebPlayerAssignmentsAdmin.RepresentsTitle(Lang)">★</span>
                                            }
                                            <span>@PlayerLabel.Of(link.Name, link.ServerName, link.AllianceTag)</span>
                                            @if (!link.IsGuildPrimary)
                                            {
                                                <button type="button" class="btn btn-sm btn-link p-0 text-white text-decoration-none"
                                                        title="@Msg.WebPlayerAssignmentsAdmin.UseHereTitle(Lang)" @onclick="() => SetGuildPrimaryAsync(m.Id, link.PlayerId)">☆</button>
                                            }
                                            <button type="button" class="btn btn-sm btn-link p-0 text-white text-decoration-none"
                                                    title="@Msg.WebCommon.Remove(Lang)" @onclick="() => UnlinkAsync(m.Id, link.PlayerId)">✕</button>
                                        </span>
                                    }
                                    @if (addingForUserId == m.Id)
                                    {
                                        <div class="d-inline-flex flex-column" style="min-width:18rem">
                                            <input class="form-control form-control-sm" placeholder="@Msg.WebPlayerAssignmentsAdmin.SearchPlayerPlaceholder(Lang)" value="@searchTerm"
                                                   @oninput="OnSearchInputAsync" autofocus />
                                            @if (searchResults.Count > 0)
                                            {
                                                <div class="list-group mt-1" style="max-height:14rem;overflow-y:auto">
                                                    @foreach (var r in searchResults)
                                                    {
                                                        <button type="button" class="list-group-item list-group-item-action py-1"
                                                                @onclick="() => AssignAsync(m.Id, r.Id)">
                                                            @PlayerLabel.Of(r.Name, r.ServerName, r.AllianceTag)
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartAdding(m.Id)">
                                            @Msg.WebPlayerAssignmentsAdmin.AddPlayerButton(Lang)
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private bool loading = true;
    private List<MemberRow> members = [];
    private string memberFilter = "";
    private bool onlyUnlinked;

    private ulong? addingForUserId;
    private string searchTerm = "";
    private List<PlayerSearchResult> searchResults = [];

    private List<MemberRow> FilteredMembers => members
        .Where(m => !onlyUnlinked || m.Links.Count == 0)
        .Where(m => memberFilter.Length == 0 || m.Name.Contains(memberFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnAuthorizedParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        var names = await DiscordData.GetMemberNicknamesAsync(ParsedGuildId);
        var links = await PlayerLink.GetLinksForUsersAsync(names.Keys, ParsedGuildId);
        members = names
            .Select(kv => new MemberRow(kv.Key, string.IsNullOrWhiteSpace(kv.Value) ? kv.Key.ToString() : kv.Value,
                links.GetValueOrDefault(kv.Key) ?? []))
            .OrderBy(m => m.Name)
            .ToList();
        loading = false;
    }

    // Refresh one member's links after a change, without re-fetching the whole Discord member list.
    private async Task RefreshLinksAsync(ulong userId)
    {
        var links = await PlayerLink.GetLinksForUsersAsync([userId], ParsedGuildId);
        var idx = members.FindIndex(m => m.Id == userId);
        if (idx >= 0)
            members[idx] = members[idx] with { Links = links.GetValueOrDefault(userId) ?? [] };
    }

    private void StartAdding(ulong userId)
    {
        addingForUserId = userId;
        searchTerm = "";
        searchResults = [];
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        searchResults = searchTerm.Trim().Length < 2 ? [] : await PlayerLink.SearchPlayersAsync(searchTerm);
    }

    private async Task AssignAsync(ulong userId, int playerId)
    {
        // Record guild membership so the role-sync jobs (which iterate GuildMembers) actually apply
        // roles to this assignment.
        await PlayerLink.EnsureGuildMemberAsync(ParsedGuildId, userId);
        await PlayerLink.LinkAsync(userId, playerId);
        await PlayerLink.MarkUserResolvedAsync(userId);
        addingForUserId = null;
        searchTerm = "";
        searchResults = [];
        await RefreshLinksAsync(userId);
    }

    private async Task SetGuildPrimaryAsync(ulong userId, int playerId)
    {
        await PlayerLink.SetGuildPrimaryAsync(ParsedGuildId, userId, playerId);
        await RefreshLinksAsync(userId);
    }

    private async Task UnlinkAsync(ulong userId, int playerId)
    {
        await PlayerLink.UnlinkAsync(userId, playerId);
        await RefreshLinksAsync(userId);
    }


    private record MemberRow(ulong Id, string Name, List<MemberPlayerLink> Links);
}
