@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.EntityFrameworkCore
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="@Msg.WebCommon.HowItWorksCardTitle(Lang)">
        <p class="form-text mt-0">
            @((MarkupString)Msg.WebPlayerLink.HowItWorksUsage(Lang))
        </p>
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="player-link" ExtraSlug="assignments" Label="@Msg.WebPlayerLink.OpenAssignmentsLink(Lang)" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebPlayerLink.StatusCardTitle(Lang)">
        <p class="form-text mt-0">
            @((MarkupString)Msg.WebPlayerLink.StatusUsage(Lang, unresolvedCount))
        </p>
    </SettingsCard>

    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, PlayerLinkSettingKeys.UnlinkedRole)"
            Usage="@Msg.WebEditor.Usage(Lang, Feature, PlayerLinkSettingKeys.UnlinkedRole)"
            @bind-Value="unlinkedRoleInput" @bind-Value:after="SaveUnlinkedRoleAsync" Roles="roles" />
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.PlayerLink;

    private int unresolvedCount;
    private List<Role> roles = [];
    private string? unlinkedRoleInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        unlinkedRoleInput = (await GetSnowflakeAsync(PlayerLinkSettingKeys.UnlinkedRole))?.ToString();

        await using var db = await DbFactory.CreateDbContextAsync();
        unresolvedCount = await db.PlayerLinkReviews
            .CountAsync(r => r.GuildId == GuildId && r.Status == PlayerLinkReviewStatus.Unresolved);
    }

    private Task SaveUnlinkedRoleAsync() =>
        SetSnowflakeAsync(PlayerLinkSettingKeys.UnlinkedRole, ParseId(unlinkedRoleInput));
}
