@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.EntityFrameworkCore

<div class="form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch" checked="@Enabled"
           @onchange="e => ToggleEnabledAsync((bool)e.Value!)" />
    <label class="form-check-label">Enabled</label>
</div>

<div class="card-grid mt-1">
    <SettingsCard Title="How it works">
        <p class="form-text mt-0">
            The bot matches each member's Discord nickname against the whole player catalog and links
            confident matches automatically — a globally-unique name, or a unique match within one of your
            alliances — with <strong>no message to the member</strong>. Everyone else (members from other
            alliances/servers, renamed players, alts) you assign by hand on the member page.
        </p>
        <a class="btn btn-primary btn-sm mt-2" href="manage/guild/@GuildId/player-assignments">
            Spielerzuordnung öffnen
        </a>
    </SettingsCard>

    <SettingsCard Title="Status">
        <p class="form-text mt-0">
            @unresolvedCount Mitglied(er) konnten nicht automatisch zugeordnet werden und warten auf
            manuelle Zuordnung. Zum Anpassen der Rollen selbst siehe die Features <em>Rang-Rollen</em> und
            <em>Ops-Level-Rollen</em>.
        </p>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.PlayerLink;

    private int unresolvedCount;

    protected override async Task OnSettingsLoadedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        unresolvedCount = await db.PlayerLinkReviews
            .CountAsync(r => r.GuildId == GuildId && r.Status == PlayerLinkReviewStatus.Unresolved);
    }
}
