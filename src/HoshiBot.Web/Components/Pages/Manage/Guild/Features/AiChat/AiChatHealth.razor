@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject AiChatHealthService HealthService
@inject GuildFeatureSettingsService Settings
@inject DiscordGuildDataService DiscordData

<PageTitle>@Msg.WebAiChatHealth.Heading(Lang)</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <LoadingPlaceholder Em="false" />
    }
    else
    {
        <h1>@Msg.WebAiChatHealth.Heading(Lang)</h1>
        <p class="text-muted">
            @Msg.WebAiChatHealth.Intro(Lang)
        </p>

        <div class="card-grid mt-1">
            <SettingsCard Title="@Msg.WebAiChatHealth.EmbeddingCoverageCardTitle(Lang)">
                <p class="mb-1">
                    @((MarkupString)Msg.WebAiChatHealth.CoverageLine(Lang, embeddedCount, totalCount, coveragePercent))
                </p>
                @if (totalCount > 0 && embeddedCount < totalCount)
                {
                    <p class="form-text mb-1">
                        @Msg.WebAiChatHealth.AwaitingEmbedding(Lang, totalCount - embeddedCount)
                    </p>
                }
                <div class="progress" role="progressbar" style="height:1.25rem">
                    <div class="progress-bar @(embeddedCount == totalCount ? "bg-success" : "bg-warning")"
                         style="width:@coveragePercent%">@coveragePercent%</div>
                </div>
                <p class="form-text mt-2 mb-0">@((MarkupString)Msg.WebAiChatHealth.EmbeddingBackendLine(Lang, embeddingProviderLabel))</p>
            </SettingsCard>

            <SettingsCard Title="@Msg.WebAiChatHealth.ProviderHealthCardTitle(Lang)">
                @if (healthRows.Count == 0)
                {
                    <p class="text-muted mb-0">@Msg.WebAiChatHealth.NoCallsRecorded(Lang)</p>
                }
                else
                {
                    @foreach (var kind in new[] { AiChatProviderCallKind.Chat, AiChatProviderCallKind.Embed })
                    {
                        var row = healthRows.FirstOrDefault(h => h.Kind == kind);
                        <div class="mb-3">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <strong>@(kind == AiChatProviderCallKind.Chat ? Msg.WebAiChatHealth.ChatLabel(Lang) : Msg.WebAiChatHealth.EmbeddingsLabel(Lang))</strong>
                                @if (row is null)
                                {
                                    <span class="badge bg-secondary">@Msg.WebAiChatHealth.NoDataBadge(Lang)</span>
                                }
                                else if (IsDegraded(row))
                                {
                                    <span class="badge bg-danger">@Msg.WebAiChatHealth.DegradedBadge(Lang)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Msg.WebAiChatHealth.HealthyBadge(Lang)</span>
                                }
                            </div>
                            @if (row is not null)
                            {
                                <ul class="list-unstyled small mb-0">
                                    <li>@((MarkupString)Msg.WebAiChatHealth.ModelLine(Lang, row.Model ?? "—"))</li>
                                    <li>@Msg.WebAiChatHealth.LastSuccessLine(Lang, Ago(row.LastSuccessAt))</li>
                                    <li>
                                        @Msg.WebAiChatHealth.LastErrorLine(Lang, Ago(row.LastErrorAt))
                                        @if (!string.IsNullOrWhiteSpace(row.LastErrorMessage))
                                        {
                                            <div class="text-danger"><code>@row.LastErrorMessage</code></div>
                                        }
                                    </li>
                                </ul>
                            }
                        </div>
                    }
                }
            </SettingsCard>

            <SettingsCard Title="@Msg.WebAiChatHealth.KnowledgeListenChannelsCardTitle(Lang)" Class="card-span-full">
                @if (tierRows.Count == 0)
                {
                    <p class="text-muted mb-0">@Msg.WebAiChatHealth.NoChannelsConfigured(Lang)</p>
                }
                else
                {
                    <QuickGrid Class="table" Items="tierRows.AsQueryable()">
                        <PropertyColumn Property="r => r.Tier" Title="@Msg.WebAiChatHealth.TierColumn(Lang)" Sortable="true" />
                        <PropertyColumn Property="r => r.Channel" Title="@Msg.WebAiChatHealth.ChannelColumn(Lang)" Sortable="true" />
                        <PropertyColumn Property="r => r.Audience" Title="@Msg.WebAiChatHealth.AudienceColumn(Lang)" Sortable="true" />
                    </QuickGrid>
                }
            </SettingsCard>
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private bool loading = true;

    private int totalCount;
    private int embeddedCount;
    private int coveragePercent;
    private string embeddingProviderLabel = "";
    private IReadOnlyList<AiChatProviderHealth> healthRows = [];
    private List<TierRow> tierRows = [];

    private sealed record TierRow(string Tier, string Channel, string Audience);

    // Tier features, in display order (preferred → normal → last resort → listen). The display
    // label is resolved per-render via Msg.WebAiChatHealth.TierLabel(Lang, feature) — it can't live
    // in this array (a `static readonly` field is initialized once at type load, long before any
    // request's Lang is known, so a baked-in label would leak whatever language initialized it
    // first to every guild).
    private static readonly GuildFeature[] Tiers =
    [
        GuildFeature.AiChatKnowledgePreferred,
        GuildFeature.AiChatKnowledge,
        GuildFeature.AiChatKnowledgeLastResort,
        GuildFeature.AiChat,
    ];

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        loading = true;

        await using var db = await DbFactory.CreateDbContextAsync();
        totalCount = await db.AiChatIndexedMessages.CountAsync(m => m.GuildId == ParsedGuildId);
        embeddedCount = await db.AiChatIndexedMessages.CountAsync(m => m.GuildId == ParsedGuildId && m.Embedding != null);
        coveragePercent = totalCount == 0 ? 100 : (int)Math.Round(100.0 * embeddedCount / totalCount);

        var channelRows = await db.GuildFeatureChannels
            .Where(c => c.GuildId == ParsedGuildId && Tiers.Contains(c.Feature))
            .ToListAsync();

        var embeddingProvider = await Settings.GetTextAsync(ParsedGuildId, GuildFeature.AiBackend, GuildAudience.Guild, null, AiBackendSettingKeys.EmbeddingProvider);
        embeddingProviderLabel = string.IsNullOrWhiteSpace(embeddingProvider) ? Msg.WebAiChatHealth.OllamaDefaultLabel(Lang) : embeddingProvider;

        healthRows = await HealthService.GetAsync(ParsedGuildId);

        // Resolve channel/category ids to names for the tier table.
        var names = new Dictionary<ulong, string>();
        foreach (var ch in await DiscordData.GetChannelsAsync(ParsedGuildId))
            names[ch.Id] = ch.Name ?? ch.Id.ToString();
        foreach (var cat in await DiscordData.GetCategoriesAsync(ParsedGuildId))
            names[cat.Id] = Msg.WebAiChatHealth.CategorySuffix(Lang, cat.Name ?? cat.Id.ToString());

        tierRows = (from tier in Tiers
                    from c in channelRows.Where(c => c.Feature == tier)
                    select new TierRow(Msg.WebAiChatHealth.TierLabel(Lang, tier), names.GetValueOrDefault(c.ChannelId, c.ChannelId.ToString()), Msg.WebAudience.Label(Lang, c.Audience)))
                   .ToList();

        loading = false;
    }

    private static bool IsDegraded(AiChatProviderHealth row) =>
        row.LastErrorAt is { } e && (row.LastSuccessAt is null || e > row.LastSuccessAt);

    private string Ago(DateTimeOffset? when) =>
        when is { } w ? $"{w:yyyy-MM-dd HH:mm} UTC" : Msg.WebCommon.AiHealthNever(Lang);
}
