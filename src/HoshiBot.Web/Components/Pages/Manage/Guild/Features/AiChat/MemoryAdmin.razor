@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@inherits GuildAdminPageBase
@inject MemoryService MemoryService
@inject DiscordGuildDataService DiscordData

<PageTitle>Memories</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <LoadingPlaceholder Em="false" Text="Loading…" />
    }
    else
    {
        <h1>Hoshi's Memories</h1>
        <p class="text-muted">
            What Hoshi remembers about the community — formed automatically from chat. Edit the wording,
            re-weight importance (salience 1–5, higher = recalled more readily and resists fading), or
            forget any memory. Low-salience, long-unused ones fade on their own over time.
        </p>

        @if (memories.Count == 0)
        {
            <p class="text-muted">No memories yet — Hoshi forms them as the community chats (needs the Memory toggle on).</p>
        }
        else
        {
            @foreach (var m in memories)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span>
                                <span class="badge bg-secondary">@m.Scope</span>
                                @if (m.Scope == MemoryScope.Member && m.SubjectDiscordUserId is { } subjectId)
                                {
                                    <span class="badge bg-info text-dark ms-1">@members.DisplayName(subjectId)</span>
                                }
                            </span>
                            <small class="text-muted">
                                created @m.CreatedAt.ToString("yyyy-MM-dd")@(m.LastRecalledAt is { } r ? $" · last recalled {r:yyyy-MM-dd}" : " · never recalled")
                            </small>
                        </div>
                        <textarea class="form-control form-control-sm mb-2" rows="2" @bind="m.Content"></textarea>
                        <div class="d-flex gap-2 align-items-center">
                            <label class="small mb-0">Salience</label>
                            <select class="form-select form-select-sm" style="width:auto" @bind="m.Salience">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(m)">Save</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ForgetAsync(m)">Forget</button>
                            @if (savedId == m.Id)
                            {
                                <span class="text-success small">Saved ✓</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
</AuthorizedGuildView>

@code {
    private bool loading = true;
    private List<GuildMemory> memories = [];
    private MemberDirectory members = MemberDirectory.Empty;
    private int? savedId;

    protected override async Task OnAuthorizedParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        members = await DiscordData.GetMemberDirectoryAsync(ParsedGuildId);
        memories = await MemoryService.GetForGuildAsync(ParsedGuildId);
        loading = false;
    }

    private async Task SaveAsync(GuildMemory m)
    {
        await MemoryService.UpdateAsync(m.Id, m.Content, m.Salience);
        savedId = m.Id;
    }

    private async Task ForgetAsync(GuildMemory m)
    {
        await MemoryService.DeleteAsync(m.Id);
        await ReloadAsync();
    }
}
