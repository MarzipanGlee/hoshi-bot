@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@inject GuildFeatureSettingsService SettingsService
@inject DiscordGuildDataService DiscordData

<p class="form-text">
    The bot listens to every message in the <strong>listen channels</strong> and answers when it has
    a genuinely helpful reply (staying silent otherwise). It always answers when addressed by its
    nickname or @@mention. Answers are grounded in the recent conversation plus the configured
    <strong>knowledge channels</strong>. The language-model provider, API key and models are shared
    across every AI feature and configured on the <strong>AI Provider</strong> page.
</p>

<p class="form-text">
    <strong>Knowledge channels</strong> (or whole categories) are the sources the bot draws on to
    ground its answers. Their <strong>priority</strong> controls which sources the answer search
    prefers — <em>Preferred</em> is boosted, <em>Last resort</em> is only used when the higher tiers
    have no answer. A channel belongs to exactly <em>one</em> tier (adding it to one removes it from
    the others).
</p>

<AiHealthBanner GuildId="GuildId" />

<div class="form-switch mb-3">
    <input type="checkbox" class="form-check-input" role="switch" checked="@Enabled"
           @onchange="e => ToggleEnabledAsync((bool)e.Value!)" />
    <label class="form-check-label">Enabled</label>
</div>

<div class="mb-3">
    <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
        FeatureSlug="ai-chat" ExtraSlug="health" Label="AI Chat health" />
</div>

<div class="card-grid mt-1">
    <MultiChannelPicker GuildId="GuildId" Feature="GuildFeature.AiChat" Audience="ResolvedAudience"
        Title="Listen channels" Usage="Channels the bot reads and answers in." />

    <MultiChannelPicker @ref="preferredPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledgePreferred"
        Audience="ResolvedAudience" AllowCategories="true"
        ExclusiveWith="PreferredExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="Knowledge – preferred"
        Usage="Curated/internal channels. Hits here are boosted in the answer search." />

    <MultiChannelPicker @ref="normalPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledge"
        Audience="ResolvedAudience" AllowCategories="true"
        ExclusiveWith="NormalExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="Knowledge – normal"
        Usage="The bot's standard knowledge sources." />

    <MultiChannelPicker @ref="lastResortPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledgeLastResort"
        Audience="ResolvedAudience" AllowCategories="true"
        ExclusiveWith="LastResortExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="Knowledge – last resort"
        Usage="E.g. external content (content creators / Scopely). Used only when the preferred/normal sources have no answer." />

    <SettingsCard Title="System prompt (optional)">
        <label for="aiChatSystemPrompt" class="form-label">
            Extra personality/behaviour instruction, prepended to the default prompt.
        </label>
        <textarea id="aiChatSystemPrompt" class="form-control flex-grow-1" rows="4"
                  @bind="systemPromptInput" @bind:after="SaveSystemPromptAsync"></textarea>
    </SettingsCard>

    <SettingsCard Title="Response streaming">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="aiChatStreaming"
                   checked="@streamResponses" @onchange="e => SaveStreamResponsesAsync((bool)e.Value!)" />
            <label class="form-check-label" for="aiChatStreaming">Stream answers live</label>
        </div>
        <div class="form-text">
            Post an answer as a placeholder / typing indicator and edit it in place as the model writes,
            instead of one message at the end. Nice for slow local (Ollama) models; off by default.
        </div>
    </SettingsCard>

    <SettingsCard Title="Memory (experimental)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="aiChatMemory"
                   checked="@memoryEnabled" @onchange="e => SaveMemoryEnabledAsync((bool)e.Value!)" />
            <label class="form-check-label" for="aiChatMemory">Let Hoshi remember events</label>
        </div>
        <p class="form-text mt-0">
            Hoshi distils notable community events from chat into memories she recalls later in
            conversation. Needs embeddings configured (see the AI Provider page). Review,
            edit, or forget them here.
        </p>
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="ai-chat" ExtraSlug="memories" Label="Open memories" />
    </SettingsCard>

    <SettingsCard Title="Search language">
        <label for="aiChatSearchLanguage" class="form-label">
            Language for the full-text search over the knowledge sources (controls word-stemming).
            Prefilled from the server language.
        </label>
        <select id="aiChatSearchLanguage" class="form-select" @bind="searchLanguageInput" @bind:after="SaveSearchLanguageAsync">
            @foreach (var lang in FtsLanguage.SupportedConfigs)
            {
                <option value="@lang">@lang</option>
            }
        </select>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AiChat;

    // The three knowledge-priority tier pickers; a channel lives in exactly one. Each declares the
    // other two as ExclusiveWith so adding a channel moves it, and OnChanged refreshes all three.
    private MultiChannelPicker? preferredPicker;
    private MultiChannelPicker? normalPicker;
    private MultiChannelPicker? lastResortPicker;

    private static readonly GuildFeature[] PreferredExclusiveWith = [GuildFeature.AiChatKnowledge, GuildFeature.AiChatKnowledgeLastResort];
    private static readonly GuildFeature[] NormalExclusiveWith = [GuildFeature.AiChatKnowledgePreferred, GuildFeature.AiChatKnowledgeLastResort];
    private static readonly GuildFeature[] LastResortExclusiveWith = [GuildFeature.AiChatKnowledge, GuildFeature.AiChatKnowledgePreferred];

    private async Task RefreshKnowledgePickersAsync()
    {
        if (preferredPicker is not null) await preferredPicker.ReloadAsync();
        if (normalPicker is not null) await normalPicker.ReloadAsync();
        if (lastResortPicker is not null) await lastResortPicker.ReloadAsync();
    }

    private string? systemPromptInput;
    private bool streamResponses;
    private bool memoryEnabled;
    private string? searchLanguageInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        systemPromptInput = await GetText(AiChatSettingKeys.SystemPrompt);
        streamResponses = string.Equals(await GetText(AiChatSettingKeys.StreamResponses), "true", StringComparison.OrdinalIgnoreCase);
        memoryEnabled = string.Equals(await GetText(AiChatSettingKeys.MemoryEnabled), "true", StringComparison.OrdinalIgnoreCase);

        // Show the effective search language: the stored choice, or the default derived from the
        // guild's Discord locale when unset (matches what the bot resolves at query time).
        var storedLanguage = await GetText(AiChatSettingKeys.SearchLanguage);
        searchLanguageInput = !string.IsNullOrWhiteSpace(storedLanguage)
            ? FtsLanguage.Normalize(storedLanguage)
            : FtsLanguage.FromDiscordLocale(await DiscordData.GetPreferredLocaleAsync(GuildId));
    }

    // These behavioral settings are per-audience — each audience/alliance tab keeps its own system
    // prompt, streaming, memory toggle and search language (ResolvedAudience + GuildAllianceId from
    // FeatureEditorBase). The guild-wide backend settings live on the AI Provider page instead.
    private Task<string?> GetText(string key) =>
        SettingsService.GetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, key);

    private Task SetText(string key, string? value) =>
        SettingsService.SetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, key, value);

    private Task SaveSystemPromptAsync() => SetText(AiChatSettingKeys.SystemPrompt, systemPromptInput);

    private async Task SaveStreamResponsesAsync(bool value)
    {
        streamResponses = value;
        await SetText(AiChatSettingKeys.StreamResponses, value ? "true" : null);
    }

    private async Task SaveMemoryEnabledAsync(bool value)
    {
        memoryEnabled = value;
        await SetText(AiChatSettingKeys.MemoryEnabled, value ? "true" : null);
    }

    private Task SaveSearchLanguageAsync() => SetText(AiChatSettingKeys.SearchLanguage, searchLanguageInput);
}
