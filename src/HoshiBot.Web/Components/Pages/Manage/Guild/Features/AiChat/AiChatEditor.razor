@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@inject DiscordGuildDataService DiscordData

<p class="form-text">
    @((MarkupString)Msg.WebAiChat.Intro1(Lang))
</p>

<p class="form-text">
    @((MarkupString)Msg.WebAiChat.Intro2(Lang))
</p>

<AiHealthBanner GuildId="GuildId" />

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="mb-3">
    <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
        FeatureSlug="ai-chat" ExtraSlug="health" Label="@Msg.WebAiChat.HealthLink(Lang)" />
</div>

<div class="card-grid mt-1">
    <MultiChannelPicker GuildId="GuildId" Feature="GuildFeature.AiChat" Audience="ResolvedAudience"
        Title="@Msg.WebAiChat.ListenTitle(Lang)" Usage="@Msg.WebAiChat.ListenUsage(Lang)" />

    @* Knowledge sources are read-only, so forums are selectable too (Kind) — the indexer expands a
       forum to its threads. The listen picker above stays Normal: the listen match compares the raw
       channel id, so a forum there would never fire. *@
    <MultiChannelPicker @ref="preferredPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledgePreferred"
        Audience="ResolvedAudience" AllowCategories="true" Kind="ChannelKind.NormalOrForum"
        ExclusiveWith="PreferredExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="@Msg.WebAiChat.KnowledgePreferredTitle(Lang)"
        Usage="@Msg.WebAiChat.KnowledgePreferredUsage(Lang)" />

    <MultiChannelPicker @ref="normalPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledge"
        Audience="ResolvedAudience" AllowCategories="true" Kind="ChannelKind.NormalOrForum"
        ExclusiveWith="NormalExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="@Msg.WebAiChat.KnowledgeNormalTitle(Lang)"
        Usage="@Msg.WebAiChat.KnowledgeNormalUsage(Lang)" />

    <MultiChannelPicker @ref="lastResortPicker" GuildId="GuildId" Feature="GuildFeature.AiChatKnowledgeLastResort"
        Audience="ResolvedAudience" AllowCategories="true" Kind="ChannelKind.NormalOrForum"
        ExclusiveWith="LastResortExclusiveWith" OnChanged="RefreshKnowledgePickersAsync"
        Title="@Msg.WebAiChat.KnowledgeLastResortTitle(Lang)"
        Usage="@Msg.WebAiChat.KnowledgeLastResortUsage(Lang)" />

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiChatSettingKeys.SystemPrompt)">
        <label for="aiChatSystemPrompt" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, AiChatSettingKeys.SystemPrompt)
        </label>
        <textarea id="aiChatSystemPrompt" class="form-control flex-grow-1" rows="4"
                  @bind="systemPromptInput" @bind:after="SaveSystemPromptAsync"></textarea>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiChatSettingKeys.StreamResponses)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="aiChatStreaming"
                   checked="@streamResponses" @onchange="e => SaveStreamResponsesAsync((bool)e.Value!)" />
            <label class="form-check-label" for="aiChatStreaming">@Msg.WebEditor.Label(Lang, Feature, AiChatSettingKeys.StreamResponses)</label>
        </div>
        <div class="form-text">
            @Msg.WebEditor.Usage(Lang, Feature, AiChatSettingKeys.StreamResponses)
        </div>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiChatSettingKeys.MemoryEnabled)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="aiChatMemory"
                   checked="@memoryEnabled" @onchange="e => SaveMemoryEnabledAsync((bool)e.Value!)" />
            <label class="form-check-label" for="aiChatMemory">@Msg.WebEditor.Label(Lang, Feature, AiChatSettingKeys.MemoryEnabled)</label>
        </div>
        <p class="form-text mt-0">
            @Msg.WebEditor.Usage(Lang, Feature, AiChatSettingKeys.MemoryEnabled)
        </p>
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="ai-chat" ExtraSlug="memories" Label="@Msg.WebAiChat.OpenMemoriesLink(Lang)" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AiChatSettingKeys.SearchLanguage)">
        <label for="aiChatSearchLanguage" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, AiChatSettingKeys.SearchLanguage)
        </label>
        <select id="aiChatSearchLanguage" class="form-select" @bind="searchLanguageInput" @bind:after="SaveSearchLanguageAsync">
            @foreach (var lang in FtsLanguage.SupportedConfigs)
            {
                <option value="@lang">@lang</option>
            }
        </select>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AiChat;

    // The three knowledge-priority tier pickers; a channel lives in exactly one. Each declares the
    // other two as ExclusiveWith so adding a channel moves it, and OnChanged refreshes all three.
    private MultiChannelPicker? preferredPicker;
    private MultiChannelPicker? normalPicker;
    private MultiChannelPicker? lastResortPicker;

    private static readonly GuildFeature[] PreferredExclusiveWith = [GuildFeature.AiChatKnowledge, GuildFeature.AiChatKnowledgeLastResort];
    private static readonly GuildFeature[] NormalExclusiveWith = [GuildFeature.AiChatKnowledgePreferred, GuildFeature.AiChatKnowledgeLastResort];
    private static readonly GuildFeature[] LastResortExclusiveWith = [GuildFeature.AiChatKnowledge, GuildFeature.AiChatKnowledgePreferred];

    private async Task RefreshKnowledgePickersAsync()
    {
        if (preferredPicker is not null) await preferredPicker.ReloadAsync();
        if (normalPicker is not null) await normalPicker.ReloadAsync();
        if (lastResortPicker is not null) await lastResortPicker.ReloadAsync();
    }

    private string? systemPromptInput;
    private bool streamResponses;
    private bool memoryEnabled;
    private string? searchLanguageInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        systemPromptInput = await GetTextAsync(AiChatSettingKeys.SystemPrompt);
        streamResponses = string.Equals(await GetTextAsync(AiChatSettingKeys.StreamResponses), "true", StringComparison.OrdinalIgnoreCase);
        memoryEnabled = string.Equals(await GetTextAsync(AiChatSettingKeys.MemoryEnabled), "true", StringComparison.OrdinalIgnoreCase);

        // Show the effective search language: the stored choice, or the default derived from the
        // guild's Discord locale when unset (matches what the bot resolves at query time).
        var storedLanguage = await GetTextAsync(AiChatSettingKeys.SearchLanguage);
        searchLanguageInput = !string.IsNullOrWhiteSpace(storedLanguage)
            ? FtsLanguage.Normalize(storedLanguage)
            : FtsLanguage.FromDiscordLocale(await DiscordData.GetPreferredLocaleAsync(GuildId));
    }

    // These behavioral settings are per-audience — each audience/alliance tab keeps its own system
    // prompt, streaming, memory toggle and search language (ResolvedAudience + GuildAllianceId from
    // FeatureEditorBase). The guild-wide backend settings live on the AI Provider page instead.
    private Task SaveSystemPromptAsync() => SetTextAsync(AiChatSettingKeys.SystemPrompt, systemPromptInput);

    private async Task SaveStreamResponsesAsync(bool value)
    {
        streamResponses = value;
        await SetTextAsync(AiChatSettingKeys.StreamResponses, value ? "true" : null);
    }

    private async Task SaveMemoryEnabledAsync(bool value)
    {
        memoryEnabled = value;
        await SetTextAsync(AiChatSettingKeys.MemoryEnabled, value ? "true" : null);
    }

    private Task SaveSearchLanguageAsync() => SetTextAsync(AiChatSettingKeys.SearchLanguage, searchLanguageInput);
}
