@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <MultiChannelPicker GuildId="GuildId" Feature="GuildFeature.AnnouncementForwarder" Audience="ResolvedAudience"
        Title="@Msg.WebAnnouncementForwarder.SourcesTitle(Lang)" Usage="@Msg.WebAnnouncementForwarder.SourcesUsage(Lang)" />

    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementForwarderSettingKeys.Channel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AnnouncementForwarderSettingKeys.Channel)"
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementForwarderSettingKeys.TargetLanguage)">
        <label for="forwarderLanguage" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, AnnouncementForwarderSettingKeys.TargetLanguage)
        </label>
        <select id="forwarderLanguage" class="form-select" @bind="targetLanguageInput" @bind:after="SaveTargetLanguageAsync">
            <option value="">@Msg.WebAnnouncementForwarder.ServerLanguageOption(Lang)</option>
            @foreach (var lang in FtsLanguage.SupportedConfigs.Where(l => l != FtsLanguage.Default))
            {
                <option value="@lang">@lang</option>
            }
        </select>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementForwarderSettingKeys.CatchUpWindowHours)">
        <label for="forwarderCatchUpWindow" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, AnnouncementForwarderSettingKeys.CatchUpWindowHours, ("hours", AnnouncementForwarderSettingKeys.DefaultCatchUpWindowHours))
        </label>
        <input id="forwarderCatchUpWindow" type="number" min="1" class="form-control"
               placeholder="@AnnouncementForwarderSettingKeys.DefaultCatchUpWindowHours"
               @bind="catchUpWindowInput" @bind:after="SaveCatchUpWindowAsync" />
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AnnouncementForwarder;

    private List<IGuildChannel> channels = [];
    private string? channelInput;
    private string? targetLanguageInput;
    private string? catchUpWindowInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        channelInput = (await GetSnowflakeAsync(AnnouncementForwarderSettingKeys.Channel))?.ToString();
        targetLanguageInput = await GetTextAsync(AnnouncementForwarderSettingKeys.TargetLanguage);
        catchUpWindowInput = await GetTextAsync(AnnouncementForwarderSettingKeys.CatchUpWindowHours);
    }

    private Task SaveChannelAsync() =>
        SetSnowflakeAsync(AnnouncementForwarderSettingKeys.Channel, ParseId(channelInput));

    private Task SaveTargetLanguageAsync() =>
        SetTextAsync(AnnouncementForwarderSettingKeys.TargetLanguage, targetLanguageInput);

    private Task SaveCatchUpWindowAsync() =>
        SetTextAsync(AnnouncementForwarderSettingKeys.CatchUpWindowHours, catchUpWindowInput);
}
