@inherits FeatureEditorBase
@using System.Globalization
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData
@inject GuildAllianceService AllianceService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createRoleError is not null)
{
    <p class="text-danger">@createRoleError</p>
}

<div class="card-grid mt-1">
    <ChannelPicker CardTitle="Digest Channel" Usage="Where this alliance's weekly/daily capture digests are posted."
            @bind-Value="digestChannelInput" @bind-Value:after="SaveDigestChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="Services Channel" Usage="Where the post-capture 'activate services' reminder for officers is posted."
            @bind-Value="servicesChannelInput" @bind-Value:after="SaveServicesChannelAsync" Channels="channels" />

    <SettingsCard Title="Services Role">
        <p class="form-text mb-0">
            The officer role pinged by the post-capture "activate services" reminder. Leave blank to
            create a dedicated role.
        </p>
        <RolePicker Label="Services Role" ShowLabel="false" CreateRoleName="Commodore"
            @bind-Value="servicesRoleInput" @bind-Value:after="SaveServicesRoleAsync" Roles="roles" />
    </SettingsCard>

    <SettingsCard Title="Service Selection">
        <p class="form-text mb-2">
            Curate each owned zone's services into must-have / nice-to-have for the "activate services"
            reminder. Unconfigured zones list all their services.
        </p>
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="territory-capture" ExtraSlug="service-selection" Label="Service Selection" />
    </SettingsCard>

    <SettingsCard Title="Zone Slot Roles">
        <p class="form-text mb-0">
            One role per owned-zone-slot the alliance currently holds this week (the "Zone Slots:
            N/5" cap shown in-game) — not days of the week. Slot N's role goes to every member with
            an owned zone in that slot.
        </p>
        <RolePicker Label="Slot 1" CreateRoleName="Slot 1" @bind-Value="zoneSlot1Input" @bind-Value:after="SaveZoneSlot1Async" Roles="roles" />
        <RolePicker Label="Slot 2" CreateRoleName="Slot 2" @bind-Value="zoneSlot2Input" @bind-Value:after="SaveZoneSlot2Async" Roles="roles" />
        <RolePicker Label="Slot 3" CreateRoleName="Slot 3" @bind-Value="zoneSlot3Input" @bind-Value:after="SaveZoneSlot3Async" Roles="roles" />
        <RolePicker Label="Slot 4" CreateRoleName="Slot 4" @bind-Value="zoneSlot4Input" @bind-Value:after="SaveZoneSlot4Async" Roles="roles" />
        <RolePicker Label="Slot 5" CreateRoleName="Slot 5" @bind-Value="zoneSlot5Input" @bind-Value:after="SaveZoneSlot5Async" Roles="roles" />
    </SettingsCard>

    <SettingsCard Title="Weekly Mention Role">
        <p class="form-text mb-0">
            The role pinged on the <em>weekly</em> digest (the daily digest pings the specific
            zone-slot roles for tomorrow instead). This is the alliance's absence-clean notification
            role — the same setting as on the Absences page; editing it here updates it there too.
        </p>
        <RolePicker Label="Notification Role" ShowLabel="false"
            @bind-Value="notificationRoleInput" @bind-Value:after="SaveNotificationRoleAsync" Roles="roles" />
    </SettingsCard>

    <SettingsCard Title="Digest Schedule">
        <p class="form-text mb-2">
            When the weekly and daily digests post, as local times in this alliance's timezone
            (<strong>@allianceTimeZoneDisplay</strong>, DST-aware — change it on
            <a href="@($"manage/guild/{GuildId}/alliance/{GuildAllianceId}/settings")">Alliance Settings</a>).
            Weekly posts the day before the capture week (Monday); daily posts every day. 30-minute steps.
        </p>
        <label for="tcWeeklyDigestTime" class="form-label">Weekly digest time</label>
        <input type="time" step="1800" id="tcWeeklyDigestTime" class="form-control mb-3"
               value="@weeklyDigestTimeInput" @onchange="OnWeeklyDigestTimeChanged" />
        <label for="tcDailyDigestTime" class="form-label">Daily digest time</label>
        <input type="time" step="1800" id="tcDailyDigestTime" class="form-control"
               value="@dailyDigestTimeInput" @onchange="OnDailyDigestTimeChanged" />
    </SettingsCard>

    <SettingsCard Title="Digest Instructions">
        <label for="territoryCaptureInstructions" class="form-label">
            Free-text "Anweisungen von {Command Staff}" section shown on the weekly/daily digest (e.g. attendance/armada expectations).
        </label>
        <textarea id="territoryCaptureInstructions" class="form-control flex-grow-1" rows="4"
                  @bind="instructionsInput" @bind:after="SaveInstructionsAsync"></textarea>
    </SettingsCard>
</div>

<PoweredBy For="@(new[] { typeof(StfcTerritoryService), typeof(StfcTerritoryOwnership) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.TerritoryCapture;

    private List<Role> roles = [];
    private List<IGuildChannel> channels = [];
    private string? digestChannelInput;
    private string? servicesChannelInput;
    private string? servicesRoleInput;
    private string? zoneSlot1Input;
    private string? zoneSlot2Input;
    private string? zoneSlot3Input;
    private string? zoneSlot4Input;
    private string? zoneSlot5Input;
    private string? notificationRoleInput;
    private string? instructionsInput;
    private string? weeklyDigestTimeInput;
    private string? dailyDigestTimeInput;
    private string allianceTimeZoneDisplay = GuildAlliance.DefaultTimeZoneId;
    private string? createRoleError;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        channels = await DiscordData.GetChannelsAsync(GuildId);
        digestChannelInput = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.DigestChannel))?.ToString();
        servicesChannelInput = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ServicesChannel))?.ToString();
        servicesRoleInput = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ServicesRole))?.ToString();
        zoneSlot1Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot1Role))?.ToString();
        zoneSlot2Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot2Role))?.ToString();
        zoneSlot3Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot3Role))?.ToString();
        zoneSlot4Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot4Role))?.ToString();
        zoneSlot5Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot5Role))?.ToString();
        notificationRoleInput = (await GetSnowflakeAsync(GuildFeature.Absences, AbsencesSettingKeys.NotificationRole))?.ToString();
        instructionsInput = await GetTextAsync(TerritoryCaptureSettingKeys.Instructions);

        weeklyDigestTimeInput = await GetTextAsync(TerritoryCaptureSettingKeys.WeeklyDigestTime) ?? TerritoryCaptureSettingKeys.DefaultWeeklyTime;
        dailyDigestTimeInput = await GetTextAsync(TerritoryCaptureSettingKeys.DailyDigestTime) ?? TerritoryCaptureSettingKeys.DefaultDailyTime;
        if (GuildAllianceId is { } allianceId)
            allianceTimeZoneDisplay = (await AllianceService.FindByIdAsync(GuildId, allianceId))?.TimeZoneId ?? GuildAlliance.DefaultTimeZoneId;
    }

    private Task SaveDigestChannelAsync() =>
        SetSnowflakeAsync(TerritoryCaptureSettingKeys.DigestChannel, ParseId(digestChannelInput));

    private Task SaveServicesChannelAsync() =>
        SetSnowflakeAsync(TerritoryCaptureSettingKeys.ServicesChannel, ParseId(servicesChannelInput));

    // A blank selection creates a dedicated "Commodore" role instead of saving null (mirrors the
    // zone-slot roles).
    private async Task SaveServicesRoleAsync()
    {
        createRoleError = null;
        (var roleId, servicesRoleInput, createRoleError) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, servicesRoleInput, "Commodore");
        if (createRoleError is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(TerritoryCaptureSettingKeys.ServicesRole, roleId);
    }

    private async Task SaveZoneSlotAsync(string key, Action<string?> setInput, string? currentInput, string slotName)
    {
        createRoleError = null;
        var (roleId, input, error) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, currentInput, slotName);
        setInput(input);
        createRoleError = error;
        if (error is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(key, roleId);
    }

    private Task SaveZoneSlot1Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot1Role, v => zoneSlot1Input = v, zoneSlot1Input, "Slot 1");
    private Task SaveZoneSlot2Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot2Role, v => zoneSlot2Input = v, zoneSlot2Input, "Slot 2");
    private Task SaveZoneSlot3Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot3Role, v => zoneSlot3Input = v, zoneSlot3Input, "Slot 3");
    private Task SaveZoneSlot4Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot4Role, v => zoneSlot4Input = v, zoneSlot4Input, "Slot 4");
    private Task SaveZoneSlot5Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot5Role, v => zoneSlot5Input = v, zoneSlot5Input, "Slot 5");

    private Task SaveInstructionsAsync() =>
        SetTextAsync(TerritoryCaptureSettingKeys.Instructions, instructionsInput);

    // The <input type="time"> emits an "HH:mm" string; bind it manually (a string @bind isn't allowed
    // on type=time). We snap to the nearest :00/:30 before saving — the sweep only fires at half-hour
    // ticks, so an off-grid value (typed past the step) would otherwise store one time but post at the
    // next slot. Blank clears the setting → the sweep falls back to the default (09:00 / 19:00).
    private async Task OnWeeklyDigestTimeChanged(ChangeEventArgs e)
    {
        weeklyDigestTimeInput = SnapToHalfHour(e.Value?.ToString());
        await SetTextAsync(TerritoryCaptureSettingKeys.WeeklyDigestTime, weeklyDigestTimeInput);
    }

    private async Task OnDailyDigestTimeChanged(ChangeEventArgs e)
    {
        dailyDigestTimeInput = SnapToHalfHour(e.Value?.ToString());
        await SetTextAsync(TerritoryCaptureSettingKeys.DailyDigestTime, dailyDigestTimeInput);
    }

    // Round a typed "HH:mm" to the nearest 30 minutes so the stored value matches when the sweep
    // actually fires. Blank/unparseable passes through (blank clears → default).
    private static string? SnapToHalfHour(string? raw)
    {
        if (!TimeOnly.TryParseExact(raw, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t))
            return raw;
        var snapped = (int)Math.Round((t.Hour * 60 + t.Minute) / 30.0, MidpointRounding.AwayFromZero) * 30 % 1440;
        return new TimeOnly(snapped / 60, snapped % 60).ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    // Stored under the Absences feature (its owner) so this and the Absences page edit one value.
    private Task SaveNotificationRoleAsync() =>
        SetSnowflakeAsync(GuildFeature.Absences, AbsencesSettingKeys.NotificationRole, ParseId(notificationRoleInput));
}
