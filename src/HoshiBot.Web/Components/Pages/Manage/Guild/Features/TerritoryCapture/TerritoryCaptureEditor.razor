@inherits FeatureEditorBase
@using HoshiBot.Domain
@using System.Globalization
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData
@inject GuildAllianceService AllianceService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createError is not null)
{
    <p class="text-danger">@createError.Value.Text(Lang)</p>
}

@if (createRoleError is not null)
{
    <p class="text-danger">@createRoleError.Value.Text(Lang)</p>
}

<div class="card-grid mt-1">
    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, TerritoryCaptureSettingKeys.DigestChannel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, TerritoryCaptureSettingKeys.DigestChannel)"
            @bind-Value="digestChannelInput" @bind-Value:after="SaveDigestChannelAsync" Channels="channels" />

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, ZoneSlotRolesKey)">
        <p class="form-text mb-0">
            @Msg.WebEditor.Usage(Lang, Feature, ZoneSlotRolesKey)
        </p>
        <RolePicker Label="Slot 1" CreateRoleName="@ZoneSlotRoleName(1)" @bind-Value="zoneSlot1Input" @bind-Value:after="SaveZoneSlot1Async" Roles="roles" />
        <RolePicker Label="Slot 2" CreateRoleName="@ZoneSlotRoleName(2)" @bind-Value="zoneSlot2Input" @bind-Value:after="SaveZoneSlot2Async" Roles="roles" />
        <RolePicker Label="Slot 3" CreateRoleName="@ZoneSlotRoleName(3)" @bind-Value="zoneSlot3Input" @bind-Value:after="SaveZoneSlot3Async" Roles="roles" />
        <RolePicker Label="Slot 4" CreateRoleName="@ZoneSlotRoleName(4)" @bind-Value="zoneSlot4Input" @bind-Value:after="SaveZoneSlot4Async" Roles="roles" />
        <RolePicker Label="Slot 5" CreateRoleName="@ZoneSlotRoleName(5)" @bind-Value="zoneSlot5Input" @bind-Value:after="SaveZoneSlot5Async" Roles="roles" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, WeeklyMentionRoleKey)">
        <p class="form-text mb-0">
            @((MarkupString)Msg.WebEditor.Usage(Lang, Feature, WeeklyMentionRoleKey))
        </p>
        <RolePicker Label="@Msg.WebEditor.Label(Lang, Feature, AbsencesSettingKeys.NotificationRole)" ShowLabel="false"
            CreateRoleName="@NotificationRoleName"
                @bind-Value="notificationRoleInput" @bind-Value:after="SaveNotificationRoleAsync" Roles="roles" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, DigestScheduleKey)">
        <p class="form-text mb-2">
            @((MarkupString)Msg.WebTerritoryCapture.DigestScheduleUsage(Lang, allianceTimeZoneDisplay, $"manage/guild/{GuildId}/alliance/{GuildAllianceId}/settings"))
        </p>
        <label for="tcWeeklyDigestTime" class="form-label">@Msg.WebTerritoryCapture.WeeklyDigestTimeLabel(Lang)</label>
        <input type="time" step="1800" id="tcWeeklyDigestTime" class="form-control mb-3"
               value="@weeklyDigestTimeInput" @onchange="OnWeeklyDigestTimeChanged" />
        <label for="tcDailyDigestTime" class="form-label">@Msg.WebTerritoryCapture.DailyDigestTimeLabel(Lang)</label>
        <input type="time" step="1800" id="tcDailyDigestTime" class="form-control"
               value="@dailyDigestTimeInput" @onchange="OnDailyDigestTimeChanged" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, TerritoryCaptureSettingKeys.Instructions)">
        <label for="territoryCaptureInstructions" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, TerritoryCaptureSettingKeys.Instructions)
        </label>
        <textarea id="territoryCaptureInstructions" class="form-control flex-grow-1" rows="4"
                  @bind="instructionsInput" @bind:after="SaveInstructionsAsync"></textarea>
    </SettingsCard>
</div>

<PoweredBy For="@(new[] { typeof(StfcTerritoryService), typeof(StfcTerritoryOwnership) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.TerritoryCapture;

    // Not real stored setting keys (no persisted value of their own — each groups several
    // *SettingKeys under one card) — used only to key these cards' catalog text, mirroring
    // RaidAlerts' local ChannelKey pattern.
    private const string ZoneSlotRolesKey = "ZoneSlotRoles";
    private const string WeeklyMentionRoleKey = "WeeklyMentionRole";
    private const string DigestScheduleKey = "DigestSchedule";

    private List<Role> roles = [];
    private DiscordCreateErrorKind? createError;
    private List<IGuildChannel> channels = [];
    private string? digestChannelInput;
    private string? zoneSlot1Input;
    private string? zoneSlot2Input;
    private string? zoneSlot3Input;
    private string? zoneSlot4Input;
    private string? zoneSlot5Input;
    private string? notificationRoleInput;
    private string? instructionsInput;
    private string? weeklyDigestTimeInput;
    private string? dailyDigestTimeInput;
    private string allianceTimeZoneDisplay = GuildAlliance.DefaultTimeZoneId;
    private DiscordCreateErrorKind? createRoleError;

    protected override async Task OnSettingsLoadedAsync()
    {

        // Only an Alliance-scoped page has a tag; elsewhere NotificationRoleName falls back to the
        // bare word rather than inventing a prefix.
        if (GuildAllianceId is { } notificationTagAllianceId)
            allianceTag = (await AllianceService.FindByIdAsync(GuildId, notificationTagAllianceId))?.StfcAlliance.Tag ?? "";
        roles = await DiscordData.GetRolesAsync(GuildId);
        channels = await DiscordData.GetChannelsAsync(GuildId);
        digestChannelInput = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.DigestChannel))?.ToString();
        zoneSlot1Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot1Role))?.ToString();
        zoneSlot2Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot2Role))?.ToString();
        zoneSlot3Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot3Role))?.ToString();
        zoneSlot4Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot4Role))?.ToString();
        zoneSlot5Input = (await GetSnowflakeAsync(TerritoryCaptureSettingKeys.ZoneSlot5Role))?.ToString();
        notificationRoleInput = (await GetSnowflakeAsync(GuildFeature.Absences, AbsencesSettingKeys.NotificationRole))?.ToString();
        instructionsInput = await GetTextAsync(TerritoryCaptureSettingKeys.Instructions);

        weeklyDigestTimeInput = await GetTextAsync(TerritoryCaptureSettingKeys.WeeklyDigestTime) ?? TerritoryCaptureSettingKeys.DefaultWeeklyTime;
        dailyDigestTimeInput = await GetTextAsync(TerritoryCaptureSettingKeys.DailyDigestTime) ?? TerritoryCaptureSettingKeys.DefaultDailyTime;
        if (GuildAllianceId is { } allianceId)
            allianceTimeZoneDisplay = (await AllianceService.FindByIdAsync(GuildId, allianceId))?.TimeZoneId ?? GuildAlliance.DefaultTimeZoneId;
    }

    private Task SaveDigestChannelAsync() =>
        SetSnowflakeAsync(TerritoryCaptureSettingKeys.DigestChannel, ParseId(digestChannelInput));

    private async Task SaveZoneSlotAsync(string key, Action<string?> setInput, string? currentInput, string slotName)
    {
        createRoleError = null;
        var (roleId, input, error) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, currentInput, slotName);
        setInput(input);
        createRoleError = error;
        if (error is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(key, roleId);
    }

    // The role Hoshi creates for a slot left blank. "TC-N" rather than "Slot N" so it's obvious in
    // Discord's role list which feature owns it. One helper because the name is needed twice per
    // slot (the picker's create option and the save that actually creates it) — they must match, or
    // the create option stays visible after the role exists. Existing roles are untouched: the
    // setting stores a role id, so a guild that already picked its own role keeps it.
    private static string ZoneSlotRoleName(int slot) => $"TC-{slot}";

    private Task SaveZoneSlot1Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot1Role, v => zoneSlot1Input = v, zoneSlot1Input, ZoneSlotRoleName(1));
    private Task SaveZoneSlot2Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot2Role, v => zoneSlot2Input = v, zoneSlot2Input, ZoneSlotRoleName(2));
    private Task SaveZoneSlot3Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot3Role, v => zoneSlot3Input = v, zoneSlot3Input, ZoneSlotRoleName(3));
    private Task SaveZoneSlot4Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot4Role, v => zoneSlot4Input = v, zoneSlot4Input, ZoneSlotRoleName(4));
    private Task SaveZoneSlot5Async() => SaveZoneSlotAsync(TerritoryCaptureSettingKeys.ZoneSlot5Role, v => zoneSlot5Input = v, zoneSlot5Input, ZoneSlotRoleName(5));

    private Task SaveInstructionsAsync() =>
        SetTextAsync(TerritoryCaptureSettingKeys.Instructions, instructionsInput);

    // The <input type="time"> emits an "HH:mm" string; bind it manually (a string @bind isn't allowed
    // on type=time). We snap to the nearest :00/:30 before saving — the sweep only fires at half-hour
    // ticks, so an off-grid value (typed past the step) would otherwise store one time but post at the
    // next slot. Blank clears the setting → the sweep falls back to the default (09:00 / 19:00).
    private async Task OnWeeklyDigestTimeChanged(ChangeEventArgs e)
    {
        weeklyDigestTimeInput = SnapToHalfHour(e.Value?.ToString());
        await SetTextAsync(TerritoryCaptureSettingKeys.WeeklyDigestTime, weeklyDigestTimeInput);
    }

    private async Task OnDailyDigestTimeChanged(ChangeEventArgs e)
    {
        dailyDigestTimeInput = SnapToHalfHour(e.Value?.ToString());
        await SetTextAsync(TerritoryCaptureSettingKeys.DailyDigestTime, dailyDigestTimeInput);
    }

    // Round a typed "HH:mm" to the nearest 30 minutes so the stored value matches when the sweep
    // actually fires. Blank/unparseable passes through (blank clears → default).
    private static string? SnapToHalfHour(string? raw)
    {
        if (!TimeOnly.TryParseExact(raw, "HH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t))
            return raw;
        var snapped = (int)Math.Round((t.Hour * 60 + t.Minute) / 30.0, MidpointRounding.AwayFromZero) * 30 % 1440;
        return new TimeOnly(snapped / 60, snapped % 60).ToString("HH:mm", CultureInfo.InvariantCulture);
    }

    // Stored under the Absences feature (its owner) so this and the Absences page edit one value.
    // The alliance's tag prefixes the created role, so a coalition guild's opt-in roles sit together
    // and a member can tell whose is whose. Falls back to a bare name when the tag isn't loaded yet.
    private string allianceTag = "";

    private string NotificationRoleName => string.IsNullOrWhiteSpace(allianceTag)
        ? "Notifications"
        : AllianceRoleNames.Notifications(allianceTag);

    // EnsureRoleOrError, not ParseId: the picker's "create it" option posts a sentinel rather than
    // an id, and parsing that stores nothing.
    private async Task SaveNotificationRoleAsync()
    {
        createError = null;
        (var roleId, notificationRoleInput, createError) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, notificationRoleInput, NotificationRoleName);
        if (createError is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(GuildFeature.Absences, AbsencesSettingKeys.NotificationRole, roleId);
    }
}
