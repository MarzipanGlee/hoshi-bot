@inherits FeatureEditorBase
@using HoshiBot.Domain
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />


<div class="card-grid mt-1">
    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AbsencesSettingKeys.ReportChannel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AbsencesSettingKeys.ReportChannel)"
            @bind-Value="reportChannelIdInput" @bind-Value:after="SaveReportChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AbsencesSettingKeys.ReportStaffChannel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AbsencesSettingKeys.ReportStaffChannel)"
            @bind-Value="staffChannelIdInput" @bind-Value:after="SaveStaffChannelAsync" Channels="channels" />

    <NotificationRoleCard GuildId="GuildId" GuildAllianceId="GuildAllianceId" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.Absences;

    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? reportChannelIdInput;
    private string? staffChannelIdInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        reportChannelIdInput = (await GetSnowflakeAsync(AbsencesSettingKeys.ReportChannel))?.ToString();
        staffChannelIdInput = (await GetSnowflakeAsync(AbsencesSettingKeys.ReportStaffChannel))?.ToString();
    }

    private Task SaveReportChannelAsync() =>
        SetSnowflakeAsync(AbsencesSettingKeys.ReportChannel, ParseId(reportChannelIdInput));

    private Task SaveStaffChannelAsync() =>
        SetSnowflakeAsync(AbsencesSettingKeys.ReportStaffChannel, ParseId(staffChannelIdInput));

    // The alliance's tag prefixes the created role, so a coalition guild's opt-in roles sit together
    // and a member can tell whose is whose. Falls back to a bare name when the tag isn't loaded yet.


}
