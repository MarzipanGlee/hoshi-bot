@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject GuildFeatureSettingsService SettingsService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="How it works">
        <p class="form-text mt-0">
            When active, the bot DMs members that <strong>Player Assignment</strong> couldn't place
            automatically, asking them to confirm the bot's best guess or type their in-game name. It only
            sends buttons and a short form — never free-text chat. Once a member confirms, they're linked and
            their roles sync automatically. Requires Player Assignment to be enabled and configured.
        </p>
    </SettingsCard>

    <SettingsCard Title="DMs per day">
        <label for="moMaxPerDay" class="form-label">
            How many onboarding DMs the bot sends per day. Paces the outreach and stays clear of Discord's
            DM rate limits. Empty → a conservative default (10).
        </label>
        <input id="moMaxPerDay" type="number" min="1" class="form-control" placeholder="10"
               @bind="maxPerDayInput" @bind:after="SaveMaxPerDayAsync" />
    </SettingsCard>

    <SettingsCard Title="Campaign">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="moCampaign"
                   checked="@campaignActive" @onchange="e => SaveCampaignAsync((bool)e.Value!)" />
            <label class="form-check-label" for="moCampaign">Campaign active — send onboarding DMs</label>
        </div>
        <div class="form-text">
            Turn this on to start DMing unresolved members (up to the daily cap). Off → the bot links only
            confident matches silently and leaves the rest for the admin table.
        </div>
        @if (progress is not null)
        {
            <p class="form-text mb-0">
                Offen @progress.Unresolved · DM gesendet @progress.DmSent · zugeordnet @progress.Resolved
                · abgelehnt @progress.Declined · nicht zustellbar @progress.Undeliverable
            </p>
        }
    </SettingsCard>
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.MemberOnboarding;

    private string? maxPerDayInput;
    private bool campaignActive;
    private ReviewProgress? progress;

    protected override async Task OnSettingsLoadedAsync()
    {
        maxPerDayInput = await SettingsService.GetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, MemberOnboardingSettingKeys.MaxInvitesPerDay);
        campaignActive = string.Equals(
            await SettingsService.GetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, MemberOnboardingSettingKeys.CampaignActive),
            "true", StringComparison.OrdinalIgnoreCase);
        await LoadProgressAsync();
    }

    private async Task LoadProgressAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var counts = await db.PlayerLinkReviews
            .Where(r => r.GuildId == GuildId)
            .GroupBy(r => r.Status)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToListAsync();

        int Count(PlayerLinkReviewStatus status) => counts.FirstOrDefault(c => c.Status == status)?.Count ?? 0;
        progress = new ReviewProgress(
            Count(PlayerLinkReviewStatus.Unresolved),
            Count(PlayerLinkReviewStatus.DmSent),
            Count(PlayerLinkReviewStatus.Resolved),
            Count(PlayerLinkReviewStatus.Declined),
            Count(PlayerLinkReviewStatus.Undeliverable));
    }

    private Task SaveMaxPerDayAsync() =>
        SettingsService.SetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, MemberOnboardingSettingKeys.MaxInvitesPerDay, maxPerDayInput);

    private async Task SaveCampaignAsync(bool value)
    {
        campaignActive = value;
        await SettingsService.SetTextAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, MemberOnboardingSettingKeys.CampaignActive, value ? "true" : null);
    }

    private record ReviewProgress(int Unresolved, int DmSent, int Resolved, int Declined, int Undeliverable);
}
