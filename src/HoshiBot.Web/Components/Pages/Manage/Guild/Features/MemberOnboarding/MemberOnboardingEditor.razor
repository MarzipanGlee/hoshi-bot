@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.EntityFrameworkCore

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="@Msg.WebCommon.HowItWorksCardTitle(Lang)">
        <p class="form-text mt-0">
            @((MarkupString)Msg.WebMemberOnboarding.HowItWorksUsage(Lang))
        </p>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, MemberOnboardingSettingKeys.MaxInvitesPerDay)">
        <label for="moMaxPerDay" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, MemberOnboardingSettingKeys.MaxInvitesPerDay)
        </label>
        <input id="moMaxPerDay" type="number" min="1" class="form-control" placeholder="10"
               @bind="maxPerDayInput" @bind:after="SaveMaxPerDayAsync" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, MemberOnboardingSettingKeys.CampaignActive)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="moCampaign"
                   checked="@campaignActive" @onchange="e => SaveCampaignAsync((bool)e.Value!)" />
            <label class="form-check-label" for="moCampaign">@Msg.WebMemberOnboarding.CampaignLabel(Lang)</label>
        </div>
        <div class="form-text">
            @Msg.WebMemberOnboarding.CampaignUsage(Lang)
        </div>
        @if (progress is not null)
        {
            <p class="form-text mb-0">
                @Msg.WebMemberOnboarding.ProgressLine(Lang, progress.Unresolved, progress.DmSent, progress.Resolved, progress.Declined, progress.Undeliverable)
            </p>
        }
    </SettingsCard>
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.MemberOnboarding;

    private string? maxPerDayInput;
    private bool campaignActive;
    private ReviewProgress? progress;

    protected override async Task OnSettingsLoadedAsync()
    {
        maxPerDayInput = await GetTextAsync(MemberOnboardingSettingKeys.MaxInvitesPerDay);
        campaignActive = string.Equals(
            await GetTextAsync(MemberOnboardingSettingKeys.CampaignActive),
            "true", StringComparison.OrdinalIgnoreCase);
        await LoadProgressAsync();
    }

    private async Task LoadProgressAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var counts = await db.PlayerLinkReviews
            .Where(r => r.GuildId == GuildId)
            .GroupBy(r => r.Status)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToListAsync();

        int Count(PlayerLinkReviewStatus status) => counts.FirstOrDefault(c => c.Status == status)?.Count ?? 0;
        progress = new ReviewProgress(
            Count(PlayerLinkReviewStatus.Unresolved),
            Count(PlayerLinkReviewStatus.DmSent),
            Count(PlayerLinkReviewStatus.Resolved),
            Count(PlayerLinkReviewStatus.Declined),
            Count(PlayerLinkReviewStatus.Undeliverable));
    }

    private Task SaveMaxPerDayAsync() =>
        SetTextAsync(MemberOnboardingSettingKeys.MaxInvitesPerDay, maxPerDayInput);

    private async Task SaveCampaignAsync(bool value)
    {
        campaignActive = value;
        await SetTextAsync(MemberOnboardingSettingKeys.CampaignActive, value ? "true" : null);
    }

    private record ReviewProgress(int Unresolved, int DmSent, int Resolved, int Declined, int Undeliverable);
}
