@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.EntityFrameworkCore
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

<PageTitle>Interviews</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <LoadingPlaceholder Em="false" Text="Loading…" />
    }
    else
    {
        <h1>Member Lore — Interviews</h1>
        <p class="text-muted">
            Every member the bot has invited to (or is running) a DM interview, and where they are in it.
            Bot-managed — status/progress come from the interview job/DM conversation, not editable here.
        </p>

        @if (interviews.Count == 0)
        {
            <p class="text-muted">No interviews yet — enable the campaign to start inviting members.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Member</th>
                            <th>Status</th>
                            <th>Invited</th>
                            <th>Last activity</th>
                            <th>Completed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in interviews)
                        {
                            <tr>
                                <td>@members.DisplayName(i.DiscordUserId)</td>
                                <td><span class="badge @StatusBadgeClass(i.Status)">@i.Status</span></td>
                                <td>@i.InvitedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@i.LastActivityAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@(i.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</AuthorizedGuildView>

@code {
    private bool loading = true;
    private List<MemberInterview> interviews = [];
    private MemberDirectory members = MemberDirectory.Empty;

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        loading = true;
        members = await DiscordData.GetMemberDirectoryAsync(ParsedGuildId);

        await using var db = await DbFactory.CreateDbContextAsync();
        interviews = await db.MemberInterviews
            .Where(i => i.GuildId == ParsedGuildId)
            .OrderByDescending(i => i.InvitedAt)
            .ToListAsync();

        loading = false;
    }

    private static string StatusBadgeClass(MemberInterviewStatus status) => status switch
    {
        MemberInterviewStatus.Completed => "bg-success",
        MemberInterviewStatus.InProgress => "bg-primary",
        MemberInterviewStatus.Invited => "bg-secondary",
        MemberInterviewStatus.Declined => "bg-warning text-dark",
        MemberInterviewStatus.Undeliverable => "bg-danger",
        _ => "bg-secondary",
    };
}
