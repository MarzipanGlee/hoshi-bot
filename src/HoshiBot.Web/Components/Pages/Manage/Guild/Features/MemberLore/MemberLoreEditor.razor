@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.EntityFrameworkCore
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, MemberLoreSettingKeys.MemberRole)" Usage="@Msg.WebEditor.Usage(Lang, Feature, MemberLoreSettingKeys.MemberRole)"
            @bind-Value="memberRoleInput" @bind-Value:after="SaveMemberRoleAsync" Roles="roles" />

    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, MemberLoreSettingKeys.CompletedRole)" Usage="@Msg.WebEditor.Usage(Lang, Feature, MemberLoreSettingKeys.CompletedRole)"
            @bind-Value="completedRoleInput" @bind-Value:after="SaveCompletedRoleAsync" Roles="roles" />

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, MemberLoreSettingKeys.MaxInterviewsPerDay)">
        <label for="mlMaxPerDay" class="form-label">
            @Msg.WebEditor.Label(Lang, Feature, MemberLoreSettingKeys.MaxInterviewsPerDay)
        </label>
        <input id="mlMaxPerDay" type="number" min="1" class="form-control" placeholder="10"
               @bind="maxPerDayInput" @bind:after="SaveMaxPerDayAsync" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, MemberLoreSettingKeys.CampaignActive)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="mlCampaign"
                   checked="@campaignActive" @onchange="e => SaveCampaignAsync((bool)e.Value!)" />
            <label class="form-check-label" for="mlCampaign">@Msg.WebMemberLore.CampaignLabel(Lang)</label>
        </div>
        <div class="form-text">
            @Msg.WebMemberLore.CampaignUsage(Lang)
        </div>
        @if (progress is not null)
        {
            <p class="form-text mb-2">
                @Msg.WebMemberLore.ProgressLine(Lang, progress.Invited, progress.InProgress, progress.Completed, progress.Declined, progress.Undeliverable)
            </p>
        }
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="member-lore" ExtraSlug="interviews" Label="@Msg.WebMemberLore.ViewInterviewsLink(Lang)" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebMemberLore.NotesCardTitle(Lang)">
        <p class="form-text mt-0">
            @Msg.WebMemberLore.NotesUsage(Lang)
        </p>
        <ExtraPageLink GuildId="GuildId" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId"
            FeatureSlug="member-lore" ExtraSlug="notes" Label="@Msg.WebMemberLore.OpenNotesLink(Lang)" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebMemberLore.AnnouncementCardTitle(Lang)">
        <label for="mlAnnouncement" class="form-label">
            @Msg.WebMemberLore.AnnouncementLabel(Lang)
        </label>
        <textarea id="mlAnnouncement" class="form-control" rows="6" readonly>@AnnouncementText</textarea>
    </SettingsCard>
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.MemberLore;

    // Bot-output content (a template the admin copies verbatim into a Discord channel), not Web UI
    // text — it's deliberately German-only today and out of scope for Phase 7 (Web UI localization
    // covers the *editor's* chrome, not the message bodies the bot itself posts). Localizing the
    // announcement text to the guild's configured language is tracked in docs/backlog.md.
    private const string AnnouncementText =
        "🖖 Hallo zusammen! Ich bin Hoshi und möchte euch besser kennenlernen, damit ich ein echtes " +
        "Mitglied unserer Community werde. In den nächsten Tagen schreibe ich einige von euch per DM an " +
        "und stelle ein paar Fragen — wie ich euch nennen soll, was ihr so macht, und ob ihr lustige " +
        "Geschichten über andere Spieler habt. Alles völlig freiwillig, aber ich freue mich riesig, wenn " +
        "ihr mitmacht! Keine Lust? Sag mir einfach Bescheid oder ignoriere mich, dann lasse ich dich in " +
        "Ruhe. Bis gleich in euren DMs! 🚀";

    private List<Role> roles = [];
    private string? memberRoleInput;
    private string? completedRoleInput;
    private string? maxPerDayInput;
    private bool campaignActive;
    private InterviewProgress? progress;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        memberRoleInput = (await GetSnowflakeAsync(MemberLoreSettingKeys.MemberRole))?.ToString();
        completedRoleInput = (await GetSnowflakeAsync(MemberLoreSettingKeys.CompletedRole))?.ToString();
        maxPerDayInput = await GetTextAsync(MemberLoreSettingKeys.MaxInterviewsPerDay);
        campaignActive = string.Equals(
            await GetTextAsync(MemberLoreSettingKeys.CampaignActive),
            "true", StringComparison.OrdinalIgnoreCase);
        await LoadProgressAsync();
    }

    private async Task LoadProgressAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var counts = await db.MemberInterviews
            .Where(i => i.GuildId == GuildId)
            .GroupBy(i => i.Status)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToListAsync();

        int Count(MemberInterviewStatus status) => counts.FirstOrDefault(c => c.Status == status)?.Count ?? 0;
        progress = new InterviewProgress(
            Count(MemberInterviewStatus.Invited),
            Count(MemberInterviewStatus.InProgress),
            Count(MemberInterviewStatus.Completed),
            Count(MemberInterviewStatus.Declined),
            Count(MemberInterviewStatus.Undeliverable));
    }

    private Task SaveMemberRoleAsync() =>
        SetSnowflakeAsync(MemberLoreSettingKeys.MemberRole, ParseId(memberRoleInput));

    private Task SaveCompletedRoleAsync() =>
        SetSnowflakeAsync(MemberLoreSettingKeys.CompletedRole, ParseId(completedRoleInput));

    private Task SaveMaxPerDayAsync() =>
        SetTextAsync(MemberLoreSettingKeys.MaxInterviewsPerDay, maxPerDayInput);

    private async Task SaveCampaignAsync(bool value)
    {
        campaignActive = value;
        await SetTextAsync(MemberLoreSettingKeys.CampaignActive, value ? "true" : null);
    }

    private record InterviewProgress(int Invited, int InProgress, int Completed, int Declined, int Undeliverable);
}
