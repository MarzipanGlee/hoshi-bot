@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.EntityFrameworkCore
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

<PageTitle>Member Notes</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <p>Lade Notizen…</p>
    }
    else
    {
        <h1>Member Lore — Notizen & Review</h1>
        <p class="text-muted">
            Aus den Interviews extrahierte Community-Notizen. Eigene Angaben der Mitglieder werden direkt
            übernommen; Geschichten über <em>andere</em> landen hier zur Freigabe, bevor Hoshi sie nutzt.
        </p>

        <h2 class="h4">Zu prüfen (@suggestions.Count)</h2>
        @if (suggestions.Count == 0)
        {
            <p class="text-muted">Keine offenen Vorschläge.</p>
        }
        else
        {
            @foreach (var s in suggestions)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <p class="mb-2">
                            <span class="badge bg-secondary">@FieldLabel(s.Field)</span>
                            von <strong>@s.SourceName</strong> über <strong>@s.TargetNameRaw</strong>
                        </p>
                        <div class="row g-2 align-items-start">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Für Mitglied</label>
                                <select class="form-select form-select-sm" @bind="s.TargetUserId">
                                    <option value="">— wählen —</option>
                                    @foreach (var m in memberOptions)
                                    {
                                        <option value="@m.Id">@m.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small mb-1">Text</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="s.Text"></textarea>
                            </div>
                            <div class="col-md-3 d-flex gap-2 align-items-end" style="height:100%">
                                <button class="btn btn-sm btn-success" disabled="@(s.TargetUserId is null || string.IsNullOrWhiteSpace(s.Text))"
                                        @onclick="() => ApproveAsync(s)">Freigeben</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectAsync(s)">Ablehnen</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <h2 class="h4 mt-5">Mitglieder-Notizen</h2>
        <div class="d-flex gap-2 align-items-end mb-3" style="max-width:32rem">
            <div class="flex-grow-1">
                <label class="form-label small mb-1">Notiz für Mitglied anlegen</label>
                <select class="form-select form-select-sm" @bind="addMemberId">
                    <option value="">— wählen —</option>
                    @foreach (var m in memberOptions.Where(m => notes.All(n => n.DiscordUserId != m.Id)))
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
            </div>
            <button class="btn btn-sm btn-primary" disabled="@(addMemberId is null)" @onclick="AddNoteAsync">Anlegen</button>
        </div>

        @if (notes.Count == 0)
        {
            <p class="text-muted">Noch keine Notizen.</p>
        }
        else
        {
            <Collapse IsAccordion="true" class="border-top">
                <CollapseItems>
                    @foreach (var n in notes)
                    {
                        <CollapseItem @key="n.Id" Text="@FullNickname(n.DiscordUserId)" IsCollapsed="true">
                            <HeaderTemplate>
                                <span>@FullNickname(n.DiscordUserId)</span>
                                @if (n.PeerLoreHidden)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Peer-Lore vom Mitglied ausgeblendet</span>
                                }
                            </HeaderTemplate>
                            <ChildContent>
                                <div class="row g-2">
                                    <div class="col-md-4">@TextField("Bevorzugter Name", n, MemberNoteField.PreferredName)</div>
                                    <div class="col-md-4">@TextField("Spitznamen", n, MemberNoteField.Nicknames)</div>
                                    <div class="col-md-4">@TextField("Sprachen", n, MemberNoteField.Languages)</div>
                                    <div class="col-md-6">@AreaField("Interessen", n, MemberNoteField.Interests)</div>
                                    <div class="col-md-6">@AreaField("Hintergrund", n, MemberNoteField.Background)</div>
                                    <div class="col-md-6">@AreaField("Running Gags (Peer)", n, MemberNoteField.RunningJokes)</div>
                                    <div class="col-md-6">@AreaField("Necken ok (Peer)", n, MemberNoteField.TeaseAbout)</div>
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveNoteAsync(n)">Speichern</button>
                                    @if (n.PeerLoreHidden)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetHiddenAsync(n, false)">Peer-Lore wieder anzeigen</button>
                                    }
                                </div>
                            </ChildContent>
                        </CollapseItem>
                    }
                </CollapseItems>
            </Collapse>
        }
    }
</AuthorizedGuildView>

@code {
    private bool loading = true;
    private List<SuggestionVm> suggestions = [];
    private List<GuildMemberNote> notes = [];
    private List<MemberOption> memberOptions = [];
    private IReadOnlyDictionary<ulong, string> memberNames = new Dictionary<ulong, string>();
    private IReadOnlyDictionary<ulong, string> memberNicknames = new Dictionary<ulong, string>();
    private ulong? addMemberId;

    protected override async Task OnAuthorizedParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        memberNames = await DiscordData.GetMemberDisplayNamesAsync(ParsedGuildId);
        // The full (untrimmed) nickname, alliance tag prefix and all — ordering the note cards by this
        // instead of the tag-stripped display name naturally groups them by alliance, then name.
        memberNicknames = await DiscordData.GetMemberNicknamesAsync(ParsedGuildId);
        // Full nicknames (tag and all) here too — the dropdowns otherwise show several visually
        // identical "Name" entries when members share a tag-stripped display name (alt accounts, or
        // just a common name), with no way to tell them apart.
        memberOptions = memberNicknames.Select(kv => new MemberOption(kv.Key, kv.Value)).OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase).ToList();

        await using var db = await DbFactory.CreateDbContextAsync();
        notes = await db.GuildMemberNotes.AsNoTracking()
            .Where(n => n.GuildId == ParsedGuildId)
            .ToListAsync();
        notes = notes.OrderBy(n => FullNickname(n.DiscordUserId), StringComparer.OrdinalIgnoreCase).ToList();

        var pending = await db.MemberNoteSuggestions.AsNoTracking()
            .Where(s => s.GuildId == ParsedGuildId && s.Status == MemberNoteSuggestionStatus.Pending)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();
        suggestions = pending.Select(s => new SuggestionVm
        {
            Id = s.Id,
            SourceName = MemberName(s.SourceDiscordUserId),
            TargetNameRaw = s.TargetNameRaw,
            TargetUserId = s.TargetDiscordUserId,
            Field = s.Field,
            Text = s.SuggestedText,
        }).ToList();

        loading = false;
    }

    private async Task ApproveAsync(SuggestionVm s)
    {
        if (s.TargetUserId is not { } target || string.IsNullOrWhiteSpace(s.Text))
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).ApproveSuggestionAsync(s.Id, target, s.Text.Trim());
        await ReloadAsync();
    }

    private async Task RejectAsync(SuggestionVm s)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).RejectSuggestionAsync(s.Id);
        await ReloadAsync();
    }

    private async Task AddNoteAsync()
    {
        if (addMemberId is not { } userId)
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).GetOrCreateAsync(ParsedGuildId, userId);
        await db.SaveChangesAsync();
        addMemberId = null;
        await ReloadAsync();
    }

    private async Task SaveNoteAsync(GuildMemberNote edited)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var note = await db.GuildMemberNotes.FirstOrDefaultAsync(n => n.Id == edited.Id);
        if (note is null)
            return;
        note.PreferredName = Clean(edited.PreferredName);
        note.Nicknames = Clean(edited.Nicknames);
        note.Languages = Clean(edited.Languages);
        note.Interests = Clean(edited.Interests);
        note.Background = Clean(edited.Background);
        note.RunningJokes = Clean(edited.RunningJokes);
        note.TeaseAbout = Clean(edited.TeaseAbout);
        note.SelfUpdatedAt = DateTimeOffset.UtcNow;
        note.PeerUpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
    }

    private async Task SetHiddenAsync(GuildMemberNote n, bool hidden)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).SetPeerLoreHiddenAsync(ParsedGuildId, n.DiscordUserId, hidden);
        await ReloadAsync();
    }

    private string MemberName(ulong id) => memberNames.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name) ? name : id.ToString();

    private string FullNickname(ulong id) => memberNicknames.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name) ? name : MemberName(id);

    private static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private RenderFragment TextField(string label, GuildMemberNote n, MemberNoteField field) => builder =>
    {
        builder.OpenElement(0, "label");
        builder.AddAttribute(1, "class", "form-label small mb-1");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "input");
        builder.AddAttribute(4, "class", "form-control form-control-sm");
        builder.AddAttribute(5, "value", MemberNoteService.GetField(n, field));
        builder.AddAttribute(6, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => MemberNoteService.ApplyField(n, field, e.Value?.ToString())));
        builder.CloseElement();
    };

    private RenderFragment AreaField(string label, GuildMemberNote n, MemberNoteField field) => builder =>
    {
        builder.OpenElement(0, "label");
        builder.AddAttribute(1, "class", "form-label small mb-1");
        builder.AddContent(2, label);
        builder.CloseElement();
        builder.OpenElement(3, "textarea");
        builder.AddAttribute(4, "class", "form-control form-control-sm");
        builder.AddAttribute(5, "rows", "2");
        builder.AddAttribute(6, "onchange", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.ChangeEventArgs>(this, e => MemberNoteService.ApplyField(n, field, e.Value?.ToString())));
        builder.AddContent(7, MemberNoteService.GetField(n, field));
        builder.CloseElement();
    };

    private static string FieldLabel(MemberNoteField field) => field switch
    {
        MemberNoteField.PreferredName => "Name",
        MemberNoteField.Nicknames => "Spitznamen",
        MemberNoteField.Interests => "Interessen",
        MemberNoteField.Background => "Hintergrund",
        MemberNoteField.Languages => "Sprachen",
        MemberNoteField.RunningJokes => "Running Gag",
        MemberNoteField.TeaseAbout => "Necken ok",
        _ => field.ToString(),
    };

    private record MemberOption(ulong Id, string Name);

    private class SuggestionVm
    {
        public int Id { get; set; }
        public string SourceName { get; set; } = "";
        public string TargetNameRaw { get; set; } = "";
        public ulong? TargetUserId { get; set; }
        public MemberNoteField Field { get; set; }
        public string Text { get; set; } = "";
    }
}
