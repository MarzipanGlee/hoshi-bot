@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.EntityFrameworkCore
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData

<PageTitle>@Msg.WebFeature.ExtraTitle(Lang, GuildFeature.MemberLore, "notes")</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <LoadingPlaceholder Em="false" />
    }
    else
    {
        <h1>@Msg.WebMemberNotesAdmin.Heading(Lang)</h1>
        <p class="text-muted">
            @((MarkupString)Msg.WebMemberNotesAdmin.Intro(Lang))
        </p>

        <h2 class="h4">@Msg.WebMemberNotesAdmin.ToReviewHeading(Lang, suggestions.Count)</h2>
        @if (suggestions.Count == 0)
        {
            <p class="text-muted">@Msg.WebMemberNotesAdmin.NoSuggestions(Lang)</p>
        }
        else
        {
            @foreach (var s in suggestions)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <p class="mb-2">
                            <span class="badge bg-secondary">@Msg.WebMemberLore.NoteFieldLabel(Lang, s.Field)</span>
                            @Msg.WebMemberNotesAdmin.FromWord(Lang) <strong>@s.SourceName</strong> @Msg.WebMemberNotesAdmin.AboutWord(Lang) <strong>@s.TargetNameRaw</strong>
                        </p>
                        <div class="row g-2 align-items-start">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">@Msg.WebMemberNotesAdmin.ForMemberLabel(Lang)</label>
                                <select class="form-select form-select-sm" @bind="s.TargetUserId">
                                    <option value="">@Msg.WebMemberNotesAdmin.ChooseOption(Lang)</option>
                                    @foreach (var m in memberOptions)
                                    {
                                        <option value="@m.Id">@m.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small mb-1">@Msg.WebMemberNotesAdmin.TextLabel(Lang)</label>
                                <textarea class="form-control form-control-sm" rows="2" @bind="s.Text"></textarea>
                            </div>
                            <div class="col-md-3 d-flex gap-2 align-items-end" style="height:100%">
                                <button class="btn btn-sm btn-success" disabled="@(s.TargetUserId is null || string.IsNullOrWhiteSpace(s.Text))"
                                        @onclick="() => ApproveAsync(s)">@Msg.WebMemberNotesAdmin.Approve(Lang)</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectAsync(s)">@Msg.WebMemberNotesAdmin.Reject(Lang)</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <h2 class="h4 mt-5">@Msg.WebMemberNotesAdmin.MembersHeading(Lang)</h2>
        <div class="d-flex gap-2 align-items-end mb-3" style="max-width:32rem">
            <div class="flex-grow-1">
                <label class="form-label small mb-1">@Msg.WebMemberNotesAdmin.CreateNoteLabel(Lang)</label>
                <select class="form-select form-select-sm" @bind="addMemberId">
                    <option value="">@Msg.WebMemberNotesAdmin.ChooseOption(Lang)</option>
                    @foreach (var m in memberOptions.Where(m => notes.All(n => n.DiscordUserId != m.Id)))
                    {
                        <option value="@m.Id">@m.Name</option>
                    }
                </select>
            </div>
            <button class="btn btn-sm btn-primary" disabled="@(addMemberId is null)" @onclick="AddNoteAsync">@Msg.WebMemberNotesAdmin.CreateButton(Lang)</button>
        </div>

        @if (notes.Count == 0)
        {
            <p class="text-muted">@Msg.WebMemberNotesAdmin.NoNotes(Lang)</p>
        }
        else
        {
            <Collapse IsAccordion="true" class="border-top">
                <CollapseItems>
                    @foreach (var n in notes)
                    {
                        <CollapseItem @key="n.Id" Text="@MemberLabel(n.DiscordUserId)" IsCollapsed="true">
                            <HeaderTemplate>
                                <span>@MemberLabel(n.DiscordUserId)</span>
                                @if (n.PeerLoreHidden)
                                {
                                    <span class="badge bg-warning text-dark ms-2">@Msg.WebMemberNotesAdmin.PeerLoreHiddenBadge(Lang)</span>
                                }
                            </HeaderTemplate>
                            <ChildContent>
                                <div class="row g-2">
                                    <div class="col-md-4"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.PreferredName)" Note="n" Field="MemberNoteField.PreferredName" /></div>
                                    <div class="col-md-4"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.Nicknames)" Note="n" Field="MemberNoteField.Nicknames" /></div>
                                    <div class="col-md-4"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.Languages)" Note="n" Field="MemberNoteField.Languages" /></div>
                                    <div class="col-md-6"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.Interests)" Note="n" Field="MemberNoteField.Interests" Multiline="true" /></div>
                                    <div class="col-md-6"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.Background)" Note="n" Field="MemberNoteField.Background" Multiline="true" /></div>
                                    <div class="col-md-6"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.RunningJokes)" Note="n" Field="MemberNoteField.RunningJokes" Multiline="true" /></div>
                                    <div class="col-md-6"><NoteField Label="@Msg.WebMemberLore.NoteFieldLabel(Lang, MemberNoteField.TeaseAbout)" Note="n" Field="MemberNoteField.TeaseAbout" Multiline="true" /></div>
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveNoteAsync(n)">@Msg.WebCommon.Save(Lang)</button>
                                    @if (n.PeerLoreHidden)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetHiddenAsync(n, false)">@Msg.WebMemberNotesAdmin.UnhideButton(Lang)</button>
                                    }
                                </div>
                            </ChildContent>
                        </CollapseItem>
                    }
                </CollapseItems>
            </Collapse>
        }
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private bool loading = true;
    private List<SuggestionVm> suggestions = [];
    private List<GuildMemberNote> notes = [];
    private List<MemberOption> memberOptions = [];
    private MemberDirectory members = MemberDirectory.Empty;
    private IReadOnlyDictionary<ulong, string> memberLabels = new Dictionary<ulong, string>();
    private ulong? addMemberId;

    protected override async Task OnAuthorizedParametersSetAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        loading = true;
        members = await DiscordData.GetMemberDirectoryAsync(ParsedGuildId);
        // The full nickname plus the username in brackets — see GetMemberLabelsAsync. Ordering the
        // note cards by it groups them by alliance tag, then name, and the bracketed username tells
        // two members with the same nickname apart.
        memberLabels = await DiscordData.GetMemberLabelsAsync(ParsedGuildId);
        memberOptions = memberLabels.Select(kv => new MemberOption(kv.Key, kv.Value)).OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase).ToList();

        await using var db = await DbFactory.CreateDbContextAsync();
        notes = await db.GuildMemberNotes.AsNoTracking()
            .Where(n => n.GuildId == ParsedGuildId)
            .ToListAsync();
        notes = notes.OrderBy(n => MemberLabel(n.DiscordUserId), StringComparer.OrdinalIgnoreCase).ToList();

        var pending = await db.MemberNoteSuggestions.AsNoTracking()
            .Where(s => s.GuildId == ParsedGuildId && s.Status == MemberNoteSuggestionStatus.Pending)
            .OrderBy(s => s.CreatedAt)
            .ToListAsync();
        suggestions = pending.Select(s => new SuggestionVm
        {
            Id = s.Id,
            SourceName = members.DisplayName(s.SourceDiscordUserId),
            TargetNameRaw = s.TargetNameRaw,
            TargetUserId = s.TargetDiscordUserId,
            Field = s.Field,
            Text = s.SuggestedText,
        }).ToList();

        loading = false;
    }

    private async Task ApproveAsync(SuggestionVm s)
    {
        if (s.TargetUserId is not { } target || string.IsNullOrWhiteSpace(s.Text))
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).ApproveSuggestionAsync(s.Id, target, s.Text.Trim());
        await ReloadAsync();
    }

    private async Task RejectAsync(SuggestionVm s)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).RejectSuggestionAsync(s.Id);
        await ReloadAsync();
    }

    private async Task AddNoteAsync()
    {
        if (addMemberId is not { } userId)
            return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).GetOrCreateAsync(ParsedGuildId, userId);
        await db.SaveChangesAsync();
        addMemberId = null;
        await ReloadAsync();
    }

    private async Task SaveNoteAsync(GuildMemberNote edited)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var note = await db.GuildMemberNotes.FirstOrDefaultAsync(n => n.Id == edited.Id);
        if (note is null)
            return;
        note.PreferredName = Clean(edited.PreferredName);
        note.Nicknames = Clean(edited.Nicknames);
        note.Languages = Clean(edited.Languages);
        note.Interests = Clean(edited.Interests);
        note.Background = Clean(edited.Background);
        note.RunningJokes = Clean(edited.RunningJokes);
        note.TeaseAbout = Clean(edited.TeaseAbout);
        note.SelfUpdatedAt = DateTimeOffset.UtcNow;
        note.PeerUpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
    }

    private async Task SetHiddenAsync(GuildMemberNote n, bool hidden)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await new MemberNoteService(db).SetPeerLoreHiddenAsync(ParsedGuildId, n.DiscordUserId, hidden);
        await ReloadAsync();
    }

    private string MemberLabel(ulong id) => memberLabels.TryGetValue(id, out var name) && !string.IsNullOrWhiteSpace(name) ? name : members.DisplayName(id);

    private static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private record MemberOption(ulong Id, string Name);

    private class SuggestionVm
    {
        public int Id { get; set; }
        public string SourceName { get; set; } = "";
        public string TargetNameRaw { get; set; } = "";
        public ulong? TargetUserId { get; set; }
        public MemberNoteField Field { get; set; }
        public string Text { get; set; } = "";
    }
}
