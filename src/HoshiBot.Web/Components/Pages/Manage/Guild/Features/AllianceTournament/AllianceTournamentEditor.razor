@using HoshiBot.Web.Components.Pages.Manage.Guild
@inject GuildFeatureService FeatureService

<p class="form-text">
    Advance-warning announcement when a new Alliance Tournament event is scheduled. Not scoped
    to a specific server — every guild tracking any server (see Scope) is notified, since
    Alliance Tournament isn't currently known to be server/region-specific. Currently fed by a
    one-time seed, not a live sync — see StfcEventStatus for why.
</p>

<FeatureEnableSwitch Enabled="enabled" OnToggle="ToggleAsync" />

<AlertChannelListEditor GuildId="GuildId" Kind="GuildAlertChannelKind.AllianceTournament" Audience="Audience" />

@code {
    [Parameter, EditorRequired] public ulong GuildId { get; set; }
    [Parameter, EditorRequired] public GuildAudience Audience { get; set; }
    [Parameter] public int? GuildAllianceId { get; set; }

    private bool enabled;

    protected override async Task OnInitializedAsync()
    {
        enabled = await FeatureService.IsEnabledAsync(GuildId, GuildFeature.AllianceTournament, Audience, GuildAllianceId);
    }

    private async Task ToggleAsync(bool value)
    {
        await FeatureService.SetEnabledAsync(GuildId, GuildFeature.AllianceTournament, Audience, GuildAllianceId, value);
        enabled = value;
    }
}
