@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createError is not null)
{
    <p class="text-danger">@createError.Value.Text(Lang)</p>
}

<RoleTierEditor GuildId="GuildId" Feature="Feature" Audience="ResolvedAudience" GuildAllianceId="GuildAllianceId" Tiers="Tiers">
    <HeaderTemplate Context="tier">
        <div class="d-flex align-items-center gap-2">
            <img src="@($"images/ranks/{tier.DefaultName.ToLowerInvariant()}.png")" alt="" style="width:1.5rem;height:1.5rem;object-fit:contain;" />
            <strong>@tier.DefaultName</strong>
        </div>
    </HeaderTemplate>
</RoleTierEditor>

@* Its own card rather than a sixth RoleTierEditor tier: the tier headers render a rank icon from
   images/ranks/{name}.png, and "no rank" has no such icon. *@
<div class="card-grid mt-1">
    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, RankRolesSettingKeys.NoRankRole)"
            Usage="@Msg.WebEditor.Usage(Lang, Feature, RankRolesSettingKeys.NoRankRole)"
            CreateRoleName="@NoRankRoleName"
            @bind-Value="noRankRoleInput" @bind-Value:after="SaveNoRankRoleAsync" Roles="roles" />
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.RankRoles;

    private static readonly IReadOnlyList<RoleTierSpec> Tiers =
    [
        new("Admiral", RankRolesSettingKeys.AdmiralRole),
        new("Commodore", RankRolesSettingKeys.CommodoreRole),
        new("Premier", RankRolesSettingKeys.PremierRole),
        new("Operative", RankRolesSettingKeys.OperativeRole),
        new("Agent", RankRolesSettingKeys.AgentRole),
    ];

    private List<Role> roles = [];
    private DiscordCreateErrorKind? createError;
    private string? noRankRoleInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        noRankRoleInput = (await GetSnowflakeAsync(RankRolesSettingKeys.NoRankRole))?.ToString();
    }

    private const string NoRankRoleName = "No-Rank";

    // EnsureRoleOrError, not ParseId: the picker's "create it" option posts a sentinel rather than
    // an id, and parsing that stores nothing.
    private async Task SaveNoRankRoleAsync()
    {
        createError = null;
        (var roleId, noRankRoleInput, createError) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, noRankRoleInput, NoRankRoleName);
        if (createError is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(RankRolesSettingKeys.NoRankRole, roleId);
    }
}
