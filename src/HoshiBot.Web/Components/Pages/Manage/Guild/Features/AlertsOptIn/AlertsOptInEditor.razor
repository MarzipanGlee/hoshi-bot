@inherits FeatureEditorBase
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

@if (createRoleError is not null)
{
    <p class="text-danger">@createRoleError.Value.Text(Lang)</p>
}

<div class="card-grid mt-1">
    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AlertsOptInSettingKeys.Role)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AlertsOptInSettingKeys.Role)" CreateRoleName="Alerts"
            @bind-Value="roleIdInput" @bind-Value:after="SaveRoleAsync" Roles="roles" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.AlertsOptIn;

    private List<Role> roles = [];
    private string? roleIdInput;
    private DiscordCreateErrorKind? createRoleError;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        roleIdInput = (await GetSnowflakeAsync(AlertsOptInSettingKeys.Role))?.ToString();
    }

    private async Task SaveRoleAsync()
    {
        createRoleError = null;
        (var roleId, roleIdInput, createRoleError) = await DiscordData.EnsureRoleOrErrorAsync(GuildId, roleIdInput, "Alerts");
        if (createRoleError is not null)
            return;

        roles = await DiscordData.GetRolesAsync(GuildId);
        await SetSnowflakeAsync(AlertsOptInSettingKeys.Role, roleId);
    }
}
