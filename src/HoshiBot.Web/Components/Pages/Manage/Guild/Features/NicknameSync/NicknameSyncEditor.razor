@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <SettingsCard Title="@Msg.WebCommon.HowItWorksCardTitle(Lang)">
        <p class="form-text mt-0">
            @((MarkupString)Msg.WebNicknameSync.HowItWorksUsage(Lang))
        </p>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, NicknameSyncSettingKeys.AllianceTagMode)">
        <label class="form-label">@((MarkupString)Msg.WebEditor.Label(Lang, Feature, NicknameSyncSettingKeys.AllianceTagMode))</label>
        <Select TValue="string" Items="ModeItems" @bind-Value="allianceMode" @bind-Value:after="SaveAllianceModeAsync" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, NicknameSyncSettingKeys.ServerTagMode)">
        <label class="form-label">@((MarkupString)Msg.WebEditor.Label(Lang, Feature, NicknameSyncSettingKeys.ServerTagMode))</label>
        <Select TValue="string" Items="ModeItems" @bind-Value="serverMode" @bind-Value:after="SaveServerModeAsync" />
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, NicknameSyncSettingKeys.MemberSuffix)">
        <div class="form-switch">
            <input type="checkbox" class="form-check-input" role="switch" id="nsMemberSuffix"
                   checked="@memberSuffix" @onchange="e => SaveMemberSuffixAsync((bool)e.Value!)" />
            <label class="form-check-label" for="nsMemberSuffix">@Msg.WebNicknameSync.MemberSuffixLabel(Lang)</label>
        </div>
        <div class="form-text">
            @((MarkupString)Msg.WebNicknameSync.MemberSuffixUsage(Lang))
        </div>
    </SettingsCard>

    <SettingsCard Title="@Msg.WebEditor.CardTitle(Lang, Feature, NicknameSyncSettingKeys.ExcludedRoles)">
        <p class="form-text mt-0">@Msg.WebEditor.Usage(Lang, Feature, NicknameSyncSettingKeys.ExcludedRoles)</p>
        @if (excludedRoleIds.Count > 0)
        {
            <ul class="list-unstyled d-flex flex-wrap gap-2 mb-2">
                @foreach (var rid in excludedRoleIds)
                {
                    <li>
                        <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                            @RoleName(rid)
                            <button type="button" class="btn btn-sm btn-link p-0 text-white text-decoration-none"
                                    title="@Msg.WebCommon.Remove(Lang)" @onclick="() => RemoveRoleAsync(rid)">@Icons.Text.Cross</button>
                        </span>
                    </li>
                }
            </ul>
        }
        <RolePicker Label="@Msg.WebNicknameSync.AddRoleLabel(Lang)" ShowLabel="false" PlaceholderText="@Msg.WebNicknameSync.AddRolePlaceholder(Lang)"
                    @bind-Value="addRoleInput" @bind-Value:after="AddRoleAsync" Roles="roles" />
    </SettingsCard>
</div>

<PoweredBy For="@(new[] { typeof(StfcPlayer) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.NicknameSync;

    private List<Role> roles = [];

    // A property (not a field initializer) — field initializers run in the constructor, before the
    // cascaded Lang parameter is set, so they'd always bake in English.
    private List<SelectedItem> ModeItems =>
    [
        new(nameof(NicknameTagMode.Never), Msg.WebNicknameSync.ModeNever(Lang)),
        new(nameof(NicknameTagMode.ForeignOnly), Msg.WebNicknameSync.ModeForeignOnly(Lang)),
        new(nameof(NicknameTagMode.Always), Msg.WebNicknameSync.ModeAlways(Lang)),
    ];

    private string allianceMode = nameof(NicknameTagMode.ForeignOnly);
    private string serverMode = nameof(NicknameTagMode.ForeignOnly);
    private List<ulong> excludedRoleIds = [];
    private string? addRoleInput;
    private bool memberSuffix;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        allianceMode = await GetTextAsync(NicknameSyncSettingKeys.AllianceTagMode)
            ?? nameof(NicknameTagMode.ForeignOnly);
        serverMode = await GetTextAsync(NicknameSyncSettingKeys.ServerTagMode)
            ?? nameof(NicknameTagMode.ForeignOnly);
        excludedRoleIds = await GetSnowflakeListAsync(NicknameSyncSettingKeys.ExcludedRoles);
        memberSuffix = NicknameSyncSettingKeys.IsMemberSuffixOn(await GetTextAsync(NicknameSyncSettingKeys.MemberSuffix));
    }

    // Default-on, so only the OFF state is stored — switching back on deletes the row rather than
    // writing "true", which keeps "never touched" and "explicitly on" the same thing.
    private async Task SaveMemberSuffixAsync(bool value)
    {
        memberSuffix = value;
        await SetTextAsync(NicknameSyncSettingKeys.MemberSuffix, value ? null : "false");
    }

    private Task SaveAllianceModeAsync() =>
        SetTextAsync(NicknameSyncSettingKeys.AllianceTagMode, allianceMode);

    private Task SaveServerModeAsync() =>
        SetTextAsync(NicknameSyncSettingKeys.ServerTagMode, serverMode);

    private async Task AddRoleAsync()
    {
        if (ulong.TryParse(addRoleInput, out var roleId) && !excludedRoleIds.Contains(roleId))
        {
            await AddSnowflakeListValueAsync(NicknameSyncSettingKeys.ExcludedRoles, roleId);
            excludedRoleIds.Add(roleId);
        }
        addRoleInput = null;
    }

    private async Task RemoveRoleAsync(ulong roleId)
    {
        await RemoveSnowflakeListValueAsync(NicknameSyncSettingKeys.ExcludedRoles, roleId);
        excludedRoleIds.Remove(roleId);
    }

    private string RoleName(ulong roleId) =>
        roles.FirstOrDefault(r => r.Id == roleId)?.Name ?? roleId.ToString();
}
