@using HoshiBot.Web.Components.Pages.Manage.Guild
@inherits FeatureEditorBase

<p class="form-text">
    @Msg.WebServerStatus.Intro(Lang)
</p>

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <AlertChannelListEditor GuildId="GuildId" Kind="GuildAlertChannelKind.ServerStatus" Audience="ResolvedAudience" />
</div>

<PoweredBy For="@(new[] { typeof(StfcServerStatus) })" />

@code {
    protected override GuildFeature Feature => GuildFeature.ServerStatus;
}
