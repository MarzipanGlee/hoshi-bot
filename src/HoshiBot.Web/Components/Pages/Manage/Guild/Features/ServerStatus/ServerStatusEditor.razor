@using HoshiBot.Web.Components.Pages.Manage.Guild
@inherits FeatureEditorBase

<p class="form-text">
    Announces when a tracked STFC server (see this guild's Scope) goes up/down or in/out of
    maintenance. Currently fed by a one-time seed, not a live sync — see
    StfcServerStatus for why.
</p>

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<AlertChannelListEditor GuildId="GuildId" Kind="GuildAlertChannelKind.ServerStatus" Audience="ResolvedAudience" />

@code {
    protected override GuildFeature Feature => GuildFeature.ServerStatus;
}
