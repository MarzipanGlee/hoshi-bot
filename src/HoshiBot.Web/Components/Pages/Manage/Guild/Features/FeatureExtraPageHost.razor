@page "/manage/guild/{GuildId}/features/{FeatureSlug}/{ExtraSlug}"
@inherits GuildAdminPageBase

<PageTitle>@(extra?.Title ?? "Not Found")</PageTitle>

@if (!Authorized)
{
    <p>Checking access...</p>
}
else if (extra is null)
{
    <p>Unknown page.</p>
}
else
{
    <DynamicComponent Type="extra.ComponentType" Parameters="parameters" />
}

@code {
    [Parameter] public string FeatureSlug { get; set; } = "";
    [Parameter] public string ExtraSlug { get; set; } = "";

    private FeatureExtraPage? extra;
    private IDictionary<string, object> parameters = new Dictionary<string, object>();

    protected override Task OnAuthorizedParametersSetAsync()
    {
        var descriptor = FeatureCatalog.FindBySlug(FeatureSlug);
        extra = descriptor?.ExtraPages.FirstOrDefault(p => p.Slug == ExtraSlug);
        if (extra is null)
        {
            Nav.NotFound();
            return Task.CompletedTask;
        }

        // Every extra-page component inherits GuildAdminPageBase itself (unchanged from when it had
        // its own @page route), so it expects the raw string GuildId — not the already-parsed ulong.
        parameters = new Dictionary<string, object> { ["GuildId"] = GuildId };
        return Task.CompletedTask;
    }
}
