@using HoshiBot.Web.Components.Pages.Manage.Guild
@inherits FeatureEditorBase

<p class="form-text">
    Advance-warning announcement when a new Infinite Incursions event is scheduled. Not scoped
    to a specific server — every guild tracking any server (see Scope) is notified, since
    Infinite Incursions aren't currently known to be server/region-specific. Currently fed by a
    one-time seed, not a live sync — see StfcEventStatus for why.
</p>

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<AlertChannelListEditor GuildId="GuildId" Kind="GuildAlertChannelKind.InfiniteIncursions" Audience="ResolvedAudience" />

@code {
    protected override GuildFeature Feature => GuildFeature.InfiniteIncursions;
}
