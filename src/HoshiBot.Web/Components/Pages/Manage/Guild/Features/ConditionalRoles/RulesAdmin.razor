@using HoshiBot.Data
@using HoshiBot.Domain.ConditionalRoles
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@using NetCord
@implements IDisposable
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject ConditionalRoleService ConditionalRoles
@inject DiscordGuildDataService DiscordData

<PageTitle>@Msg.WebFeature.ExtraTitle(Lang, GuildFeature.ConditionalRoles, "rules")</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (loading)
    {
        <LoadingPlaceholder Em="false" />
    }
    else if (editing is { } rule)
    {
        @* One rule at a time, on its own URL. The list used to be edited in place, and because it
           re-sorts by name after every save, renaming a rule moved the card out from under whoever
           was editing it — the next thing they set then landed on a different rule. A separate page
           makes that impossible rather than merely unlikely. *@
        <a href="@ListHref">@Msg.WebConditionalRoles.BackToList(Lang)</a>
        <h1 class="mt-2">@rule.Name</h1>

        <div class="card-grid">
            <SettingsCard Class="card-span-full">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                    <input class="form-control condition-name-input" maxlength="100" placeholder="@Msg.WebConditionalRoles.RuleNamePlaceholder(Lang)"
                           @bind="rule.Name" @bind:after="() => rule.Dirty = true" />
                    <div class="form-switch">
                        <input type="checkbox" class="form-check-input" role="switch" id="cr-enabled"
                               checked="@rule.Enabled" @onchange="e => { rule.Enabled = (bool)e.Value!; rule.Dirty = true; }" />
                        <label class="form-check-label" for="cr-enabled">@Msg.WebConditionalRoles.RuleEnabled(Lang)</label>
                    </div>
                </div>

                <label class="form-label">@Msg.WebConditionalRoles.TargetRoleLabel(Lang)</label>
                <RolePicker ShowLabel="false" @bind-Value="rule.TargetRoleId" @bind-Value:after="() => rule.Dirty = true" Roles="roles" />

                <label class="form-label mt-3">@Msg.WebConditionalRoles.ConditionLabel(Lang)</label>
                <ConditionNodeEditor Node="rule.Root" Roles="roles" Conditions="conditionOptions" GuildId="ParsedGuildId"
                                     PlayerLabels="playerLabels" AllianceLabels="allianceLabels" IsRoot="true"
                                     OnChanged="() => rule.Dirty = true" />

                @if (!IsUsable(rule))
                {
                    <p class="text-warning mt-2 mb-0">@Msg.WebConditionalRoles.IncompleteWarning(Lang)</p>
                }

                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-primary" @onclick="() => SaveRuleAsync(rule)">@Msg.WebCommon.Save(Lang)</button>
                    @if (rule.Dirty)
                    {
                        <span class="form-text">@Msg.WebConditionalRoles.UnsavedChanges(Lang)</span>
                    }
                </div>
            </SettingsCard>
        </div>
    }
    else
    {
        <h1>@Msg.WebFeature.ExtraTitle(Lang, GuildFeature.ConditionalRoles, "rules")</h1>
        <p class="text-muted">@Msg.WebConditionalRoles.RulesIntro(Lang)</p>

        @if (rules.Count == 0)
        {
            <p class="form-text">@Msg.WebConditionalRoles.NoRulesYet(Lang)</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="condition-expand-col"></th>
                            <th>@Msg.WebConditionalRoles.ColName(Lang)</th>
                            <th>@Msg.WebConditionalRoles.ColTargetRole(Lang)</th>
                            <th>@Msg.WebConditionalRoles.ColStatus(Lang)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var listed in rules)
                        {
                            <tr @key="listed.Id">
                                @* Several rules can be open at once — comparing two is the reason
                                   to expand them at all, so this is a set rather than an accordion. *@
                                <td class="condition-expand-col">
                                    <button type="button" class="btn btn-sm btn-link condition-expand" @onclick="() => ToggleExpanded(listed.Id)"
                                            aria-expanded="@expanded.Contains(listed.Id)" title="@listed.Name">
                                        @(expanded.Contains(listed.Id) ? "▾" : "▸")
                                    </button>
                                </td>
                                <td>@listed.Name</td>
                                @* Shown here so a rule reads "Rogues → @Rogue" at a glance: the one
                                   mismatch that actually happened was invisible until you opened the
                                   rule and cross-referenced the role by hand. *@
                                <td>
                                    @if (TargetRoleName(listed) is { } roleName)
                                    {
                                        <span class="badge bg-secondary">@roleName</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">@Msg.WebConditionalRoles.NoTargetRole(Lang)</span>
                                    }
                                </td>
                                <td>@StatusOf(listed)</td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" href="@EditHref(listed.Id)">@Msg.WebCommon.Edit(Lang)</a>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyRuleAsync(listed.Id)">@Msg.WebConditionalRoles.Copy(Lang)</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRuleAsync(listed.Id)">@Msg.WebCommon.Delete(Lang)</button>
                                </td>
                            </tr>
                            @if (expanded.Contains(listed.Id))
                            {
                                <tr @key="@($"detail-{listed.Id}")" class="condition-detail-row">
                                    <td></td>
                                    <td colspan="3">
                                        <ul class="condition-summary list-unstyled mb-0">
                                            <ConditionSummary Node="listed.Root" Roles="roles" Conditions="conditionOptions"
                                                              PlayerLabels="playerLabels" AllianceLabels="allianceLabels" />
                                        </ul>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="form-text">@Msg.WebConditionalRoles.CopyIsInactive(Lang)</p>
        }

        <div class="card-grid">
            <SettingsCard Title="@Msg.WebConditionalRoles.AddRuleCardTitle(Lang)" Class="card-span-full">
                <div class="d-flex align-items-end gap-2 flex-wrap">
                    <div class="condition-name-input">
                        <label class="form-label">@Msg.WebConditionalRoles.RuleNamePlaceholder(Lang)</label>
                        <input class="form-control" maxlength="100" @bind="newRuleName" />
                    </div>
                    <button class="btn btn-primary" @onclick="AddRuleAsync" disabled="@string.IsNullOrWhiteSpace(newRuleName)">
                        @Msg.WebCommon.Add(Lang)
                    </button>
                </div>
            </SettingsCard>
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    // A rule as the page holds it: the stored fields plus the live tree and whether it has been
    // touched since the last save. Explicit Save (not the settings cards' autosave) — a half-edited
    // tree written on every keystroke would grant and revoke roles while someone is still thinking.
    private sealed class RuleVm
    {
        public int Id;
        public string Name = "";
        public string? TargetRoleId;
        public bool Enabled = true;
        public EditableNode Root = EditableNode.NewGroup();
        public bool Dirty;
    }

    private bool loading = true;
    private List<RuleVm> rules = [];
    private RuleVm? editing;
    private List<Role> roles = [];
    private List<ConditionNodeEditor.ConditionOption> conditionOptions = [];
    private Dictionary<int, ConditionNode> conditionTrees = [];
    private Dictionary<int, string> playerLabels = [];
    private Dictionary<int, string> allianceLabels = [];
    private string? newRuleName;
    private bool subscribed;
    private readonly HashSet<int> expanded = [];

    private string ListHref => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];

    private string EditHref(int ruleId) => $"{ListHref}?rule={ruleId}";

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        loading = true;
        roles = await DiscordData.GetRolesAsync(ParsedGuildId);

        if (!subscribed)
        {
            Nav.LocationChanged += OnLocationChanged;
            subscribed = true;
        }

        await LoadAsync();
        loading = false;
    }

    // Edit and back are query-string changes on the same route, which doesn't re-run the page's
    // parameters — so the mode is re-read here instead of relying on a re-render.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        // onlyEnabledRules: false — the editor shows disabled rules too, which is the whole point of
        // the switch.
        var snapshot = await ConditionalRoles.LoadAsync(ParsedGuildId, onlyEnabledRules: false);
        conditionTrees = snapshot.Conditions.ToDictionary(kv => kv.Key, kv => kv.Value);

        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.ConditionalRoleRules
            .Where(r => r.GuildId == ParsedGuildId)
            .OrderBy(r => r.Name)
            .ToListAsync();

        conditionOptions = (await db.ConditionalRoleConditions
                .Where(c => c.GuildId == ParsedGuildId)
                .OrderBy(c => c.Name)
                .ToListAsync())
            .Select(c => new ConditionNodeEditor.ConditionOption(c.Id, c.Name))
            .ToList();

        rules = stored.Select(r => new RuleVm
        {
            Id = r.Id,
            Name = r.Name,
            TargetRoleId = r.TargetRoleId == 0 ? null : r.TargetRoleId.ToString(),
            Enabled = r.Enabled,
            Root = snapshot.Rules.FirstOrDefault(s => s.Id == r.Id)?.Root is { } root
                ? EditableNode.FromDomain(root)
                : EditableNode.NewGroup(),
        }).ToList();

        // Which rule (if any) this URL is editing. Read from the query rather than a route parameter
        // because FeatureExtraPageHost only ever passes the guild id along.
        var query = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        editing = query.TryGetValue("rule", out var raw) && int.TryParse(raw, out var editingId)
            ? rules.FirstOrDefault(r => r.Id == editingId)
            : null;

        await LoadOperandLabelsAsync();
    }

    // One query per operand kind for the whole page, rather than one per node: a rogue listing is a
    // dozen leaves and each would otherwise be its own round trip.
    private async Task LoadOperandLabelsAsync()
    {
        var roots = rules.Select(x => x.Root).ToList();
        playerLabels = await ConditionalRoles.PlayerLabelsAsync(Collect(roots, n => n.StfcPlayerId));
        allianceLabels = await ConditionalRoles.AllianceLabelsAsync(Collect(roots, n => n.StfcAllianceId));
    }

    private static List<int> Collect(IEnumerable<EditableNode> roots, Func<EditableNode, int?> pick)
    {
        var ids = new HashSet<int>();
        var stack = new Stack<EditableNode>(roots);
        while (stack.Count > 0)
        {
            var node = stack.Pop();
            if (pick(node) is { } id)
                ids.Add(id);
            foreach (var child in node.Children)
                stack.Push(child);
        }
        return ids.ToList();
    }

    private void ToggleExpanded(int ruleId)
    {
        if (!expanded.Add(ruleId))
            expanded.Remove(ruleId);
    }

    private string? TargetRoleName(RuleVm rule) =>
        ulong.TryParse(rule.TargetRoleId, out var id) ? roles.FirstOrDefault(r => r.Id == id)?.Name : null;

    // What the sync will conclude, shown before it happens: an unfinished tree or a missing target
    // role means the rule grants nothing at all (ConditionEvaluator fails closed), and an admin
    // should hear that from the editor rather than by watching nothing happen for ten minutes.
    private bool IsUsable(RuleVm rule) =>
        ulong.TryParse(rule.TargetRoleId, out _)
        && ConditionEvaluator.IsComplete(rule.Root.ToDomain(), conditionTrees);

    private string StatusOf(RuleVm rule) =>
        !rule.Enabled ? Msg.WebConditionalRoles.StatusInactive(Lang)
        : !IsUsable(rule) ? Msg.WebConditionalRoles.StatusUnfinished(Lang)
        : Msg.WebConditionalRoles.StatusActive(Lang);

    private async Task SaveRuleAsync(RuleVm rule)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var stored = await db.ConditionalRoleRules.FirstOrDefaultAsync(r => r.Id == rule.Id && r.GuildId == ParsedGuildId);
        if (stored is null)
            return;

        stored.Name = string.IsNullOrWhiteSpace(rule.Name) ? stored.Name : rule.Name.Trim();
        stored.TargetRoleId = ulong.TryParse(rule.TargetRoleId, out var roleId) ? roleId : 0;
        stored.Enabled = rule.Enabled;
        await db.SaveChangesAsync();

        await ConditionalRoles.SaveTreeAsync(rule.Id, null, rule.Root.ToDomain());
        rule.Dirty = false;
        await LoadAsync();
    }

    private async Task DeleteRuleAsync(int ruleId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        // Its nodes go with it (cascade from the owner).
        await db.ConditionalRoleRules.Where(r => r.Id == ruleId && r.GuildId == ParsedGuildId).ExecuteDeleteAsync();
        await LoadAsync();
    }

    private async Task CopyRuleAsync(int ruleId)
    {
        // Straight into the copy: it is inactive and named "… (copy)", so it needs editing before it
        // does anything.
        if (await ConditionalRoles.CopyRuleAsync(ParsedGuildId, ruleId) is { } copyId)
            Nav.NavigateTo(EditHref(copyId));
    }

    private async Task AddRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(newRuleName))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var rule = new ConditionalRoleRule
        {
            GuildId = ParsedGuildId,
            Name = newRuleName.Trim(),
            // No target role and no tree yet, so it grants nothing until it's filled in.
            Enabled = true,
        };
        db.ConditionalRoleRules.Add(rule);
        await db.SaveChangesAsync();

        newRuleName = null;
        // Straight into the new rule — an empty one has nothing to look at in the list.
        Nav.NavigateTo(EditHref(rule.Id));
    }

    public void Dispose()
    {
        if (subscribed)
            Nav.LocationChanged -= OnLocationChanged;
    }
}
