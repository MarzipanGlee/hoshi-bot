@using HoshiBot.Data
@using HoshiBot.Domain.ConditionalRoles
@using NetCord
@inject ConditionalRoleService ConditionalRoles

@* One node of a condition tree, rendering itself again for each child — the only recursive editor
   in this codebase. Indentation comes from the nesting, so an admin reads the shape of their rule
   the way it evaluates. *@
<div class="condition-node @(Depth > 0 ? "condition-node-nested" : "")">
    @* No flex-wrap: the kind select and its operand read as one statement ("has role — @164") and
       must stay on one line; the row is sized so they fit rather than being allowed to break. *@
    <div class="condition-row d-flex align-items-center gap-2">
        <select class="form-select form-select-sm condition-kind-select" value="@Node.Kind"
                @onchange="OnKindChangedAsync">
            @foreach (var kind in SelectableKinds)
            {
                <option value="@kind">@KindLabel(kind)</option>
            }
        </select>

        @if (Node.Kind == ConditionNodeKind.HasRole)
        {
            <div class="condition-operand">
                <RolePicker ShowLabel="false" @bind-Value="Node.RoleId" @bind-Value:after="Changed" Roles="Roles" />
            </div>
        }
        else if (IsCatalogLeaf)
        {
            @* A server carries a couple of thousand players, so this searches rather than listing.
               Once something is picked it collapses back to a button showing the choice — clicking
               it reopens the search. *@
            <div class="condition-operand position-relative">
                @if (searching)
                {
                    <input class="form-control form-control-sm" autofocus placeholder="@Msg.WebConditionalRoles.SearchPlaceholder(Lang)"
                           value="@searchTerm" @oninput="OnSearchInputAsync" @onblur="StopSearching" />
                    @if (searchResults.Count > 0)
                    {
                        <ul class="condition-search-results list-unstyled mb-0">
                            @foreach (var option in searchResults)
                            {
                                @* onmousedown, not onclick: blur fires first on a click and would
                                   close the list before the selection ever registered. *@
                                <li><button type="button" class="condition-search-result"
                                            @onmousedown="() => PickAsync(option)">@option.Label</button></li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <button type="button" class="form-select form-select-sm text-start" @onclick="StartSearching">
                        @(SelectedLabel ?? Msg.WebConditionalRoles.ChooseOperand(Lang))
                    </button>
                }
            </div>
        }
        else if (Node.Kind == ConditionNodeKind.MatchesCondition)
        {
            <div class="condition-operand">
                <select class="form-select form-select-sm" value="@Node.ReferencedConditionId"
                        @onchange="OnConditionChangedAsync">
                    <option value="">@Msg.WebConditionalRoles.ChooseCondition(Lang)</option>
                    @foreach (var condition in Conditions)
                    {
                        <option value="@condition.Id">@condition.Name</option>
                    }
                </select>
            </div>
        }

        @if (!IsRoot)
        {
            @* Sits right after the operand rather than pushed to the far edge (no ms-auto): the row
               is as wide as the tree allows, so a right-aligned button would strand itself. *@
            <button type="button" class="btn btn-sm btn-outline-danger" title="@Msg.WebCommon.Delete(Lang)"
                    @onclick="() => OnRemove.InvokeAsync(Node)">✕</button>
        }
    </div>

    @if (Node.IsOperator)
    {
        <div class="condition-children">
            @foreach (var child in Node.Children)
            {
                <ConditionNodeEditor @key="child" Node="child" Roles="Roles" Conditions="Conditions" GuildId="GuildId"
                                     PlayerLabels="PlayerLabels" AllianceLabels="AllianceLabels"
                                     Depth="Depth + 1" OnRemove="RemoveChildAsync" OnChanged="Changed" />
            }

            @if (Node.Kind == ConditionNodeKind.Not && Node.Children.Count >= 1)
            {
                <p class="form-text condition-add-row mb-0">@Msg.WebConditionalRoles.NotTakesOneHint(Lang)</p>
            }
            else
            {
                @* condition-add-row: the same left padding the child nodes carry, so the add
                   controls line up with the things they add rather than sitting a step to the left. *@
                <div class="condition-add-row d-flex align-items-center gap-2 flex-wrap mt-2">
                    @* Picking a role adds the leaf in one action — the "any of these eight tags"
                       case is otherwise an add-then-pick round trip per tag. *@
                    <div class="condition-operand">
                        <RolePicker ShowLabel="false" PlaceholderText="@Msg.WebConditionalRoles.AddRoleOption(Lang)"
                                    @bind-Value="addRoleInput" @bind-Value:after="AddRoleChildAsync" Roles="Roles" />
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddPlayerChildAsync">
                        @Msg.WebConditionalRoles.AddPlayerOption(Lang)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddAllianceChildAsync">
                        @Msg.WebConditionalRoles.AddAllianceOption(Lang)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddGroupChildAsync">
                        @Msg.WebConditionalRoles.AddGroup(Lang)
                    </button>
                    @if (Conditions.Count > 0)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="AddConditionChildAsync">
                            @Msg.WebConditionalRoles.AddConditionRef(Lang)
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter, EditorRequired] public EditableNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Role> Roles { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<ConditionOption> Conditions { get; set; } = [];

    // Labels for ids already stored in this tree, resolved once by the page. The typeahead fills in
    // anything picked during this session itself, so this only has to cover what was loaded.
    [Parameter] public IReadOnlyDictionary<int, string> PlayerLabels { get; set; } = new Dictionary<int, string>();
    [Parameter] public IReadOnlyDictionary<int, string> AllianceLabels { get; set; } = new Dictionary<int, string>();

    [Parameter, EditorRequired] public ulong GuildId { get; set; }

    [Parameter] public int Depth { get; set; }

    // The root has no remove button — a tree always has exactly one root; emptying it is done by
    // changing its kind, not by deleting it.
    [Parameter] public bool IsRoot { get; set; }

    [Parameter] public EventCallback<EditableNode> OnRemove { get; set; }

    // Bubbles every edit up so the page can mark itself dirty; the tree itself is mutated in place.
    [Parameter] public EventCallback OnChanged { get; set; }

    public record ConditionOption(int Id, string Name);



    private string? addRoleInput;

    // Per-node typeahead state; each node in the tree keeps its own.
    private bool searching;
    private string searchTerm = "";
    private IReadOnlyList<OperandOption> searchResults = [];
    private string? pickedLabel;

    private static readonly ConditionNodeKind[] SelectableKinds =
    [
        ConditionNodeKind.And,
        ConditionNodeKind.Or,
        ConditionNodeKind.Not,
        ConditionNodeKind.HasRole,
        ConditionNodeKind.MatchesCondition,
        // Player-data leaves: no operand to pick, so they render as the select alone.
        ConditionNodeKind.HasLinkedPlayer,
        ConditionNodeKind.InHomeAlliance,
        ConditionNodeKind.OnHomeServer,
        ConditionNodeKind.IsPlayer,
        ConditionNodeKind.InAlliance,
    ];

    private string KindLabel(ConditionNodeKind kind) => kind switch
    {
        ConditionNodeKind.And => Msg.WebConditionalRoles.KindAnd(Lang),
        ConditionNodeKind.Or => Msg.WebConditionalRoles.KindOr(Lang),
        ConditionNodeKind.Not => Msg.WebConditionalRoles.KindNot(Lang),
        ConditionNodeKind.HasRole => Msg.WebConditionalRoles.KindHasRole(Lang),
        ConditionNodeKind.HasLinkedPlayer => Msg.WebConditionalRoles.KindHasLinkedPlayer(Lang),
        ConditionNodeKind.InHomeAlliance => Msg.WebConditionalRoles.KindInHomeAlliance(Lang),
        ConditionNodeKind.OnHomeServer => Msg.WebConditionalRoles.KindOnHomeServer(Lang),
        ConditionNodeKind.IsPlayer => Msg.WebConditionalRoles.KindIsPlayer(Lang),
        ConditionNodeKind.InAlliance => Msg.WebConditionalRoles.KindInAlliance(Lang),
        _ => Msg.WebConditionalRoles.KindMatchesCondition(Lang),
    };

    private Task Changed() => OnChanged.InvokeAsync();

    // Children survive a switch between operators (AND ↔ OR ↔ NOT), so an admin can restructure
    // without rebuilding. Switching to a leaf drops them, since a leaf can't hold any.
    private async Task OnKindChangedAsync(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ConditionNodeKind>(e.Value?.ToString(), out var kind))
            return;

        Node.Kind = kind;
        if (!Node.IsOperator)
            Node.Children.Clear();

        await Changed();
    }

    private async Task OnConditionChangedAsync(ChangeEventArgs e)
    {
        Node.ReferencedConditionId = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await Changed();
    }

    private async Task AddRoleChildAsync()
    {
        if (!ulong.TryParse(addRoleInput, out var roleId))
            return;

        Node.Children.Add(new EditableNode { Kind = ConditionNodeKind.HasRole, RoleId = roleId.ToString() });
        addRoleInput = null;
        await Changed();
    }

    // The two leaves whose operand is a catalog entity picked by search.
    private bool IsCatalogLeaf => Node.Kind is ConditionNodeKind.IsPlayer or ConditionNodeKind.InAlliance;

    private string? SelectedLabel => pickedLabel ?? (Node.Kind == ConditionNodeKind.IsPlayer
        ? Node.StfcPlayerId is { } p ? PlayerLabels.GetValueOrDefault(p) : null
        : Node.StfcAllianceId is { } a ? AllianceLabels.GetValueOrDefault(a) : null);

    private void StartSearching()
    {
        searching = true;
        searchTerm = "";
        searchResults = [];
    }

    private void StopSearching() => searching = false;

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        // Two characters before hitting the database, matching the assignment page's typeahead.
        searchResults = searchTerm.Trim().Length < 2
            ? []
            : Node.Kind == ConditionNodeKind.IsPlayer
                ? await ConditionalRoles.SearchPlayersAsync(searchTerm, GuildId)
                : await ConditionalRoles.SearchAlliancesAsync(searchTerm, GuildId);
    }

    private async Task PickAsync(OperandOption option)
    {
        if (Node.Kind == ConditionNodeKind.IsPlayer)
            Node.StfcPlayerId = option.Id;
        else
            Node.StfcAllianceId = option.Id;

        // Remembered locally so the collapsed button shows the choice without waiting for the page
        // to reload its label dictionaries.
        pickedLabel = option.Label;
        searching = false;
        await Changed();
    }

    private async Task AddPlayerChildAsync()
    {
        Node.Children.Add(new EditableNode { Kind = ConditionNodeKind.IsPlayer });
        await Changed();
    }

    private async Task AddAllianceChildAsync()
    {
        Node.Children.Add(new EditableNode { Kind = ConditionNodeKind.InAlliance });
        await Changed();
    }

    private async Task AddGroupChildAsync()
    {
        Node.Children.Add(EditableNode.NewGroup());
        await Changed();
    }

    private async Task AddConditionChildAsync()
    {
        Node.Children.Add(new EditableNode { Kind = ConditionNodeKind.MatchesCondition });
        await Changed();
    }

    private async Task RemoveChildAsync(EditableNode child)
    {
        Node.Children.Remove(child);
        await Changed();
    }
}
