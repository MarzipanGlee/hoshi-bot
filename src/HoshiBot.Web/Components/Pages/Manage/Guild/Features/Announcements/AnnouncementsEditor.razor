@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inherits FeatureEditorBase
@using HoshiBot.Domain
@inject DiscordGuildDataService DiscordData
@inject GuildAllianceService AllianceService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />


<div class="card-grid mt-1">
    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementsSettingKeys.Channel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AnnouncementsSettingKeys.Channel)"
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementsSettingKeys.DraftChannel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AnnouncementsSettingKeys.DraftChannel)"
            @bind-Value="draftChannelInput" @bind-Value:after="SaveDraftChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementsSettingKeys.TestChannel)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AnnouncementsSettingKeys.TestChannel)"
            @bind-Value="testChannelInput" @bind-Value:after="SaveTestChannelAsync" Channels="channels" />

    @if (ResolvedAudience == GuildAudience.Alliance)
    {
        @* Keyed under Announcements (this editor's wording), even though the value is stored
           under the Absences feature — the Absences page carries its own wording for it. *@
    <OwnedElsewhereCard Title="@Msg.WebAlliance.NotificationRoleTitle(Lang)"
            Label="@Msg.WebAlliance.NotificationRoleUsage(Lang)" Lang="Lang"
            Value="@RoleDisplay(notificationRoleId)"
            Hint="@Msg.WebCommon.OwnedByAllianceSettings(Lang)"
            LinkText="@Msg.WebCommon.OpenAllianceSettings(Lang)"
            LinkHref="@($"manage/guild/{GuildId}/alliance/{GuildAllianceId}/settings")" />
    }

    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, AnnouncementsSettingKeys.WarningsRole)" Usage="@Msg.WebEditor.Usage(Lang, Feature, AnnouncementsSettingKeys.WarningsRole)"
            @bind-Value="warningsRoleInput" @bind-Value:after="SaveWarningsRoleAsync" Roles="roles" />

    <CommandStaffRoleCard GuildId="GuildId" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.Announcements;

    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? channelInput;
    private string? draftChannelInput;
    private string? testChannelInput;
    private string? warningsRoleInput;
    private ulong? notificationRoleId;

    private string? RoleDisplay(ulong? roleId) =>
        roleId is { } id && roles.FirstOrDefault(r => r.Id == id) is { } role ? $"@{role.Name}" : null;

    protected override async Task OnSettingsLoadedAsync()
    {
        // The notification role belongs to the alliance, not to this feature — read here, changed on
        // the alliance settings page (see AllianceOwnedRoleCard).
        var alliance = GuildAllianceId is { } roleAllianceId ? await AllianceService.FindByIdAsync(GuildId, roleAllianceId) : null;

        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        channelInput = (await GetSnowflakeAsync(AnnouncementsSettingKeys.Channel))?.ToString();
        draftChannelInput = (await GetSnowflakeAsync(AnnouncementsSettingKeys.DraftChannel))?.ToString();
        testChannelInput = (await GetSnowflakeAsync(AnnouncementsSettingKeys.TestChannel))?.ToString();
        warningsRoleInput = (await GetSnowflakeAsync(AnnouncementsSettingKeys.WarningsRole))?.ToString();

        // Shown/stored only for the Alliance audience: it's the per-alliance Absences-owned role
        // (same value as on the Absences/TC pages), and GetSnowflakeAsync's scope guard rejects
        // the Alliance audience with a null alliance id anyway.
        if (ResolvedAudience == GuildAudience.Alliance)
            notificationRoleId = alliance?.NotificationRoleId;
    }

    private Task SaveChannelAsync() =>
        SetSnowflakeAsync(AnnouncementsSettingKeys.Channel, ParseId(channelInput));


    private Task SaveDraftChannelAsync() =>
        SetSnowflakeAsync(AnnouncementsSettingKeys.DraftChannel, ParseId(draftChannelInput));

    // Optional: with nothing picked, the publish prompt simply doesn't offer a dry run.
    private Task SaveTestChannelAsync() =>
        SetSnowflakeAsync(AnnouncementsSettingKeys.TestChannel, ParseId(testChannelInput));

    private Task SaveWarningsRoleAsync() =>
        SetSnowflakeAsync(AnnouncementsSettingKeys.WarningsRole, ParseId(warningsRoleInput));

    // The alliance's tag prefixes the created role, so a coalition guild's opt-in roles sit together
    // and a member can tell whose is whose. Falls back to a bare name when the tag isn't loaded yet.


}
