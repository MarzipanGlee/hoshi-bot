@using HoshiBot.Web.Services
@using NetCord
@using NetCord.Rest
@inherits FeatureEditorBase
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureSettingsService SettingsService

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <ChannelPicker CardTitle="Announcements" Usage="Where published announcements are posted."
            @bind-Value="channelInput" @bind-Value:after="SaveChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="Announcements Reminders" Usage="A second channel that gets reminder pings for unread announcements."
            @bind-Value="remindersChannelInput" @bind-Value:after="SaveRemindersChannelAsync" Channels="channels" />

    <ChannelPicker CardTitle="Announcements Draft" Usage="Where staff post announcement drafts (plain message, attachments allowed) before publishing them."
            @bind-Value="draftChannelInput" @bind-Value:after="SaveDraftChannelAsync" Channels="channels" />

    @if (ResolvedAudience == GuildAudience.Alliance)
    {
        <RolePicker CardTitle="Notification Role" Usage="Pinged when an Elevated-severity announcement is published — the default members ping (High severity pings the Warnings Role instead). This is the alliance's absence-clean notification role, shared with the Absences and Territory Capture pages."
                @bind-Value="notificationRoleInput" @bind-Value:after="SaveNotificationRoleAsync" Roles="roles" />
    }

    <RolePicker CardTitle="Warnings Role" Usage="Pinged when a High-severity announcement is published."
            @bind-Value="warningsRoleInput" @bind-Value:after="SaveWarningsRoleAsync" Roles="roles" />

    <CommandStaffRoleCard GuildId="GuildId" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.Announcements;

    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? channelInput;
    private string? remindersChannelInput;
    private string? draftChannelInput;
    private string? warningsRoleInput;
    private string? notificationRoleInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        channels = await DiscordData.GetChannelsAsync(GuildId);
        roles = await DiscordData.GetRolesAsync(GuildId);
        channelInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.Channel))?.ToString();
        remindersChannelInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.RemindersChannel))?.ToString();
        draftChannelInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.DraftChannel))?.ToString();
        warningsRoleInput = (await SettingsService.GetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.WarningsRole))?.ToString();

        // Shown/stored only for the Alliance audience: it's the per-alliance Absences-owned role
        // (same value as on the Absences/TC pages), and GetSnowflakeAsync's scope guard rejects
        // the Alliance audience with a null alliance id anyway.
        if (ResolvedAudience == GuildAudience.Alliance)
            notificationRoleInput = (await SettingsService.GetSnowflakeAsync(GuildId, GuildFeature.Absences, GuildAudience.Alliance, GuildAllianceId, AbsencesSettingKeys.NotificationRole))?.ToString();
    }

    private Task SaveChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.Channel, ParseId(channelInput));

    private Task SaveRemindersChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.RemindersChannel, ParseId(remindersChannelInput));

    private Task SaveDraftChannelAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.DraftChannel, ParseId(draftChannelInput));

    private Task SaveWarningsRoleAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, Feature, ResolvedAudience, GuildAllianceId, AnnouncementsSettingKeys.WarningsRole, ParseId(warningsRoleInput));

    // Stored under the Absences feature (its owner) so this and the Absences/TC pages edit one value.
    private Task SaveNotificationRoleAsync() =>
        SettingsService.SetSnowflakeAsync(GuildId, GuildFeature.Absences, GuildAudience.Alliance, GuildAllianceId, AbsencesSettingKeys.NotificationRole, ParseId(notificationRoleInput));
}
