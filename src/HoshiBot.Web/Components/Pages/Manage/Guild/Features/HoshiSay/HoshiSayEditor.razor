@inherits FeatureEditorBase
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using HoshiBot.Web.Services
@using NetCord
@inject DiscordGuildDataService DiscordData

<FeatureEnableSwitch Enabled="Enabled" OnToggle="ToggleEnabledAsync" />

<div class="card-grid mt-1">
    <RolePicker CardTitle="@Msg.WebEditor.CardTitle(Lang, Feature, HoshiSaySettingKeys.AllowedRole)"
            Usage="@Msg.WebEditor.Usage(Lang, Feature, HoshiSaySettingKeys.AllowedRole)"
            @bind-Value="allowedRoleInput" @bind-Value:after="SaveAllowedRoleAsync" Roles="roles" />
</div>

@code {
    protected override GuildFeature Feature => GuildFeature.HoshiSay;

    private List<Role> roles = [];
    private string? allowedRoleInput;

    protected override async Task OnSettingsLoadedAsync()
    {
        roles = await DiscordData.GetRolesAsync(GuildId);
        allowedRoleInput = (await GetSnowflakeAsync(HoshiSaySettingKeys.AllowedRole))?.ToString();
    }

    private Task SaveAllowedRoleAsync() =>
        SetSnowflakeAsync(HoshiSaySettingKeys.AllowedRole, ParseId(allowedRoleInput));
}
