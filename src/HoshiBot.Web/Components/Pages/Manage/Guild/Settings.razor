@page "/manage/guild/{GuildId}/settings"
@inherits GuildAdminPageBase

<PageTitle>@Msg.WebNav.Settings(Lang)</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>@Msg.WebNav.Settings(Lang)</h1>
    <p>@Msg.WebGuild.SettingsLead(Lang)</p>

    <SettingsEditor GuildId="ParsedGuildId" />
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }
}
