@page "/manage/guild/{GuildId}/alliance"
@page "/manage/guild/{GuildId}/alliance/{GuildAllianceIdRaw:int}"
@inherits AllianceAdminPageBase
@inject GuildFeatureService FeatureService

<PageTitle>@(allianceTag is null ? "Alliance" : $"[{allianceTag}]")</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (NeedsAllianceLink)
    {
        <h1>Alliance</h1>
        <AllianceLinkRequiredHint GuildId="@GuildId" />
    }
    else
    {
        <h1>[@allianceTag] @allianceName</h1>

        <div class="card-grid">
            @foreach (var p in AllianceAdminPages.All.Where(x => x.ShowOnOverviewCard))
            {
                <NavCard Href="@AllianceAdminPages.Href(ParsedGuildId, ResolvedAllianceId!.Value, p)" Icon="@p.Icon" Title="@p.Label" Subtitle="@CardSubtitle(p)" />
            }
        </div>
    }
</AuthorizedGuildView>

@code {
    private string? allianceTag;
    private string? allianceName;
    private int enabledCount;
    private int featureTotal;

    protected override string PageSlug => "";

    protected override async Task OnAllianceResolvedAsync(int guildAllianceId)
    {
        var alliance = await AllianceService.FindByIdAsync(ParsedGuildId, guildAllianceId);
        if (alliance is null)
        {
            // Raced with an unlink — leave the labels blank; the next navigation re-resolves.
            return;
        }

        allianceTag = alliance.StfcAlliance.Tag;
        allianceName = alliance.StfcAlliance.Name;

        var allianceRelevantFeatures = FeatureCatalog.RelevantTo(GuildAudience.Alliance);
        featureTotal = allianceRelevantFeatures.Count;
        enabledCount = (await FeatureService.GetEnabledAsync(ParsedGuildId))
            .Count(s => s.Audience == GuildAudience.Alliance && s.GuildAllianceId == guildAllianceId && allianceRelevantFeatures.Contains(s.Feature));
    }

    // Per-card subtitle for the Overview grid, keyed by the page's route suffix. Settings has no
    // single headline number, so it gets a static descriptor.
    private string CardSubtitle(AllianceAdminPage page) => page.RouteSuffix switch
    {
        "features" => $"{enabledCount}/{featureTotal} enabled",
        "settings" => "Channels & roles",
        _ => "",
    };
}
