@page "/manage/guild/{GuildId}/alliance/settings"
@page "/manage/guild/{GuildId}/alliance/{GuildAllianceIdRaw:int}/settings"
@using HoshiBot.Web.Services
@using NetCord
@inherits AllianceAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData
@inject LanguageResolver LanguageResolver
@inject GuildFeatureService FeatureService

<PageTitle>@Msg.WebAlliance.SettingsPageTitle(Lang)</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (NeedsAllianceLink)
    {
        <h1>@Msg.WebAlliance.SettingsPageTitle(Lang)</h1>
        <AllianceLinkRequiredHint GuildId="@GuildId" />
    }
    else
    {
        <h1>@Msg.WebAlliance.SettingsHeading(Lang, allianceTag)</h1>
        <p>@Msg.WebAlliance.SettingsLead(Lang)</p>

        <h2>@Msg.WebCommon.Defaults(Lang)</h2>
        <div class="card-grid mt-1">
            <ChannelPicker CardTitle="@Msg.WebAlliance.DefaultCategoryTitle(Lang)" Usage="@Msg.WebAlliance.DefaultCategoryUsage(Lang)" CategorySelect="true" CreateChannelName="Hoshi Bot" @bind-Value="defaultChannelCategoryIdInput" @bind-Value:after="SaveDefaultChannelCategoryAsync" Channels="categories" PlaceholderText="@Msg.WebAlliance.ServerRootPlaceholder(Lang)" />
        </div>

        <h2>@Msg.WebCommon.Channels(Lang)</h2>
        <div class="card-grid mt-1">
            <ChannelPicker CardTitle="@Msg.WebAlliance.RemindersAlliesTitle(Lang)" Usage="@Msg.WebAlliance.NotImplementedYet(Lang)" @bind-Value="remindersAlliesChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RemindersAlliesChannelId = ParseId(remindersAlliesChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="@Msg.WebAlliance.RulesDeTitle(Lang)" Usage="@Msg.WebAlliance.NotImplementedYet(Lang)" @bind-Value="rulesDeChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RulesDeChannelId = ParseId(rulesDeChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="@Msg.WebAlliance.RulesEnTitle(Lang)" Usage="@Msg.WebAlliance.NotImplementedYet(Lang)" @bind-Value="rulesEnChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RulesEnChannelId = ParseId(rulesEnChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="@Msg.WebAlliance.UserNotificationsTitle(Lang)" Usage="@($"{Msg.WebAlliance.NotImplementedYet(Lang)} {Msg.WebAlliance.UserNotificationsUsage(Lang)}")" @bind-Value="userNotificationsChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.UserNotificationsChannelId = ParseId(userNotificationsChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="@Msg.WebAlliance.SeniorStaffJobsTitle(Lang)" Usage="@Msg.WebAlliance.NotImplementedYet(Lang)" @bind-Value="seniorStaffJobsChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.SeniorStaffJobsChannelId = ParseId(seniorStaffJobsChannelIdInput))" Channels="channels" />
        </div>

        @if (showMemberRole || showBoardingRole || showDiplomatRole || showSeniorStaffRole || showAlertRole || showNotificationRole)
        {
            <h2>@Msg.WebCommon.Roles(Lang)</h2>
            @if (createError is not null)
            {
                <p class="text-danger">@createError.Value.Text(Lang)</p>
            }
            <div class="card-grid mt-1">
                @* Each card appears only while some enabled feature reads it — see SharedSettingUsage. *@
                @if (showMemberRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.MemberRoleTitle(Lang)" Usage="@Msg.WebAlliance.MemberRoleUsage(Lang)" CreateRoleName="@memberRoleName" @bind-Value="memberRoleIdInput" @bind-Value:after="SaveMemberRoleAsync" Roles="roles" />
                }
                @if (showBoardingRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.BoardingRoleTitle(Lang)" Usage="@Msg.WebCommon.BoardingRoleUsage(Lang)" CreateRoleName="@boardingRoleName" @bind-Value="boardingRoleIdInput" @bind-Value:after="SaveBoardingRoleAsync" Roles="roles" />
                }
                @if (showDiplomatRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.DiplomatRoleTitle(Lang)" Usage="@Msg.WebCommon.DiplomatRoleUsage(Lang)" CreateRoleName="@diplomatRoleName" @bind-Value="diplomatRoleIdInput" @bind-Value:after="SaveDiplomatRoleAsync" Roles="roles" />
                }
                @if (showSeniorStaffRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.SeniorStaffRoleTitle(Lang)" Usage="@Msg.WebCommon.SeniorStaffRoleUsage(Lang)" CreateRoleName="@seniorStaffRoleName" @bind-Value="seniorStaffRoleIdInput" @bind-Value:after="SaveSeniorStaffRoleAsync" Roles="roles" />
                }
                @if (showAlertRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.AlertRoleTitle(Lang)" Usage="@Msg.WebCommon.AlertRoleUsage(Lang)" CreateRoleName="@alertRoleName" @bind-Value="alertRoleIdInput" @bind-Value:after="SaveAlertRoleAsync" Roles="roles" />
                }
                @if (showNotificationRole)
                {
                    <RolePicker CardTitle="@Msg.WebAlliance.NotificationRoleTitle(Lang)" Usage="@Msg.WebAlliance.NotificationRoleUsage(Lang)" CreateRoleName="@notificationRoleName" @bind-Value="notificationRoleIdInput" @bind-Value:after="SaveNotificationRoleAsync" Roles="roles" />
                }
            </div>
        }

        <h2>@Msg.WebCommon.Regional(Lang)</h2>
        <div class="card-grid mt-1">
            <SettingsCard Title="@Msg.WebAlliance.TimezoneTitle(Lang)">
                <p class="form-text mb-2">
                    @Msg.WebAlliance.TimezoneUsage(Lang)
                </p>
                <Select TValue="string" ShowSearch="true" @bind-Value="timeZoneIdInput" @bind-Value:after="SaveTimeZoneAsync" Items="TimeZoneItems" />
            </SettingsCard>
            <LanguagePicker CardTitle="@Msg.WebGuild.LanguageTitle(Lang)"
                            Usage="@Msg.WebAlliance.AllianceLanguageUsage(Lang)"
                            InheritedLabel="@InheritedLanguageLabel"
                            @bind-Value="languageInput" @bind-Value:after="SaveLanguageAsync" />
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    protected override string PageSlug => "settings";

    private string allianceTag = "";
    private string memberRoleName = "Member";
    private string notificationRoleName = "Notifications";
    private string boardingRoleName = "Boarding";
    private string alertRoleName = "Alerts";
    private string diplomatRoleName = "Diplomat";
    private string seniorStaffRoleName = "Senior Staff";
    private List<IGuildChannel> channels = [];
    private List<CategoryGuildChannel> categories = [];
    private List<Role> roles = [];
    private DiscordCreateErrorKind? createError;

    private string? remindersAlliesChannelIdInput;
    private string? rulesDeChannelIdInput;
    private string? rulesEnChannelIdInput;
    private string? userNotificationsChannelIdInput;
    private string? seniorStaffJobsChannelIdInput;
    private string? defaultChannelCategoryIdInput;
    private string? memberRoleIdInput;
    private string? notificationRoleIdInput;
    private string? boardingRoleIdInput;
    private string? alertRoleIdInput;
    private string? diplomatRoleIdInput;
    private string? seniorStaffRoleIdInput;
    private string? timeZoneIdInput;
    private string? languageInput;
    private string? guildLanguageName;

    // A shared role's card is shown only while some feature enabled for THIS alliance reads it —
    // see SharedSettingUsage for the mapping and why hiding is by usage rather than by value.
    private bool showMemberRole;
    private bool showBoardingRole;
    private bool showAlertRole;
    private bool showDiplomatRole;
    private bool showSeniorStaffRole;
    private bool showNotificationRole;

    // What an empty language selection resolves to — mirrors AudienceSettings' own
    // InheritedLanguageLabel: the resolved guild language once loaded, the bare "guild
    // language" wording during the transient pre-load render.
    private string InheritedLanguageLabel => guildLanguageName is null
        ? Msg.WebGuild.GuildLanguage(Lang)
        : Msg.WebGuild.GuildLanguageInherited(Lang, guildLanguageName);

    // IANA ids (on Linux TimeZoneInfo.Id is the IANA id); searchable so the admin can type e.g. "Zurich".
    private static readonly List<SelectedItem> TimeZoneItems =
        TimeZoneInfo.GetSystemTimeZones().Select(tz => new SelectedItem(tz.Id, tz.Id)).ToList();

    protected override async Task OnAllianceResolvedAsync(int guildAllianceId)
    {
        createError = null;

        var alliance = await AllianceService.FindByIdAsync(ParsedGuildId, guildAllianceId);
        if (alliance is null)
        {
            // Raced with an unlink — fall back to the "no alliance" hint on the next render.
            return;
        }

        allianceTag = alliance.StfcAlliance.Tag;
        memberRoleName = $"{allianceTag}-Member";
        notificationRoleName = $"{allianceTag}-Notifications";
        boardingRoleName = $"{allianceTag}-Boarding";
        alertRoleName = $"{allianceTag}-Alerts";
        diplomatRoleName = $"{allianceTag}-Diplomat";
        seniorStaffRoleName = $"{allianceTag}-Senior-Staff";

        channels = await DiscordData.GetChannelsAsync(ParsedGuildId);
        categories = await DiscordData.GetCategoriesAsync(ParsedGuildId);
        roles = await DiscordData.GetRolesAsync(ParsedGuildId);

        remindersAlliesChannelIdInput = alliance.RemindersAlliesChannelId?.ToString();
        rulesDeChannelIdInput = alliance.RulesDeChannelId?.ToString();
        rulesEnChannelIdInput = alliance.RulesEnChannelId?.ToString();
        userNotificationsChannelIdInput = alliance.UserNotificationsChannelId?.ToString();
        seniorStaffJobsChannelIdInput = alliance.SeniorStaffJobsChannelId?.ToString();
        defaultChannelCategoryIdInput = alliance.DefaultChannelCategoryId?.ToString();
        memberRoleIdInput = alliance.MemberRoleId?.ToString();
        notificationRoleIdInput = alliance.NotificationRoleId?.ToString();
        boardingRoleIdInput = alliance.BoardingRoleId?.ToString();
        alertRoleIdInput = alliance.AlertRoleId?.ToString();
        diplomatRoleIdInput = alliance.DiplomatRoleId?.ToString();
        seniorStaffRoleIdInput = alliance.SeniorStaffRoleId?.ToString();
        timeZoneIdInput = alliance.TimeZoneId ?? GuildAlliance.DefaultTimeZoneId;
        languageInput = alliance.Language;
        guildLanguageName = Languages.NativeName(await LanguageResolver.ForGuildAsync(ParsedGuildId));

        showMemberRole = await AnyEnabledAsync(SharedSettingUsage.MemberRole, guildAllianceId);
        showBoardingRole = await AnyEnabledAsync(SharedSettingUsage.BoardingRole, guildAllianceId);
        showAlertRole = await AnyEnabledAsync(SharedSettingUsage.AlertRole, guildAllianceId);
        showDiplomatRole = await AnyEnabledAsync(SharedSettingUsage.DiplomatRole, guildAllianceId);
        showSeniorStaffRole = await AnyEnabledAsync(SharedSettingUsage.SeniorStaffRole, guildAllianceId);
        showNotificationRole = await AnyEnabledAsync(SharedSettingUsage.NotificationRole, guildAllianceId);
    }

    private Task SaveTimeZoneAsync() =>
        SaveAsync(a => a.TimeZoneId = string.IsNullOrEmpty(timeZoneIdInput) ? null : timeZoneIdInput);

    private Task SaveLanguageAsync() => SaveAsync(a => a.Language = languageInput);

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;

    private async Task SaveAsync(Action<GuildAlliance> apply)
    {
        if (ResolvedAllianceId is not { } id)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildAlliances.FirstOrDefaultAsync(a => a.Id == id && a.GuildId == ParsedGuildId);
        if (existing is null)
            return;

        apply(existing);
        await db.SaveChangesAsync();
    }

    private async Task SaveDefaultChannelCategoryAsync()
    {
        createError = null;
        (var categoryId, defaultChannelCategoryIdInput, createError) = await DiscordData.EnsureChannelOrErrorAsync(ParsedGuildId, defaultChannelCategoryIdInput, "Hoshi Bot", ChannelType.CategoryChannel);
        if (createError is not null)
            return;

        categories = await DiscordData.GetCategoriesAsync(ParsedGuildId);
        await SaveAsync(a => a.DefaultChannelCategoryId = categoryId);
    }

    // A blank selection creates a new role (named after the alliance tag) instead of saving null.
    // Mirrors the guild SettingsEditor's SaveRoleAsync.
    private async Task SaveRoleAsync(Action<GuildAlliance, ulong?> setter, string? currentInput, Action<string?> setInput, string defaultName)
    {
        createError = null;
        var (roleId, input, error) = await DiscordData.EnsureRoleOrErrorAsync(ParsedGuildId, currentInput, defaultName);
        setInput(input);
        createError = error;
        if (error is not null)
            return;

        roles = await DiscordData.GetRolesAsync(ParsedGuildId);
        await SaveAsync(a => setter(a, roleId));
    }

    private Task SaveMemberRoleAsync() => SaveRoleAsync((a, id) => a.MemberRoleId = id, memberRoleIdInput, v => memberRoleIdInput = v, memberRoleName);
    private Task SaveBoardingRoleAsync() => SaveRoleAsync((a, id) => a.BoardingRoleId = id, boardingRoleIdInput, v => boardingRoleIdInput = v, boardingRoleName);

    private Task SaveAlertRoleAsync() => SaveRoleAsync((a, id) => a.AlertRoleId = id, alertRoleIdInput, v => alertRoleIdInput = v, alertRoleName);

    private Task SaveDiplomatRoleAsync() => SaveRoleAsync((a, id) => a.DiplomatRoleId = id, diplomatRoleIdInput, v => diplomatRoleIdInput = v, diplomatRoleName);

    private Task SaveSeniorStaffRoleAsync() => SaveRoleAsync((a, id) => a.SeniorStaffRoleId = id, seniorStaffRoleIdInput, v => seniorStaffRoleIdInput = v, seniorStaffRoleName);
    private Task SaveNotificationRoleAsync() => SaveRoleAsync((a, id) => a.NotificationRoleId = id, notificationRoleIdInput, v => notificationRoleIdInput = v, notificationRoleName);

    private Task<bool> AnyEnabledAsync(IReadOnlyList<GuildFeature> features, int guildAllianceId) =>
        FeatureService.AnyEnabledAsync(ParsedGuildId, features, GuildAudience.Alliance, guildAllianceId);
}
