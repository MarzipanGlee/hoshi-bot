@page "/manage/guild/{GuildId}/alliance/settings"
@page "/manage/guild/{GuildId}/alliance/{GuildAllianceIdRaw:int}/settings"
@using HoshiBot.Web.Services
@using NetCord
@inherits AllianceAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData
@inject LanguageResolver LanguageResolver

<PageTitle>Alliance Settings</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (NeedsAllianceLink)
    {
        <h1>Alliance Settings</h1>
        <AllianceLinkRequiredHint GuildId="@GuildId" />
    }
    else
    {
        <h1>Alliance Settings — [@allianceTag]</h1>
        <p>Per-alliance channels and roles. A coalition guild configures each linked alliance separately.</p>

        <h2>Channels</h2>
        <div class="card-grid mt-1">
            <ChannelPicker CardTitle="Alliance Boarding" Usage="Where new-member boarding happens." @bind-Value="allianceBoardingChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.AllianceBoardingChannelId = ParseId(allianceBoardingChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Reminders (Allies)" @bind-Value="remindersAlliesChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RemindersAlliesChannelId = ParseId(remindersAlliesChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Rules (DE)" @bind-Value="rulesDeChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RulesDeChannelId = ParseId(rulesDeChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Rules (EN)" @bind-Value="rulesEnChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.RulesEnChannelId = ParseId(rulesEnChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="User Notifications" Usage="General user-facing notifications, not tied to one feature." @bind-Value="userNotificationsChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.UserNotificationsChannelId = ParseId(userNotificationsChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Bot Support" Usage="Where server admins can ask for help with the bot itself." @bind-Value="botSupportChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.BotSupportChannelId = ParseId(botSupportChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Command Staff Jobs" @bind-Value="commandStaffJobsChannelIdInput" @bind-Value:after="() => SaveAsync(a => a.CommandStaffJobsChannelId = ParseId(commandStaffJobsChannelIdInput))" Channels="channels" />
            <ChannelPicker CardTitle="Default Channel Category" Usage="Category new channels get auto-created under (e.g. by the Setup Wizard) when none is picked explicitly." CategorySelect="true" CreateChannelName="Hoshi Bot" @bind-Value="defaultChannelCategoryIdInput" @bind-Value:after="SaveDefaultChannelCategoryAsync" Channels="categories" PlaceholderText="— server root —" />
        </div>

        <h2>Roles</h2>
        @if (createError is not null)
        {
            <p class="text-danger">@createError</p>
        }
        <div class="card-grid mt-1">
            <RolePicker CardTitle="Member" Usage="This alliance's general membership role." CreateRoleName="@memberRoleName" @bind-Value="memberRoleIdInput" @bind-Value:after="SaveMemberRoleAsync" Roles="roles" />
            <RolePicker CardTitle="Officer" CreateRoleName="@officerRoleName" @bind-Value="officerRoleIdInput" @bind-Value:after="SaveOfficerRoleAsync" Roles="roles" />
            <RolePicker CardTitle="Diplomat" CreateRoleName="@diplomatRoleName" @bind-Value="diplomatRoleIdInput" @bind-Value:after="SaveDiplomatRoleAsync" Roles="roles" />
            <RolePicker CardTitle="Boarding" CreateRoleName="@boardingRoleName" @bind-Value="boardingRoleIdInput" @bind-Value:after="SaveBoardingRoleAsync" Roles="roles" />
        </div>

        <h2>Regional</h2>
        <div class="card-grid mt-1">
            <SettingsCard Title="Timezone">
                <p class="form-text mb-2">
                    The alliance's home timezone, used to interpret scheduled local times such as the
                    Territory Capture digest (DST-aware). Reused by other schedule-driven features.
                </p>
                <Select TValue="string" ShowSearch="true" @bind-Value="timeZoneIdInput" @bind-Value:after="SaveTimeZoneAsync" Items="TimeZoneItems" />
            </SettingsCard>
            <LanguagePicker CardTitle="Language"
                            Usage="The bot's language for public posts scoped to this alliance (digests, reminders, announcements)."
                            InheritedLabel="@inheritedLanguageLabel"
                            @bind-Value="languageInput" @bind-Value:after="SaveLanguageAsync" />
        </div>
    }
</AuthorizedGuildView>

@code {
    protected override string PageSlug => "settings";

    private string allianceTag = "";
    private string memberRoleName = "Member";
    private string officerRoleName = "Officer";
    private string diplomatRoleName = "Diplomat";
    private string boardingRoleName = "Boarding";
    private List<IGuildChannel> channels = [];
    private List<CategoryGuildChannel> categories = [];
    private List<Role> roles = [];
    private string? createError;

    private string? allianceBoardingChannelIdInput;
    private string? remindersAlliesChannelIdInput;
    private string? rulesDeChannelIdInput;
    private string? rulesEnChannelIdInput;
    private string? userNotificationsChannelIdInput;
    private string? botSupportChannelIdInput;
    private string? commandStaffJobsChannelIdInput;
    private string? defaultChannelCategoryIdInput;
    private string? memberRoleIdInput;
    private string? officerRoleIdInput;
    private string? diplomatRoleIdInput;
    private string? boardingRoleIdInput;
    private string? timeZoneIdInput;
    private string? languageInput;
    private string inheritedLanguageLabel = "guild language";

    // IANA ids (on Linux TimeZoneInfo.Id is the IANA id); searchable so the admin can type e.g. "Zurich".
    private static readonly List<SelectedItem> TimeZoneItems =
        TimeZoneInfo.GetSystemTimeZones().Select(tz => new SelectedItem(tz.Id, tz.Id)).ToList();

    protected override async Task OnAllianceResolvedAsync(int guildAllianceId)
    {
        createError = null;

        var alliance = await AllianceService.FindByIdAsync(ParsedGuildId, guildAllianceId);
        if (alliance is null)
        {
            // Raced with an unlink — fall back to the "no alliance" hint on the next render.
            return;
        }

        allianceTag = alliance.StfcAlliance.Tag;
        memberRoleName = $"{allianceTag}-Member";
        officerRoleName = $"{allianceTag}-Officer";
        diplomatRoleName = $"{allianceTag}-Diplomat";
        boardingRoleName = $"{allianceTag}-Boarding";

        channels = await DiscordData.GetChannelsAsync(ParsedGuildId);
        categories = await DiscordData.GetCategoriesAsync(ParsedGuildId);
        roles = await DiscordData.GetRolesAsync(ParsedGuildId);

        allianceBoardingChannelIdInput = alliance.AllianceBoardingChannelId?.ToString();
        remindersAlliesChannelIdInput = alliance.RemindersAlliesChannelId?.ToString();
        rulesDeChannelIdInput = alliance.RulesDeChannelId?.ToString();
        rulesEnChannelIdInput = alliance.RulesEnChannelId?.ToString();
        userNotificationsChannelIdInput = alliance.UserNotificationsChannelId?.ToString();
        botSupportChannelIdInput = alliance.BotSupportChannelId?.ToString();
        commandStaffJobsChannelIdInput = alliance.CommandStaffJobsChannelId?.ToString();
        defaultChannelCategoryIdInput = alliance.DefaultChannelCategoryId?.ToString();
        memberRoleIdInput = alliance.MemberRoleId?.ToString();
        officerRoleIdInput = alliance.OfficerRoleId?.ToString();
        diplomatRoleIdInput = alliance.DiplomatRoleId?.ToString();
        boardingRoleIdInput = alliance.BoardingRoleId?.ToString();
        timeZoneIdInput = alliance.TimeZoneId ?? GuildAlliance.DefaultTimeZoneId;
        languageInput = alliance.Language;
        inheritedLanguageLabel = $"guild language: {Languages.NativeName(await LanguageResolver.ForGuildAsync(ParsedGuildId))}";
    }

    private Task SaveTimeZoneAsync() =>
        SaveAsync(a => a.TimeZoneId = string.IsNullOrEmpty(timeZoneIdInput) ? null : timeZoneIdInput);

    private Task SaveLanguageAsync() => SaveAsync(a => a.Language = languageInput);

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;

    private async Task SaveAsync(Action<GuildAlliance> apply)
    {
        if (ResolvedAllianceId is not { } id)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildAlliances.FirstOrDefaultAsync(a => a.Id == id && a.GuildId == ParsedGuildId);
        if (existing is null)
            return;

        apply(existing);
        await db.SaveChangesAsync();
    }

    private async Task SaveDefaultChannelCategoryAsync()
    {
        createError = null;
        (var categoryId, defaultChannelCategoryIdInput, createError) = await DiscordData.EnsureChannelOrErrorAsync(ParsedGuildId, defaultChannelCategoryIdInput, "Hoshi Bot", ChannelType.CategoryChannel);
        if (createError is not null)
            return;

        categories = await DiscordData.GetCategoriesAsync(ParsedGuildId);
        await SaveAsync(a => a.DefaultChannelCategoryId = categoryId);
    }

    // A blank selection creates a new role (named after the alliance tag) instead of saving null.
    // Mirrors the guild SettingsEditor's SaveRoleAsync.
    private async Task SaveRoleAsync(Action<GuildAlliance, ulong?> setter, string? currentInput, Action<string?> setInput, string defaultName)
    {
        createError = null;
        var (roleId, input, error) = await DiscordData.EnsureRoleOrErrorAsync(ParsedGuildId, currentInput, defaultName);
        setInput(input);
        createError = error;
        if (error is not null)
            return;

        roles = await DiscordData.GetRolesAsync(ParsedGuildId);
        await SaveAsync(a => setter(a, roleId));
    }

    private Task SaveMemberRoleAsync() => SaveRoleAsync((a, id) => a.MemberRoleId = id, memberRoleIdInput, v => memberRoleIdInput = v, memberRoleName);
    private Task SaveOfficerRoleAsync() => SaveRoleAsync((a, id) => a.OfficerRoleId = id, officerRoleIdInput, v => officerRoleIdInput = v, officerRoleName);
    private Task SaveDiplomatRoleAsync() => SaveRoleAsync((a, id) => a.DiplomatRoleId = id, diplomatRoleIdInput, v => diplomatRoleIdInput = v, diplomatRoleName);
    private Task SaveBoardingRoleAsync() => SaveRoleAsync((a, id) => a.BoardingRoleId = id, boardingRoleIdInput, v => boardingRoleIdInput = v, boardingRoleName);
}
