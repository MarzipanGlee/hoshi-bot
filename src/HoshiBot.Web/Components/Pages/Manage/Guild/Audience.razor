@page "/manage/guild/{GuildId}/audience"
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory

<PageTitle>@Msg.WebNav.Audience(Lang)</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>@Msg.WebNav.Audience(Lang)</h1>
    <p>@Msg.WebGuild.AudienceLead(Lang)</p>

    <AudienceEditor GuildId="ParsedGuildId" AudienceChanged="OnAudienceChanged" OnConfigure="OnConfigureAudienceAsync" />

    <div class="mt-4">
        <h2>@Msg.WebGuild.Configuration(Lang)</h2>
        <ScopeAccordion @ref="scopeAccordion" GuildId="ParsedGuildId" Audiences="audiences" />
    </div>

    @if (settingsAudiences.Count > 0)
    {
        <div class="mt-4">
            <h2>@Msg.WebGuild.AudienceSettings(Lang)</h2>
            <p>@Msg.WebGuild.AudienceSettingsLead(Lang)</p>
            <div class="card-grid mt-1">
                @foreach (var audience in settingsAudiences)
                {
                    <NavCard Href="@AudienceSettingsHref(audience)"
                             Icon="@AudienceDisplay.Icon(audience)"
                             Title="@Msg.WebGuild.AudienceSettingsTitle(Lang, AudienceDisplay.Labels(Lang, audience).First())"
                             Subtitle="@AudienceDisplay.Description(Lang, audience)" />
                }
            </div>
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private GuildAudience audiences;
    private ScopeAccordion? scopeAccordion;

    // Alliance settings are per-alliance (its own page); the other selectable audiences
    // each get an AudienceSettings page.
    private List<GuildAudience> settingsAudiences =>
        new[] { GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community }
            .Where(a => audiences.HasFlag(a))
            .ToList();

    private string AudienceSettingsHref(GuildAudience audience) =>
        $"{AudienceDisplay.FeatureScopePrefix(ParsedGuildId, audience, null)}/settings";

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        audiences = await db.GuildSettings
            .Where(s => s.GuildId == ParsedGuildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();
    }

    private void OnAudienceChanged(GuildAudience newAudiences) => audiences = newAudiences;

    // Expands the matching accordion section, then scrolls to it — the section can be a
    // fair way down the page below the audience cards.
    private void OnConfigureAudienceAsync(GuildAudience audience)
    {
        scopeAccordion?.Expand(audience);
        Nav.NavigateTo($"{Nav.Uri.Split('#')[0]}#scope-{AudienceDisplay.Slug(audience)}");
    }
}
