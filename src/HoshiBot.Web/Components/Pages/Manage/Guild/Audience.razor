@page "/manage/guild/{GuildId}/audience"
@using HoshiBot.Domain.Localization
@inherits GuildAdminPageBase
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject LanguageResolver LanguageResolver

<PageTitle>Audience</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>Audience</h1>
    <p>Which audience(s) this guild serves — drives the Setup Wizard's relevant steps and how the Features page groups its cards. Doesn't restrict which features can be enabled.</p>

    <AudienceEditor GuildId="ParsedGuildId" AudienceChanged="OnAudienceChanged" OnConfigure="OnConfigureAudienceAsync" />

    <div class="mt-4">
        <h2>Configuration</h2>
        <ScopeAccordion @ref="scopeAccordion" GuildId="ParsedGuildId" Audiences="audiences" />
    </div>

    @if (languageAudiences.Count > 0)
    {
        <div class="mt-4">
            <h2>Language per audience</h2>
            <p>Public posts scoped to an audience use its language; unset audiences inherit the guild language. The Alliance audience is configured per alliance on its <a href="@($"manage/guild/{GuildId}/alliance/settings")">Alliance Settings</a> page.</p>
            <div class="card-grid mt-1">
                @foreach (var audience in languageAudiences)
                {
                    <LanguagePicker CardTitle="@AudienceDisplay.Labels(audience).First()"
                                    InheritedLabel="@inheritedLanguageLabel"
                                    Value="@AudienceLanguage(audience)"
                                    ValueChanged="value => SaveAudienceLanguageAsync(audience, value)" />
                }
            </div>
        </div>
    }
</AuthorizedGuildView>

@code {
    private GuildAudience audiences;
    private ScopeAccordion? scopeAccordion;
    private Dictionary<GuildAudience, string> audienceLanguages = [];
    private string inheritedLanguageLabel = "guild language";

    // Alliance is per-alliance (GuildAlliance.Language), so only the other selectable
    // audiences get a per-audience selector here.
    private List<GuildAudience> languageAudiences =>
        new[] { GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community }
            .Where(a => audiences.HasFlag(a))
            .ToList();

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        audiences = await db.GuildSettings
            .Where(s => s.GuildId == ParsedGuildId)
            .Select(s => s.Audiences)
            .FirstOrDefaultAsync();

        audienceLanguages = await db.GuildAudienceLanguages
            .Where(l => l.GuildId == ParsedGuildId)
            .ToDictionaryAsync(l => l.Audience, l => l.Language);

        inheritedLanguageLabel = $"guild language: {Languages.NativeName(await LanguageResolver.ForGuildAsync(ParsedGuildId))}";
    }

    private void OnAudienceChanged(GuildAudience newAudiences) => audiences = newAudiences;

    private string? AudienceLanguage(GuildAudience audience) => audienceLanguages.GetValueOrDefault(audience);

    private async Task SaveAudienceLanguageAsync(GuildAudience audience, string? value)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildAudienceLanguages
            .FirstOrDefaultAsync(l => l.GuildId == ParsedGuildId && l.Audience == audience);

        if (value is null)
        {
            if (existing is not null)
                db.GuildAudienceLanguages.Remove(existing);
            audienceLanguages.Remove(audience);
        }
        else if (existing is null)
        {
            db.GuildAudienceLanguages.Add(new GuildAudienceLanguage { GuildId = ParsedGuildId, Audience = audience, Language = value });
            audienceLanguages[audience] = value;
        }
        else
        {
            existing.Language = value;
            audienceLanguages[audience] = value;
        }

        await db.SaveChangesAsync();
    }

    // Expands the matching accordion section, then scrolls to it — the section can be a
    // fair way down the page below the audience cards.
    private void OnConfigureAudienceAsync(GuildAudience audience)
    {
        scopeAccordion?.Expand(audience);
        Nav.NavigateTo($"{Nav.Uri.Split('#')[0]}#scope-{AudienceDisplay.Slug(audience)}");
    }
}
