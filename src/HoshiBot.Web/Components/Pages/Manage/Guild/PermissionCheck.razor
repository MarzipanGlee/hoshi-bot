@page "/manage/guild/{GuildId}/permission-check"
@inherits GuildAdminPageBase
@inject PermissionAuditService Audit

<PageTitle>Permission Check</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>Channel Permission Check</h1>
    <p>Define the exact permission overwrite a role should have on a channel, then audit live Discord permissions against it.</p>

    @if (discordDataError is not null)
    {
        <div class="alert alert-warning">@discordDataError</div>
    }

    <div class="alert @(context.BotHasManageRoles ? "alert-info" : "alert-danger")">
        <strong>Bot's highest role:</strong> @(context.BotTopRoleName ?? "—")
        @(context.BotRolesAbove == 0 ? "(highest role in the server)" : $"({context.BotRolesAbove} role{(context.BotRolesAbove == 1 ? "" : "s")} above it)") ·
        <strong>Manage Roles:</strong> @(context.BotHasManageRoles ? "Yes" : "No — Fix actions will fail entirely")
        @if (context.BotNonAdminRolesAbove > 0)
        {
            <div class="mt-1">
                Tip: for Hoshi Bot to reliably manage every role's channel permissions, place its role directly
                below your top admin/owner role in Server Settings → Roles. Any role positioned above the bot's
                role can't be fixed here — Discord requires a bot's own role to outrank a role before it can
                manage that role's permissions. (Roles above it that have Administrator are fine — they bypass
                channel permissions entirely, so the bot never needs to manage them.)
            </div>
        }
    </div>

    <BotAccessSection Context="context"
                      Results="botAccessResults"
                      Checking="checkingBotAccess"
                      FixStatus="fixStatus"
                      OnReCheck="ReCheckBotAccessAsync"
                      OnFix="FixBotAccessAsync" />

    <ExpectationEditor Context="context"
                       Expectations="expectations"
                       OnSave="SaveExpectationAsync"
                       OnDelete="DeleteExpectationAsync" />

    <ExpectationAuditSection Context="context"
                             Results="auditResults"
                             Auditing="auditing"
                             OnRunAudit="RunAudit"
                             OnFix="FixExpectationAsync" />
</AuthorizedGuildView>

@code {
    // Composition + top-level state only — the audit/fix engines live in
    // PermissionAuditService, the three sections render in their child components.
    private PermissionAuditContext context = PermissionAuditContext.Empty;
    private List<ChannelPermissionExpectation> expectations = [];
    private string? discordDataError;

    private bool auditing;
    private List<PermissionAuditResult>? auditResults;

    private bool checkingBotAccess;
    private List<BotAccessResult>? botAccessResults;

    // Per-channel outcome line from the last Fix, so the escalation (category → re-check →
    // channel) can explain each step in place. Keyed by the configured channel id.
    private readonly Dictionary<ulong, string> fixStatus = [];

    protected override async Task OnAuthorizedParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        expectations = await Audit.GetExpectationsAsync(ParsedGuildId);
        context = await Audit.LoadContextAsync(ParsedGuildId, context);
        discordDataError = context.DiscordDataError;
        await RunBotAccessCheckAsync();
    }

    // Manual re-check clears the per-fix outcome lines for a fresh look; auto-run and post-fix
    // re-checks call RunBotAccessCheckAsync directly so their status lines survive. The service
    // reloads live channel/role data first (evicting the 60s Discord cache) so a permission the
    // admin just changed in Discord is actually picked up.
    private async Task ReCheckBotAccessAsync()
    {
        fixStatus.Clear();
        context = await Audit.ReloadContextAsync(ParsedGuildId, context);
        discordDataError = context.DiscordDataError;
        await RunBotAccessCheckAsync();
    }

    private async Task RunBotAccessCheckAsync()
    {
        checkingBotAccess = true;
        botAccessResults = null;
        try
        {
            botAccessResults = await Audit.CheckBotAccessAsync(context);
        }
        finally
        {
            checkingBotAccess = false;
        }
    }

    private async Task FixBotAccessAsync((BotAccessResult Result, ulong TargetId, bool ViaCategory) fix)
    {
        if (await Audit.FixBotAccessAsync(context, fix.Result, fix.TargetId, fix.ViaCategory) is not { } outcome)
            return;

        fixStatus[fix.Result.ChannelId] = outcome.Status;
        if (!outcome.Applied)
            return;

        context = outcome.Context;
        discordDataError = context.DiscordDataError;
        await RunBotAccessCheckAsync();
    }

    private void RunAudit()
    {
        auditing = true;
        try
        {
            auditResults = Audit.AuditExpectations(context, expectations);
        }
        finally
        {
            auditing = false;
        }
    }

    private async Task FixExpectationAsync(PermissionAuditResult result)
    {
        var (updated, error) = await Audit.FixExpectationAsync(context, result.Expectation);
        if (error is not null)
        {
            discordDataError = error;
            return;
        }

        context = updated;
        discordDataError = context.DiscordDataError;
        RunAudit();
    }

    private async Task SaveExpectationAsync(ExpectationSaveRequest request)
    {
        await Audit.SaveExpectationAsync(ParsedGuildId, request);
        await LoadAsync();
    }

    private async Task DeleteExpectationAsync(ChannelPermissionExpectation expectation)
    {
        await Audit.DeleteExpectationAsync(expectation);
        await LoadAsync();
    }
}
