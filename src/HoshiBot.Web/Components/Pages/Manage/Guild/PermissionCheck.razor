@page "/manage/guild/{GuildId}/permission-check"
@inherits GuildAdminPageBase
@using System.Net
@using HoshiBot.Web.Services
@using Microsoft.Extensions.Caching.Memory
@using NetCord
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData
@inject RestClient BotRestClient
@inject IMemoryCache Cache
@inject IConfiguration Configuration

<PageTitle>Permission Check</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>Channel Permission Check</h1>
    <p>Define the exact permission overwrite a role should have on a channel, then audit live Discord permissions against it.</p>

    @if (discordDataError is not null)
    {
        <div class="alert alert-warning">@discordDataError</div>
    }

    <div class="alert @(botHasManageRoles ? "alert-info" : "alert-danger")">
        <strong>Bot's highest role:</strong> @(botTopRoleName ?? "—")
        @(botRolesAbove == 0 ? "(highest role in the server)" : $"({botRolesAbove} role{(botRolesAbove == 1 ? "" : "s")} above it)") ·
        <strong>Manage Roles:</strong> @(botHasManageRoles ? "Yes" : "No — Fix actions will fail entirely")
        @if (botNonAdminRolesAbove > 0)
        {
            <div class="mt-1">
                Tip: for Hoshi Bot to reliably manage every role's channel permissions, place its role directly
                below your top admin/owner role in Server Settings → Roles. Any role positioned above the bot's
                role can't be fixed here — Discord requires a bot's own role to outrank a role before it can
                manage that role's permissions. (Roles above it that have Administrator are fine — they bypass
                channel permissions entirely, so the bot never needs to manage them.)
            </div>
        }
    </div>

    <h2>Bot Posting Access</h2>
    <p>
        Every channel the bot is configured to post to (feature channels, alert channels, and the
        guild's Settings channels), checked for the permissions the bot actually needs there —
        View Channel, Send Messages, Embed Links (its messages are embeds), plus Read Message
        History where it reads messages back. A channel it can't post to is silently skipped at
        send time — this is where that shows up.
    </p>
    <button class="btn btn-primary" disabled="@checkingBotAccess" @onclick="ReCheckBotAccessAsync">@(checkingBotAccess ? "Checking..." : "Re-check")</button>

    @if (botAccessResults is not null)
    {
        @if (botAccessResults.Count == 0)
        {
            <p class="text-muted mt-3">No post-to channels are configured for this guild yet.</p>
        }
        else
        {
            @if (botAccessResults.Any(r => !r.CanView))
            {
                <div class="alert alert-info mt-3">
                    <strong>Some channels can't be fixed from here — what to do</strong>
                    <p class="mb-2 mt-1">
                        When a row says <em>Can't see channel</em> and offers no working fix button, Discord is
                        hiding that channel from the bot entirely. Discord won't let a bot change a channel it can't
                        even see, so you have to grant access once by hand in Discord — after that, the fix buttons
                        on this page take over. In Discord:
                    </p>
                    <ol class="mb-2">
                        <li>Right-click the <strong>category</strong> the channel sits in (its name is on the blue “Fix on category” button) → <strong>Edit Category</strong> → <strong>Permissions</strong>.</li>
                        <li>Click the <strong>＋</strong> next to “Roles/Members” and add the <strong>Hoshi Bot</strong> role.</li>
                        <li>Turn on <strong>View Channel</strong> (and <strong>Send Messages</strong> if the bot should post there) — the green ✓.</li>
                        <li>If a channel still shows red afterwards, right-click that <strong>channel</strong> → <strong>Edit Channel</strong> → <strong>Permissions</strong> → <strong>Sync Now</strong> so it inherits the category, then hit <em>Re-check</em> here.</li>
                    </ol>
                    <p class="mb-0">
                        Don't want to touch each category? Giving the <strong>Hoshi Bot</strong> role the
                        <strong>Administrator</strong> permission also works and skips all of this — but it removes
                        every channel restriction for the bot, so the steps above are the safer choice.
                    </p>
                </div>
            }

            <table class="table mt-3">
                <thead><tr><th>Channel</th><th>Used by</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var result in botAccessResults)
                    {
                        <tr class="@(result.HasAccess ? "table-success" : "table-danger")">
                            <td>@ChannelName(result.ChannelId)</td>
                            <td>@result.Sources</td>
                            <td>
                                @if (result.HasAccess)
                                {
                                    <span>✅ OK</span>
                                }
                                else
                                {
                                    <div>🚫 Missing access</div>
                                    <div class="small text-nowrap">Channel — @PermsSummary(result.Required, result.ChannelEffective)</div>
                                    @if (result.Category is { } cat)
                                    {
                                        <div class="small text-nowrap">Category — @PermsSummary(result.Required, cat.Effective)</div>
                                    }
                                }
                            </td>
                            <td>
                                @* A fix button is only shown for a level the bot can actually see: Discord
                                   returns Missing Access on any edit to a channel/category it can't view, so a
                                   button there would always fail. When it can see neither, the only route is a
                                   manual grant in Discord (the callout above). *@
                                @if (!result.HasAccess)
                                {
                                    @if (result.CanFix && (result.CanFixChannel || result.CanFixCategory))
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (result.ParentCategoryId is { } categoryId && result.CanFixCategory)
                                            {
                                                <button class="btn btn-sm btn-primary" @onclick="() => FixBotAccessAsync(result, categoryId, true)">Fix on category (@CategoryName(categoryId))</button>
                                            }
                                            @if (result.CanFixChannel)
                                            {
                                                <button class="btn btn-sm @(result.CanFixCategory ? "btn-outline-dark" : "btn-primary")" @onclick="() => FixBotAccessAsync(result, result.ChannelId, false)">Fix on channel</button>
                                            }
                                        </div>
                                    }
                                    else if (result.CanFix)
                                    {
                                        <div class="small text-danger mt-1">
                                            This channel can't be fixed automatically from here — grant the Hoshi Bot
                                            role the permissions listed under Status to the channel itself in Discord
                                            (see the note above), then Re-check.
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger">⚠ @result.BlockReason</span>
                                    }
                                }
                                @if (fixStatus.TryGetValue(result.ChannelId, out var status))
                                {
                                    <div class="small mt-1">@status</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <h2>Expected Permissions</h2>
    <table class="table">
        <thead><tr><th>Channel</th><th>Role</th><th>Allow</th><th>Deny</th><th></th></tr></thead>
        <tbody>
            @foreach (var exp in expectations)
            {
                <tr>
                    <td>@ChannelName(exp.ChannelId)</td>
                    <td>@RoleName(exp.RoleId)</td>
                    <td>@PermissionListLabel((Permissions)exp.Allow)</td>
                    <td>@PermissionListLabel((Permissions)exp.Deny)</td>
                    <td>
                        <button class="btn btn-sm btn-secondary" @onclick="() => EditExpectation(exp)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteExpectation(exp)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>@(editingId is null ? "Add" : "Edit") Expected Permission</h3>
    <div class="mb-2">
        <label>Channel</label>
        <select class="form-select d-inline-block w-auto" @bind="formChannelIdInput">
            <option value="">— select channel —</option>
            @foreach (var group in DiscordGuildDataService.GroupChannelsForDisplay(channels))
            {
                @if (group.Category is not null)
                {
                    <optgroup label="@group.Category.Name">
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    </optgroup>
                }
                else
                {
                    @foreach (var channel in group.Channels)
                    {
                        <option value="@channel.Id">@ChannelLabel(channel)</option>
                    }
                }
            }
        </select>
    </div>
    <div class="mb-2">
        <label>Role</label>
        <select class="form-select d-inline-block w-auto" @bind="formRoleIdInput">
            <option value="">— select role —</option>
            @foreach (var role in roles)
            {
                <option value="@role.Id">@role.Name</option>
            }
        </select>
    </div>

    <table class="table table-sm permission-grid">
        <thead><tr><th>Permission</th><th class="text-center">Neutral</th><th class="text-center">Allow</th><th class="text-center">Deny</th></tr></thead>
        <tbody>
            @foreach (var permission in AllPermissions)
            {
                var current = permission;
                <tr>
                    <td>@current</td>
                    <td class="text-center"><input type="radio" name="@RadioGroupName(current)" checked="@(GetState(current) == PermissionState.Neutral)" @onchange="() => SetState(current, PermissionState.Neutral)" /></td>
                    <td class="text-center"><input type="radio" name="@RadioGroupName(current)" checked="@(GetState(current) == PermissionState.Allow)" @onchange="() => SetState(current, PermissionState.Allow)" /></td>
                    <td class="text-center"><input type="radio" name="@RadioGroupName(current)" checked="@(GetState(current) == PermissionState.Deny)" @onchange="() => SetState(current, PermissionState.Deny)" /></td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary" @onclick="SaveExpectation">@(editingId is null ? "Add" : "Save")</button>
    @if (editingId is not null)
    {
        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
    }

    <h2>Audit</h2>
    <button class="btn btn-primary" disabled="@auditing" @onclick="RunAudit">@(auditing ? "Checking..." : "Run Audit")</button>

    @if (auditResults is not null)
    {
        <table class="table mt-3">
            <thead><tr><th>Channel</th><th>Role</th><th>Status</th><th>Details</th><th></th></tr></thead>
            <tbody>
                @foreach (var result in auditResults)
                {
                    <tr class="@(result.IsMatch ? "table-success" : "table-danger")">
                        <td>@ChannelName(result.Expectation.ChannelId)</td>
                        <td>@RoleName(result.Expectation.RoleId)</td>
                        <td>@(result.IsMatch ? "✅ OK" : "🚫 Mismatch")</td>
                        <td>
                            @if (!result.IsMatch)
                            {
                                @if (result.MissingAllow.Count > 0)
                                {
                                    <div>Missing Allow: @string.Join(", ", result.MissingAllow)</div>
                                }
                                @if (result.ExtraAllow.Count > 0)
                                {
                                    <div>Unexpected Allow: @string.Join(", ", result.ExtraAllow)</div>
                                }
                                @if (result.MissingDeny.Count > 0)
                                {
                                    <div>Missing Deny: @string.Join(", ", result.MissingDeny)</div>
                                }
                                @if (result.ExtraDeny.Count > 0)
                                {
                                    <div>Unexpected Deny: @string.Join(", ", result.ExtraDeny)</div>
                                }
                            }
                        </td>
                        <td>
                            @if (!result.IsMatch)
                            {
                                @if (result.CanFix)
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => FixAsync(result)">Fix</button>
                                }
                                else
                                {
                                    <span class="text-danger">⚠ @result.BlockReason</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</AuthorizedGuildView>

@code {
    private enum PermissionState { Neutral, Allow, Deny }

    private record AuditResult(
        ChannelPermissionExpectation Expectation,
        bool IsMatch,
        List<Permissions> MissingAllow,
        List<Permissions> ExtraAllow,
        List<Permissions> MissingDeny,
        List<Permissions> ExtraDeny,
        bool CanFix,
        string? BlockReason);

    // One configured channel and whether the bot has the permissions it actually needs there.
    // Sources is the human-readable list of what points here; Required is the union of what those
    // uses need (most just post → View + Send; the Announcements draft is read → also Read Message
    // History). ChannelEffective/Category.Effective are the bot's resolved permissions on the
    // channel and its parent category, shown side by side so a sync mismatch is visible.
    private record BotAccessResult(
        ulong ChannelId, ulong? ParentCategoryId, string Sources,
        Permissions Required,
        Permissions ChannelEffective, bool ChannelManage,
        (Permissions Effective, bool Manage)? Category,
        bool CanFix, string? BlockReason)
    {
        public bool CanView => ChannelEffective.HasFlag(Permissions.ViewChannel);
        public Permissions ChannelMissing => Required & ~ChannelEffective;
        public bool HasAccess => ChannelMissing == default;

        // A fix at a given level only works if the bot can both see it and manage its
        // permissions there — Discord 403s an overwrite edit otherwise. So a button is offered
        // only where both hold; anything else needs a manual grant in Discord.
        public bool CanFixChannel => CanView && ChannelManage;

        // Category fix is also pointless when the category already grants everything required: the
        // child is blocked by its own (unsynced) overwrite, so re-granting on the category changes
        // nothing. Only offer it when the category can be managed and is itself still missing part
        // of what's required.
        public bool CanFixCategory => Category is { } cat
            && cat.Manage
            && cat.Effective.HasFlag(Permissions.ViewChannel)
            && (Required & ~cat.Effective) != default;
    }

    private static string Mark(bool granted) => granted ? "✅" : "❌";

    // The bot's messages are branded embeds (EmbedBranding) almost everywhere, and sending or
    // editing a rich embed needs Embed Links — a channel that grants Send but denies Embed Links
    // (common where @everyone is locked down) would pass a View+Send check yet fail at post time.
    private const Permissions PostPermissions = Permissions.ViewChannel | Permissions.SendMessages | Permissions.EmbedLinks;

    // The Announcements draft channel is read (staff post drafts, the bot reads them back to
    // publish) as well as written — View + Send + Read Message History, but no embeds posted there.
    private const Permissions DraftPermissions = Permissions.ViewChannel | Permissions.SendMessages | Permissions.ReadMessageHistory;

    // AiChat listen channels: the bot reads recent messages back (Read Message History — this is
    // what lets it see any content at all) and posts plain-text replies (Send, no embeds). A
    // listen channel missing Read Message History is the classic "the bot stays silent for no
    // obvious reason" case.
    private const Permissions AiChatListenPermissions = Permissions.ViewChannel | Permissions.SendMessages | Permissions.ReadMessageHistory;

    // AiChat knowledge-source channels are only ever read, never posted to — View + Read Message
    // History. (A knowledge entry can also be a whole category; granting these on the category
    // propagates to its synced child channels.)
    private const Permissions AiChatKnowledgePermissions = Permissions.ViewChannel | Permissions.ReadMessageHistory;

    private static readonly Permissions[] AllPermissions = Enum.GetValues<Permissions>();

    private static bool IsManage(Permissions perms) =>
        perms.HasFlag(Permissions.Administrator) || perms.HasFlag(Permissions.ManageRoles);

    private static string PermLabel(Permissions permission) => permission switch
    {
        Permissions.ViewChannel => "View Channel",
        Permissions.SendMessages => "Send Messages",
        Permissions.EmbedLinks => "Embed Links",
        Permissions.ReadMessageHistory => "Read Message History",
        Permissions.AddReactions => "Add Reactions",
        _ => permission.ToString(),
    };

    // Each individual required permission with its granted state, e.g. "✅ View Channel · ❌ Send Messages".
    private static string PermsSummary(Permissions required, Permissions effective) =>
        string.Join(" · ", AllPermissions
            .Where(p => p != default && required.HasFlag(p))
            .Select(p => $"{Mark(effective.HasFlag(p))} {PermLabel(p)}"));

    private List<ChannelPermissionExpectation> expectations = [];
    private List<IGuildChannel> channels = [];
    private List<Role> roles = [];
    private string? discordDataError;

    private int? editingId;
    private string? formChannelIdInput;
    private string? formRoleIdInput;
    private readonly Dictionary<Permissions, PermissionState> formPermissionStates = new();

    private bool auditing;
    private List<AuditResult>? auditResults;

    private bool checkingBotAccess;
    private List<BotAccessResult>? botAccessResults;

    private Dictionary<ulong, Role> allRolesById = [];
    private GuildUser? botMember;
    private Permissions botPermissions;
    private int botHighestRolePosition;
    private int botRolesAbove;
    private int botNonAdminRolesAbove;
    private string? botTopRoleName;
    private ulong botUserId;
    private ulong? botTopRoleId;
    private bool botHasManageRoles => botPermissions.HasFlag(Permissions.Administrator) || botPermissions.HasFlag(Permissions.ManageRoles);

    // Per-channel outcome line from the last Fix, so the escalation (category → re-check →
    // channel) can explain each step in place. Keyed by the configured channel id.
    private readonly Dictionary<ulong, string> fixStatus = [];

    protected override async Task OnAuthorizedParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        expectations = await db.ChannelPermissionExpectations
            .Where(e => e.GuildId == ParsedGuildId)
            .AsNoTracking()
            .ToListAsync();

        await LoadDiscordDataAsync();
        await RunBotAccessCheckAsync();
    }

    private async Task LoadDiscordDataAsync()
    {
        discordDataError = null;
        try
        {
            var guildId = ParsedGuildId;

            channels = await DiscordData.GetChannelsAsync(guildId);

            // GetAllRolesAsync (not the filtered GetRolesAsync) — allRolesById needs @everyone
            // too, for LoadBotStatusAsync's permission/hierarchy math below.
            var allRoles = await DiscordData.GetAllRolesAsync(guildId);
            allRolesById = allRoles.ToDictionary(r => r.Id);
            roles = allRoles.Where(r => r.Id != guildId).ToList();

            await LoadBotStatusAsync(guildId);
        }
        catch (RestException)
        {
            channels = [];
            roles = [];
            discordDataError = "Could not load channels/roles from Discord (is the bot in this guild?)";
        }
    }

    // The bot's effective guild permissions and role hierarchy — used here to know whether the bot
    // can grant a given permission at all, and how high its own role sits. The computation (the
    // @everyone-baseline OR and the roles-above math) lives in DiscordGuildDataService so the
    // Overview's permission card shares exactly one source; this just unpacks the result into the
    // fields the rest of the page reads.
    private async Task LoadBotStatusAsync(ulong guildId)
    {
        botUserId = ulong.Parse(Configuration["Discord:ClientId"]!);
        var status = await DiscordData.GetBotRoleStatusAsync(guildId, botUserId);

        botMember = status.BotMember;
        botPermissions = status.BotPermissions;
        botHighestRolePosition = status.HighestRolePosition;
        botTopRoleId = status.TopRoleId;
        botTopRoleName = status.TopRoleName;
        botRolesAbove = status.RolesAbove;
        botNonAdminRolesAbove = status.NonAdminRolesAbove;
    }

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        VoiceGuildChannel or StageGuildChannel => $"🔊 {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"📋 {channel.Name}",
        _ => $"# {channel.Name}",
    };

    private string ChannelName(ulong id) =>
        channels.FirstOrDefault(c => c.Id == id) is { } channel ? ChannelLabel(channel) : $"⚠ Unbekannt ({id})";

    private string CategoryName(ulong id) =>
        channels.FirstOrDefault(c => c.Id == id)?.Name ?? $"⚠ Unbekannt ({id})";

    private string RoleName(ulong id) =>
        roles.FirstOrDefault(r => r.Id == id)?.Name ?? $"⚠ Unbekannt ({id})";

    private static string PermissionListLabel(Permissions permissions) =>
        permissions == 0 ? "—" : string.Join(", ", AllPermissions.Where(p => permissions.HasFlag(p)));

    private static string RadioGroupName(Permissions permission) => $"perm-{(ulong)permission}";

    private PermissionState GetState(Permissions permission) =>
        formPermissionStates.GetValueOrDefault(permission, PermissionState.Neutral);

    private void SetState(Permissions permission, PermissionState state) =>
        formPermissionStates[permission] = state;

    private void EditExpectation(ChannelPermissionExpectation exp)
    {
        editingId = exp.Id;
        formChannelIdInput = exp.ChannelId.ToString();
        formRoleIdInput = exp.RoleId.ToString();

        formPermissionStates.Clear();
        var allow = (Permissions)exp.Allow;
        var deny = (Permissions)exp.Deny;
        foreach (var permission in AllPermissions)
        {
            if (allow.HasFlag(permission))
                formPermissionStates[permission] = PermissionState.Allow;
            else if (deny.HasFlag(permission))
                formPermissionStates[permission] = PermissionState.Deny;
        }
    }

    private void CancelEdit()
    {
        editingId = null;
        formChannelIdInput = null;
        formRoleIdInput = null;
        formPermissionStates.Clear();
    }

    private async Task SaveExpectation()
    {
        if (!ulong.TryParse(formChannelIdInput, out var channelId) || !ulong.TryParse(formRoleIdInput, out var roleId))
            return;

        ulong allow = 0;
        ulong deny = 0;
        foreach (var (permission, state) in formPermissionStates)
        {
            if (state == PermissionState.Allow)
                allow |= (ulong)permission;
            else if (state == PermissionState.Deny)
                deny |= (ulong)permission;
        }

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            if (editingId is { } id)
            {
                var existing = await db.ChannelPermissionExpectations.FirstAsync(e => e.Id == id);
                existing.ChannelId = channelId;
                existing.RoleId = roleId;
                existing.Allow = allow;
                existing.Deny = deny;
            }
            else
            {
                db.ChannelPermissionExpectations.Add(new ChannelPermissionExpectation
                {
                    GuildId = ParsedGuildId,
                    ChannelId = channelId,
                    RoleId = roleId,
                    Allow = allow,
                    Deny = deny,
                });
            }

            await db.SaveChangesAsync();
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteExpectation(ChannelPermissionExpectation exp)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.ChannelPermissionExpectations.Remove(exp);
            await db.SaveChangesAsync();
        }

        await LoadAsync();
    }

    private async Task RunAudit()
    {
        auditing = true;
        auditResults = null;
        try
        {
            var results = new List<AuditResult>();
            foreach (var expectation in expectations)
            {
                var channel = channels.FirstOrDefault(c => c.Id == expectation.ChannelId);

                PermissionOverwrite? overwrite = channel is not null && channel.PermissionOverwrites.TryGetValue(expectation.RoleId, out var found)
                    ? found
                    : null;

                var actualAllow = overwrite?.Allowed ?? default;
                var actualDeny = overwrite?.Denied ?? default;
                var expectedAllow = (Permissions)expectation.Allow;
                var expectedDeny = (Permissions)expectation.Deny;

                var missingAllow = AllPermissions.Where(p => expectedAllow.HasFlag(p) && !actualAllow.HasFlag(p)).ToList();
                var extraAllow = AllPermissions.Where(p => actualAllow.HasFlag(p) && !expectedAllow.HasFlag(p)).ToList();
                var missingDeny = AllPermissions.Where(p => expectedDeny.HasFlag(p) && !actualDeny.HasFlag(p)).ToList();
                var extraDeny = AllPermissions.Where(p => actualDeny.HasFlag(p) && !expectedDeny.HasFlag(p)).ToList();

                var isMatch = missingAllow.Count == 0 && extraAllow.Count == 0 && missingDeny.Count == 0 && extraDeny.Count == 0;
                var (canFix, blockReason) = isMatch ? (true, null) : EvaluateFixability(expectation);
                results.Add(new AuditResult(expectation, isMatch, missingAllow, extraAllow, missingDeny, extraDeny, canFix, blockReason));
            }

            auditResults = results;
        }
        finally
        {
            auditing = false;
        }
    }

    // Mirrors Discord's own rules for editing a channel permission overwrite: the bot
    // needs Manage Roles at all, its own highest role must outrank the role being
    // configured, and — unless it has Administrator — it can only Allow a permission it
    // already holds itself. Any of these failing makes "Fix" a guaranteed 403, so it's
    // checked here instead of just letting the API call fail.
    private (bool CanFix, string? Reason) EvaluateFixability(ChannelPermissionExpectation expectation)
    {
        if (!botHasManageRoles)
            return (false, "Bot lacks Manage Roles permission in this server.");

        if (botPermissions.HasFlag(Permissions.Administrator))
            return (true, null);

        if (allRolesById.TryGetValue(expectation.RoleId, out var targetRole) && targetRole.RawPosition >= botHighestRolePosition)
            return (false, $"Bot's role ({botTopRoleName}) doesn't outrank {targetRole.Name} — move the bot's role higher.");

        var expectedAllow = (Permissions)expectation.Allow;
        var ungrantable = AllPermissions.Where(p => expectedAllow.HasFlag(p) && !botPermissions.HasFlag(p)).ToList();
        if (ungrantable.Count > 0)
            return (false, $"Bot doesn't hold these permissions itself, so it can't grant them: {string.Join(", ", ungrantable)}.");

        return (true, null);
    }

    // Every channel the bot is configured to post to (feature channel lists, alert channel
    // rows, and the guild-wide GuildSettings slots), audited for the bot's own View Channel +
    // Send Messages access — the check that would have surfaced the "message only reached one
    // channel" ClientRelease case (a second channel the bot silently couldn't post to).
    // Manual re-check clears the per-fix outcome lines for a fresh look; auto-run and post-fix
    // re-checks call RunBotAccessCheckAsync directly so their status lines survive. Crucially it
    // reloads live channel/role data first (evicting the 60s Discord cache) so a permission the
    // admin just changed in Discord is actually picked up — recomputing against the stale
    // in-memory list is exactly the "Re-check didn't reflect my change" symptom.
    private async Task ReCheckBotAccessAsync()
    {
        fixStatus.Clear();
        DiscordData.InvalidateCache(ParsedGuildId);
        await LoadDiscordDataAsync();
        await RunBotAccessCheckAsync();
    }

    // The read-only knowledge buckets (AiChatKnowledge is the Normal tier); a configured entry here
    // may be a whole category that the bot expands to its child channels at read time.
    private static bool IsKnowledgeFeature(GuildFeature feature) => feature is
        GuildFeature.AiChatKnowledge or GuildFeature.AiChatKnowledgePreferred or GuildFeature.AiChatKnowledgeLastResort;

    private async Task RunBotAccessCheckAsync()
    {
        checkingBotAccess = true;
        botAccessResults = null;
        try
        {
            var sources = new Dictionary<ulong, SortedSet<string>>();
            var required = new Dictionary<ulong, Permissions>();
            void Add(ulong? id, string label, Permissions perms)
            {
                if (id is not { } channelId || channelId == 0)
                    return;
                if (!sources.TryGetValue(channelId, out var set))
                    sources[channelId] = set = [];
                set.Add(label);
                required[channelId] = required.GetValueOrDefault(channelId) | perms;
            }

            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                var featureChannels = await db.GuildFeatureChannels
                    .Where(c => c.GuildId == ParsedGuildId)
                    .Select(c => new { c.ChannelId, c.Feature })
                    .ToListAsync();
                foreach (var fc in featureChannels)
                {
                    // Most features post embeds; AiChat instead reads message history (and, for
                    // its listen channels, posts plain-text replies) — so it needs Read Message
                    // History rather than Embed Links. All three knowledge buckets are read-only.
                    var perms = fc.Feature switch
                    {
                        GuildFeature.AiChat => AiChatListenPermissions,
                        GuildFeature.AiChatKnowledge
                            or GuildFeature.AiChatKnowledgePreferred
                            or GuildFeature.AiChatKnowledgeLastResort => AiChatKnowledgePermissions,
                        _ => PostPermissions,
                    };
                    var label = $"Feature: {fc.Feature}";

                    // A knowledge entry can be a whole category; the bot reads its child channels
                    // (AiChatIndexService.ResolveSourcesAsync), not the category node — so expand a
                    // configured category to the children the bot would actually read (text + forum;
                    // skip voice/stage/nested categories) and check each. Forum children are checked
                    // at the forum level, since threads inherit the forum's read permissions.
                    if (IsKnowledgeFeature(fc.Feature)
                        && channels.FirstOrDefault(c => c.Id == fc.ChannelId) is CategoryGuildChannel category)
                    {
                        foreach (var child in channels.Where(c =>
                            DiscordGuildDataService.GetParentCategoryId(c) == category.Id
                            && c is TextGuildChannel or ForumGuildChannel))
                        {
                            Add(child.Id, $"{label} (category {category.Name})", perms);
                        }
                    }
                    else
                    {
                        Add(fc.ChannelId, label, perms);
                    }
                }

                var alertChannels = await db.GuildAlertChannels
                    .Where(c => c.GuildId == ParsedGuildId)
                    .Select(c => new { c.ChannelId, c.Kind })
                    .ToListAsync();
                foreach (var ac in alertChannels)
                    Add(ac.ChannelId, $"Alert: {ac.Kind}", PostPermissions);

                // Per-feature channel settings (Absences report channels, Territory Capture
                // digest, Announcements/Tickets/etc.) live in the generic settings table, not a
                // dedicated channel table — by convention every channel-typed key ends in
                // "Channel" (role keys end in "Role", message-id keys in "MessageId"), so that's
                // how we tell a channel value apart from the roles stored alongside it. Most are
                // post targets; the Announcements draft is also read back by the bot, so it needs
                // Read Message History on top of View + Send.
                var settingChannels = await db.GuildFeatureSettingSnowflakes
                    .Where(s => s.GuildId == ParsedGuildId && s.Key.EndsWith("Channel"))
                    .Select(s => new { s.Feature, s.Key, s.Value })
                    .ToListAsync();
                foreach (var sc in settingChannels)
                {
                    var perms = sc is { Feature: GuildFeature.Announcements, Key: AnnouncementsSettingKeys.DraftChannel }
                        ? DraftPermissions
                        : PostPermissions;
                    Add(sc.Value, $"Feature: {sc.Feature} ({sc.Key})", perms);
                }

                var settings = await db.GuildSettings.AsNoTracking().FirstOrDefaultAsync(s => s.GuildId == ParsedGuildId);
                if (settings is not null)
                {
                    Add(settings.LogChannelId, "Log", PostPermissions);
                    Add(settings.AdminChannelId, "Admin", PostPermissions);
                    Add(settings.UserLogChannelId, "User Log", PostPermissions);
                }

                // Alliance-scoped channels + Command Bridge now live per linked alliance.
                var allianceChannels = await db.GuildAlliances
                    .Where(a => a.GuildId == ParsedGuildId)
                    .Include(a => a.StfcAlliance)
                    .ToListAsync();
                foreach (var a in allianceChannels)
                {
                    var tag = a.StfcAlliance.Tag;
                    Add(a.AllianceBoardingChannelId, $"[{tag}] Alliance Boarding", PostPermissions);
                    Add(a.CommandBridgeChannelId, $"[{tag}] Command Bridge", PostPermissions);
                    Add(a.StaffCommandBridgeChannelId, $"[{tag}] Staff Command Bridge", PostPermissions);
                    Add(a.FriendsCommandBridgeChannelId, $"[{tag}] Friends Command Bridge", PostPermissions);
                    Add(a.RemindersAlliesChannelId, $"[{tag}] Reminders (Allies)", PostPermissions);
                    // Reminders (Services) moved to the TerritoryCapture feature settings (ServicesChannel);
                    // the generic per-feature-Channel loop above already covers it.
                    Add(a.RulesDeChannelId, $"[{tag}] Rules (DE)", PostPermissions);
                    Add(a.RulesEnChannelId, $"[{tag}] Rules (EN)", PostPermissions);
                    Add(a.UserNotificationsChannelId, $"[{tag}] User Notifications", PostPermissions);
                    Add(a.BotSupportChannelId, $"[{tag}] Bot Support", PostPermissions);
                    Add(a.CommandStaffJobsChannelId, $"[{tag}] Command Staff Jobs", PostPermissions);
                }
            }

            var results = new List<BotAccessResult>();
            foreach (var (channelId, labels) in sources)
            {
                var sourceLabel = string.Join(", ", labels);
                var req = required[channelId];
                var channel = channels.FirstOrDefault(c => c.Id == channelId);
                if (channel is null)
                {
                    // Configured but not present in the live channel list — deleted, or the bot
                    // can't even see it. Either way it's undeliverable and not auto-fixable here.
                    results.Add(new BotAccessResult(channelId, null, sourceLabel, req, default, false, null, false, "Channel not found in this guild (deleted, or not visible to the bot)."));
                    continue;
                }

                var parentCategoryId = DiscordGuildDataService.GetParentCategoryId(channel);
                var channelEffective = BotChannelPermissions(channel);

                (Permissions Effective, bool Manage)? category = null;
                if (parentCategoryId is { } catId && channels.FirstOrDefault(c => c.Id == catId) is { } categoryChannel)
                {
                    var categoryEffective = BotChannelPermissions(categoryChannel);
                    category = (categoryEffective, IsManage(categoryEffective));
                }

                var hasAccess = (req & ~channelEffective) == default;
                var (canFix, blockReason) = hasAccess ? (true, (string?)null) : EvaluateBotAccessFixability(req);
                results.Add(new BotAccessResult(channelId, parentCategoryId, sourceLabel, req, channelEffective, IsManage(channelEffective), category, canFix, blockReason));
            }

            // Problems first, then alphabetically by what points at the channel.
            botAccessResults = results.OrderBy(r => r.HasAccess).ThenBy(r => r.Sources, StringComparer.OrdinalIgnoreCase).ToList();
        }
        finally
        {
            checkingBotAccess = false;
        }
    }

    // Effective channel permissions for the bot, via NetCord's own resolver (base guild perms +
    // the channel's @everyone/role/member overwrites, Administrator bypassing all). A channel
    // synced with its category already carries the category's overwrites on itself, so this one
    // channel-scoped call reflects the true result without walking to the parent.
    private Permissions BotChannelPermissions(IGuildChannel channel) =>
        botMember?.GetChannelPermissions(botPermissions, channel) ?? botPermissions;

    // The Fix grants the bot's own top role the required permissions via a channel overwrite,
    // so the same guardrails as EvaluateFixability apply: needs Manage Roles, and (unless
    // Administrator) can only grant permissions the bot already holds itself.
    private (bool CanFix, string? Reason) EvaluateBotAccessFixability(Permissions required)
    {
        if (!botHasManageRoles)
            return (false, "Bot lacks Manage Roles permission in this server.");

        if (botPermissions.HasFlag(Permissions.Administrator))
            return (true, null);

        if (botTopRoleId is null)
            return (false, "Bot has no assignable role to grant a channel override to.");

        var missing = AllPermissions
            .Where(p => p != default && required.HasFlag(p) && !botPermissions.HasFlag(p))
            .Select(PermLabel)
            .ToList();
        if (missing.Count > 0)
            return (false, $"Bot doesn't hold these permissions itself, so it can't grant them: {string.Join(", ", missing)}.");

        return (true, null);
    }

    // One fix step. targetId is either the channel itself or its parent category: a category
    // grant fixes every channel under it that syncs its permissions in one go, a channel grant
    // touches only that channel. After applying, this re-reads live permissions and reports
    // whether the bot can now post — so the admin can escalate step by step (fix the category,
    // re-check, and only drop to the channel level if that channel doesn't sync).
    private async Task FixBotAccessAsync(BotAccessResult result, ulong targetId, bool viaCategory)
    {
        if (botTopRoleId is not { } roleId)
            return;

        // Preserve any existing overwrite for the bot's role on the target; only add the
        // required permissions to Allow and clear them from Deny.
        Permissions existingAllow = default, existingDeny = default;
        if (channels.FirstOrDefault(c => c.Id == targetId) is { } target
            && target.PermissionOverwrites.TryGetValue(roleId, out var overwrite))
        {
            existingAllow = overwrite.Allowed;
            existingDeny = overwrite.Denied;
        }

        try
        {
            await BotRestClient.ModifyGuildChannelPermissionsAsync(targetId,
                new PermissionOverwriteProperties(roleId, PermissionOverwriteType.Role)
                {
                    Allowed = existingAllow | result.Required,
                    Denied = existingDeny & ~result.Required,
                });

            Cache.Remove($"discord-guild-channels:{ParsedGuildId}");
            await LoadDiscordDataAsync();

            var channelNow = channels.FirstOrDefault(c => c.Id == result.ChannelId);
            var effectiveNow = channelNow is null ? default : BotChannelPermissions(channelNow);
            var viewNow = effectiveNow.HasFlag(Permissions.ViewChannel);
            var hasAccessNow = (result.Required & ~effectiveNow) == default;
            fixStatus[result.ChannelId] = (viaCategory, hasAccessNow, viewNow) switch
            {
                (_, true, _) => viaCategory
                    ? "✅ Fixed via the category — the bot now has the access it needs here."
                    : "✅ Fixed on the channel — the bot now has the access it needs here.",
                (true, false, true) => "Category updated, but the channel is still missing some of what it needs — use \"Fix on channel\".",
                (true, false, false) => "⚠ Category updated, but this channel doesn't inherit from it (its permissions aren't synced). A channel the bot can't see can't be fixed automatically — grant Hoshi Bot access to it manually in Discord.",
                (false, false, _) => "⚠ Overwrite applied on the channel, but the bot still lacks the required access. Check that its role isn't out-ranked and that another overwrite doesn't deny the needed permissions.",
            };

            await RunBotAccessCheckAsync();
        }
        catch (RestException ex)
        {
            var level = viaCategory ? "category" : "channel";
            var targetChannel = channels.FirstOrDefault(c => c.Id == targetId);
            var canSeeTarget = targetChannel is not null && BotChannelPermissions(targetChannel).HasFlag(Permissions.ViewChannel);
            fixStatus[result.ChannelId] = ex.StatusCode == HttpStatusCode.Forbidden
                ? canSeeTarget
                    ? $"⚠ Discord refused the change — the bot can see this {level} but isn't allowed to change its permissions here (it needs the Manage Permissions right on it). Grant Hoshi Bot access to this {level} manually in Discord."
                    : $"⚠ Discord refused the change (Missing Access) — the bot can't edit a {level} it can't see. Grant Hoshi Bot access to it manually in Discord."
                : $"⚠ Discord rejected the change ({ex.StatusCode}). Check the bot's Manage Roles permission and role position.";
        }
    }

    private async Task FixAsync(AuditResult result)
    {
        var expectation = result.Expectation;
        try
        {
            await BotRestClient.ModifyGuildChannelPermissionsAsync(expectation.ChannelId,
                new PermissionOverwriteProperties(expectation.RoleId, PermissionOverwriteType.Role)
                {
                    Allowed = (Permissions)expectation.Allow,
                    Denied = (Permissions)expectation.Deny,
                });

            Cache.Remove($"discord-guild-channels:{ParsedGuildId}");
            await LoadDiscordDataAsync();
            await RunAudit();
        }
        catch (RestException)
        {
            discordDataError = "Could not update the permission overwrite on Discord — does the bot have Manage Roles/Manage Channels permission in this server?";
        }
    }
}
