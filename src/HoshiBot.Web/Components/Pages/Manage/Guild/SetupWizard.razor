@page "/manage/guild/{GuildId}/setup-wizard"
@inherits GuildAdminPageBase
@using HoshiBot.Web.Services
@using Microsoft.Extensions.Caching.Memory
@using NetCord
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject DiscordGuildDataService DiscordData
@inject GuildAllianceService AllianceService
@inject IMemoryCache Cache

<PageTitle>Guild Setup Wizard</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>Setup Wizard</h1>
    <p class="text-muted">Step @DisplayStepNumber of @VisibleSteps.Count — @AllSteps[step].Title. Every step is optional; you can always adjust things later via Scope/Settings, or per-feature via Features.</p>

    @if (step == 0)
    {
        <h2>Welcome</h2>
        <p>This wizard walks you through the essentials for a new guild: which audience it serves, linking your alliance(s)/server(s), a few core channels/roles, and making sure someone besides the server owner can manage the bot.</p>
        <p>Nothing here is mandatory — skip anything and configure it later. Turning individual features on/off now happens from Features, not this wizard.</p>
    }
    else if (step == 1)
    {
        <h2>Audience</h2>
        <p>Which audience(s) this guild serves — drives which of this wizard's later steps are relevant, and how the Features page groups its feature cards. Doesn't restrict which features can be enabled.</p>
        <AudienceEditor GuildId="ParsedGuildId" AudienceChanged="OnAudienceChanged" ShowConfigureButton="false" />
    }
    else if (step == 2)
    {
        <h2>Scope</h2>
        <p>Which shared alliances, servers, and veil groups this guild tracks.</p>
        <ScopeAccordion GuildId="ParsedGuildId" Audiences="@audiences" />
    }
    else if (step == 3)
    {
        <h2>Core channels &amp; roles</h2>
        <p>A curated subset most guilds need right away — the full list is on the <a href="manage/guild/@GuildId/settings">Settings page</a>, editable any time.</p>
        <p>Leave any field below empty to have Hoshi Bot create it for you.</p>

        @if (discordDataError is not null)
        {
            <p class="text-danger">@discordDataError</p>
        }
        @if (createError is not null)
        {
            <p class="text-danger">@createError</p>
        }

        @if (creating)
        {
            <p class="text-muted">Creating anything left blank on Discord...</p>
        }

        <div class="mb-3">
            <label>Channel group for anything created below</label>
            <select class="form-select d-inline-block w-auto" @bind="selectedCategoryIdInput">
                <option value="">— none / server root —</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <span class="mx-1">or</span>
            <input type="text" class="form-control d-inline-block w-auto" @bind="newCategoryNameInput" placeholder="create a new group named..." />
        </div>
        <div class="mb-2">
            <label>Log Channel</label>
            <select class="form-select" @bind="logChannelIdInput">
                <option value="">— create automatically —</option>
                @if (IsUnknownChannel(logChannelIdInput))
                {
                    <option value="@logChannelIdInput" selected>⚠ Unbekannt (@logChannelIdInput)</option>
                }
                @foreach (var group in NormalChannelGroups)
                {
                    @if (group.Category is not null)
                    {
                        <optgroup label="@group.Category.Name">
                            @foreach (var channel in group.Channels)
                            {
                                <option value="@channel.Id">@ChannelLabel(channel)</option>
                            }
                        </optgroup>
                    }
                    else
                    {
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label>Admin Channel</label>
            <select class="form-select" @bind="adminChannelIdInput">
                <option value="">— create automatically —</option>
                @if (IsUnknownChannel(adminChannelIdInput))
                {
                    <option value="@adminChannelIdInput" selected>⚠ Unbekannt (@adminChannelIdInput)</option>
                }
                @foreach (var group in NormalChannelGroups)
                {
                    @if (group.Category is not null)
                    {
                        <optgroup label="@group.Category.Name">
                            @foreach (var channel in group.Channels)
                            {
                                <option value="@channel.Id">@ChannelLabel(channel)</option>
                            }
                        </optgroup>
                    }
                    else
                    {
                        @foreach (var channel in group.Channels)
                        {
                            <option value="@channel.Id">@ChannelLabel(channel)</option>
                        }
                    }
                }
            </select>
        </div>
        <div class="mb-2">
            <label>Member Role</label>
            <select class="form-select" @bind="memberRoleIdInput">
                <option value="">— create automatically —</option>
                @if (IsUnknownRole(memberRoleIdInput))
                {
                    <option value="@memberRoleIdInput" selected>⚠ Unbekannt (@memberRoleIdInput)</option>
                }
                @foreach (var role in roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </div>
        <div class="mb-2">
            <label>Command Staff Role</label>
            <select class="form-select" @bind="commandStaffRoleIdInput">
                <option value="">— create automatically —</option>
                @if (IsUnknownRole(commandStaffRoleIdInput))
                {
                    <option value="@commandStaffRoleIdInput" selected>⚠ Unbekannt (@commandStaffRoleIdInput)</option>
                }
                @foreach (var role in roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
        </div>
    }
    else if (step == 4)
    {
        <h2>Admin access</h2>
        <p>Members holding any of these roles can manage this guild's Hoshi Bot settings even without Discord's "Manage Server" permission — so setup doesn't leave the server owner as the only possible admin.</p>

        <table class="table">
            <thead><tr><th>Role</th><th></th></tr></thead>
            <tbody>
                @foreach (var adminRole in guildAdminRoles)
                {
                    <tr>
                        <td>@RoleName(adminRole.DiscordRoleId)</td>
                        <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteAdminRoleAsync(adminRole)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>

        <EditForm Model="this" FormName="setup-add-admin-role" OnValidSubmit="AddAdminRoleAsync">
            <select class="form-select d-inline-block w-auto" @bind="newAdminRoleIdInput">
                <option value="">— select role —</option>
                @foreach (var role in roles)
                {
                    <option value="@role.Id">@role.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Add</button>
        </EditForm>
    }
    else if (step == 5)
    {
        <h2>Review &amp; finish</h2>
        <p>Audience: <strong>@(audiences == GuildAudience.None ? "not set" : audiences.ToString())</strong></p>
        <p>Alliances/servers/veil groups linked: <strong>@(guildAllianceCount + guildServerCount + guildVeilGroupCount)</strong></p>
        <p>Admin roles configured: <strong>@guildAdminRoles.Count</strong></p>
        <p>
            Anything left unset here just stays editable later via Scope/Settings —
            finishing doesn't require completing every step. Turning individual features
            on/off, and their own channel/role settings, happens from Features.
        </p>
        <button class="btn btn-success" @onclick="FinishAsync">Finish setup</button>
    }

    <div class="mt-3">
        @if (step > 0)
        {
            <button class="btn btn-secondary" disabled="@creating" @onclick="Back">Back</button>
        }
        @if (step < 5)
        {
            <button class="btn btn-primary" disabled="@creating" @onclick="Next">@(creating ? "Saving..." : "Next")</button>
        }
    </div>
</AuthorizedGuildView>

@code {
    private static readonly (int Step, string Title)[] AllSteps =
    [
        (0, "Welcome"),
        (1, "Audience"),
        (2, "Scope"),
        (3, "Core channels & roles"),
        (4, "Admin access"),
        (5, "Review & finish"),
    ];

    private int step;
    private GuildSettings settings = new();
    private GuildAudience audiences;
    private List<GuildAdminRole> guildAdminRoles = [];
    private List<IGuildChannel> channels = [];
    private List<CategoryGuildChannel> categories = [];
    private List<Role> roles = [];
    private string? discordDataError;
    private string? createError;
    private bool creating;
    private string? selectedCategoryIdInput;
    private string? newCategoryNameInput;
    private string? logChannelIdInput;
    private string? adminChannelIdInput;
    private string? memberRoleIdInput;
    private string? commandStaffRoleIdInput;
    private string? newAdminRoleIdInput;
    private int guildAllianceCount;
    private int guildServerCount;
    private int guildVeilGroupCount;

    protected override async Task OnAuthorizedParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var guildId = ParsedGuildId;

        await using var db = await DbFactory.CreateDbContextAsync();

        settings = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == guildId) ?? new GuildSettings { GuildId = guildId };
        audiences = settings.Audiences;
        guildAdminRoles = await db.GuildAdminRoles.Where(r => r.GuildId == guildId).AsNoTracking().ToListAsync();

        logChannelIdInput = settings.LogChannelId?.ToString();
        adminChannelIdInput = settings.AdminChannelId?.ToString();
        commandStaffRoleIdInput = settings.CommandStaffRoleId?.ToString();

        // Member role + default channel category are now per-alliance (GuildAlliance) — load the
        // primary alliance's values if one is linked yet (may not be, this early in setup).
        var primaryAlliance = await AllianceService.GetPrimaryAsync(guildId);
        memberRoleIdInput = primaryAlliance?.MemberRoleId?.ToString();
        selectedCategoryIdInput = primaryAlliance?.DefaultChannelCategoryId?.ToString();

        guildAllianceCount = await db.GuildAlliances.CountAsync(g => g.GuildId == guildId);
        guildServerCount = await db.GuildServers.CountAsync(g => g.GuildId == guildId);
        guildVeilGroupCount = await db.GuildVeilGroups.CountAsync(g => g.GuildId == guildId);

        await LoadDiscordDataAsync();
    }

    private async Task LoadDiscordDataAsync()
    {
        discordDataError = null;
        try
        {
            var guildId = ParsedGuildId;
            channels = await DiscordData.GetChannelsAsync(guildId);
            categories = await DiscordData.GetCategoriesAsync(guildId);
            roles = await DiscordData.GetRolesAsync(guildId);
        }
        catch (RestException)
        {
            channels = [];
            categories = [];
            roles = [];
            discordDataError = "Could not load channels/roles from Discord (is the bot in this guild?)";
        }
    }

    private static string ChannelLabel(IGuildChannel channel) => channel switch
    {
        VoiceGuildChannel or StageGuildChannel => $"🔊 {channel.Name}",
        ForumGuildChannel or MediaForumGuildChannel => $"📋 {channel.Name}",
        _ => $"# {channel.Name}",
    };

    private string RoleName(ulong id) =>
        roles.FirstOrDefault(r => r.Id == id)?.Name ?? $"⚠ Unbekannt ({id})";

    private bool IsUnknownChannel(string? current) =>
        !string.IsNullOrEmpty(current) && ulong.TryParse(current, out var id) && !channels.Any(c => c.Id == id);

    // Log/Admin Channel both just get a plain SendMessageAsync-style post — Normal is right
    // for both, same as every other ChannelPicker-based setting's default.
    private List<ChannelGroup> NormalChannelGroups =>
        DiscordGuildDataService.GroupChannelsForDisplay(channels
                .Where(c => c is CategoryGuildChannel || DiscordGuildDataService.IsAllowedChannel(c, ChannelKind.Normal))
                .ToList())
            .Where(g => g.Channels.Count > 0)
            .ToList();

    private bool IsUnknownRole(string? current) =>
        !string.IsNullOrEmpty(current) && ulong.TryParse(current, out var id) && !roles.Any(r => r.Id == id);

    private void OnAudienceChanged(GuildAudience newAudiences) => audiences = newAudiences;

    // Scope has nothing to link for a guild that's Community-only by definition — skip it
    // in that case. Any other audience (including "not decided yet") keeps it visible.
    private bool SkipScope => audiences == GuildAudience.Community;

    private IReadOnlyList<(int Step, string Title)> VisibleSteps =>
        SkipScope ? AllSteps.Where(s => s.Step != 2).ToList() : AllSteps;

    private int DisplayStepNumber => VisibleSteps.ToList().FindIndex(s => s.Step == step) + 1;

    // Any of the four fields left blank gets created on Discord instead of just being
    // saved as null — a new group/category first (or the selected existing one), then
    // channels/roles under/using it, so a brand-new guild doesn't need everything
    // pre-created by hand before it can finish this step. Returns false (and leaves
    // createError set) on failure, so Next/Back know not to advance the step.
    private async Task<bool> SaveCoreSettingsAsync()
    {
        createError = null;
        creating = true;
        try
        {
            var guildId = ParsedGuildId;

            ulong? categoryId = null;
            if (!string.IsNullOrWhiteSpace(newCategoryNameInput))
            {
                categoryId = await DiscordData.CreateCategoryAsync(guildId, newCategoryNameInput.Trim());
            }
            else if (ulong.TryParse(selectedCategoryIdInput, out var existingCategoryId))
            {
                categoryId = existingCategoryId;
            }

            var logId = await DiscordData.EnsureChannelAsync(guildId, logChannelIdInput, "log", categoryId);
            var adminId = await DiscordData.EnsureChannelAsync(guildId, adminChannelIdInput, "admin", categoryId);
            var memberId = await DiscordData.EnsureRoleAsync(guildId, memberRoleIdInput, "Member", alwaysCreateIfBlank: true);
            var staffId = await DiscordData.EnsureRoleAsync(guildId, commandStaffRoleIdInput, "Command Staff", alwaysCreateIfBlank: true);

            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                var existing = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == guildId);
                if (existing is null)
                {
                    existing = new GuildSettings { GuildId = guildId };
                    db.GuildSettings.Add(existing);
                }

                existing.LogChannelId = logId;
                existing.AdminChannelId = adminId;
                existing.CommandStaffRoleId = staffId;

                // Member role + default channel category are per-alliance now — write them to the
                // guild's primary alliance if one is linked. If not (brand-new guild, before the
                // Scope step), the created role/category still exist on Discord; assign them on the
                // alliance's Settings page once an alliance is linked.
                var primaryAlliance = await db.GuildAlliances
                    .Where(a => a.GuildId == guildId).OrderBy(a => a.Id).FirstOrDefaultAsync();
                if (primaryAlliance is not null)
                {
                    primaryAlliance.MemberRoleId = memberId;
                    primaryAlliance.DefaultChannelCategoryId = categoryId;
                }

                await db.SaveChangesAsync();
                settings = existing;
            }

            logChannelIdInput = logId?.ToString();
            adminChannelIdInput = adminId?.ToString();
            memberRoleIdInput = memberId?.ToString();
            commandStaffRoleIdInput = staffId?.ToString();
            newCategoryNameInput = null;
            selectedCategoryIdInput = categoryId?.ToString();

            // DiscordGuildDataService's Create*/EnsureRoleAsync/EnsureChannelAsync calls above
            // already invalidate the 60s Discord-data cache whenever they actually create/
            // modify something — this just re-reads it so the wizard's own state (and the
            // Admin Access step's role dropdown) reflects it immediately.
            await LoadDiscordDataAsync();

            return true;
        }
        catch (RestException)
        {
            createError = "Could not create a channel/role on Discord — does the bot have Manage Channels/Manage Roles permission in this server?";
            return false;
        }
        finally
        {
            creating = false;
        }
    }

    private async Task AddAdminRoleAsync()
    {
        if (!ulong.TryParse(newAdminRoleIdInput, out var roleId))
            return;

        if (guildAdminRoles.Any(r => r.DiscordRoleId == roleId))
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAdminRoles.Add(new GuildAdminRole { GuildId = ParsedGuildId, DiscordRoleId = roleId });
        await db.SaveChangesAsync();
        newAdminRoleIdInput = null;
        guildAdminRoles = await db.GuildAdminRoles.Where(r => r.GuildId == ParsedGuildId).AsNoTracking().ToListAsync();
        // GuildAdminHandler caches this list for 60s (discord-guild-admin-roles:{guildId})
        // — invalidate so a newly-granted admin role takes effect immediately.
        Cache.Remove($"discord-guild-admin-roles:{ParsedGuildId}");
    }

    private async Task DeleteAdminRoleAsync(GuildAdminRole adminRole)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.GuildAdminRoles.Remove(adminRole);
        await db.SaveChangesAsync();
        guildAdminRoles = await db.GuildAdminRoles.Where(r => r.GuildId == ParsedGuildId).AsNoTracking().ToListAsync();
        Cache.Remove($"discord-guild-admin-roles:{ParsedGuildId}");
    }

    // The Core-settings step (3) has no separate Save button — leaving it in either
    // direction runs SaveCoreSettingsAsync (including its create-if-missing Discord
    // calls) first, and a failure (e.g. missing Discord permission) keeps the step in
    // place with createError shown rather than silently discarding what was entered.
    private async Task<bool> LeaveCurrentStepAsync() =>
        step != 3 || await SaveCoreSettingsAsync();

    private async Task Back()
    {
        if (step <= 0 || !await LeaveCurrentStepAsync())
            return;

        var newStep = step - 1;
        if (newStep == 2 && SkipScope)
            newStep--;
        step = newStep;
    }

    private async Task Next()
    {
        if (step >= 5 || !await LeaveCurrentStepAsync())
            return;

        var newStep = step + 1;
        if (newStep == 2 && SkipScope)
            newStep++;
        step = newStep;
    }

    private async Task FinishAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildSettings.FirstOrDefaultAsync(s => s.GuildId == ParsedGuildId);
        if (existing is null)
        {
            existing = new GuildSettings { GuildId = ParsedGuildId };
            db.GuildSettings.Add(existing);
        }

        existing.SetupCompletedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();

        Nav.NavigateTo($"manage/guild/{ParsedGuildId}");
    }
}
