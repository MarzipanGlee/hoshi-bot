@page "/manage/guild/{GuildId}"
@inherits GuildAdminPageBase
@using NetCord.Rest
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject GuildFeatureService FeatureService
@inject GuildAllianceService AllianceService
@inject CurrentAllianceContext AllianceContext
@inject DiscordGuildDataService DiscordData
@inject IConfiguration Configuration

<PageTitle>@(guildName ?? Msg.WebNav.GuildGroup(Lang))</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    <h1>@guildName</h1>

    <div class="card-grid">
        @foreach (var p in GuildAdminPages.All.Where(x => x.ShowOnOverviewCard))
        {
            <NavCard Href="@GuildAdminPages.Href(ParsedGuildId, p)" Icon="@p.Icon" Title="@p.Label(Lang)" Subtitle="@CardSubtitle(p)" />
        }
    </div>

    @if (links.Count > 0)
    {
        <h2 class="fs-5 fw-semibold mb-2">@Msg.WebGuild.Alliances(Lang)</h2>
        <p class="mb-3 card-subtext">@Msg.WebGuild.AlliancesLead(Lang)</p>
        <div class="card-grid">
            @foreach (var link in links)
            {
                <AllianceCard Link="link" EnabledCount="allianceEnabledCounts.GetValueOrDefault(link.Id)" TotalCount="allianceFeatureTotal"
                              OnOpen="() => OpenAllianceAsync(link.Id)" />
            }
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private string? guildName;
    private string? audienceSummary;
    private string? botStatusSummary;
    private bool setupComplete;
    private int enabledCount;
    private int totalCount;
    private List<GuildAlliance> links = [];
    private Dictionary<int, int> allianceEnabledCounts = new();
    private int allianceFeatureTotal;

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        links = await AllianceService.GetLinksAsync(ParsedGuildId);

        var allianceRelevantFeatures = FeatureCatalog.RelevantTo(GuildAudience.Alliance);
        allianceFeatureTotal = allianceRelevantFeatures.Count;
        allianceEnabledCounts = (await FeatureService.GetEnabledAsync(ParsedGuildId))
            .Where(s => s.Audience == GuildAudience.Alliance && s.GuildAllianceId is not null && allianceRelevantFeatures.Contains(s.Feature))
            .GroupBy(s => s.GuildAllianceId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        await using var db = await DbFactory.CreateDbContextAsync();
        guildName = await db.DiscordGuilds
            .Where(g => g.Id == ParsedGuildId)
            .Select(g => g.Name)
            .FirstOrDefaultAsync();

        var settings = await db.GuildSettings.Where(s => s.GuildId == ParsedGuildId).FirstOrDefaultAsync();
        var guildAudiences = settings?.Audiences ?? GuildAudience.None;
        setupComplete = settings?.SetupCompletedAt is not null;
        audienceSummary = guildAudiences == GuildAudience.None
            ? Msg.WebGuild.NotConfiguredYet(Lang)
            : string.Join(", ", AudienceDisplay.Labels(Lang, guildAudiences));

        // The top "Features" card links to the guild-wide features page (the bare .../features route,
        // GuildAudience.Guild), which lists exactly the Guild-audience features — so the card counts
        // those, not the per-alliance/audience features summarized by the Alliance cards below.
        enabledCount = 0;
        totalCount = 0;
        foreach (var feature in FeatureCatalog.All)
        {
            if (!feature.RelevantAudiences().HasFlag(GuildAudience.Guild))
                continue;

            totalCount++;
            if (await FeatureService.IsEnabledAsync(ParsedGuildId, feature.Feature, GuildAudience.Guild, null))
                enabledCount++;
        }

        await LoadBotStatusSummaryAsync();
    }

    // Live one-liner for the Permission Check card, mirroring that page's top banner: whether the
    // bot has Manage Roles and whether any non-admin role outranks it. A Discord hiccup shouldn't
    // break the Overview, so a REST failure just shows a neutral fallback.
    private async Task LoadBotStatusSummaryAsync()
    {
        try
        {
            var botUserId = ulong.Parse(Configuration["Discord:ClientId"]!);
            var status = await DiscordData.GetBotRoleStatusAsync(ParsedGuildId, botUserId);
            botStatusSummary = !status.HasManageRoles
                ? Msg.WebGuild.MissingManageRoles(Lang)
                : status.NonAdminRolesAbove > 0
                    ? Msg.WebGuild.RolesAboveBot(Lang, status.NonAdminRolesAbove)
                    : Msg.WebGuild.PermissionsOk(Lang);
        }
        catch (RestException)
        {
            botStatusSummary = Msg.WebGuild.DiscordUnreachable(Lang);
        }
    }

    // Per-card subtitle for the Overview grid, keyed by the page's route suffix. The dynamic bits
    // (audience summary, feature counts, setup + permission status) are computed above; Settings
    // has no single headline number, so it gets a static descriptor.
    private string CardSubtitle(AdminPage page) => page.RouteSuffix switch
    {
        "audience" => audienceSummary ?? Msg.WebGuild.NotConfiguredYet(Lang),
        "features" => Msg.WebGuild.EnabledCount(Lang, enabledCount, totalCount),
        "settings" => Msg.WebGuild.SettingsSubtitle(Lang),
        "setup-wizard" => setupComplete ? Msg.WebGuild.SetupComplete(Lang) : Msg.WebGuild.NeedsSetupSubtitle(Lang),
        "permission-check" => botStatusSummary ?? "…",
        _ => "",
    };

    private async Task OpenAllianceAsync(int guildAllianceId)
    {
        await AllianceContext.SetAsync(guildAllianceId);
        Nav.NavigateTo($"manage/guild/{GuildId}/alliance/{guildAllianceId}");
    }
}
