@page "/manage/guild/{GuildId}/{AudienceSlug}/settings"
@inherits GuildAdminPageBase
@using NetCord
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject LanguageResolver LanguageResolver
@inject DiscordGuildDataService DiscordData
@inject GuildFeatureService FeatureService

<PageTitle>@(validAudience ? Msg.WebGuild.AudienceSettingsTitle(Lang, AudienceTitle) : Msg.WebGuild.AudienceSettingsHeading(Lang))</PageTitle>

<AuthorizedGuildView Authorized="Authorized">
    @if (!validAudience)
    {
        <h1>@Msg.WebGuild.AudienceSettingsHeading(Lang)</h1>
        <p>@Msg.WebGuild.UnknownAudienceLead(Lang) <a href="@($"manage/guild/{GuildId}/audience")">@Msg.WebNav.Audience(Lang)</a>@Msg.WebGuild.UnknownAudienceTail(Lang)</p>
    }
    else
    {
        <h1>@Msg.WebGuild.AudienceSettingsTitle(Lang, AudienceTitle)</h1>
        <p>@AudienceDisplay.Description(Lang, audience) @Msg.WebGuild.AudienceSettingsIntro(Lang) <a href="@($"{AudienceDisplay.FeatureScopePrefix(ParsedGuildId, audience, null)}/features")">@Msg.WebNav.Features(Lang)</a>@Msg.WebGuild.AudienceSettingsIntroTail(Lang)</p>

        @* The linking UI for this audience, moved here from the Audience page's accordion — one
           page per audience now, reached from that page's Configure link. Community has no
           GuildXxx link entity, so ScopeEditor renders nothing for it; say so rather than leaving
           a gap where the other audiences have a table. *@
        @if (audience == GuildAudience.Community)
        {
            <div class="card-grid mt-1 mb-4">
                <SettingsCard Title="@Msg.WebGuild.NothingToLinkCardTitle(Lang)">
                    <p class="form-text mt-0 mb-0">@Msg.WebGuild.NothingToLinkUsage(Lang)</p>
                </SettingsCard>
            </div>
        }
        else
        {
            <div class="mb-4">
                <ScopeEditor GuildId="ParsedGuildId" Audience="audience" />
            </div>
        }

        @* Its own group, above the rest: not one setting among the others but the default they
           get created under. Never hidden — every audience creates channels, so every audience
           needs somewhere to put them. Mirrors the Alliance audience's own Settings page. *@
        <h2>@Msg.WebCommon.Defaults(Lang)</h2>
        <div class="card-grid mt-1">
            <ChannelPicker CardTitle="@Msg.WebAlliance.DefaultCategoryTitle(Lang)"
                           Usage="@Msg.WebAlliance.DefaultCategoryUsage(Lang)"
                           PlaceholderText="@Msg.WebAlliance.ServerRootPlaceholder(Lang)"
                           CategorySelect="true" CreateChannelName="Hoshi Bot" Channels="categories"
                           @bind-Value="categoryInput" @bind-Value:after="SaveCategoryAsync" />
        </div>

        @* Shown only while a feature enabled for THIS audience reads it — see SharedSettingUsage. *@
        @if (showSeniorStaff)
        {
            <h2>@Msg.WebCommon.Roles(Lang)</h2>
            <div class="card-grid mt-1">
                <RolePicker CardTitle="@Msg.WebCommon.SeniorStaffRole(Lang)"
                            Usage="@Msg.WebCommon.SeniorStaffRoleUsage(Lang)"
                            CreateRoleName="Senior Staff" Roles="roles"
                            @bind-Value="seniorStaffInput" @bind-Value:after="SaveSeniorStaffAsync" />
            </div>
        }

        <h2>@Msg.WebCommon.Regional(Lang)</h2>
        <div class="card-grid mt-1">
            <LanguagePicker CardTitle="@Msg.WebGuild.LanguageTitle(Lang)"
                            Usage="@Msg.WebGuild.AudienceLanguageUsage(Lang)"
                            InheritedLabel="@InheritedLanguageLabel"
                            @bind-Value="languageInput" @bind-Value:after="SaveLanguageAsync" />
        </div>
    }
</AuthorizedGuildView>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [Parameter] public string? AudienceSlug { get; set; }

    private GuildAudience audience;
    private bool validAudience;
    private string? languageInput;
    private string? categoryInput;
    private string? seniorStaffInput;
    private List<Role> roles = [];
    private List<CategoryGuildChannel> categories = [];
    private string? guildLanguageName;

    private string AudienceTitle => AudienceDisplay.Labels(Lang, audience).First();

    // What an empty language selection resolves to — the resolved guild language once
    // loaded; the bare "guild language" wording during the transient pre-load render.
    private string InheritedLanguageLabel => guildLanguageName is null
        ? Msg.WebGuild.GuildLanguage(Lang)
        : Msg.WebGuild.GuildLanguageInherited(Lang, guildLanguageName);

    protected override async Task OnAuthorizedParametersSetAsync()
    {
        validAudience = AudienceDisplay.TryParseSlug(AudienceSlug, out audience);

        // Guild-wide and Alliance settings have their own homes — redirect rather than
        // duplicating them here (Alliance language is per-alliance, not per-audience).
        if (audience == GuildAudience.Guild)
        {
            Nav.NavigateTo($"manage/guild/{GuildId}/settings");
            return;
        }
        if (audience == GuildAudience.Alliance)
        {
            Nav.NavigateTo($"manage/guild/{GuildId}/alliance/settings");
            return;
        }

        if (!validAudience)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var settings = await db.GuildAudienceSettings
            .FirstOrDefaultAsync(a => a.GuildId == ParsedGuildId && a.Audience == audience);
        languageInput = settings?.Language;
        categoryInput = settings?.DefaultChannelCategoryId?.ToString();
        seniorStaffInput = settings?.SeniorStaffRoleId?.ToString();
        roles = await DiscordData.GetRolesAsync(ParsedGuildId);

        categories = await DiscordData.GetCategoriesAsync(ParsedGuildId);

        guildLanguageName = Languages.NativeName(await LanguageResolver.ForGuildAsync(ParsedGuildId));

        showSeniorStaff = await FeatureService.AnyEnabledAsync(
            ParsedGuildId, SharedSettingUsage.SeniorStaffRole, audience, null);
    }

    private bool showSeniorStaff;

    private Task SaveLanguageAsync() => UpdateAsync(a => a.Language = languageInput);

    private Task SaveCategoryAsync() => UpdateAsync(a => a.DefaultChannelCategoryId = ParseId(categoryInput));

    private Task SaveSeniorStaffAsync() => UpdateAsync(a => a.SeniorStaffRoleId = ParseId(seniorStaffInput));

    // One row per audience holding every audience-level setting, created on first use and deleted
    // once nothing is set — so "inherit everything" stays the absence of a row rather than a row
    // full of nulls that reads like a decision.
    private async Task UpdateAsync(Action<GuildAudienceSettings> apply)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.GuildAudienceSettings
            .FirstOrDefaultAsync(a => a.GuildId == ParsedGuildId && a.Audience == audience);

        var row = existing ?? new GuildAudienceSettings { GuildId = ParsedGuildId, Audience = audience };
        apply(row);

        if (row.Language is null && row.DefaultChannelCategoryId is null && row.SeniorStaffRoleId is null)
        {
            if (existing is not null)
                db.GuildAudienceSettings.Remove(existing);
        }
        else if (existing is null)
        {
            db.GuildAudienceSettings.Add(row);
        }

        await db.SaveChangesAsync();
    }

    private static ulong? ParseId(string? input) => ulong.TryParse(input, out var id) ? id : null;

}
