@page "/"
@layout LandingLayout

<PageTitle>Hoshi Bot</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <h1>Command Your STFC Community With Hoshi Bot.</h1>
            <p class="hero-subtitle">
                Raid and shield alerts, absences, Territory Capture reminders, RoE reports, and more —
                one bot for your STFC alliance, server, veil group, or community.
            </p>
            <div class="hero-actions">
                <a class="btn btn-light btn-lg" href="invite">Add to Discord</a>
                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-outline-light btn-lg" href="manage/dashboard">Manage</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-light btn-lg" href="login">Log in with Discord</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <img src="favicon.png" alt="" class="hero-portrait" />
    </div>
</section>

<section class="features">
    <h2>Built for Every Kind of STFC Discord</h2>
    <p class="features-intro">Jump to what matters for your Discord.</p>
    <div class="audience-overview-grid">
        @foreach (var audience in AudienceSections)
        {
            <a class="audience-overview-card" href="#audience-@audience">
                <div class="feature-icon"><span class="oi @AudienceDisplay.Icon(audience)" aria-hidden="true"></span></div>
                <h3>@AudienceDisplay.Labels(audience).First()</h3>
                <p>@Tagline(audience)</p>
            </a>
        }
    </div>
</section>

@foreach (var audience in AudienceSections)
{
    var cards = FeatureCatalog.All
        .Where(f => f.RelevantAudiences().HasFlag(audience))
        .Select(f => (f.Icon, f.Title, f.Description))
        .Concat(ExtraCards.GetValueOrDefault(audience, []))
        .ToList();

    <section id="audience-@audience" class="features">
        <h2>For @(AudienceDisplay.Labels(audience).First()) Discords</h2>
        <p class="features-intro">@Intro(audience)</p>
        @if (cards.Count > 0)
        {
            <div class="feature-grid">
                @foreach (var card in cards)
                {
                    <div class="feature-card">
                        <div class="feature-icon"><span class="oi @card.Icon" aria-hidden="true"></span></div>
                        <h3>@card.Title</h3>
                        <p>@card.Description</p>
                    </div>
                }
            </div>
        }
    </section>
}

<section class="cta">
    <div class="cta-inner">
        <h2>Ready to upgrade your Discord?</h2>
        <p>Add Hoshi Bot to your server and get set up in minutes.</p>
        <a class="btn btn-light btn-lg" href="invite">Add to Discord</a>
    </div>
</section>

@code {
    private static readonly GuildAudience[] AudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    // Real bot capabilities that aren't IFeatureModule entries — Setup Wizard is a one-time
    // guided flow, not a toggleable feature; nickname/role sync and onboarding are
    // guild-level settings, not their own admin page. Kept here so the page can still
    // advertise them without pretending they're feature modules.
    private static readonly Dictionary<GuildAudience, (string Icon, string Title, string Description)[]> ExtraCards = new()
    {
        [GuildAudience.Alliance] =
        [
            ("oi-wrench", "Setup Wizard", "Get a new server configured in minutes with a guided, step-by-step setup flow."),
        ],
        [GuildAudience.Server] =
        [
            ("oi-loop-circular", "Member Name & Role Sync", "Keep Discord nicknames and roles in sync with in-game commander names, automatically."),
            ("oi-account-login", "Member Onboarding", "A guided welcome flow gets new members oriented before they touch the rest of the server."),
        ],
        [GuildAudience.VeilGroup] =
        [
            ("oi-loop-circular", "Member Name & Role Sync", "Keep Discord nicknames and roles in sync with in-game commander names, automatically."),
            ("oi-account-login", "Member Onboarding", "A guided welcome flow gets new members oriented before they touch the rest of the server."),
        ],
        [GuildAudience.Community] = [],
    };

    private static string Tagline(GuildAudience audience) => audience switch
    {
        GuildAudience.Alliance => "Run day-to-day alliance operations.",
        GuildAudience.Server => "Organize a whole STFC server.",
        GuildAudience.VeilGroup => "Coordinate across a veil group.",
        GuildAudience.Community => "Support a general STFC community.",
        _ => "",
    };

    private static string Intro(GuildAudience audience) => audience switch
    {
        GuildAudience.Alliance => "Everything your alliance leadership needs to run day-to-day operations.",
        GuildAudience.Server => "Running a Discord for a whole STFC server? Hoshi Bot keeps membership organized across everyone in it.",
        GuildAudience.VeilGroup => "Running a Discord for a veil group spanning multiple servers? Hoshi Bot keeps membership organized across everyone in it.",
        GuildAudience.Community => "Not tied to one alliance, server, or veil group? Hoshi Bot's announcements, tickets, and anonymous messages work just as well for general STFC community and fan Discords.",
        _ => "",
    };
}
