@page "/"
@layout LandingLayout

<PageTitle>Hoshi Bot</PageTitle>

<section class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <h1>@Msg.WebLanding.HeroTitle(Lang)</h1>
            <p class="hero-subtitle">
                @Msg.WebLanding.HeroSubtitle(Lang)
            </p>
            <div class="hero-actions">
                <a class="btn btn-light btn-lg" href="invite">@Msg.WebLanding.AddToDiscord(Lang)</a>
                <AuthorizeView>
                    <Authorized>
                        <a class="btn btn-outline-light btn-lg" href="manage">@Msg.WebNav.Manage(Lang)</a>
                        <a class="btn btn-outline-light btn-lg" href="me">@Msg.WebNav.MyArea(Lang)</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-outline-light btn-lg" href="login">@Msg.WebLanding.LogInWithDiscord(Lang)</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <img src="favicon.png" alt="" class="hero-portrait" />
    </div>
</section>

<section class="features">
    <h2>@Msg.WebLanding.FeaturesTitle(Lang)</h2>
    <p class="features-intro">@Msg.WebLanding.FeaturesIntro(Lang)</p>
    <div class="row g-4">
        @foreach (var audience in AudienceSections)
        {
            <div class="col-12 col-md-6 col-lg-3">
                <a class="card h-100 text-decoration-none text-body text-center" href="#audience-@audience">
                    <div class="card-body">
                        <div class="feature-icon mx-auto"><span class="oi @AudienceDisplay.Icon(audience)" aria-hidden="true"></span></div>
                        <h3>@AudienceDisplay.Labels(Lang, audience).First()</h3>
                        <p class="mb-0 card-subtext audience-tagline">@Msg.WebLanding.AudienceTagline(Lang, audience)</p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

@* Members sit right after the four server-type cards above: the reader has just been told which
   kind of Discord Hoshi is for, and "what's in it for me as a member" belongs there — before the
   long per-audience feature lists those cards link down into, not buried underneath them. *@
<section class="features">
    <h2>@Msg.WebLanding.MembersTitle(Lang)</h2>
    <p class="features-intro">
        @Msg.WebLanding.MembersIntro(Lang)
    </p>
    @* Centered, unlike the per-audience grids below: those fill their rows, while MePages is a
       short list (one entry today) that would otherwise sit hard left under a centered heading. *@
    <div class="row g-4 justify-content-center">
        @foreach (var p in MePages.All)
        {
            <div class="col-12 col-md-6 col-lg-4">
                @* Centred content, matching the server-type cards directly above — the
                   per-audience feature cards below stay left-aligned. *@
                <div class="card h-100">
                    <div class="card-body text-center">
                        <div class="feature-icon mx-auto"><span class="oi @p.Icon" aria-hidden="true"></span></div>
                        <h3>@p.Label(Lang)</h3>
                        <p class="mb-0 card-subtext">@p.Description(Lang)</p>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-4 text-center">
        <AuthorizeView>
            <Authorized>
                <a class="btn btn-primary btn-lg" href="me">@Msg.WebLanding.OpenMyArea(Lang)</a>
            </Authorized>
            <NotAuthorized>
                @* returnUrl so the login round-trip lands on /me instead of /manage — without it
                   an anonymous click straight through to /me is bounced to "/" by Routes.razor's
                   RedirectToHome. *@
                <a class="btn btn-primary btn-lg" href="login?returnUrl=/me">@Msg.WebLanding.LogInWithDiscord(Lang)</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

@foreach (var audience in AudienceSections)
{
    var cards = FeatureCatalog.All
        .Where(f => f.RelevantAudiences().HasFlag(audience))
        .Select(f => (f.Icon, Title: f.Title(Lang), Description: f.Description(Lang)))
        .Concat(ExtraCards(audience))
        .OrderBy(c => c.Title, StringComparer.OrdinalIgnoreCase)
        .ToList();

    <section id="audience-@audience" class="features">
        <h2>@Msg.WebLanding.AudienceSectionHeading(Lang, AudienceDisplay.Labels(Lang, audience).First())</h2>
        <p class="features-intro">@Msg.WebLanding.AudienceIntro(Lang, audience)</p>
        @if (cards.Count > 0)
        {
            <div class="row g-4">
                @foreach (var card in cards)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="feature-icon"><span class="oi @card.Icon" aria-hidden="true"></span></div>
                                <h3>@card.Title</h3>
                                <p class="mb-0 card-subtext">@card.Description</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

<section class="cta">
    <div class="cta-inner">
        <h2>@Msg.WebLanding.CtaTitle(Lang)</h2>
        <p>@Msg.WebLanding.CtaSubtitle(Lang)</p>
        <a class="btn btn-light btn-lg" href="invite">@Msg.WebLanding.AddToDiscord(Lang)</a>
    </div>
</section>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    private static readonly GuildAudience[] AudienceSections =
        [GuildAudience.Alliance, GuildAudience.Server, GuildAudience.VeilGroup, GuildAudience.Community];

    // Real bot capabilities that aren't IFeatureModule entries — Setup Wizard is a one-time
    // guided flow, not a toggleable feature; nickname/role sync and onboarding are
    // guild-level settings, not their own admin page. Kept here so the page can still
    // advertise them without pretending they're feature modules.
    // Announcement Forwarder IS a real feature (GuildFeature.AnnouncementForwarder), but a
    // Guild-audience one (one destination for the whole Discord, not per-alliance/server/veil-
    // group/community), so it never matches the per-audience FeatureCatalog filter above —
    // listed here instead, duplicated across every section like Member Name & Role Sync below,
    // since translating official game announcements is equally useful for any kind of Discord.
    // Its title reuses Msg.WebFeature.Title (identical wording to the admin catalog); its
    // description is landing-specific pitch copy, kept separate from the admin description.
    private (string Icon, string Title, string Description)[] ExtraCards(GuildAudience audience)
    {
        var announcementForwarder = ("oi-globe", Msg.WebFeature.Title(Lang, GuildFeature.AnnouncementForwarder), Msg.WebLanding.AnnouncementForwarderPitch(Lang));

        return audience switch
        {
            GuildAudience.Alliance =>
            [
                ("oi-wrench", Msg.WebNav.SetupWizard(Lang), Msg.WebLanding.SetupWizardDescription(Lang)),
                announcementForwarder,
            ],
            GuildAudience.Server or GuildAudience.VeilGroup =>
            [
                ("oi-loop-circular", Msg.WebLanding.MemberSyncTitle(Lang), Msg.WebLanding.MemberSyncDescription(Lang)),
                ("oi-account-login", Msg.WebFeature.Title(Lang, GuildFeature.MemberOnboarding), Msg.WebLanding.MemberOnboardingPitch(Lang)),
                announcementForwarder,
            ],
            GuildAudience.Community => [announcementForwarder],
            _ => [],
        };
    }
}
