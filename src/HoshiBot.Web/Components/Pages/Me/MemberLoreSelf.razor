@page "/me/lore"
@using System.Security.Claims
@using HoshiBot.Data
@using HoshiBot.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using NetCord.Rest
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject RestClient BotRest

<PageTitle>My Profile</PageTitle>

<div class="container py-4" style="max-width:900px">

<h1>My Profile in Hoshi</h1>
<p class="text-muted">
    Here you can see and edit what Hoshi knows about you, so she addresses you the right way and can
    chat with you like a real community member. Only you can change your own entries.
</p>

@if (loading)
{
    <LoadingPlaceholder Em="false" Text="Loading…" />
}
else if (cards.Count == 0)
{
    <p class="text-muted">There's nothing for you to edit here right now (no matching community found).</p>
}
else
{
    @foreach (var c in cards)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 mb-3">@c.GuildName</h2>

                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small mb-1">What should Hoshi call you?</label>
                        <input class="form-control form-control-sm" @bind="c.Note.PreferredName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Nicknames</label>
                        <input class="form-control form-control-sm" @bind="c.Note.Nicknames" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Languages</label>
                        <input class="form-control form-control-sm" @bind="c.Note.Languages" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small mb-1">Interests / hobbies</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="c.Note.Interests"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-1">About you (whatever you'd like to share)</label>
                        <textarea class="form-control form-control-sm" rows="2" @bind="c.Note.Background"></textarea>
                    </div>
                </div>

                <div class="mt-2">
                    <button class="btn btn-sm btn-primary" @onclick="() => SaveAsync(c)">Save</button>
                    @if (c.Saved)
                    {
                        <span class="text-success small ms-2">Saved ✓</span>
                    }
                </div>

                @if (c.HasPeerLore)
                {
                    <hr />
                    <h3 class="h6">What others have said about you</h3>
                    <p class="form-text mt-0">
                        Notes contributed by other members. You can't edit them, but you can hide them —
                        then Hoshi won't use them and the team takes another look.
                    </p>
                    @if (!string.IsNullOrWhiteSpace(c.Note.RunningJokes))
                    {
                        <p class="mb-1"><span class="badge bg-secondary">Running jokes</span> @c.Note.RunningJokes</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(c.Note.TeaseAbout))
                    {
                        <p class="mb-1"><span class="badge bg-secondary">OK to tease</span> @c.Note.TeaseAbout</p>
                    }
                    <div class="form-switch mt-2">
                        <input type="checkbox" class="form-check-input" role="switch" id="hide-@c.GuildId"
                               checked="@c.Note.PeerLoreHidden" @onchange="e => ToggleHiddenAsync(c, (bool)e.Value!)" />
                        <label class="form-check-label" for="hide-@c.GuildId">Hide these notes</label>
                    </div>
                }
            </div>
        </div>
    }
}

</div>

@code {
    private bool loading = true;
    private ulong userId;
    private List<GuildCard> cards = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (idClaim is null || !ulong.TryParse(idClaim, out userId))
        {
            loading = false;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        // The guilds that run MemberLore, that this user is actually a member of (checked bot-side, so
        // we never need the user's OAuth token inside the circuit).
        var guildIds = await db.GuildEnabledFeatures
            .Where(f => f.Feature == GuildFeature.MemberLore)
            .Select(f => f.GuildId)
            .Distinct()
            .ToListAsync();

        foreach (var guildId in guildIds)
        {
            if (!await IsMemberAsync(guildId))
                continue;

            var note = await db.GuildMemberNotes.AsNoTracking()
                .FirstOrDefaultAsync(n => n.GuildId == guildId && n.DiscordUserId == userId)
                ?? new GuildMemberNote { GuildId = guildId, DiscordUserId = userId };

            var guildName = await db.DiscordGuilds.Where(g => g.Id == guildId).Select(g => g.Name).FirstOrDefaultAsync();
            cards.Add(new GuildCard { GuildId = guildId, GuildName = guildName ?? "Community", Note = note });
        }

        loading = false;
    }

    private async Task<bool> IsMemberAsync(ulong guildId)
    {
        try
        {
            _ = await BotRest.GetGuildUserAsync(guildId, userId);
            return true;
        }
        catch (RestException)
        {
            return false; // 404 = not a member (or the bot can't see them)
        }
    }

    private async Task SaveAsync(GuildCard c)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var note = await db.GuildMemberNotes.FirstOrDefaultAsync(n => n.GuildId == c.GuildId && n.DiscordUserId == userId);
        if (note is null)
        {
            note = new GuildMemberNote { GuildId = c.GuildId, DiscordUserId = userId };
            db.GuildMemberNotes.Add(note);
        }
        // Self-fields only — never touch the peer-authored fields here.
        note.PreferredName = Clean(c.Note.PreferredName);
        note.Nicknames = Clean(c.Note.Nicknames);
        note.Languages = Clean(c.Note.Languages);
        note.Interests = Clean(c.Note.Interests);
        note.Background = Clean(c.Note.Background);
        note.SelfUpdatedAt = DateTimeOffset.UtcNow;
        await db.SaveChangesAsync();
        c.Saved = true;
    }

    private async Task ToggleHiddenAsync(GuildCard c, bool hidden)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var note = await db.GuildMemberNotes.FirstOrDefaultAsync(n => n.GuildId == c.GuildId && n.DiscordUserId == userId);
        if (note is null)
            return;
        note.PeerLoreHidden = hidden;
        await db.SaveChangesAsync();
        c.Note.PeerLoreHidden = hidden;
    }

    private static string? Clean(string? v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();

    private class GuildCard
    {
        public ulong GuildId { get; set; }
        public string GuildName { get; set; } = "";
        public GuildMemberNote Note { get; set; } = new();
        public bool Saved { get; set; }
        public bool HasPeerLore => !string.IsNullOrWhiteSpace(Note.RunningJokes) || !string.IsNullOrWhiteSpace(Note.TeaseAbout);
    }
}
