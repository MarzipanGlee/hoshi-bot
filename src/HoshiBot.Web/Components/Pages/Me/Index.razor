@page "/me"
@using Microsoft.AspNetCore.Authentication
@inject AuthenticationStateProvider AuthStateProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject DiscordUserGuildsService DiscordUserGuilds
@inject DiscordGuildDataService DiscordData
@inject PlayerLinkService PlayerLink
@inject IDbContextFactory<HoshiBotDbContext> DbFactory
@inject LanguageResolver LanguageResolver
@inject NavigationManager Nav

<PageTitle>@Msg.WebNav.MyArea(Lang)</PageTitle>

<div class="container py-4" style="max-width:900px">

    <div class="d-flex align-items-center gap-3 mb-2">
        @if (avatarUrl is not null)
        {
            <img src="@avatarUrl" alt="" class="rounded-circle object-fit-cover flex-shrink-0" style="width:3.5rem;height:3.5rem;" />
        }
        else
        {
            @* Same fallback the admin topbar uses for a user with no custom Discord avatar;
               inline because the sizing is arbitrary and the colours aren't worth a class
               for one element. *@
            <span class="oi oi-person d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                  style="width:3.5rem;height:3.5rem;background-color:#e5e5e8;color:#8a8a92;" aria-hidden="true"></span>
        }
        <h1 class="mb-0">@(userName ?? Msg.WebNav.MyArea(Lang))</h1>
    </div>
    <p class="card-subtext">@Msg.WebMe.Lead(Lang)</p>

    @if (LinkResultMessage is { } linkMessage)
    {
        <div class="alert @(Link == "ok" ? "alert-success" : "alert-warning") alert-dismissible fade show" role="alert">
            @linkMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-grid">
        @foreach (var p in MePages.All)
        {
            <NavCard Href="@MePages.Href(p)" Icon="@p.Icon" Title="@p.Label(Lang)" Subtitle="@p.Description(Lang)" />
        }
    </div>

    <h2 class="mt-5 mb-2">@Msg.WebMe.PlayerAccountsTitle(Lang)</h2>
    <p class="card-subtext">
        @Msg.WebMe.PlayerAccountsLead(Lang)
    </p>

    @if (loading)
    {
        <p class="card-subtext">@Msg.WebNav.GuildsLoading(Lang)</p>
    }
    else
    {
        @if (players.Count == 0)
        {
            <p class="card-subtext">@Msg.WebMe.NoPlayersYet(Lang)</p>
        }
        else
        {
            <ul class="list-group mb-3">
                @foreach (var player in players)
                {
                    <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span>
                            @PlayerLabel.Of(player.Name, player.ServerName, player.AllianceTag)
                            @if (player.OwnerId != currentUserId)
                            {
                                <span class="card-subtext ms-2">@Msg.WebMe.Via(Lang, OwnerName(player.OwnerId))</span>
                            }
                        </span>
                        @if (player.OwnerId == currentUserId)
                        {
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemovePlayerAsync(player.PlayerId)">@Msg.WebCommon.Remove(Lang)</button>
                        }
                    </li>
                }
            </ul>
        }

        <div style="max-width:26rem">
            <label class="form-label small mb-1" for="player-search">@Msg.WebMe.ConnectPlayerLabel(Lang)</label>
            <input id="player-search" class="form-control form-control-sm" placeholder="@Msg.WebMe.SearchPlaceholder(Lang)"
                   value="@playerSearchTerm" @oninput="OnPlayerSearchAsync" />
            @if (playerSearchResults.Count > 0)
            {
                <div class="list-group mt-1" style="max-height:14rem;overflow-y:auto">
                    @foreach (var result in playerSearchResults)
                    {
                        <button type="button" class="list-group-item list-group-item-action py-1"
                                @onclick="() => ConnectPlayerAsync(result)">
                            @PlayerLabel.Of(result.Name, result.ServerName, result.AllianceTag)
                        </button>
                    }
                </div>
            }
            @if (playerError is { } error)
            {
                <p class="text-danger small mt-2 mb-0">@error</p>
            }
        </div>
    }

    <h2 class="mt-5 mb-2">@Msg.WebMe.CommunitiesTitle(Lang)</h2>
    @if (loading)
    {
        <p class="card-subtext">@Msg.WebNav.GuildsLoading(Lang)</p>
    }
    else if (sharedGuilds.Count == 0)
    {
        @* One message for both cases: DiscordUserGuildsService degrades a rate-limited or
           failed /users/@@me/guilds call to an empty list, so "none shared" and "Discord
           didn't answer" are indistinguishable here. *@
        <p class="card-subtext">
            @Msg.WebMe.NoCommunities(Lang)
        </p>
    }
    else
    {
        <div class="card-grid">
            @foreach (var guild in sharedGuilds)
            {
                <SettingsCard>
                    <HeaderContent>
                        <div class="d-flex align-items-center gap-3">
                            <GuildIcon GuildId="guild.Id" IconHash="@guild.IconHash" Name="@guild.Name"
                                       CssClass="rounded-circle object-fit-cover flex-shrink-0"
                                       Style="width:2.5rem;height:2.5rem;font-size:1rem;" />
                            <h3 class="fs-6 fw-semibold mb-0">@guild.Name</h3>
                        </div>
                    </HeaderContent>
                    <ChildContent>
                        @{ var audience = audiencesByGuildId.GetValueOrDefault(guild.Id); }
                        @if (audience != GuildAudience.None)
                        {
                            <div>
                                @foreach (var label in AudienceDisplay.Labels(Lang, audience))
                                {
                                    <span class="badge bg-secondary me-1">@label</span>
                                }
                            </div>
                        }

                        @if (players.Count == 0)
                        {
                            <p class="mb-0 card-subtext">@Msg.WebMe.ConnectPlayerToGetRoles(Lang)</p>
                        }
                        else if (players.Count == 1)
                        {
                            <p class="mb-0 card-subtext">@Msg.WebMe.PlayingHereAs(Lang, players[0].Name)</p>
                        }
                        else
                        {
                            @* Plain <select>, not BootstrapBlazor's — MeLayout has no BootstrapBlazorRoot,
                               and the rest of /me is plain Bootstrap too. *@
                            <div>
                                <label class="form-label small mb-1" for="primary-@guild.Id">@Msg.WebMe.PlayingHereAsLabel(Lang)</label>
                                <select id="primary-@guild.Id" class="form-select form-select-sm"
                                        value="@PrimaryPlayerId(guild.Id)"
                                        @onchange="e => SetGuildPrimaryAsync(guild.Id, e.Value?.ToString())">
                                    @foreach (var player in players)
                                    {
                                        <option value="@player.PlayerId" selected="@(PrimaryPlayerId(guild.Id) == player.PlayerId)">
                                            @PlayerLabel.Of(player.Name, player.ServerName, player.AllianceTag)
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                    </ChildContent>
                </SettingsCard>
            }
        </div>
    }

    <h2 class="mt-5 mb-2">@Msg.WebMe.LanguageTitle(Lang)</h2>
    <p class="card-subtext">
        @Msg.WebMe.LanguageLead(Lang)
    </p>

    @if (!loading)
    {
        @* Plain <select>, not BootstrapBlazor's — MeLayout has no BootstrapBlazorRoot,
           same constraint as the per-community primary-player selects above. *@
        <select class="form-select w-auto" @onchange="OnLanguageChangedAsync">
            <option value="" selected="@(userLanguage is null)">@Msg.WebMe.Automatic(Lang, automaticLanguageLabel)</option>
            @foreach (var language in Languages.Enabled)
            {
                <option value="@Languages.ToCode(language)" selected="@(userLanguage == Languages.ToCode(language))">
                    @Languages.NativeName(language)
                </option>
            }
        </select>
    }

    <h2 class="mt-5 mb-2">@Msg.WebMe.DiscordAccountsTitle(Lang)</h2>
    <p class="card-subtext">
        @Msg.WebMe.DiscordAccountsLead(Lang)
    </p>

    @if (!loading)
    {
        <ul class="list-group mb-3">
            @foreach (var accountId in accountGroup.OrderByDescending(id => id == currentUserId).ThenBy(id => id))
            {
                <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <span class="d-flex align-items-center gap-2">
                        @if (AccountAvatar(accountId) is { } accountAvatar)
                        {
                            <img src="@accountAvatar" alt="" class="rounded-circle object-fit-cover flex-shrink-0" style="width:1.75rem;height:1.75rem;" />
                        }
                        <span>@OwnerName(accountId)</span>
                        @if (accountId == currentUserId)
                        {
                            <span class="badge bg-secondary">@Msg.WebMe.SignedInBadge(Lang)</span>
                        }
                    </span>
                    @if (accountId != currentUserId)
                    {
                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => UnlinkAccountAsync(accountId)">@Msg.WebCommon.Remove(Lang)</button>
                    }
                </li>
            }
        </ul>

        @* A real navigation, not an @@onclick: this starts an OAuth challenge on the server. *@
        <a class="btn btn-primary" href="@DiscordAccountLink.StartPath">@Msg.WebMe.LinkAnotherAccount(Lang)</a>
        <p class="card-subtext mt-2 mb-0">
            @((MarkupString)Msg.WebMe.LinkAnotherAccountHint(Lang))
        </p>
    }

</div>

@code {
    [CascadingParameter] public Language Lang { get; set; }

    [SupplyParameterFromQuery(Name = DiscordAccountLink.ResultQueryKey)]
    public string? Link { get; set; }

    private ulong currentUserId;
    private string? userName;
    private string? avatarUrl;
    private bool loading = true;

    private HashSet<ulong> accountGroup = [];
    private List<PersonPlayer> players = [];
    private IReadOnlyDictionary<ulong, DiscordUserSummary> accountSummaries = new Dictionary<ulong, DiscordUserSummary>();

    private List<UserManagedGuild> sharedGuilds = [];
    private Dictionary<ulong, GuildAudience> audiencesByGuildId = [];
    private Dictionary<ulong, int> primaryByGuildId = [];

    private string playerSearchTerm = "";
    private List<PlayerSearchResult> playerSearchResults = [];
    private string? playerError;

    private string? userLanguage;
    private string automaticLanguageLabel = "your Discord language";

    private string? LinkResultMessage => Link switch
    {
        "ok" => Msg.WebMe.LinkOk(Lang),
        "already" => Msg.WebMe.LinkAlready(Lang),
        "self" => Msg.WebMe.LinkSelf(Lang),
        "noplayers" => Msg.WebMe.LinkNoPlayers(Lang),
        "failed" => Msg.WebMe.LinkFailed(Lang),
        _ => null,
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userName = user.Identity?.Name;
        avatarUrl = DiscordAvatar.UrlFor(user);

        if (!ulong.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out currentUserId))
        {
            loading = false;
            return;
        }

        // Same access-token route every other caller of DiscordUserGuildsService takes
        // (GuildSelector, Manage/Index) — the user's own OAuth token, not the bot's.
        var httpContext = HttpContextAccessor.HttpContext;
        var accessToken = httpContext is null ? null : await httpContext.GetTokenAsync("access_token");
        if (accessToken is not null)
            sharedGuilds = await DiscordUserGuilds.GetUserSharedBotGuildsAsync(accessToken, currentUserId);

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            audiencesByGuildId = await db.GuildSettings.AsNoTracking()
                .ToDictionaryAsync(s => s.GuildId, s => s.Audiences);

            var userRow = await db.DiscordUsers.AsNoTracking()
                .Where(u => u.DiscordUserId == currentUserId)
                .Select(u => new { u.Language, u.DiscordLocale })
                .FirstOrDefaultAsync();
            userLanguage = userRow?.Language;

            // The bot records DiscordLocale from interactions; before the first one, the web
            // login itself knows the locale (the mapped OAuth claim) — use it for the label
            // and seed the stored value so DMs can resolve the language too.
            var discordLocale = userRow?.DiscordLocale ?? user.FindFirst(DiscordAccountLink.LocaleClaim)?.Value;
            if (userRow?.DiscordLocale is null && discordLocale is not null)
                await LanguageResolver.RecordUserLocaleAsync(currentUserId, discordLocale);

            automaticLanguageLabel = Languages.FromDiscordLocale(discordLocale) is { } discordLanguage
                ? Msg.WebMe.DiscordLanguageLabel(Lang, Languages.NativeName(discordLanguage))
                : Msg.WebMe.YourDiscordLanguage(Lang);
        }

        await ReloadPersonAsync();
        loading = false;
    }

    private async Task OnLanguageChangedAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        userLanguage = string.IsNullOrEmpty(value) ? null : value;

        await using var db = await DbFactory.CreateDbContextAsync();
        var user = await db.DiscordUsers.FindAsync(currentUserId);
        if (user is null)
        {
            db.DiscordUsers.Add(new DiscordUser { DiscordUserId = currentUserId, Language = userLanguage });
        }
        else
        {
            user.Language = userLanguage;
        }

        await db.SaveChangesAsync();

        // The cascaded Lang was resolved once for this circuit (WebRequestLanguage, in
        // MeLayout.OnInitializedAsync) and stays fixed for its lifetime — a plain re-render
        // would keep showing the page in the old language. Force a full reload so the next
        // circuit re-resolves WebRequestLanguage against the language just saved above.
        Nav.NavigateTo("me", forceLoad: true);
    }

    // The whole person, not just this account: every Discord account linked to it and every player
    // any of them holds, plus each community's current pick.
    private async Task ReloadPersonAsync()
    {
        accountGroup = await PlayerLink.GetAccountGroupAsync(currentUserId);
        accountSummaries = await DiscordData.GetUserSummariesAsync(accountGroup);

        var linksByUser = await PlayerLink.GetLinksForUsersAsync(accountGroup);
        players = linksByUser
            .SelectMany(kv => kv.Value.Select(link => new PersonPlayer(kv.Key, link.PlayerId, link.Name, link.ServerName, link.AllianceTag)))
            // A player both accounts hold is one player to the person — show it once, owned by
            // whichever account is signed in if that's one of them.
            .GroupBy(p => p.PlayerId)
            .Select(g => g.FirstOrDefault(p => p.OwnerId == currentUserId) ?? g.First())
            .OrderBy(p => p.Name)
            .ToList();

        primaryByGuildId = [];
        await using var db = await DbFactory.CreateDbContextAsync();
        var picks = await db.GuildMembers
            .Where(gm => gm.DiscordUserId == currentUserId && gm.PrimaryStfcPlayerId != null)
            .Select(gm => new { gm.GuildId, PlayerId = gm.PrimaryStfcPlayerId!.Value })
            .ToListAsync();
        foreach (var pick in picks)
            primaryByGuildId[pick.GuildId] = pick.PlayerId;
    }

    private string OwnerName(ulong userId) =>
        accountSummaries.TryGetValue(userId, out var summary) ? summary.Name : userId.ToString();

    private string? AccountAvatar(ulong userId) =>
        accountSummaries.TryGetValue(userId, out var summary) ? summary.AvatarUrl : null;

    // The pick, or the fallback the sync jobs would use (oldest link) so the dropdown shows what's
    // actually in effect rather than an empty selection.
    private int? PrimaryPlayerId(ulong guildId) =>
        primaryByGuildId.TryGetValue(guildId, out var playerId) ? playerId : players.FirstOrDefault()?.PlayerId;

    private async Task OnPlayerSearchAsync(ChangeEventArgs e)
    {
        playerError = null;
        playerSearchTerm = e.Value?.ToString() ?? "";
        playerSearchResults = playerSearchTerm.Trim().Length < 2 ? [] : await PlayerLink.SearchPlayersAsync(playerSearchTerm);
    }

    private async Task ConnectPlayerAsync(PlayerSearchResult result)
    {
        // Someone else already plays this commander: linking anyway would silently merge two
        // people. Deliberately doesn't say *who* — otherwise the search doubles as a lookup of
        // which Discord account owns any given player.
        var owners = await PlayerLink.GetPlayerOwnersAsync(result.Id);
        if (owners.Any(owner => !accountGroup.Contains(owner)))
        {
            playerError = Msg.WebMe.PlayerAlreadyLinked(Lang, result.Name);
            return;
        }

        await PlayerLink.LinkAsync(currentUserId, result.Id);
        await PlayerLink.MarkUserResolvedAsync(currentUserId);
        playerSearchTerm = "";
        playerSearchResults = [];
        await ReloadPersonAsync();
    }

    private async Task RemovePlayerAsync(int playerId)
    {
        await PlayerLink.UnlinkAsync(currentUserId, playerId);
        await ReloadPersonAsync();
    }

    // Unlinking an account means dropping its links to the players it shares with this one — the
    // shared player IS the link, so there's nothing else to delete.
    private async Task UnlinkAccountAsync(ulong accountId)
    {
        var ownPlayerIds = players.Select(p => p.PlayerId).ToList();
        foreach (var playerId in ownPlayerIds)
            await PlayerLink.UnlinkAsync(accountId, playerId);
        await ReloadPersonAsync();
    }

    private async Task SetGuildPrimaryAsync(ulong guildId, string? value)
    {
        if (!int.TryParse(value, out var playerId))
            return;
        await PlayerLink.SetGuildPrimaryAsync(guildId, currentUserId, playerId);
        primaryByGuildId[guildId] = playerId;
    }

    private record PersonPlayer(ulong OwnerId, int PlayerId, string Name, string ServerName, string? AllianceTag);
}
