<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToHome />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        @* The title itself moves inside NotFoundContent, which is nested under LandingLayout
           and can consume its cascaded Language — this NotFound branch has no resolved
           language of its own yet. *@
        <LayoutView Layout="@typeof(Layout.LandingLayout)">
            <NotFoundContent />
        </LayoutView>
    </NotFound>
</Router>
